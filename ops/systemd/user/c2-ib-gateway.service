[Unit]
Description=DEPRECATED non-owning C2 IB Gateway marker

[Service]
Type=oneshot
ExecStart=/usr/bin/printf 'DEPRECATED: c2-ib-gateway.service is non-owning. Canonical IB Gateway owner is ib-gateway@node.service. Broker/account evidence remains the trading-readiness authority.\n'

[Install]
WantedBy=default.target
