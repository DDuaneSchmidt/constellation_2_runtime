[Unit]
Description=C2 Global Monitoring/Readiness Refresh (authoritative global truth)
After=network-online.target
Wants=network-online.target
After=c2-paper-day-orchestrator.service

[Service]
Type=oneshot
WorkingDirectory=/home/node/constellation
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash -lc 'set -euo pipefail; cd /home/node/constellation; DAY="$$(TZ=America/New_York date +%%F)"; exec /usr/bin/python3 /home/node/constellation/ops/tools/run_c2_global_monitoring_refresh_v1.py --day_utc "$$DAY" --truth_root /home/node/constellation_runtime_data/truth --with-diagnostics'
