[Unit]
Description=Aegis Lite EOD report v1 (manual-only, no broker submit, no transmit automation)
Documentation=/home/node/constellation/docs/aegis_lite_timer_model.md

[Service]
Type=oneshot
WorkingDirectory=/home/node/constellation_active
Environment=PYTHONUNBUFFERED=1
Environment=AEGIS_LITE_MANUAL_ONLY=1
Environment=AEGIS_MARKET_DATA_MODE=INTRADAY_OPERATIONAL
ExecStart=/home/node/constellation_runtime_data/truth/releases/run_current_release_tool_v1.sh run_aegis_intraday_sleeves_now_v1 --day-utc @today_utc@ --truth-root /home/node/constellation_runtime_data/truth --environment PAPER
