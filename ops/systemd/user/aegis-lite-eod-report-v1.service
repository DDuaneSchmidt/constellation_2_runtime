[Unit]
Description=Aegis Lite EOD report v1 (manual-only, no broker submit, no transmit automation)
Documentation=/home/node/constellation/docs/aegis_lite_timer_model.md

[Service]
Type=oneshot
WorkingDirectory=/home/node/constellation_active
Environment=PYTHONUNBUFFERED=1
Environment=AEGIS_LITE_MANUAL_ONLY=1
ExecStart=/home/node/constellation_runtime_data/truth/releases/run_current_release_tool_v1.sh run_aegis_lite_eod_pipeline_v1 --day_utc @today_utc@ --environment PAPER --manual-only --allow-not-ready-exit-zero
