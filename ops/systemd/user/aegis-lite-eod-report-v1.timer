[Unit]
Description=Schedule Aegis Lite sleeve runs v1 at 09:50 and 14:50 America/New_York weekdays
Documentation=/home/node/constellation/docs/aegis_lite_timer_model.md

[Timer]
OnCalendar=Mon-Fri 09:50 America/New_York
OnCalendar=Mon-Fri 14:50 America/New_York
AccuracySec=30s
Persistent=false
Unit=aegis-lite-eod-report-v1.service

[Install]
WantedBy=timers.target
