[Unit]
Description=Schedule Aegis Lite EOD report v1 at 15:35 America/New_York
Documentation=/home/node/constellation/docs/aegis_lite_timer_model.md

[Timer]
OnCalendar=Mon..Fri *-*-* 15:35:00 America/New_York
AccuracySec=30s
Persistent=false
Unit=aegis-lite-eod-report-v1.service

[Install]
WantedBy=timers.target
