[Unit]
Description=C2 Paper Day Orchestrator (LEGACY_PAPER_AUTOMATION_DEFERRED)
ConditionEnvironment=AEGIS_ENABLE_LEGACY_PAPER_AUTOMATION=1
Wants=network-online.target
After=network-online.target
OnFailure=c2-kill-switch-engage.service

[Service]
Type=oneshot
WorkingDirectory=/home/node/constellation_active
Environment=PYTHONUNBUFFERED=1
Environment=C2_MODE=PAPER
ExecStart=/usr/bin/bash -lc 'set -euo pipefail; exec /home/node/constellation_active/ops/run/c2_paper_day_orchestrator_systemd_entry_v1.sh'
