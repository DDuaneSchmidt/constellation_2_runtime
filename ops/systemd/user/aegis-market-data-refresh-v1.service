[Unit]
Description=Aegis Market Data Refresh v1 (read-only provider refresh, no execution)
Documentation=/home/node/constellation/docs/aegis_market_data_readiness_v1.md

[Service]
Type=oneshot
WorkingDirectory=/home/node/constellation_active
Environment=PYTHONUNBUFFERED=1
Environment=AEGIS_LITE_MANUAL_ONLY=1
Environment=AEGIS_MARKET_DATA_MODE=INTRADAY_OPERATIONAL
EnvironmentFile=-/home/node/constellation_runtime_data/config/aegis_market_data.env
EnvironmentFile=/home/node/constellation_runtime_data/config/private/aegis_eod_provider.env
ExecStart=/home/node/constellation_runtime_data/truth/releases/run_current_release_tool_v1.sh build_aegis_symbol_map_v1 --day @today_utc@ --truth_root /home/node/constellation_runtime_data/truth
ExecStart=/home/node/constellation_runtime_data/truth/releases/run_current_release_tool_v1.sh refresh_aegis_market_data_v1 --day @today_utc@ --truth_root /home/node/constellation_runtime_data/truth --market-data-mode INTRADAY_OPERATIONAL
ExecStart=/home/node/constellation_runtime_data/truth/releases/run_current_release_tool_v1.sh build_aegis_data_registry_v1 --day @today_utc@ --truth_root /home/node/constellation_runtime_data/truth
ExecStart=/home/node/constellation_runtime_data/truth/releases/run_current_release_tool_v1.sh build_aegis_sleeve_readiness_v1 --day @today_utc@ --truth_root /home/node/constellation_runtime_data/truth
