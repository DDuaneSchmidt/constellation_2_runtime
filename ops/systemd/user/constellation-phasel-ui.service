[Unit]
Description=Constellation PhaseL Ops Dashboard (C3 truth, :8787)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/node/constellation_active
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/node/constellation_active
ExecStart=/usr/bin/python3 -B -m constellation_2.phaseL.ui.server.run_ops_dashboard_v1 --host 127.0.0.1 --port 8787

Restart=always
RestartSec=2

# Use SIGTERM so stop/restart does not look like a crash (no KeyboardInterrupt stack traces).
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
