[Unit]
Description=Constellation 2.0 Paper Auto Repair Controller EOD Final Check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/node/constellation_2_runtime
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/node/constellation_2_runtime/ops/run/c2_paper_auto_repair_controller_run_v1.sh

[Install]
WantedBy=default.target
