[Unit]
Description=Aegis portal healthz static projection refresh v1

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/home/node/constellation
ExecStart=/bin/bash -lc 'TODAY=$(date -u +%%F); python3 -B ops/tools/write_portal_healthz_v1.py --target-day "$TODAY" --truth-root /home/node/constellation_runtime_data/truth --portal-site-root /home/node/projects/sv_portal/site'
