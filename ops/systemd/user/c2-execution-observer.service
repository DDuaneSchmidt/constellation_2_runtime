[Unit]
Description=C2 IB Execution Observer v1 (PAPER) - Core 1 canonical raw-evidence writer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/node/constellation
ConditionEnvironment=AEGIS_ENABLE_LEGACY_BROKER_OBSERVATION=1

# LEGACY BROKER OBSERVATION DEFERRED AFTER AEGIS LITE PIVOT.
# This service is not part of default Lite EOD/event/Research/performance operation.
# It may run only when explicitly enabled for a separate broker-observation phase.
ExecStart=/usr/bin/bash -lc 'set -euo pipefail; exec /home/node/constellation/ops/run/c2_execution_observer_v1.sh'

Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
