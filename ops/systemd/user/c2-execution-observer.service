[Unit]
Description=C2 IB Execution Observer v1 (PAPER) - Core 1 canonical raw-evidence writer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/node/constellation

# Fail-closed: if python/ibapi or canonical Core 1 governance is unavailable, service will fail and restart.
ExecStart=/usr/bin/bash -lc 'set -euo pipefail; exec /home/node/constellation/ops/run/c2_execution_observer_v1.sh'

Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
