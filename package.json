{
  "name": "constellation",
  "private": true,
  "scripts": {
    "aegis:ui:start": "python3 ops/runtime/supervisor.py start",
    "aegis:ui:stop": "python3 ops/runtime/supervisor.py stop",
    "aegis:ui:restart": "python3 ops/runtime/supervisor.py restart",
    "aegis:ui:status": "python3 ops/runtime/supervisor.py status",
    "aegis:ui:refresh": "python3 ops/tools/run_c2_global_monitoring_refresh_v1.py --include-ui-data --ui-only",
    "aegis:paper:preflight": "python3 ops/tools/run_aegis_paper_preflight_v1.py",
    "aegis:paper:submit": "python3 ops/tools/run_aegis_paper_submit_v1.py",
    "aegis:paper:daily": "python3 ops/tools/run_aegis_paper_daily_v1.py",
    "aegis:paper:auto": "python3 ops/tools/run_aegis_paper_auto_v1.py",
    "aegis:runtime:authority": "python3 ops/tools/run_runtime_service_authority_v1.py",
    "aegis:marketdata:authority": "python3 ops/tools/run_market_data_authority_v1.py",
    "aegis:mode:authority": "python3 ops/tools/run_execution_mode_authority_v1.py",
    "aegis:closure:authority": "python3 ops/tools/run_trading_day_closure_authority_v1.py",
    "aegis:strategy:authority": "python3 ops/tools/run_strategy_decision_authority_v1.py",
    "aegis:portfolio:authority": "python3 ops/tools/run_portfolio_account_authority_v1.py",
    "aegis:risk:authority": "python3 ops/tools/run_risk_sizing_authority_v1.py",
    "aegis:chatgpt:packet": "python3 ops/tools/aegis_chatgpt_packet.py",
    "aegis:chatgpt:show": "python3 ops/tools/aegis_chatgpt_show.py",
    "aegis:chatgpt:control-packet": "python3 ops/tools/build_aegis_chatgpt_control_packet_v1.py --truth_root ${AEGIS_TRUTH_ROOT:-/home/node/constellation_runtime_data/truth} --day ${TARGET_DAY:-$(date -u +%F)}",
    "aegis:chatgpt:control-show": "python3 ops/tools/show_aegis_chatgpt_control_packet_v1.py --truth_root ${AEGIS_TRUTH_ROOT:-/home/node/constellation_runtime_data/truth} --day ${TARGET_DAY:-$(date -u +%F)}",
    "aegis:noon:preflight": "python3 ops/tools/run_aegis_noon_preflight_rehearsal_v1.py --truth_root ${AEGIS_TRUTH_ROOT:-/home/node/constellation_runtime_data/truth} --day_utc ${TARGET_DAY:-$(date -u +%F)}",
    "aegis:audit": "npm run aegis:chatgpt:control-packet && npm run aegis:chatgpt:control-show && python3 ops/tools/build_aegis_audit_handoff_v1.py --truth_root ${AEGIS_TRUTH_ROOT:-/home/node/constellation_runtime_data/truth} --day ${TARGET_DAY:-$(date -u +%F)}",
    "aegis:alerts": "python3 ops/tools/run_aegis_alert_authority_v1.py",
    "repo:require-clean": "python3 ops/tools/require_canonical_repo_clean_v1.py",
    "workspace:create": "python3 ops/tools/create_codex_agent_workspace_v1.py --task_id default",
    "workspace:verify": "python3 ops/tools/verify_codex_agent_workspace_v1.py",
    "patch:apply": "python3 ops/tools/apply_codex_patch_bundle_v1.py --task_id recovery_dirty_tree_preserve_v1",
    "patch:verify-base": "python3 ops/tools/verify_patch_bundle_base_commit_v1.py",
    "repo:protect": "python3 ops/tools/protect_canonical_repo_v1.py",
    "repo:unprotect-for-intake": "python3 ops/tools/unprotect_canonical_repo_for_intake_v1.py --reason apply_codex_patch_bundle_v1:manual",
    "readiness:freeze:preflight": "python3 ops/tools/run_readiness_freeze_preflight_v1.py",
    "app:start": "python3 ops/runtime/supervisor.py start",
    "app:stop": "python3 ops/runtime/supervisor.py stop",
    "app:restart": "python3 ops/runtime/supervisor.py restart",
    "app:status": "python3 ops/runtime/supervisor.py status",
    "app:doctor": "python3 ops/runtime/healthcheck.py",
    "app:logs": "python3 ops/runtime/supervisor.py logs",
    "trading:prepare": "python3 ops/tools/run_trading_prepare_v1.py",
    "trading:preflight": "python3 ops/tools/run_trading_preflight_v1.py",
    "trading:preflight:json": "python3 ops/tools/run_trading_preflight_v1.py --json",
    "aegis:truth:resolve": "python3 -B ops/tools/run_aegis_truth_resolver_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:portal:probe": "python3 -B ops/tools/run_portal_availability_probe_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:alerts:run": "python3 -B ops/tools/run_aegis_alert_sink_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:projection:refresh": "python3 -B ops/tools/run_aegis_projection_refresh_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:mutation:check": "python3 -B ops/tools/run_protected_mutation_check_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER} --path /home/node/constellation --operation check",
    "aegis:truth:test": "python3 -B -m pytest constellation_2/aegis_truth/tests",
    "aegis:state:alerts": "python3 -B ops/tools/run_alert_lifecycle_state_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:state:portal": "python3 -B ops/tools/run_portal_surface_state_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:state:trading": "python3 -B ops/tools/run_trading_readiness_state_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:state:projection": "python3 -B ops/tools/run_projection_freshness_state_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:state:repo": "python3 -B ops/tools/run_repo_protection_state_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:kernel:run": "python3 -B ops/tools/run_aegis_control_plane_kernel_v1.py --target-day ${TARGET_DAY:-$(date -u +%F)} --environment ${AEGIS_ENVIRONMENT:-PAPER}",
    "aegis:kernel:test": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m pytest constellation_2/aegis_truth/tests",
    "aegis:kernel:refresh": "npm run aegis:portal:probe && npm run aegis:state:portal && npm run aegis:state:trading && npm run aegis:state:projection && npm run aegis:state:repo && npm run aegis:kernel:run && npm run aegis:state:alerts && npm run aegis:projection:refresh"
  }
}
