{
  "$id": "https://constellation.local/schemas/broker_submit_attempt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrokerSubmitAttempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "submission_id",
    "attempted_at_utc",
    "attempt_state",
    "dry_run",
    "reason_codes",
    "evidence_artifacts"
  ],
  "properties": {
    "schema_id": { "const": "broker_submit_attempt" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "submission_id": { "type": "string", "minLength": 16, "maxLength": 128 },
    "attempted_at_utc": { "type": "string", "format": "date-time" },
    "attempt_state": { "const": "SUBMIT_ATTEMPTED" },
    "ib_account": { "type": ["string", "null"], "minLength": 1, "maxLength": 32 },
    "dry_run": { "type": "boolean" },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "evidence_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "uniqueItems": true
    },
    "canonical_json_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
