{
  "$id": "https://constellation.local/schemas/execution_identity_record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionIdentityRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "created_at_utc",
    "day_utc",
    "attempt_id",
    "sleeve_id",
    "environment",
    "intent_id",
    "intent_hash",
    "plan_hash",
    "binding_hash",
    "trade_instance_id",
    "submission_id",
    "duplicate_classification",
    "source_refs",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "execution_identity_record" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "execution_identity_authority_v1" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "attempt_id": { "type": "string", "pattern": "^A[0-9]{4}$" },
    "sleeve_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE", "GLOBAL"] },
    "intent_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "binding_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trade_instance_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "submission_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "duplicate_classification": {
      "type": "string",
      "enum": ["FIRST_INSTANCE", "SAME_INSTANCE_REPLAY", "NEW_INSTANCE_SAME_PLAN", "NEW_INSTANCE_NEW_PLAN"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_type", "path", "sha256"],
        "properties": {
          "ref_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
