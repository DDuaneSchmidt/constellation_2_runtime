{
  "$id": "https://constellation.local/schemas/broker_order_outcome.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrokerOrderOutcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "submission_id",
    "evaluated_at_utc",
    "outcome_state",
    "broker_ids",
    "reason_codes",
    "evidence_artifacts"
  ],
  "properties": {
    "schema_id": { "const": "broker_order_outcome" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "submission_id": { "type": "string", "minLength": 16, "maxLength": 128 },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "outcome_state": {
      "type": "string",
      "enum": [
        "NOT_ATTEMPTED",
        "SUBMIT_ATTEMPTED",
        "BROKER_ID_ASSIGNED",
        "BROKER_ACCEPTED",
        "BROKER_REJECTED",
        "BROKER_CANCELLED",
        "PARTIALLY_FILLED",
        "FILLED",
        "UNKNOWN_PENDING"
      ]
    },
    "status": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
    "ib_account": { "type": ["string", "null"], "minLength": 1, "maxLength": 32 },
    "broker_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "perm_id"],
      "properties": {
        "order_id": { "type": ["integer", "null"], "minimum": 0 },
        "perm_id": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "uniqueItems": true
    },
    "canonical_json_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
