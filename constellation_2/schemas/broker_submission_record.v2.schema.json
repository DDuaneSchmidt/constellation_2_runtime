{
  "$id": "https://constellation.local/schemas/broker_submission_record.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrokerSubmissionRecord v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "submission_id",
    "submitted_at_utc",
    "binding_hash",
    "broker",
    "status",
    "broker_ids"
  ],
  "properties": {
    "schema_id": { "const": "broker_submission_record" },
    "schema_version": { "const": "v2" },

    "submission_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "description": "Deterministic submission identifier (hash-derived preferred)."
    },

    "submitted_at_utc": { "type": "string", "format": "date-time" },

    "binding_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of canonical BindingRecord."
    },

    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment"],
      "properties": {
        "name": { "type": "string", "enum": ["INTERACTIVE_BROKERS"] },
        "environment": { "type": "string", "enum": ["PAPER", "LIVE"] }
      }
    },

    "status": {
      "type": "string",
      "enum": [
        "PENDINGSUBMIT",
        "PRESUBMITTED",
        "SUBMITTED",
        "ACKNOWLEDGED",
        "REJECTED",
        "CANCELLED",
        "INACTIVE",
        "PARTIALLY_FILLED",
        "FILLED",
        "UNKNOWN"
      ],
      "description": "Submission status at time of recording (IB-compatible)."
    },

    "broker_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "perm_id"],
      "properties": {
        "order_id": { "type": ["integer", "null"], "minimum": 0 },
        "perm_id": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": ["integer", "string"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },

    "protection_status": {
      "type": ["string", "null"],
      "enum": ["PROTECTED", "ENTRY_ONLY", "UNKNOWN", null]
    },

    "order_linkage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "parent_order_id",
        "parent_perm_id",
        "stop_order_id",
        "stop_perm_id",
        "take_profit_order_id",
        "take_profit_perm_id",
        "bracket_linkage",
        "oca_group"
      ],
      "properties": {
        "parent_order_id": { "type": ["integer", "null"], "minimum": 0 },
        "parent_perm_id": { "type": ["integer", "null"], "minimum": 0 },
        "stop_order_id": { "type": ["integer", "null"], "minimum": 0 },
        "stop_perm_id": { "type": ["integer", "null"], "minimum": 0 },
        "take_profit_order_id": { "type": ["integer", "null"], "minimum": 0 },
        "take_profit_perm_id": { "type": ["integer", "null"], "minimum": 0 },
        "bracket_linkage": {
          "type": "string",
          "enum": ["PARENT_STOP", "PARENT_STOP_TAKE_PROFIT", "ENTRY_ONLY"]
        },
        "oca_group": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
      }
    },

    "canonical_json_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
