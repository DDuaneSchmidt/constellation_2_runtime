{
  "$id": "https://constellation.local/schemas/exposure_to_options_adapter_record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExposureToOptionsAdapterRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "status",
    "reason_codes",
    "input_exposure_intent",
    "output_options_intent",
    "policy",
    "produced_utc",
    "producer"
  ],
  "properties": {
    "schema_id": {
      "const": "exposure_to_options_adapter_record"
    },
    "schema_version": {
      "const": "v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "OK"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "input_exposure_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "output_options_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "produced_utc": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "repo",
        "git_sha"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64
        }
      }
    },
    "canonical_json_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
