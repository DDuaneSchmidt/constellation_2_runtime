{
  "$id": "https://constellation.local/schemas/broker_acknowledgement.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrokerAcknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "submission_id",
    "acknowledged_at_utc",
    "ack_state",
    "status",
    "broker_ids",
    "identity_strength",
    "reason_codes",
    "evidence_artifacts"
  ],
  "properties": {
    "schema_id": { "const": "broker_acknowledgement" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "submission_id": { "type": "string", "minLength": 16, "maxLength": 128 },
    "acknowledged_at_utc": { "type": "string", "format": "date-time" },
    "ack_state": { "const": "BROKER_ID_ASSIGNED" },
    "status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "ib_account": { "type": ["string", "null"], "minLength": 1, "maxLength": 32 },
    "broker_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "perm_id"],
      "properties": {
        "order_id": { "type": ["integer", "null"], "minimum": 0 },
        "perm_id": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "identity_strength": { "type": "string", "enum": ["STRONG", "WEAK"] },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "evidence_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "uniqueItems": true
    },
    "canonical_json_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
