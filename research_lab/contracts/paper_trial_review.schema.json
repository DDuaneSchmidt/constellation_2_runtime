{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "content_hash": {
      "minLength": 12,
      "type": "string"
    },
    "review_decision": {
      "enum": [
        "continue",
        "pause",
        "complete",
        "cancel",
        "promote_to_sleeve_review_candidate"
      ]
    }
  },
  "required": [
    "paper_trial_review_id",
    "paper_trial_id",
    "review_date",
    "review_decision",
    "review_reason",
    "reviewed_by",
    "metrics_summary",
    "next_state",
    "created_at",
    "schema_version",
    "content_hash"
  ],
  "title": "PaperTrialReview",
  "type": "object"
}
