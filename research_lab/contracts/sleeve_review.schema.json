{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "content_hash": {
      "minLength": 12,
      "type": "string"
    },
    "review_decision": {
      "enum": [
        "continue",
        "revise",
        "defer",
        "retire",
        "promote_to_paper_trial_candidate"
      ]
    }
  },
  "required": [
    "sleeve_review_id",
    "sleeve_id",
    "sleeve_version_id",
    "sleeve_challenge_id",
    "review_decision",
    "review_reason",
    "reviewed_by",
    "reviewed_at",
    "next_state",
    "schema_version",
    "content_hash"
  ],
  "title": "SleeveReview",
  "type": "object"
}
