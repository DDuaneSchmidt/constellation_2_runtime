{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "actionability_status": {
      "const": "non_actionable_research_only"
    },
    "blockers": {
      "type": "array"
    },
    "content_hash": {
      "minLength": 12,
      "type": "string"
    },
    "generated_at": {
      "minLength": 1,
      "type": "string"
    },
    "hypothesis_family": {
      "minLength": 1,
      "type": "string"
    },
    "hypothesis_label": {
      "minLength": 1,
      "type": "string"
    },
    "hypothesis_statement": {
      "minLength": 1,
      "type": "string"
    },
    "hypothesis_status": {
      "enum": [
        "inactive_research_only",
        "blocked",
        "deferred"
      ]
    },
    "hypothesis_version": {
      "minLength": 1,
      "type": "string"
    },
    "immutable_hash": {
      "minLength": 12,
      "type": "string"
    },
    "latest_integrity_report_id": {
      "type": "string"
    },
    "latest_research_os_status_report_id": {
      "type": "string"
    },
    "minimum_observation_count": {
      "minimum": 0,
      "type": "integer"
    },
    "no_capital_allocation_assertion": {
      "const": true
    },
    "no_challenger_created_assertion": {
      "const": true
    },
    "no_sleeve_created_assertion": {
      "const": true
    },
    "non_actionable_research_only_assertion": {
      "type": "object"
    },
    "proposed_benchmark": {
      "type": "string"
    },
    "proposed_event_window": {
      "type": "string"
    },
    "proposed_test_design": {
      "type": "object"
    },
    "proposed_universe": {
      "type": "string"
    },
    "required_data": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "research_hypothesis_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_label": {
      "const": "RESEARCH_ONLY"
    },
    "research_question": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "source_artifact_hashes": {
      "type": "object"
    },
    "source_artifact_ids": {
      "type": "object"
    },
    "source_hypothesis_proposal_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_hypothesis_proposal_review_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_observation_candidate_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_observation_cluster_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "research_hypothesis_id",
    "generated_at",
    "hypothesis_version",
    "hypothesis_status",
    "hypothesis_family",
    "hypothesis_label",
    "hypothesis_statement",
    "research_question",
    "source_hypothesis_proposal_id",
    "source_hypothesis_proposal_review_id",
    "source_observation_cluster_id",
    "source_observation_candidate_ids",
    "proposed_test_design",
    "required_data",
    "minimum_observation_count",
    "proposed_event_window",
    "proposed_universe",
    "proposed_benchmark",
    "blockers",
    "latest_integrity_report_id",
    "latest_research_os_status_report_id",
    "non_actionable_research_only_assertion",
    "no_challenger_created_assertion",
    "no_sleeve_created_assertion",
    "no_capital_allocation_assertion",
    "source_artifact_ids",
    "source_artifact_hashes",
    "immutable_hash"
  ],
  "title": "ResearchHypothesis",
  "type": "object"
}
