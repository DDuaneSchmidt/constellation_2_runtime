{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "baseline_metrics": {
      "type": "object"
    },
    "candidate_count": {
      "minimum": 0,
      "type": "integer"
    },
    "content_hash": {
      "minLength": 12,
      "type": "string"
    },
    "drift_reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "drift_status": {
      "enum": [
        "insufficient_data",
        "stable",
        "watch",
        "degrading",
        "improving"
      ]
    },
    "expectancy_drift_report_id": {
      "minLength": 1,
      "type": "string"
    },
    "latest_metrics": {
      "type": "object"
    },
    "longitudinal_run_id": {
      "minLength": 1,
      "type": "string"
    },
    "measured_candidate_count": {
      "minimum": 0,
      "type": "integer"
    },
    "recommended_action": {
      "enum": [
        "collect_more_candidates",
        "continue_research",
        "review_sleeve",
        "revise_ranking_policy",
        "revise_candidate_generator",
        "challenge_sleeve"
      ]
    },
    "research_label": {
      "minLength": 1,
      "type": "string"
    },
    "rolling_metrics": {
      "type": "object"
    },
    "rolling_window_size": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "sleeve_id": {
      "minLength": 1,
      "type": "string"
    },
    "sleeve_version_id": {
      "minLength": 1,
      "type": "string"
    },
    "windows_analyzed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "expectancy_drift_report_id",
    "sleeve_id",
    "sleeve_version_id",
    "longitudinal_run_id",
    "created_at",
    "created_by",
    "windows_analyzed",
    "rolling_window_size",
    "candidate_count",
    "measured_candidate_count",
    "drift_status",
    "drift_reasons",
    "rolling_metrics",
    "latest_metrics",
    "baseline_metrics",
    "recommended_action",
    "research_label",
    "schema_version",
    "content_hash"
  ],
  "title": "ExpectancyDriftReport",
  "type": "object"
}
