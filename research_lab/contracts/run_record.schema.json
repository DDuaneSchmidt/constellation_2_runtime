{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "status": {
      "enum": [
        "cancelled",
        "completed",
        "failed",
        "started"
      ]
    }
  },
  "required": [
    "run_id",
    "run_type",
    "status",
    "actor",
    "command",
    "started_at",
    "ended_at",
    "inputs",
    "input_hash",
    "outputs",
    "output_hash",
    "warnings",
    "errors",
    "code_version",
    "environment",
    "schema_version"
  ],
  "title": "RunRecord",
  "type": "object"
}
