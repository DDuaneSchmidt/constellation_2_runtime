{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "actionability_status": {
      "const": "non_actionable_research_only"
    },
    "blockers": {
      "type": "array"
    },
    "content_hash": {
      "minLength": 12,
      "type": "string"
    },
    "created_research_hypothesis_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "eligibility_checks": {
      "type": "object"
    },
    "generated_at": {
      "minLength": 1,
      "type": "string"
    },
    "hypothesis_intake_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "immutable_hash": {
      "minLength": 12,
      "type": "string"
    },
    "intake_decision": {
      "enum": [
        "block_intake",
        "defer_intake",
        "create_inactive_research_hypothesis"
      ]
    },
    "intake_rationale": {
      "minLength": 1,
      "type": "string"
    },
    "intake_status": {
      "enum": [
        "blocked",
        "deferred",
        "accepted_inactive_research_only"
      ]
    },
    "intake_version": {
      "minLength": 1,
      "type": "string"
    },
    "latest_integrity_report_id": {
      "type": "string"
    },
    "latest_research_os_status_report_id": {
      "type": "string"
    },
    "no_lifecycle_mutation_assertion": {
      "type": "object"
    },
    "non_actionable_research_only_assertion": {
      "type": "object"
    },
    "research_label": {
      "const": "RESEARCH_ONLY"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "source_artifact_hashes": {
      "type": "object"
    },
    "source_artifact_ids": {
      "type": "object"
    },
    "source_hypothesis_proposal_batch_id": {
      "type": "string"
    },
    "source_hypothesis_proposal_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_hypothesis_proposal_review_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_observation_cluster_id": {
      "type": "string"
    }
  },
  "required": [
    "hypothesis_intake_decision_id",
    "generated_at",
    "intake_version",
    "source_hypothesis_proposal_review_id",
    "source_hypothesis_proposal_id",
    "source_hypothesis_proposal_batch_id",
    "source_observation_cluster_id",
    "intake_status",
    "intake_decision",
    "intake_rationale",
    "eligibility_checks",
    "blockers",
    "created_research_hypothesis_id",
    "latest_integrity_report_id",
    "latest_research_os_status_report_id",
    "non_actionable_research_only_assertion",
    "no_lifecycle_mutation_assertion",
    "source_artifact_ids",
    "source_artifact_hashes",
    "immutable_hash"
  ],
  "title": "HypothesisIntakeDecision",
  "type": "object"
}
