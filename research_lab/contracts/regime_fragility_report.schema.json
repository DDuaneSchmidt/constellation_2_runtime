{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "best_regimes": {
      "type": "array"
    },
    "content_hash": {
      "minLength": 12,
      "type": "string"
    },
    "fragility_reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "fragility_status": {
      "enum": [
        "insufficient_data",
        "robust",
        "watch",
        "fragile"
      ]
    },
    "longitudinal_run_id": {
      "minLength": 1,
      "type": "string"
    },
    "recommended_action": {
      "enum": [
        "collect_more_candidates",
        "continue_research",
        "review_sleeve",
        "revise_ranking_policy",
        "revise_candidate_generator",
        "challenge_sleeve"
      ]
    },
    "regime_coverage": {
      "type": "object"
    },
    "regime_dimensions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "regime_fragility_report_id": {
      "minLength": 1,
      "type": "string"
    },
    "regime_metrics": {
      "type": "object"
    },
    "research_label": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "sleeve_id": {
      "minLength": 1,
      "type": "string"
    },
    "sleeve_version_id": {
      "minLength": 1,
      "type": "string"
    },
    "windows_analyzed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "worst_regimes": {
      "type": "array"
    }
  },
  "required": [
    "regime_fragility_report_id",
    "sleeve_id",
    "sleeve_version_id",
    "longitudinal_run_id",
    "created_at",
    "created_by",
    "regime_dimensions",
    "windows_analyzed",
    "fragility_status",
    "fragility_reasons",
    "regime_metrics",
    "best_regimes",
    "worst_regimes",
    "regime_coverage",
    "recommended_action",
    "research_label",
    "schema_version",
    "content_hash"
  ],
  "title": "RegimeFragilityReport",
  "type": "object"
}
