{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_v2_experiment_experience_writer.v1.schema.json",
  "title": "Atlas V2 Experiment Experience Writer V1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/ExperimentResult"},
    {"$ref": "#/$defs/ExperimentExperienceWriteSummary"}
  ],
  "$defs": {
    "OutcomeStatus": {"enum": ["PASSED", "FAILED", "INCONCLUSIVE"]},
    "StringList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ExperimentResult": {
      "type": "object",
      "required": [
        "object_type",
        "experiment_result_id",
        "hypothesis_id",
        "experiment_spec_id",
        "outcome_status",
        "observed_outcome",
        "evidence_reference"
      ],
      "properties": {
        "object_type": {"const": "ExperimentResult"},
        "experiment_result_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "experiment_spec_id": {"type": "string", "minLength": 1},
        "outcome_status": {"$ref": "#/$defs/OutcomeStatus"},
        "observed_outcome": {"type": "string", "minLength": 1},
        "evidence_reference": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "outcome_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_learning_value": {"type": "number", "minimum": 0, "maximum": 1},
        "actual_learning_value": {"type": "number", "minimum": 0, "maximum": 1},
        "attention_cost_estimate": {"type": "number", "minimum": 0, "maximum": 1},
        "importance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "regret_score": {"type": "number", "minimum": 0, "maximum": 1},
        "prediction_statement": {"type": "string"},
        "expected_outcome": {"type": "string"},
        "evaluation_date": {"type": "string"},
        "outcome_date": {"type": "string"},
        "period_start": {"type": "string"},
        "period_end": {"type": "string"},
        "actual_learning_source_fields": {"$ref": "#/$defs/StringList"},
        "authority_boundary_acknowledged": {"const": true}
      },
      "additionalProperties": true
    },
    "ExperimentExperienceWriteSummary": {
      "type": "object",
      "required": [
        "prediction_id",
        "outcome_id",
        "outcome_status",
        "regret_id",
        "calibration_id",
        "experience_id",
        "learning_velocity_metric_id",
        "hypothesis_id",
        "experiment_spec_id",
        "experiment_result_id"
      ],
      "properties": {
        "prediction_id": {"type": "string", "minLength": 1},
        "outcome_id": {"type": "string", "minLength": 1},
        "outcome_status": {"$ref": "#/$defs/OutcomeStatus"},
        "regret_id": {"type": "string", "minLength": 1},
        "calibration_id": {"type": "string", "minLength": 1},
        "experience_id": {"type": "string", "minLength": 1},
        "learning_velocity_metric_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "experiment_spec_id": {"type": "string", "minLength": 1},
        "experiment_result_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
