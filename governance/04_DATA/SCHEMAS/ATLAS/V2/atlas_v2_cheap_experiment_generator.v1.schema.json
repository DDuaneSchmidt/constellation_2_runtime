{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_v2_cheap_experiment_generator.v1.schema.json",
  "title": "Atlas V2 Cheap Experiment Generator V1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/CheapExperimentSpec"},
    {"$ref": "#/$defs/ExperimentDataRequirement"},
    {"$ref": "#/$defs/ExperimentEvaluationPlan"},
    {"$ref": "#/$defs/ExperimentGenerationRun"}
  ],
  "$defs": {
    "Tier": {"enum": ["TIER_0_DEDUPE", "TIER_1_SANITY", "TIER_2_LIGHTWEIGHT_VALIDATION"]},
    "ForbiddenTier": {"enum": ["TIER_3_ROBUST_VALIDATION", "TIER_4_MATURITY_TRACKING"]},
    "Transition": {
      "type": "object",
      "required": ["transitioned_at", "from_status", "to_status", "reason", "triggering_object"],
      "properties": {
        "transitioned_at": {"type": "string", "minLength": 1},
        "from_status": {"type": "string"},
        "to_status": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "triggering_object": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "Base": {
      "type": "object",
      "required": ["object_type", "created_at", "transition_history"],
      "properties": {
        "object_type": {"type": "string"},
        "created_at": {"type": "string", "minLength": 1},
        "transition_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Transition"}}
      }
    },
    "CheapExperimentSpec": {
      "allOf": [
        {"$ref": "#/$defs/Base"},
        {
          "type": "object",
          "required": ["experiment_spec_id", "hypothesis_id", "mechanism_id", "tier", "entry_condition", "exit_condition", "stop_condition", "target_condition", "baseline_condition", "required_data", "evaluation_metric", "falsification_threshold", "authority_boundary_acknowledged", "status"],
          "properties": {
            "object_type": {"const": "CheapExperimentSpec"},
            "experiment_spec_id": {"type": "string", "minLength": 1},
            "hypothesis_id": {"type": "string", "minLength": 1},
            "mechanism_id": {"type": "string", "minLength": 1},
            "tier": {"$ref": "#/$defs/Tier"},
            "entry_condition": {"type": "string", "minLength": 1},
            "exit_condition": {"type": "string", "minLength": 1},
            "stop_condition": {"type": "string", "minLength": 1},
            "target_condition": {"type": "string", "minLength": 1},
            "baseline_condition": {"type": "string", "minLength": 1},
            "required_data": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "evaluation_metric": {"type": "string", "minLength": 1},
            "falsification_threshold": {"type": "string", "minLength": 1},
            "authority_boundary_acknowledged": {"const": true},
            "status": {"enum": ["GENERATED_SPEC", "SPEC_ONLY"]}
          }
        }
      ]
    },
    "ExperimentDataRequirement": {
      "allOf": [
        {"$ref": "#/$defs/Base"},
        {
          "type": "object",
          "required": ["data_requirement_id", "experiment_spec_id", "hypothesis_id", "data_name", "data_purpose", "minimum_observation_count", "source_mode", "authority_boundary_acknowledged", "status"],
          "properties": {
            "object_type": {"const": "ExperimentDataRequirement"},
            "data_requirement_id": {"type": "string", "minLength": 1},
            "experiment_spec_id": {"type": "string", "minLength": 1},
            "hypothesis_id": {"type": "string", "minLength": 1},
            "data_name": {"type": "string", "minLength": 1},
            "data_purpose": {"type": "string", "minLength": 1},
            "minimum_observation_count": {"type": "integer", "minimum": 1},
            "source_mode": {"enum": ["EXISTING_LEDGER", "EXISTING_HISTORICAL_FIXTURE", "OPERATOR_SUPPLIED_DATA"]},
            "authority_boundary_acknowledged": {"const": true},
            "status": {"enum": ["REQUIRED", "SPEC_ONLY"]}
          }
        }
      ]
    },
    "ExperimentEvaluationPlan": {
      "allOf": [
        {"$ref": "#/$defs/Base"},
        {
          "type": "object",
          "required": ["evaluation_plan_id", "experiment_spec_id", "hypothesis_id", "baseline_condition", "evaluation_metric", "falsification_threshold", "comparison_method", "result_recording_allowed", "execution_allowed", "authority_boundary_acknowledged", "status"],
          "properties": {
            "object_type": {"const": "ExperimentEvaluationPlan"},
            "evaluation_plan_id": {"type": "string", "minLength": 1},
            "experiment_spec_id": {"type": "string", "minLength": 1},
            "hypothesis_id": {"type": "string", "minLength": 1},
            "baseline_condition": {"type": "string", "minLength": 1},
            "evaluation_metric": {"type": "string", "minLength": 1},
            "falsification_threshold": {"type": "string", "minLength": 1},
            "comparison_method": {"type": "string", "minLength": 1},
            "result_recording_allowed": {"const": false},
            "execution_allowed": {"const": false},
            "authority_boundary_acknowledged": {"const": true},
            "status": {"enum": ["PLANNED_SPEC_ONLY", "SPEC_ONLY"]}
          }
        }
      ]
    },
    "ExperimentGenerationRun": {
      "allOf": [
        {"$ref": "#/$defs/Base"},
        {
          "type": "object",
          "required": ["generation_run_id", "generator_version", "input_hypothesis_count", "generated_spec_count", "experiment_spec_ids", "data_requirement_ids", "evaluation_plan_ids", "allowed_tiers", "forbidden_tiers", "authority_boundary_acknowledged", "status"],
          "properties": {
            "object_type": {"const": "ExperimentGenerationRun"},
            "generation_run_id": {"type": "string", "minLength": 1},
            "generator_version": {"const": "atlas_v2_cheap_experiment_generator_v1"},
            "input_hypothesis_count": {"type": "integer", "minimum": 0},
            "generated_spec_count": {"type": "integer", "minimum": 0},
            "experiment_spec_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "data_requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "evaluation_plan_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "allowed_tiers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/Tier"}},
            "forbidden_tiers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/ForbiddenTier"}},
            "authority_boundary_acknowledged": {"const": true},
            "status": {"const": "COMPLETED_SPEC_GENERATION"}
          }
        }
      ]
    }
  }
}
