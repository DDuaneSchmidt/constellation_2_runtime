{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_v2_external_strategy_claims.v1.schema.json",
  "title": "Atlas V2 External Strategy Claims V1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/ExternalStrategySource"},
    {"$ref": "#/$defs/ExternalStrategyClaim"},
    {"$ref": "#/$defs/ExternalStrategyMechanism"},
    {"$ref": "#/$defs/ExternalStrategyDeduplicationResult"},
    {"$ref": "#/$defs/ExternalStrategyContrarianTheory"},
    {"$ref": "#/$defs/ExternalStrategyCheapExperimentHandoff"}
  ],
  "$defs": {
    "SourceType": {"enum": ["YOUTUBE_TRANSCRIPT", "YOUTUBE_MANUAL_NOTES", "BLOG", "PAPER", "OTHER"]},
    "ExtractionStatus": {"enum": ["EXTRACTED", "INSUFFICIENT_RULE_DETAIL", "TRANSCRIPT_REQUIRED", "UNSUPPORTED_SOURCE", "DUPLICATE_CLAIM"]},
    "MechanismFamily": {"enum": ["OPENING_RANGE", "BREAKOUT", "MEAN_REVERSION", "TREND_CONTINUATION", "LIQUIDITY_SWEEP", "VOLATILITY_EXPANSION", "PULLBACK", "MOMENTUM", "VWAP_OR_AVERAGE_RECLAIM", "ATR_FILTER", "SESSION_TIMING", "UNKNOWN"]},
    "CheapExperimentTier": {"enum": ["TIER_0_DEDUPE", "TIER_1_SANITY", "TIER_2_LIGHTWEIGHT_VALIDATION"]},
    "PrimaryFailureMode": {"enum": ["OVERFITTING", "CROWDING", "SLIPPAGE", "REGIME_DEPENDENCE", "VAGUE_RULES", "LOOKAHEAD_BIAS", "SURVIVORSHIP_BIAS", "COMMISSION_DRAG", "CHERRY_PICKING", "DATA_MINING", "LOW_SAMPLE_SIZE", "UNKNOWN"]},
    "ContrarianStatus": {"enum": ["GENERATED", "UNKNOWN", "INSUFFICIENT_DETAIL", "DUPLICATE_CONTRARIAN", "REQUIRES_CLARIFICATION"]},
    "Transition": {"type": "object", "required": ["transitioned_at", "from_status", "to_status", "reason", "triggering_object"], "properties": {"transitioned_at": {"type": "string", "format": "date-time"}, "from_status": {"type": "string"}, "to_status": {"type": "string"}, "reason": {"type": "string", "minLength": 1}, "triggering_object": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "Base": {"type": "object", "required": ["object_type", "created_at", "transition_history"], "properties": {"object_type": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "transition_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Transition"}}}},
    "ExternalStrategySource": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["source_id", "source_type", "source_title", "input_text", "input_text_hash", "transcript_available", "status"], "properties": {"object_type": {"const": "ExternalStrategySource"}, "source_id": {"type": "string", "minLength": 1}, "source_type": {"$ref": "#/$defs/SourceType"}, "source_url": {"type": "string"}, "source_title": {"type": "string", "minLength": 1}, "source_channel": {"type": "string"}, "input_text": {"type": "string"}, "input_text_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "transcript_available": {"type": "boolean"}, "status": {"type": "string", "minLength": 1}}}]},
    "ExternalStrategyClaim": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["claim_id", "source_id", "claim_text", "confidence", "extraction_status"], "properties": {"object_type": {"const": "ExternalStrategyClaim"}, "claim_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "claim_text": {"type": "string", "minLength": 1}, "market_context": {"type": "string"}, "timeframe": {"type": "string"}, "entry_rule": {"type": "string"}, "exit_rule": {"type": "string"}, "filter_rule": {"type": "string"}, "risk_rule": {"type": "string"}, "instrument": {"type": "string"}, "claimed_edge": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "extraction_status": {"$ref": "#/$defs/ExtractionStatus"}}}]},
    "ExternalStrategyMechanism": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["mechanism_id", "claim_id", "mechanism_family", "mechanism_description", "classification_confidence"], "properties": {"object_type": {"const": "ExternalStrategyMechanism"}, "mechanism_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "mechanism_family": {"$ref": "#/$defs/MechanismFamily"}, "mechanism_description": {"type": "string", "minLength": 1}, "classification_confidence": {"type": "number", "minimum": 0, "maximum": 1}}}]},
    "ExternalStrategyDeduplicationResult": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["dedupe_id", "claim_id", "claim_fingerprint", "mechanism_fingerprint", "is_duplicate", "status"], "properties": {"object_type": {"const": "ExternalStrategyDeduplicationResult"}, "dedupe_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "claim_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "mechanism_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "duplicate_of_claim_id": {"type": "string"}, "duplicate_reason": {"type": "string"}, "is_duplicate": {"type": "boolean"}, "status": {"type": "string", "minLength": 1}}}]},

    "ExternalStrategyContrarianTheory": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["contrarian_id", "claim_id", "mechanism_id", "primary_failure_modes", "opposite_hypothesis", "fragility_conditions", "required_falsification_tests", "prior_failure_matches", "contrarian_confidence", "status"], "properties": {"object_type": {"const": "ExternalStrategyContrarianTheory"}, "contrarian_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "mechanism_id": {"type": "string", "minLength": 1}, "primary_failure_modes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/PrimaryFailureMode"}}, "opposite_hypothesis": {"type": "string", "minLength": 1}, "fragility_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "required_falsification_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "prior_failure_matches": {"type": "array", "items": {"type": "object", "required": ["provenance_reference"], "properties": {"provenance_reference": {"type": "string", "minLength": 1}, "summary": {"type": "string"}, "matched_failure_mode": {"$ref": "#/$defs/PrimaryFailureMode"}}}}, "contrarian_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"$ref": "#/$defs/ContrarianStatus"}}}]},
    "ExternalStrategyCheapExperimentHandoff": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["handoff_id", "claim_id", "mechanism_id", "dedupe_id", "eligible_for_cheap_experiment", "recommended_tier", "reason", "authority_boundary_acknowledged", "status"], "properties": {"object_type": {"const": "ExternalStrategyCheapExperimentHandoff"}, "handoff_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "mechanism_id": {"type": "string", "minLength": 1}, "dedupe_id": {"type": "string", "minLength": 1}, "contrarian_id": {"type": "string", "minLength": 1}, "eligible_for_cheap_experiment": {"type": "boolean"}, "recommended_tier": {"$ref": "#/$defs/CheapExperimentTier"}, "reason": {"type": "string", "minLength": 1}, "authority_boundary_acknowledged": {"const": true}, "status": {"type": "string", "minLength": 1}}}]}
  }
}
