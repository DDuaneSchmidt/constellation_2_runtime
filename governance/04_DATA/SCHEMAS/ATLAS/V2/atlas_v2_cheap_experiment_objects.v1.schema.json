{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_v2_cheap_experiment_objects.v1.schema.json",
  "title": "Atlas V2 Cheap Experiment Objects",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/CheapExperiment"
    },
    {
      "$ref": "#/$defs/LearningVelocityMetric"
    },
    {
      "$ref": "#/$defs/ExperimentTierSummary"
    },
    {
      "$ref": "#/$defs/PromotionGateDecision"
    }
  ],
  "$defs": {
    "Tier": {
      "enum": [
        "TIER_0_DEDUPE",
        "TIER_1_SANITY",
        "TIER_2_LIGHTWEIGHT_VALIDATION",
        "TIER_3_ROBUST_VALIDATION",
        "TIER_4_MATURITY_TRACKING"
      ]
    },
    "Transition": {
      "type": "object",
      "required": [
        "transitioned_at",
        "from_status",
        "to_status",
        "reason",
        "triggering_object"
      ],
      "properties": {
        "transitioned_at": {
          "type": "string",
          "format": "date-time"
        },
        "from_status": {
          "type": "string"
        },
        "to_status": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "triggering_object": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Base": {
      "type": "object",
      "required": [
        "object_type",
        "created_at",
        "transition_history"
      ],
      "properties": {
        "object_type": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "transition_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Transition"
          }
        }
      }
    },
    "CheapExperiment": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "type": "object",
          "required": [
            "experiment_id",
            "originating_object_id",
            "originating_object_type",
            "tier",
            "prediction_statement",
            "expected_learning_value",
            "attention_cost_estimate",
            "data_scope",
            "method_summary",
            "outcome_summary",
            "actual_learning_value",
            "status"
          ],
          "properties": {
            "object_type": {
              "const": "CheapExperiment"
            },
            "experiment_id": {
              "type": "string",
              "minLength": 1
            },
            "originating_object_id": {
              "type": "string",
              "minLength": 1
            },
            "originating_object_type": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "$ref": "#/$defs/Tier"
            },
            "prediction_statement": {
              "type": "string",
              "minLength": 1
            },
            "expected_learning_value": {
              "type": "number",
              "minimum": 0
            },
            "attention_cost_estimate": {
              "type": "number",
              "minimum": 0
            },
            "data_scope": {
              "type": "string",
              "minLength": 1
            },
            "method_summary": {
              "type": "string",
              "minLength": 1
            },
            "outcome_summary": {
              "type": "string",
              "minLength": 1
            },
            "actual_learning_value": {
              "type": "number",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "promotion_gate_id": {
              "type": "string"
            },
            "evidence_maturity_rationale": {
              "type": "string"
            }
          }
        }
      ]
    },
    "LearningVelocityMetric": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "type": "object",
          "required": [
            "metric_id",
            "period_start",
            "period_end",
            "prediction_outcome_cycles",
            "cheap_experiments_completed",
            "actual_learning_total",
            "average_learning_per_cycle",
            "rejection_count",
            "promotion_count",
            "promotion_rate",
            "importance_weighted_regret_total"
          ],
          "properties": {
            "object_type": {
              "const": "LearningVelocityMetric"
            },
            "metric_id": {
              "type": "string",
              "minLength": 1
            },
            "period_start": {
              "type": "string",
              "minLength": 1
            },
            "period_end": {
              "type": "string",
              "minLength": 1
            },
            "prediction_outcome_cycles": {
              "type": "number",
              "minimum": 0
            },
            "cheap_experiments_completed": {
              "type": "number",
              "minimum": 0
            },
            "actual_learning_total": {
              "type": "number",
              "minimum": 0
            },
            "average_learning_per_cycle": {
              "type": "number",
              "minimum": 0
            },
            "rejection_count": {
              "type": "number",
              "minimum": 0
            },
            "promotion_count": {
              "type": "number",
              "minimum": 0
            },
            "promotion_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "importance_weighted_regret_total": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "ExperimentTierSummary": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "type": "object",
          "required": [
            "summary_id",
            "period_start",
            "period_end",
            "tier",
            "experiments_run",
            "experiments_rejected",
            "experiments_promoted",
            "actual_learning_total",
            "average_cost_estimate",
            "average_learning_value"
          ],
          "properties": {
            "object_type": {
              "const": "ExperimentTierSummary"
            },
            "summary_id": {
              "type": "string",
              "minLength": 1
            },
            "period_start": {
              "type": "string",
              "minLength": 1
            },
            "period_end": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "$ref": "#/$defs/Tier"
            },
            "experiments_run": {
              "type": "number",
              "minimum": 0
            },
            "experiments_rejected": {
              "type": "number",
              "minimum": 0
            },
            "experiments_promoted": {
              "type": "number",
              "minimum": 0
            },
            "actual_learning_total": {
              "type": "number",
              "minimum": 0
            },
            "average_cost_estimate": {
              "type": "number",
              "minimum": 0
            },
            "average_learning_value": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "PromotionGateDecision": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "type": "object",
          "required": [
            "gate_id",
            "experiment_id",
            "from_tier",
            "to_tier",
            "decision",
            "reason",
            "expected_incremental_learning",
            "required_evidence",
            "forbidden_authority_acknowledged"
          ],
          "properties": {
            "object_type": {
              "const": "PromotionGateDecision"
            },
            "gate_id": {
              "type": "string",
              "minLength": 1
            },
            "experiment_id": {
              "type": "string",
              "minLength": 1
            },
            "from_tier": {
              "$ref": "#/$defs/Tier"
            },
            "to_tier": {
              "enum": [
                "TIER_3_ROBUST_VALIDATION",
                "TIER_4_MATURITY_TRACKING"
              ]
            },
            "decision": {
              "enum": [
                "APPROVED",
                "REJECTED",
                "DEFERRED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "expected_incremental_learning": {
              "type": "number",
              "minimum": 0
            },
            "required_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden_authority_acknowledged": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
