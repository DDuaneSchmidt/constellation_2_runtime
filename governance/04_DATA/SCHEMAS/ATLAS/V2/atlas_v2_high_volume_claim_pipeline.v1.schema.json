{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_v2_high_volume_claim_pipeline.v1.schema.json",
  "title": "Atlas V2 High Volume Claim Pipeline V1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/ClaimBatch"},
    {"$ref": "#/$defs/ClaimBatchMetrics"},
    {"$ref": "#/$defs/MechanismRegistry"},
    {"$ref": "#/$defs/MechanismCluster"},
    {"$ref": "#/$defs/ClaimClusterSummary"}
  ],
  "$defs": {
    "SourceType": {"enum": ["TRANSCRIPT_INTAKE", "MANUAL_CLAIM_ENTRY", "HISTORICAL_RESEARCH_ARTIFACTS", "EXTERNAL_STRATEGY_CLAIMS"]},
    "BatchSizeTier": {"enum": ["UP_TO_1000", "UP_TO_5000", "UP_TO_10000"]},
    "MechanismFamily": {"enum": ["OPENING_RANGE", "BREAKOUT", "MEAN_REVERSION", "TREND_CONTINUATION", "LIQUIDITY_SWEEP", "VOLATILITY_EXPANSION", "PULLBACK", "MOMENTUM", "VWAP_OR_AVERAGE_RECLAIM", "ATR_FILTER", "SESSION_TIMING", "UNKNOWN"]},
    "Transition": {"type": "object", "required": ["transitioned_at", "from_status", "to_status", "reason", "triggering_object"], "properties": {"transitioned_at": {"type": "string", "format": "date-time"}, "from_status": {"type": "string"}, "to_status": {"type": "string"}, "reason": {"type": "string", "minLength": 1}, "triggering_object": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "Base": {"type": "object", "required": ["object_type", "created_at", "transition_history"], "properties": {"object_type": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "transition_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Transition"}}}},
    "ClaimBatch": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["batch_id", "pipeline_version", "claim_count", "batch_size_tier", "allowed_source_types", "source_types_present", "claim_ids", "authority_boundary_acknowledged", "status"], "properties": {"object_type": {"const": "ClaimBatch"}, "batch_id": {"type": "string", "minLength": 1}, "pipeline_version": {"const": "atlas_v2_high_volume_claim_pipeline_v1"}, "claim_count": {"type": "integer", "minimum": 1, "maximum": 10000}, "batch_size_tier": {"$ref": "#/$defs/BatchSizeTier"}, "allowed_source_types": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/SourceType"}}, "source_types_present": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SourceType"}}, "claim_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "string", "minLength": 1}}, "authority_boundary_acknowledged": {"const": true}, "status": {"type": "string", "minLength": 1}}}]},
    "CheapExperimentCandidate": {"type": "object", "required": ["mechanism_family", "cluster_id", "claim_count", "source_count", "route", "reason"], "properties": {"mechanism_family": {"$ref": "#/$defs/MechanismFamily"}, "cluster_id": {"type": "string", "minLength": 1}, "claim_count": {"type": "integer", "minimum": 1}, "source_count": {"type": "integer", "minimum": 1}, "route": {"const": "TIER_1_SANITY_SUMMARY_ONLY"}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "ClaimBatchMetrics": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["metrics_id", "batch_id", "total_claims", "unique_claims", "unique_mechanisms", "duplicate_ratio", "mechanism_distribution", "cheap_experiment_candidates", "claims_ingested", "claims_deduped", "mechanisms_discovered", "mechanisms_reused", "contrarian_coverage", "cheap_experiment_coverage", "authority_boundary_acknowledged"], "properties": {"object_type": {"const": "ClaimBatchMetrics"}, "metrics_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "total_claims": {"type": "integer", "minimum": 1, "maximum": 10000}, "unique_claims": {"type": "integer", "minimum": 1, "maximum": 10000}, "unique_mechanisms": {"type": "integer", "minimum": 1}, "duplicate_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "mechanism_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "cheap_experiment_candidates": {"type": "array", "items": {"$ref": "#/$defs/CheapExperimentCandidate"}}, "claims_ingested": {"type": "integer", "minimum": 1, "maximum": 10000}, "claims_deduped": {"type": "integer", "minimum": 0}, "mechanisms_discovered": {"type": "integer", "minimum": 1}, "mechanisms_reused": {"type": "integer", "minimum": 0}, "contrarian_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "cheap_experiment_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "authority_boundary_acknowledged": {"const": true}}}]},
    "MechanismRegistry": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["mechanism_id", "mechanism_family", "claim_count", "source_count", "contrarian_count", "cheap_experiment_count", "last_updated"], "properties": {"object_type": {"const": "MechanismRegistry"}, "mechanism_id": {"type": "string", "minLength": 1}, "mechanism_family": {"$ref": "#/$defs/MechanismFamily"}, "claim_count": {"type": "integer", "minimum": 0}, "source_count": {"type": "integer", "minimum": 0}, "contrarian_count": {"type": "integer", "minimum": 0}, "cheap_experiment_count": {"type": "integer", "minimum": 0}, "last_updated": {"type": "string", "format": "date-time"}}}]},
    "MechanismCluster": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["cluster_id", "mechanism_family", "claim_ids", "claim_count", "source_diversity", "confidence"], "properties": {"object_type": {"const": "MechanismCluster"}, "cluster_id": {"type": "string", "minLength": 1}, "mechanism_family": {"$ref": "#/$defs/MechanismFamily"}, "claim_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "string", "minLength": 1}}, "claim_count": {"type": "integer", "minimum": 1, "maximum": 10000}, "source_diversity": {"type": "integer", "minimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}]},
    "ClaimClusterSummary": {"allOf": [{"$ref": "#/$defs/Base"}, {"type": "object", "required": ["summary_id", "batch_id", "cluster_count", "clusters", "dedupe_strategy", "authority_boundary_acknowledged"], "properties": {"object_type": {"const": "ClaimClusterSummary"}, "summary_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "cluster_count": {"type": "integer", "minimum": 0}, "clusters": {"type": "array", "items": {"type": "object", "required": ["cluster_id", "mechanism_family", "claim_count"], "properties": {"cluster_id": {"type": "string", "minLength": 1}, "mechanism_family": {"$ref": "#/$defs/MechanismFamily"}, "claim_count": {"type": "integer", "minimum": 1}}, "additionalProperties": false}}, "dedupe_strategy": {"type": "string", "minLength": 1}, "authority_boundary_acknowledged": {"const": true}}}]}
  }
}
