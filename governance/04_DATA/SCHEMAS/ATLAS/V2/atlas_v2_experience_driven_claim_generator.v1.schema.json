{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_v2_experience_driven_claim_generator.v1.schema.json",
  "title": "Atlas V2 Experience-Driven Claim Generator V1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/GeneratedResearchClaim"},
    {"$ref": "#/$defs/ClaimGenerationRun"}
  ],
  "$defs": {
    "SourceType": {"enum": ["HISTORICAL_FAILURE", "HISTORICAL_CONTRADICTION", "REGRET_SIGNAL", "CALIBRATION_ERROR", "MECHANISM_GAP", "CONTRARIAN_GAP", "PRIOR_EXPERIENCE_EVENT"]},
    "ClaimStatus": {"enum": ["GENERATED", "DUPLICATE", "INSUFFICIENT_BASIS", "UNSUPPORTED_MECHANISM", "REJECTED_LOW_TESTABILITY"]},
    "RunStatus": {"enum": ["COMPLETED", "COMPLETED_WITH_REJECTIONS", "NO_ELIGIBLE_SOURCES"]},
    "Transition": {"type": "object", "required": ["transitioned_at", "from_status", "to_status", "reason", "triggering_object"], "properties": {"transitioned_at": {"type": "string", "format": "date-time"}, "from_status": {"type": "string"}, "to_status": {"type": "string"}, "reason": {"type": "string", "minLength": 1}, "triggering_object": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "Base": {"type": "object", "required": ["object_type", "created_at", "transition_history"], "properties": {"object_type": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "transition_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Transition"}}}},
    "StringList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "GeneratedResearchClaim": {
      "allOf": [
        {"$ref": "#/$defs/Base"},
        {"type": "object", "required": ["generated_claim_id", "created_at", "source_event_ids", "source_mechanism_ids", "source_type", "mechanism_family", "claim_text", "rationale", "novelty_basis", "expected_learning_value", "uncertainty_score", "contrarian_prompt", "intended_testability", "authority_boundary_acknowledged", "status"], "properties": {"object_type": {"const": "GeneratedResearchClaim"}, "generated_claim_id": {"type": "string", "minLength": 1}, "source_event_ids": {"$ref": "#/$defs/StringList"}, "source_mechanism_ids": {"$ref": "#/$defs/StringList"}, "source_type": {"$ref": "#/$defs/SourceType"}, "mechanism_family": {"type": "string", "minLength": 1}, "claim_text": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "novelty_basis": {"type": "string", "minLength": 1}, "expected_learning_value": {"type": "number", "minimum": 0, "maximum": 1}, "uncertainty_score": {"type": "number", "minimum": 0, "maximum": 1}, "contrarian_prompt": {"type": "string", "minLength": 1}, "intended_testability": {"type": "string", "minLength": 1}, "authority_boundary_acknowledged": {"const": true}, "status": {"$ref": "#/$defs/ClaimStatus"}}}
      ]
    },
    "ClaimGenerationRun": {
      "allOf": [
        {"$ref": "#/$defs/Base"},
        {"type": "object", "required": ["run_id", "created_at", "max_claims", "claims_generated", "duplicates_detected", "insufficient_basis_count", "mechanism_distribution", "status"], "properties": {"object_type": {"const": "ClaimGenerationRun"}, "run_id": {"type": "string", "minLength": 1}, "max_claims": {"type": "integer", "minimum": 0, "maximum": 100}, "claims_generated": {"type": "integer", "minimum": 0}, "duplicates_detected": {"type": "integer", "minimum": 0}, "insufficient_basis_count": {"type": "integer", "minimum": 0}, "mechanism_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "status": {"$ref": "#/$defs/RunStatus"}}}
      ]
    }
  }
}
