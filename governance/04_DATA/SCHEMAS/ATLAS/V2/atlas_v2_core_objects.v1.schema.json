            "actual_outcome": {
              "minLength": 1,
              "type": "string"
            },
            "calibration_error": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "conversion_reason": {
              "minLength": 1,
              "type": "string"
            },
            "converted_experience_event_id": {
              "minLength": 1,
              "type": "string"
            },
            "decision_summary": {
              "minLength": 1,
              "type": "string"
            },
            "expected_learning_source_fields": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "expected_learning_value_pre_outcome": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "expected_outcome": {
              "minLength": 1,
              "type": "string"
            },
            "experience_quality_score": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "historical_date": {
              "minLength": 1,
              "type": "string"
            },
            "object_type": {
              "const": "HistoricalExperienceRecord"
            },
            "provenance_reference": {
              "minLength": 1,
              "type": "string"
            },
            "record_id": {
              "minLength": 1,
              "type": "string"
            },
            "regret_score": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "source_artifact": {
              "minLength": 1,
              "type": "string"
            },
            "source_type": {
              "enum": [
                "FAILURE",
                "OBSERVATION",
                "KNOWLEDGE",
                "DECISION",
                "CONTRADICTION",
                "RESEARCH_OUTCOME"
              ]
            },
            "status": {
              "enum": [
                "CONVERTED",
                "INCOMPLETE_PROVENANCE",
                "UNSUPPORTED_SOURCE",
                "DUPLICATE_SOURCE",
                "REJECTED_LOW_QUALITY"
              ]
            }
          },
          "required": [
            "record_id",
            "source_artifact",
            "source_type",
            "historical_date",
            "decision_summary",
            "expected_outcome",
            "actual_outcome",
            "confidence",
            "regret_score",
            "experience_quality_score",
            "expected_learning_value_pre_outcome",
            "actual_learning_value_post_outcome",
            "expected_learning_source_fields",
            "actual_learning_source_fields",
            "conversion_reason",
            "calibration_error",
            "provenance_reference",
            "converted_experience_event_id",
            "status"
          ],
          "type": "object"
        }
      ]
