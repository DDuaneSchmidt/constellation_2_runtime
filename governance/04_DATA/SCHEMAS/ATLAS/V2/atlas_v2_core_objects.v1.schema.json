            "outcome_confidence": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "outcome_date": {
              "type": "string"
            },
            "outcome_id": {
              "minLength": 1,
              "type": "string"
            },
            "prediction_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "outcome_id",
            "prediction_id",
            "observed_outcome",
            "outcome_date",
            "matched_expected_outcome",
            "outcome_confidence",
            "evidence_reference"
          ],
          "type": "object"
        }
      ]
