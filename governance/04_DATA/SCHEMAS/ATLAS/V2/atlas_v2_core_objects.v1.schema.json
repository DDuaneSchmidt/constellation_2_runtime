            "missed_alternative": {
              "type": "string"
            },
            "object_type": {
              "const": "Regret"
            },
            "outcome_id": {
              "minLength": 1,
              "type": "string"
            },
            "regret_id": {
              "minLength": 1,
              "type": "string"
            },
            "regret_reason": {
              "minLength": 1,
              "type": "string"
            },
            "regret_score": {
              "type": "number"
            }
          },
          "required": [
            "regret_id",
            "decision_id",
            "outcome_id",
            "regret_score",
            "missed_alternative",
            "regret_reason",
            "importance_weighted_regret"
          ],
          "type": "object"
