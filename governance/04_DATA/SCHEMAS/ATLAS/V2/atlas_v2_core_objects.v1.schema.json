{
  "$defs": {
    "AttentionDecision": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "attention_cost": {
              "type": "number"
            },
            "decision_id": {
              "minLength": 1,
              "type": "string"
            },
            "decision_reason": {
              "minLength": 1,
              "type": "string"
            },
            "decision_type": {
              "minLength": 1,
              "type": "string"
            },
            "expected_learning_value": {
              "type": "number"
            },
            "expected_regret_if_ignored": {
              "type": "number"
            },
            "importance_score": {
              "type": "number"
            },
            "object_type": {
              "const": "AttentionDecision"
            },
            "rejected_alternatives": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "selected_action": {
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "uncertainty_target": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "decision_id",
            "decision_type",
            "uncertainty_target",
            "importance_score",
            "expected_learning_value",
            "expected_regret_if_ignored",
            "attention_cost",
            "selected_action",
            "rejected_alternatives",
            "decision_reason",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "Base": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "object_type": {
          "type": "string"
        },
        "transition_history": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "object_type",
        "created_at",
        "transition_history"
      ],
      "type": "object"
    },
    "BehaviorChange": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "behavior_change_id": {
              "minLength": 1,
              "type": "string"
            },
            "change_reason": {
              "minLength": 1,
              "type": "string"
            },
            "expected_future_impact": {
              "minLength": 1,
              "type": "string"
            },
            "new_behavior": {
              "minLength": 1,
              "type": "string"
            },
            "object_type": {
              "const": "BehaviorChange"
            },
            "previous_behavior": {
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "triggering_calibration_id": {
              "type": "string"
            },
            "triggering_regret_id": {
              "type": "string"
            }
          },
          "required": [
            "behavior_change_id",
            "previous_behavior",
            "new_behavior",
            "change_reason",
            "expected_future_impact",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "BeliefUpdate": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "belief_update_id": {
              "minLength": 1,
              "type": "string"
            },
            "new_belief": {
              "minLength": 1,
              "type": "string"
            },
            "object_type": {
              "const": "BeliefUpdate"
            },
            "previous_belief": {
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "triggering_experience_id": {
              "minLength": 1,
              "type": "string"
            },
            "update_reason": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "belief_update_id",
            "triggering_experience_id",
            "previous_belief",
            "new_belief",
            "update_reason",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "CalibrationRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "actual_result": {
              "type": "boolean"
            },
            "calibration_bucket": {
              "minLength": 1,
              "type": "string"
            },
            "calibration_error": {
              "type": "number"
            },
            "calibration_id": {
              "minLength": 1,
              "type": "string"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "object_type": {
              "const": "CalibrationRecord"
            },
            "prediction_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "calibration_id",
            "prediction_id",
            "confidence",
            "actual_result",
            "calibration_error",
            "calibration_bucket"
          ],
          "type": "object"
        }
      ]
    },
    "ExperienceEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "actual_learning_source_fields": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "actual_learning_value_post_outcome": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "behavior_change_id": {
              "type": "string"
            },
            "calibration_id": {
              "type": "string"
            },
            "experience_id": {
              "minLength": 1,
              "type": "string"
            },
            "experience_quality_score": {
              "type": "number"
            },
            "lesson": {
              "minLength": 1,
              "type": "string"
            },
            "object_type": {
              "const": "ExperienceEvent"
            },
            "outcome_id": {
              "minLength": 1,
              "type": "string"
            },
            "prediction_id": {
              "minLength": 1,
              "type": "string"
            },
            "regret_id": {
              "type": "string"
            },
            "source_decision_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "experience_id",
            "source_decision_id",
            "prediction_id",
            "outcome_id",
            "lesson",
            "experience_quality_score"
          ],
          "type": "object"
        }
      ]
    },
    "HistoricalExperienceRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        },
        {
          "properties": {
            "actual_learning_source_fields": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "actual_learning_value_post_outcome": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
