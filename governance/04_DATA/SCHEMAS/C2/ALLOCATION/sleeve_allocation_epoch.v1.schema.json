{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "C2_SLEEVE_ALLOCATION_EPOCH_V1",
  "title": "C2 Sleeve Allocation Epoch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "epoch_id",
    "portfolio_snapshot_id",
    "policy_hash",
    "sleeve_registry_hash",
    "correlation_gate_hash",
    "portfolio_allowed_capital_at_risk_cents",
    "portfolio_used_capital_at_risk_cents",
    "portfolio_headroom_cents",
    "per_sleeve",
    "input_manifest"
  ],
  "properties": {
    "schema_id": { "const": "C2_SLEEVE_ALLOCATION_EPOCH_V1" },
    "schema_version": { "type": "integer", "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "minLength": 1 },
    "epoch_id": { "type": "string", "minLength": 1 },
    "portfolio_snapshot_id": { "type": "string", "minLength": 1 },
    "policy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sleeve_registry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "correlation_gate_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "portfolio_allowed_capital_at_risk_cents": { "type": "integer", "minimum": 0 },
    "portfolio_used_capital_at_risk_cents": { "type": "integer", "minimum": 0 },
    "portfolio_headroom_cents": { "type": "integer", "minimum": 0 },
    "per_sleeve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_sleeve_id",
          "engine_ids",
          "assigned_budget_cents",
          "used_budget_cents",
          "remaining_budget_cents"
        ],
        "properties": {
          "canonical_sleeve_id": { "type": "string", "minLength": 1 },
          "engine_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "assigned_budget_cents": { "type": "integer", "minimum": 0 },
          "used_budget_cents": { "type": "integer", "minimum": 0 },
          "remaining_budget_cents": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256", "day_utc", "producer"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "day_utc": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              { "type": "null" }
            ]
          },
          "producer": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
