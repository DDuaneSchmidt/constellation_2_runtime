{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/signal/hy_spread_signal.v1.schema.json",
  "title": "hy_spread_signal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "signal_id",
    "engine_version",
    "policy_version",
    "authority_status",
    "execution_authority",
    "effective_at",
    "spread_level_bps",
    "spread_level_state",
    "warnings",
    "created_at"
  ],
  "properties": {
    "schema_id": {
      "const": "hy_spread_signal"
    },
    "schema_version": {
      "const": "v1"
    },
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "authority_status": {
      "type": "string",
      "enum": [
        "candidate",
        "authoritative"
      ]
    },
    "execution_authority": {
      "type": "boolean"
    },
    "effective_at": {
      "type": "string",
      "minLength": 1
    },
    "spread_level_bps": {
      "type": "integer",
      "minimum": 0
    },
    "spread_level_state": {
      "type": "string",
      "enum": [
        "very_tight",
        "tight",
        "neutral",
        "wide",
        "very_wide"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
