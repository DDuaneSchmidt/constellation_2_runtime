{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/orchestration_trigger.v1.schema.json",
  "title": "orchestration_trigger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "trigger_id",
    "day_utc",
    "emitted_at_utc",
    "trade_identity_ref",
    "trigger_class",
    "reason_class",
    "reason_code",
    "trigger_target_type",
    "orchestration_state_ref",
    "policy_projection_ref",
    "constraint_refs",
    "core2_refs",
    "upper_layer_provenance_ref",
    "artifact_driven_only",
    "direct_transport_forbidden",
    "downstream_execution_posture"
  ],
  "properties": {
    "schema_id": { "const": "orchestration_trigger" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "orchestration_trigger_v1" },
    "trigger_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "emitted_at_utc": { "type": "string", "format": "date-time" },
    "trade_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_identity_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "trigger_class": {
      "type": "string",
      "enum": ["PERIODIC_EVALUATION", "RETRY", "ALERT", "REVIEW", "SESSION_OPEN"]
    },
    "reason_class": { "type": "string", "minLength": 1 },
    "reason_code": { "type": "string", "minLength": 1 },
    "trigger_target_type": {
      "type": "string",
      "enum": [
        "CORE3_REEVALUATION_REQUEST",
        "OPERATOR_REVIEW_REQUEST",
        "POLICY_REPROJECTION_REQUEST",
        "EXCEPTION_RECLASSIFICATION_REQUEST",
        "ALERT_ONLY_REQUEST"
      ]
    },
    "orchestration_state_ref": { "$ref": "#/$defs/logical_artifact_ref" },
    "policy_projection_ref": { "$ref": "#/$defs/logical_artifact_ref" },
    "constraint_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/logical_artifact_ref" }
    },
    "core2_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_ref",
        "incorporated_state_ref",
        "reconciled_description_ref",
        "reconciliation_health_ref",
        "reconciliation_provenance_ref"
      ],
      "properties": {
        "trade_identity_ref": { "$ref": "#/$defs/artifact_ref" },
        "incorporated_state_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciled_description_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_health_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_provenance_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "upper_layer_provenance_ref": { "$ref": "#/$defs/artifact_ref" },
    "artifact_driven_only": { "const": true },
    "direct_transport_forbidden": { "const": true },
    "downstream_execution_posture": { "const": "REENTER_CORE3_AND_CORE4_REQUIRED" }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "logical_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "artifact_path", "artifact_sha256"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
