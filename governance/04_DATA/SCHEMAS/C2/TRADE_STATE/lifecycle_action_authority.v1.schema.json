{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/lifecycle_action_authority.v1.schema.json",
  "title": "lifecycle_action_authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "canonical_owner_status",
    "materialization_set_id",
    "day_utc",
    "evaluated_at_utc",
    "trade_identity_ref",
    "environment",
    "sleeve_id",
    "account_id",
    "ownership_classification",
    "final_action_posture",
    "allowed_actions",
    "required_actions",
    "forbidden_actions",
    "blocked_actions",
    "action_safety_posture",
    "first_blocker",
    "ambiguity_state",
    "policy_basis_refs",
    "upstream_core2_refs",
    "gate_ref",
    "candidate_set_ref",
    "rule_version",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "lifecycle_action_authority" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "lifecycle_action_authority_v1" },
    "canonical_owner_status": { "const": "CANONICAL_ACTION_AUTHORITY_OWNER" },
    "materialization_set_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "trade_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_identity_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "environment": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string" },
    "ownership_classification": { "type": "string", "minLength": 1 },
    "final_action_posture": {
      "type": "string",
      "enum": ["HOLD_ONLY", "ACTION_ALLOWED", "ACTION_REQUIRED", "REVIEW_REQUIRED", "BLOCKED"]
    },
    "allowed_actions": { "$ref": "#/$defs/action_array" },
    "required_actions": { "$ref": "#/$defs/action_array" },
    "forbidden_actions": { "$ref": "#/$defs/action_array" },
    "blocked_actions": { "$ref": "#/$defs/action_array" },
    "action_safety_posture": { "type": "string", "enum": ["ACTIONABLE", "DEGRADED_REVIEW_REQUIRED", "BLOCKED"] },
    "first_blocker": { "type": "string", "minLength": 1 },
    "ambiguity_state": { "type": "string", "minLength": 1 },
    "policy_basis_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_ref" }
    },
    "upstream_core2_refs": { "$ref": "#/$defs/core2_refs" },
    "gate_ref": { "$ref": "#/$defs/artifact_ref" },
    "candidate_set_ref": { "$ref": "#/$defs/artifact_ref" },
    "rule_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_contract_id",
        "policy_contract_version",
        "conflict_contract_id",
        "conflict_contract_version"
      ],
      "properties": {
        "policy_contract_id": { "type": "string", "minLength": 1 },
        "policy_contract_version": { "type": "integer", "minimum": 1 },
        "conflict_contract_id": { "type": "string", "minLength": 1 },
        "conflict_contract_version": { "type": "integer", "minimum": 1 }
      }
    },
    "derived_only": { "const": false }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "core2_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_ref",
        "incorporated_state_ref",
        "reconciled_description_ref",
        "reconciliation_health_ref",
        "reconciliation_provenance_ref"
      ],
      "properties": {
        "trade_identity_ref": { "$ref": "#/$defs/artifact_ref" },
        "incorporated_state_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciled_description_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_health_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_provenance_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "action_array": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "HOLD",
          "ADD_INITIAL_PROTECTION",
          "AMEND_PROTECTION",
          "REDUCE_POSITION",
          "CLOSE_POSITION",
          "CANCEL_ORPHAN_CHILD",
          "OPERATOR_REVIEW_REQUIRED",
          "BLOCK_ALL_ACTIONS"
        ]
      }
    }
  }
}
