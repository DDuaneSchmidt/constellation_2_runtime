{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/operator_timeline_view.v1.schema.json",
  "title": "operator_timeline_view.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "materialization_set_id",
    "trade_identity_id",
    "day_utc",
    "evaluated_at_utc",
    "current_operator_health_ref",
    "prior_operator_health_ref",
    "summary_provenance_ref",
    "timeline_classification",
    "narrative_lines",
    "material_change_entries",
    "degraded_reason_codes",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "operator_timeline_view" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "operator_timeline_view_v1" },
    "materialization_set_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trade_identity_id": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "current_operator_health_ref": { "$ref": "#/$defs/artifact_ref" },
    "prior_operator_health_ref": { "$ref": "#/$defs/artifact_link" },
    "summary_provenance_ref": { "$ref": "#/$defs/artifact_ref" },
    "timeline_classification": {
      "type": "string",
      "enum": ["INITIAL", "STABLE", "MATERIAL_CHANGE", "DEGRADED"]
    },
    "narrative_lines": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "material_change_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/change_row" }
    },
    "degraded_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "derived_only": { "const": true }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifact_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "source_family",
        "present",
        "artifact_path",
        "artifact_sha256",
        "missing_reason_code"
      ],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "source_family": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" },
        "missing_reason_code": { "type": "string" }
      }
    },
    "change_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "statement", "traceability_claim_ids", "lower_core_refs"],
      "properties": {
        "classification": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "traceability_claim_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "lower_core_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_link" }
        }
      }
    }
  }
}
