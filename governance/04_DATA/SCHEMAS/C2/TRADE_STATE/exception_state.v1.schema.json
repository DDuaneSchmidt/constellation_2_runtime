{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/exception_state.v1.schema.json",
  "title": "exception_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "exception_id",
    "day_utc",
    "evaluated_at_utc",
    "trade_identity_ref",
    "environment",
    "sleeve_id",
    "exception_class",
    "classification_status",
    "severity",
    "abnormal_state_subtype",
    "detected_abnormal_subtypes",
    "repair_recommendation_class",
    "constraint_posture",
    "reason_codes",
    "core1_refs",
    "core2_refs",
    "core3_refs",
    "core4_refs",
    "upper_layer_provenance_ref",
    "artifact_driven_only",
    "direct_execution_forbidden",
    "downstream_execution_posture"
  ],
  "properties": {
    "schema_id": { "const": "exception_state" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "exception_state_v1" },
    "exception_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "trade_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_identity_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "environment": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "exception_class": {
      "type": "string",
      "enum": [
        "NO_EXCEPTION",
        "PARTIAL_FILL",
        "RECONNECT_RECOVERY",
        "MANUAL_IB_CHANGE",
        "ORPHAN_ORDER",
        "MULTIPLE_CONSTRAINTS"
      ]
    },
    "classification_status": {
      "type": "string",
      "enum": ["CLEAR", "ACTIVE", "DEGRADED", "BLOCKED"]
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "REVIEW_REQUIRED", "CRITICAL"]
    },
    "abnormal_state_subtype": { "type": "string", "minLength": 1 },
    "detected_abnormal_subtypes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "repair_recommendation_class": { "type": "string", "minLength": 1 },
    "constraint_posture": {
      "type": "string",
      "enum": ["NONE", "REVIEW_REQUIRED", "CORE3_REENTRY_REQUIRED", "BLOCKED"]
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "core1_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/logical_artifact_ref" }
    },
    "core2_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_ref",
        "incorporated_state_ref",
        "reconciled_description_ref",
        "reconciliation_health_ref",
        "reconciliation_provenance_ref"
      ],
      "properties": {
        "trade_identity_ref": { "$ref": "#/$defs/artifact_ref" },
        "incorporated_state_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciled_description_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_health_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_provenance_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "core3_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/logical_artifact_ref" }
    },
    "core4_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/logical_artifact_ref" }
    },
    "upper_layer_provenance_ref": { "$ref": "#/$defs/artifact_ref" },
    "artifact_driven_only": { "const": true },
    "direct_execution_forbidden": { "const": true },
    "downstream_execution_posture": { "const": "REENTER_CORE3_AND_CORE4_REQUIRED" }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "logical_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "artifact_path", "artifact_sha256"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
