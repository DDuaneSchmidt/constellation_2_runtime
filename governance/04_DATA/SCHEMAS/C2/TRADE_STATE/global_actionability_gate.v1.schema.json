{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/global_actionability_gate.v1.schema.json",
  "title": "global_actionability_gate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "materialization_set_id",
    "day_utc",
    "evaluated_at_utc",
    "trade_identity_ref",
    "gate_verdict",
    "first_reason_code",
    "reason_codes",
    "freshness_basis",
    "ownership_basis",
    "reconciliation_basis",
    "upstream_core2_refs",
    "rule_version",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "global_actionability_gate" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "global_actionability_gate_v1" },
    "materialization_set_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "trade_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_identity_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "gate_verdict": { "type": "string", "enum": ["ACTIONABLE", "DEGRADED_REVIEW_REQUIRED", "BLOCKED"] },
    "first_reason_code": { "type": "string", "minLength": 1 },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "freshness_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconciliation_health_state", "freshness_status", "downstream_action_posture"],
      "properties": {
        "reconciliation_health_state": { "type": "string", "minLength": 1 },
        "freshness_status": { "type": "string", "minLength": 1 },
        "downstream_action_posture": { "type": "string", "minLength": 1 }
      }
    },
    "ownership_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership_classification", "ambiguity_state", "blocker_state"],
      "properties": {
        "ownership_classification": { "type": "string", "minLength": 1 },
        "ambiguity_state": { "type": "string", "minLength": 1 },
        "blocker_state": { "type": "string", "minLength": 1 }
      }
    },
    "reconciliation_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "freshness_status",
        "ambiguity_status",
        "insufficient_evidence_status",
        "description_downstream_posture",
        "description_reconciliation_status"
      ],
      "properties": {
        "current_state": { "type": "string", "minLength": 1 },
        "freshness_status": { "type": "string", "minLength": 1 },
        "ambiguity_status": { "type": "string", "minLength": 1 },
        "insufficient_evidence_status": { "type": "string", "minLength": 1 },
        "description_downstream_posture": { "type": "string", "minLength": 1 },
        "description_reconciliation_status": { "type": "string", "minLength": 1 }
      }
    },
    "upstream_core2_refs": {
      "$ref": "#/$defs/core2_refs"
    },
    "rule_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_contract_id", "gate_contract_version"],
      "properties": {
        "gate_contract_id": { "type": "string", "minLength": 1 },
        "gate_contract_version": { "type": "integer", "minimum": 1 }
      }
    },
    "derived_only": { "const": true }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "core2_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_ref",
        "incorporated_state_ref",
        "reconciled_description_ref",
        "reconciliation_health_ref",
        "reconciliation_provenance_ref"
      ],
      "properties": {
        "trade_identity_ref": { "$ref": "#/$defs/artifact_ref" },
        "incorporated_state_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciled_description_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_health_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_provenance_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    }
  }
}
