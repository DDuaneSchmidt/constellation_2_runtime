{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/operator_snapshot_binding.v1.schema.json",
  "title": "operator_snapshot_binding.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "binding_id",
    "trade_identity_id",
    "day_utc",
    "evaluated_at_utc",
    "environment",
    "sleeve_id",
    "account_id",
    "core1_refs",
    "core2_refs",
    "core3_refs",
    "core4_refs",
    "rule_version_set",
    "binding_status",
    "coherence_status",
    "invalidation_status",
    "degradation_codes",
    "omitted_elements",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "operator_snapshot_binding" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "operator_snapshot_binding_v1" },
    "binding_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trade_identity_id": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "environment": { "type": "string" },
    "sleeve_id": { "type": "string" },
    "account_id": { "type": "string" },
    "core1_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health_ref", "audit_ref"],
      "properties": {
        "health_ref": { "$ref": "#/$defs/artifact_link" },
        "audit_ref": { "$ref": "#/$defs/artifact_link" }
      }
    },
    "core2_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_ref",
        "incorporated_state_ref",
        "reconciled_description_ref",
        "reconciliation_health_ref",
        "reconciliation_provenance_ref"
      ],
      "properties": {
        "trade_identity_ref": { "$ref": "#/$defs/artifact_link" },
        "incorporated_state_ref": { "$ref": "#/$defs/artifact_link" },
        "reconciled_description_ref": { "$ref": "#/$defs/artifact_link" },
        "reconciliation_health_ref": { "$ref": "#/$defs/artifact_link" },
        "reconciliation_provenance_ref": { "$ref": "#/$defs/artifact_link" }
      }
    },
    "core3_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle_action_authority_ref", "action_decision_provenance_ref"],
      "properties": {
        "lifecycle_action_authority_ref": { "$ref": "#/$defs/artifact_link" },
        "action_decision_provenance_ref": { "$ref": "#/$defs/artifact_link" }
      }
    },
    "core4_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submit_boundary_status_ref"],
      "properties": {
        "submit_boundary_status_ref": { "$ref": "#/$defs/artifact_link" }
      }
    },
    "rule_version_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_contract_id",
        "snapshot_contract_version",
        "rollup_contract_id",
        "rollup_contract_version",
        "operator_health_contract_id",
        "operator_health_contract_version",
        "provenance_contract_id",
        "provenance_contract_version",
        "narrative_contract_id",
        "narrative_contract_version"
      ],
      "properties": {
        "snapshot_contract_id": { "type": "string", "minLength": 1 },
        "snapshot_contract_version": { "type": "integer", "minimum": 1 },
        "rollup_contract_id": { "type": "string", "minLength": 1 },
        "rollup_contract_version": { "type": "integer", "minimum": 1 },
        "operator_health_contract_id": { "type": "string", "minLength": 1 },
        "operator_health_contract_version": { "type": "integer", "minimum": 1 },
        "provenance_contract_id": { "type": "string", "minLength": 1 },
        "provenance_contract_version": { "type": "integer", "minimum": 1 },
        "narrative_contract_id": { "type": "string", "minLength": 1 },
        "narrative_contract_version": { "type": "integer", "minimum": 1 }
      }
    },
    "binding_status": { "type": "string", "enum": ["BOUND", "DEGRADED", "BLOCKED"] },
    "coherence_status": { "type": "string", "enum": ["COHERENT", "DEGRADED", "INCOHERENT"] },
    "invalidation_status": {
      "type": "string",
      "enum": [
        "NONE",
        "MISSING_REQUIRED_ARTIFACT",
        "INCOMPLETE_PROVENANCE",
        "INCOHERENT_CROSS_CORE_INPUTS",
        "RULE_VERSION_MISSING",
        "SNAPSHOT_SUPERSEDED"
      ]
    },
    "degradation_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "omitted_elements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "derived_only": { "const": true }
  },
  "$defs": {
    "artifact_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "source_family",
        "present",
        "artifact_path",
        "artifact_sha256",
        "missing_reason_code"
      ],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "source_family": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" },
        "missing_reason_code": { "type": "string" }
      }
    }
  }
}
