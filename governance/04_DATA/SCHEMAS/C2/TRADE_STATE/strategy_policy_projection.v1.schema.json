{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/strategy_policy_projection.v1.schema.json",
  "title": "strategy_policy_projection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "plane_owner_status",
    "policy_projection_id",
    "day_utc",
    "evaluated_at_utc",
    "trade_identity_ref",
    "environment",
    "sleeve_id",
    "policy_input_posture",
    "stop_posture",
    "trailing_posture",
    "scaling_posture",
    "time_exit_posture",
    "risk_rule_posture",
    "policy_version_set",
    "constraint_refs",
    "core2_refs",
    "upper_layer_provenance_ref",
    "artifact_driven_only",
    "direct_execution_forbidden",
    "downstream_execution_posture",
    "blocker_codes",
    "degraded_codes"
  ],
  "properties": {
    "schema_id": { "const": "strategy_policy_projection" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "strategy_policy_projection_v1" },
    "plane_owner_status": { "const": "CANONICAL_POLICY_PROJECTION_PLANE_ARTIFACT" },
    "policy_projection_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "trade_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_identity_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "environment": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "policy_input_posture": {
      "type": "string",
      "enum": ["READY", "DEGRADED", "BLOCKED"]
    },
    "stop_posture": { "$ref": "#/$defs/policy_posture" },
    "trailing_posture": { "$ref": "#/$defs/policy_posture" },
    "scaling_posture": { "$ref": "#/$defs/policy_posture" },
    "time_exit_posture": { "$ref": "#/$defs/policy_posture" },
    "risk_rule_posture": { "$ref": "#/$defs/policy_posture" },
    "policy_version_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_policy_version",
        "trailing_policy_version",
        "scaling_policy_version",
        "time_exit_policy_version",
        "risk_rule_version",
        "selection_policy_version"
      ],
      "properties": {
        "stop_policy_version": { "type": "string", "minLength": 1 },
        "trailing_policy_version": { "type": "string", "minLength": 1 },
        "scaling_policy_version": { "type": "string", "minLength": 1 },
        "time_exit_policy_version": { "type": "string", "minLength": 1 },
        "risk_rule_version": { "type": "string", "minLength": 1 },
        "selection_policy_version": { "type": "string", "minLength": 1 }
      }
    },
    "constraint_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/logical_artifact_ref" }
    },
    "core2_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_ref",
        "incorporated_state_ref",
        "reconciled_description_ref",
        "reconciliation_health_ref",
        "reconciliation_provenance_ref"
      ],
      "properties": {
        "trade_identity_ref": { "$ref": "#/$defs/artifact_ref" },
        "incorporated_state_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciled_description_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_health_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_provenance_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "upper_layer_provenance_ref": { "$ref": "#/$defs/artifact_ref" },
    "artifact_driven_only": { "const": true },
    "direct_execution_forbidden": { "const": true },
    "downstream_execution_posture": { "const": "REENTER_CORE3_AND_CORE4_REQUIRED" },
    "blocker_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "degraded_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "logical_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "artifact_path", "artifact_sha256"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "policy_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_status",
        "projected_action_class",
        "reason_codes",
        "parameter_values"
      ],
      "properties": {
        "projection_status": {
          "type": "string",
          "enum": ["PROJECTED", "INACTIVE", "DEGRADED", "BLOCKED"]
        },
        "projected_action_class": { "type": "string", "minLength": 1 },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "parameter_values": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    }
  }
}
