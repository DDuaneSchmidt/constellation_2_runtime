{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/orchestration_state.v1.schema.json",
  "title": "orchestration_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "plane_owner_status",
    "orchestration_state_id",
    "day_utc",
    "evaluated_at_utc",
    "trade_identity_ref",
    "environment",
    "sleeve_id",
    "cadence_window",
    "next_evaluation_at_utc",
    "pending_retries",
    "pending_alerts",
    "session_phase",
    "trigger_refs_emitted",
    "orchestration_posture",
    "reason_codes",
    "policy_projection_ref",
    "constraint_refs",
    "core2_refs",
    "upper_layer_provenance_ref",
    "artifact_driven_only",
    "direct_execution_forbidden",
    "downstream_execution_posture"
  ],
  "properties": {
    "schema_id": { "const": "orchestration_state" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "orchestration_state_v1" },
    "plane_owner_status": { "const": "CANONICAL_ORCHESTRATION_STATE_PLANE_ARTIFACT" },
    "orchestration_state_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "trade_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_identity_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "environment": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "cadence_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadence_class",
        "cadence_seconds",
        "window_started_at_utc",
        "window_ends_at_utc"
      ],
      "properties": {
        "cadence_class": { "type": "string", "minLength": 1 },
        "cadence_seconds": { "type": "integer", "minimum": 1 },
        "window_started_at_utc": { "type": "string", "format": "date-time" },
        "window_ends_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "next_evaluation_at_utc": { "type": "string", "format": "date-time" },
    "pending_retries": {
      "type": "array",
      "items": { "$ref": "#/$defs/cadence_item" }
    },
    "pending_alerts": {
      "type": "array",
      "items": { "$ref": "#/$defs/cadence_item" }
    },
    "session_phase": { "type": "string", "minLength": 1 },
    "trigger_refs_emitted": {
      "type": "array",
      "items": { "$ref": "#/$defs/logical_artifact_ref" }
    },
    "orchestration_posture": {
      "type": "string",
      "enum": ["READY", "DEGRADED", "BLOCKED"]
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "policy_projection_ref": { "$ref": "#/$defs/logical_artifact_ref" },
    "constraint_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/logical_artifact_ref" }
    },
    "core2_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_ref",
        "incorporated_state_ref",
        "reconciled_description_ref",
        "reconciliation_health_ref",
        "reconciliation_provenance_ref"
      ],
      "properties": {
        "trade_identity_ref": { "$ref": "#/$defs/artifact_ref" },
        "incorporated_state_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciled_description_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_health_ref": { "$ref": "#/$defs/artifact_ref" },
        "reconciliation_provenance_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "upper_layer_provenance_ref": { "$ref": "#/$defs/artifact_ref" },
    "artifact_driven_only": { "const": true },
    "direct_execution_forbidden": { "const": true },
    "downstream_execution_posture": { "const": "REENTER_CORE3_AND_CORE4_REQUIRED" }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "logical_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "artifact_path", "artifact_sha256"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "cadence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "scheduled_for_utc"],
      "properties": {
        "reason_code": { "type": "string", "minLength": 1 },
        "scheduled_for_utc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
