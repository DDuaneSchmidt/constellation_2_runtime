{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/lifecycle_action_operator_surface.v1.schema.json",
  "title": "lifecycle_action_operator_surface.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "materialization_set_id",
    "day_utc",
    "evaluated_at_utc",
    "trade_action_dossiers",
    "blocked_action_index",
    "required_action_index",
    "review_required_index",
    "close_eligible_index",
    "protection_required_index",
    "health_summary",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "lifecycle_action_operator_surface" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "lifecycle_action_operator_surface_v1" },
    "materialization_set_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluated_at_utc": { "type": "string", "format": "date-time" },
    "trade_action_dossiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/dossier_row" }
    },
    "blocked_action_index": {
      "type": "array",
      "items": { "$ref": "#/$defs/dossier_row" }
    },
    "required_action_index": {
      "type": "array",
      "items": { "$ref": "#/$defs/dossier_row" }
    },
    "review_required_index": {
      "type": "array",
      "items": { "$ref": "#/$defs/dossier_row" }
    },
    "close_eligible_index": {
      "type": "array",
      "items": { "$ref": "#/$defs/dossier_row" }
    },
    "protection_required_index": {
      "type": "array",
      "items": { "$ref": "#/$defs/dossier_row" }
    },
    "health_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trades_total",
        "blocked_total",
        "review_required_total",
        "required_action_total",
        "actionable_total"
      ],
      "properties": {
        "trades_total": { "type": "integer", "minimum": 0 },
        "blocked_total": { "type": "integer", "minimum": 0 },
        "review_required_total": { "type": "integer", "minimum": 0 },
        "required_action_total": { "type": "integer", "minimum": 0 },
        "actionable_total": { "type": "integer", "minimum": 0 }
      }
    },
    "derived_only": { "const": true }
  },
  "$defs": {
    "dossier_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_id",
        "final_action_posture",
        "allowed_actions",
        "required_actions",
        "blocked_actions",
        "first_blocker",
        "authority_ref"
      ],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "final_action_posture": { "type": "string", "minLength": 1 },
        "allowed_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blocked_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "first_blocker": { "type": "string", "minLength": 1 },
        "authority_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_path", "artifact_sha256"],
          "properties": {
            "artifact_path": { "type": "string", "minLength": 1 },
            "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    }
  }
}
