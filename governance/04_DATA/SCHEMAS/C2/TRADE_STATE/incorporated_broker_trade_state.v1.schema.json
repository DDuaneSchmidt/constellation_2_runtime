{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/incorporated_broker_trade_state.v1.schema.json",
  "title": "incorporated_broker_trade_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "truth_owner_status",
    "materialization_set_id",
    "day_utc",
    "evaluation_utc",
    "trade_identity_ref",
    "environment",
    "sleeve_id",
    "account_id",
    "instrument_identity",
    "ownership_classification",
    "current_quantity",
    "side",
    "average_cost",
    "incorporated_fills",
    "current_working_orders",
    "terminal_order_lineage",
    "orphan_order_facts",
    "last_reconciled_fact_boundary",
    "drift_basis",
    "freshness_basis",
    "first_blocker",
    "ambiguity_state",
    "blocker_codes",
    "degraded_codes",
    "last_successful_reconciliation_utc",
    "upstream_core1_evidence_refs",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "incorporated_broker_trade_state" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "incorporated_broker_trade_state_v1" },
    "truth_owner_status": { "const": "CANONICAL_CURRENT_TRUTH_OWNER" },
    "materialization_set_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluation_utc": { "type": "string", "format": "date-time" },
    "trade_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_identity_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "environment": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string" },
    "instrument_identity": { "$ref": "#/$defs/instrument_identity" },
    "ownership_classification": {
      "type": "string",
      "enum": [
        "CONSTELLATION_OWNED",
        "FOREIGN_MANUAL",
        "AMBIGUOUS_OWNERSHIP",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "current_quantity": { "type": "string" },
    "side": { "type": "string", "enum": ["LONG", "SHORT", "FLAT", "UNKNOWN"] },
    "average_cost": { "type": "string" },
    "incorporated_fills": {
      "type": "array",
      "items": { "$ref": "#/$defs/fill_row" }
    },
    "current_working_orders": {
      "type": "array",
      "items": { "$ref": "#/$defs/order_row" }
    },
    "terminal_order_lineage": {
      "type": "array",
      "items": { "$ref": "#/$defs/order_row" }
    },
    "orphan_order_facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/orphan_order_row" }
    },
    "last_reconciled_fact_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_journal_sequence_number",
        "latest_observed_utc",
        "raw_journal_path",
        "raw_journal_sha256"
      ],
      "properties": {
        "max_journal_sequence_number": { "type": "integer", "minimum": 0 },
        "latest_observed_utc": { "type": "string", "format": "date-time" },
        "raw_journal_path": { "type": "string", "minLength": 1 },
        "raw_journal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "drift_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_quantity",
        "net_fill_quantity",
        "position_vs_fill_consistent",
        "mismatch_quantity",
        "reason_codes"
      ],
      "properties": {
        "position_quantity": { "type": "string" },
        "net_fill_quantity": { "type": "string" },
        "position_vs_fill_consistent": { "type": "boolean" },
        "mismatch_quantity": { "type": "string" },
        "reason_codes": { "$ref": "#/$defs/string_array" }
      }
    },
    "freshness_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core1_downstream_trust_verdict",
        "core1_freshness_status",
        "evaluation_utc",
        "latest_observed_utc",
        "age_seconds"
      ],
      "properties": {
        "core1_downstream_trust_verdict": { "type": "string", "minLength": 1 },
        "core1_freshness_status": { "type": "string", "minLength": 1 },
        "evaluation_utc": { "type": "string", "format": "date-time" },
        "latest_observed_utc": { "type": "string", "format": "date-time" },
        "age_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "first_blocker": { "type": "string" },
    "ambiguity_state": { "type": "string", "minLength": 1 },
    "blocker_codes": { "$ref": "#/$defs/string_array" },
    "degraded_codes": { "$ref": "#/$defs/string_array" },
    "last_successful_reconciliation_utc": { "type": "string" },
    "upstream_core1_evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_journal_ref", "fact_ledger_refs", "health_ref"],
      "properties": {
        "raw_journal_ref": { "$ref": "#/$defs/artifact_ref" },
        "fact_ledger_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_order_fact",
            "observed_order_status_fact",
            "observed_fill_fact",
            "observed_position_fact"
          ],
          "properties": {
            "observed_order_fact": { "$ref": "#/$defs/artifact_ref" },
            "observed_order_status_fact": { "$ref": "#/$defs/artifact_ref" },
            "observed_fill_fact": { "$ref": "#/$defs/artifact_ref" },
            "observed_position_fact": { "$ref": "#/$defs/artifact_ref" }
          }
        },
        "health_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "derived_only": { "const": false }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "instrument_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "sec_type", "exchange", "currency", "raw_summary"],
      "properties": {
        "symbol": { "type": "string" },
        "sec_type": { "type": "string" },
        "exchange": { "type": "string" },
        "currency": { "type": "string" },
        "raw_summary": { "type": "string" }
      }
    },
    "fill_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "order_id",
        "perm_id",
        "fill_quantity",
        "fill_price",
        "side",
        "commission",
        "currency",
        "observed_utc",
        "fact_record_ids"
      ],
      "properties": {
        "execution_id": { "type": "string" },
        "order_id": { "type": "string" },
        "perm_id": { "type": "string" },
        "fill_quantity": { "type": "string" },
        "fill_price": { "type": "string" },
        "side": { "type": "string" },
        "commission": { "type": "string" },
        "currency": { "type": "string" },
        "observed_utc": { "type": "string", "format": "date-time" },
        "fact_record_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "order_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_key",
        "order_id",
        "perm_id",
        "status",
        "action",
        "total_quantity",
        "filled_quantity",
        "remaining_quantity",
        "observed_utc",
        "fact_record_ids"
      ],
      "properties": {
        "order_key": { "type": "string", "minLength": 1 },
        "order_id": { "type": "string" },
        "perm_id": { "type": "string" },
        "status": { "type": "string" },
        "action": { "type": "string" },
        "total_quantity": { "type": "string" },
        "filled_quantity": { "type": "string" },
        "remaining_quantity": { "type": "string" },
        "observed_utc": { "type": "string", "format": "date-time" },
        "fact_record_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "orphan_order_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_key", "fact_record_id", "reason_code"],
      "properties": {
        "order_key": { "type": "string", "minLength": 1 },
        "fact_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason_code": { "type": "string", "minLength": 1 }
      }
    }
  }
}

