{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/trade_state/trade_identity.v1.schema.json",
  "title": "trade_identity.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "materialization_set_id",
    "day_utc",
    "evaluation_utc",
    "trade_identity_id",
    "environment",
    "sleeve_id",
    "account_id",
    "instrument_identity",
    "ownership_classification",
    "ownership_reason_codes",
    "lineage_attachment_refs",
    "open_close_continuity",
    "ambiguity_state",
    "blocker_state",
    "blocker_codes",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "trade_identity" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "trade_identity_resolution_v1" },
    "materialization_set_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evaluation_utc": { "type": "string", "format": "date-time" },
    "trade_identity_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "environment": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string" },
    "instrument_identity": { "$ref": "#/$defs/instrument_identity" },
    "ownership_classification": {
      "type": "string",
      "enum": [
        "CONSTELLATION_OWNED",
        "FOREIGN_MANUAL",
        "AMBIGUOUS_OWNERSHIP",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "ownership_reason_codes": { "$ref": "#/$defs/string_array" },
    "lineage_attachment_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_ids", "perm_ids", "execution_ids", "fact_record_ids"],
      "properties": {
        "order_ids": { "$ref": "#/$defs/string_array" },
        "perm_ids": { "$ref": "#/$defs/string_array" },
        "execution_ids": { "$ref": "#/$defs/string_array" },
        "fact_record_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "open_close_continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity_key",
        "segment_index",
        "continuity_status",
        "opened_by_fact_record_id",
        "closed_by_fact_record_id"
      ],
      "properties": {
        "continuity_key": { "type": "string", "minLength": 1 },
        "segment_index": { "type": "integer", "minimum": 1 },
        "continuity_status": { "type": "string", "enum": ["OPEN", "CLOSED", "UNRESOLVED"] },
        "opened_by_fact_record_id": { "type": "string" },
        "closed_by_fact_record_id": { "type": "string" }
      }
    },
    "ambiguity_state": {
      "type": "string",
      "enum": [
        "NONE",
        "TRADE_IDENTITY_UNRESOLVED",
        "OWNERSHIP_AMBIGUOUS",
        "ACCOUNT_MISMATCH",
        "INSTRUMENT_IDENTITY_UNRESOLVED",
        "LINEAGE_UNRESOLVED"
      ]
    },
    "blocker_state": { "type": "string", "enum": ["CLEAR", "BLOCKED"] },
    "blocker_codes": { "$ref": "#/$defs/string_array" },
    "derived_only": { "const": false }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "instrument_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "sec_type", "exchange", "currency", "raw_summary"],
      "properties": {
        "symbol": { "type": "string" },
        "sec_type": { "type": "string" },
        "exchange": { "type": "string" },
        "currency": { "type": "string" },
        "raw_summary": { "type": "string" }
      }
    }
  }
}

