{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/advisor_bridge/promotion_record.v2.schema.json",
  "title": "promotion_record.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "produced_utc",
    "run_id",
    "promotion_record_id",
    "household_id",
    "portfolio_intent_id",
    "promotion_decision_id",
    "parent_lineage_refs",
    "approved_delta",
    "blocked_scope",
    "reason_codes",
    "status",
    "idempotency_key",
    "timestamp_utc",
    "validity_status",
    "source_artifact_refs",
    "notes"
  ],
  "properties": {
    "schema_id": { "const": "promotion_record" },
    "schema_version": { "const": "v2" },
    "produced_utc": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "promotion_record_id": { "type": "string", "minLength": 1 },
    "household_id": { "type": "string", "minLength": 1 },
    "portfolio_intent_id": { "type": "string", "minLength": 1 },
    "promotion_decision_id": { "type": "string", "minLength": 1 },
    "parent_lineage_refs": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "approved_delta": {
      "type": "array",
      "items": { "$ref": "#/$defs/approved_delta_entry" }
    },
    "blocked_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["AUTHORIZED", "NO_ACTION", "BLOCKED", "SUPERSEDED"]
    },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "timestamp_utc": { "type": "string", "minLength": 1 },
    "validity_status": { "type": "string", "enum": ["VALID", "INVALID_BLOCKED", "INVALID_NO_ACTION", "INVALID_SUPERSEDED"] },
    "source_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "approved_delta_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "account_id",
        "environment",
        "sleeve_id",
        "operation_type",
        "engine_id",
        "instrument",
        "side",
        "quantity_shares",
        "order_terms",
        "reason_codes",
        "detail_refs"
      ],
      "properties": {
        "change_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
        "sleeve_id": { "type": "string", "minLength": 1 },
        "operation_type": { "type": "string", "minLength": 1 },
        "engine_id": { "type": "string", "minLength": 1 },
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "symbol", "currency", "ib_conId", "ib_localSymbol"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "currency": { "type": "string", "minLength": 1 },
            "ib_conId": { "type": ["integer", "null"] },
            "ib_localSymbol": { "type": ["string", "null"] }
          }
        },
        "side": { "type": "string", "enum": ["BUY", "SELL"] },
        "quantity_shares": { "type": "integer", "minimum": 1 },
        "order_terms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order_type", "limit_price", "time_in_force"],
          "properties": {
            "order_type": { "type": "string", "enum": ["LIMIT", "MARKET"] },
            "limit_price": { "type": ["string", "null"] },
            "time_in_force": { "type": "string", "enum": ["DAY", "GTC"] }
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "detail_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
