{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "C2_EXPOSURE_LEDGER_V1",
  "title": "C2 Exposure Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "position_id",
    "binding_hash",
    "submission_id",
    "engine_id",
    "canonical_sleeve_id",
    "source_intent_id",
    "intent_hash",
    "authorization_ledger_ref",
    "fill_ledger_ref",
    "position_snapshot_ref",
    "qty",
    "avg_cost_cents",
    "status",
    "reason_codes"
  ],
  "properties": {
    "schema_id": { "const": "C2_EXPOSURE_LEDGER_V1" },
    "schema_version": { "type": "integer", "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "position_id": { "type": "string", "minLength": 1 },
    "binding_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "submission_id": { "type": "string", "minLength": 1 },
    "engine_id": { "type": "string", "minLength": 1 },
    "canonical_sleeve_id": { "type": "string", "minLength": 1 },
    "source_intent_id": { "type": "string", "minLength": 1 },
    "intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorization_ledger_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "fill_ledger_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "position_snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "qty": { "type": "integer" },
    "avg_cost_cents": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "minLength": 1 },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
