{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/advisor_execution/blocked_action.v1.schema.json",
  "title": "blocked_action.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "plan_id",
    "recommendation_id",
    "domain_id",
    "action_type",
    "support_status",
    "blockers",
    "rationale_refs",
    "evidence_refs",
    "created_at",
    "version"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "recommendation_id": {
      "type": "string",
      "minLength": 1
    },
    "domain_id": {
      "type": "string",
      "enum": [
        "liquidity",
        "withdrawal",
        "tax",
        "annuity"
      ]
    },
    "action_type": {
      "type": "string",
      "enum": [
        "raise_cash_reserve",
        "withdraw_from_taxable",
        "hold_annuity",
        "collect_missing_input"
      ]
    },
    "support_status": {
      "type": "string",
      "enum": [
        "blocked"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "const": "v1"
    }
  }
}
