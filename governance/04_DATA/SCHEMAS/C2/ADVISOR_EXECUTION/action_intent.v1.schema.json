{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/advisor_execution/action_intent.v1.schema.json",
  "title": "action_intent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "action_intent_id",
    "planning_snapshot_id",
    "advisory_packet_id",
    "policy_pack_id",
    "actions",
    "blocked_actions",
    "replan_triggers",
    "version"
  ],
  "properties": {
    "schema_id": {
      "const": "action_intent"
    },
    "schema_version": {
      "const": "v1"
    },
    "action_intent_id": {
      "type": "string",
      "minLength": 1
    },
    "planning_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "advisory_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://constellation.local/schemas/c2/advisor_execution/decision_action.v1.schema.json",
        "title": "decision_action.v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "plan_id",
          "recommendation_id",
          "domain_id",
          "action_type",
          "action_status",
          "support_status",
          "priority",
          "source_account",
          "destination_account",
          "annual_amount",
          "periodic_amount",
          "periodicity",
          "constraints",
          "blockers",
          "rationale_refs",
          "evidence_refs",
          "created_at",
          "version"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "recommendation_id": {
            "type": "string",
            "minLength": 1
          },
          "domain_id": {
            "type": "string",
            "enum": [
              "liquidity",
              "withdrawal",
              "tax",
              "annuity"
            ]
          },
          "action_type": {
            "type": "string",
            "enum": [
              "raise_cash_reserve",
              "withdraw_from_taxable",
              "hold_annuity",
              "collect_missing_input"
            ]
          },
          "action_status": {
            "type": "string",
            "enum": [
              "planned",
              "blocked"
            ]
          },
          "support_status": {
            "type": "string",
            "enum": [
              "fully_supported",
              "degraded",
              "provisional",
              "blocked"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "source_account": {
            "type": [
              "string",
              "null"
            ]
          },
          "destination_account": {
            "type": [
              "string",
              "null"
            ]
          },
          "annual_amount": {
            "type": "integer",
            "minimum": 0
          },
          "periodic_amount": {
            "type": "integer",
            "minimum": 0
          },
          "periodicity": {
            "type": "string",
            "enum": [
              "annual",
              "monthly",
              "none"
            ]
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "const": "v1"
          }
        }
      }
    },
    "blocked_actions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://constellation.local/schemas/c2/advisor_execution/blocked_action.v1.schema.json",
        "title": "blocked_action.v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "plan_id",
          "recommendation_id",
          "domain_id",
          "action_type",
          "support_status",
          "blockers",
          "rationale_refs",
          "evidence_refs",
          "created_at",
          "version"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "recommendation_id": {
            "type": "string",
            "minLength": 1
          },
          "domain_id": {
            "type": "string",
            "enum": [
              "liquidity",
              "withdrawal",
              "tax",
              "annuity"
            ]
          },
          "action_type": {
            "type": "string",
            "enum": [
              "raise_cash_reserve",
              "withdraw_from_taxable",
              "hold_annuity",
              "collect_missing_input"
            ]
          },
          "support_status": {
            "type": "string",
            "enum": [
              "blocked"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "const": "v1"
          }
        }
      }
    },
    "replan_triggers": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://constellation.local/schemas/c2/advisor_execution/replan_trigger_rule.v1.schema.json",
        "title": "replan_trigger_rule.v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger_id",
          "trigger_type",
          "description"
        ],
        "properties": {
          "trigger_id": {
            "type": "string",
            "minLength": 1
          },
          "trigger_type": {
            "type": "string",
            "enum": [
              "market_drawdown",
              "spending_deviation",
              "tax_profile_update",
              "employment_change"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "version": {
      "type": "string",
      "const": "v1"
    }
  }
}
