          "$ref": "#/$defs/policy"
        }
      },
      "required": [
        "C2_CROSS_ASSET_TREND_V1",
        "C2_DEFENSIVE_TAIL_V1",
        "C2_EVENT_DISLOCATION_V1",
        "C2_MARKET_NEUTRAL_SPREAD_V1",
