{
  "$defs": {
    "policy": {
      "additionalProperties": false,
      "properties": {
        "allow_entry_only_paper_test": {
          "const": false,
          "type": "boolean"
        },
        "broker_execution_allowed": {
          "const": false,
          "type": "boolean"
        },
        "capital_allocation_allowed": {
          "const": false,
          "type": "boolean"
        },
        "contract_ref": {
          "minLength": 1,
          "type": "string"
        },
        "estimated_notional_risk_pct_method": {
          "const": "max_loss_estimate_over_suggested_notional",
          "type": "string"
        },
        "expected_holding_days_default": {
          "minimum": 1,
          "type": "integer"
        },
        "hard_stop": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": true,
              "type": "boolean"
            },
            "long_formula": {
              "minLength": 1,
              "type": "string"
            },
            "rounding": {
              "const": "currency_cents_half_up",
              "type": "string"
            },
            "short_formula": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "long_formula",
            "short_formula",
            "rounding"
          ],
          "type": "object"
        },
        "invalidation_policy": {
          "additionalProperties": false,
          "properties": {
            "policy_id": {
              "minLength": 1,
              "type": "string"
            },
            "rules": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "expected_holding_days": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "rule_id": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "rule_id",
                  "description"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "policy_id",
            "rules"
          ],
          "type": "object"
        },
        "live_trading_allowed": {
          "const": false,
          "type": "boolean"
        },
        "order_routing_allowed": {
          "const": false,
          "type": "boolean"
        },
        "paper_only_today": {
          "const": true,
          "type": "boolean"
        },
        "paper_submit_allowed": {
          "const": false,
          "type": "boolean"
        },
        "per_trade_notional_pct_max": {
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "type": "string"
        },
        "risk_estimate_method": {
          "const": "entry_minus_stop_times_quantity",
          "type": "string"
        },
        "stop_loss_bps_default": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "target_notional_pct_default": {
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "contract_ref",
        "target_notional_pct_default",
        "per_trade_notional_pct_max",
        "stop_loss_bps_default",
        "expected_holding_days_default",
        "risk_estimate_method",
        "estimated_notional_risk_pct_method",
        "hard_stop",
        "invalidation_policy",
        "allow_entry_only_paper_test",
        "paper_only_today",
        "broker_execution_allowed",
        "live_trading_allowed",
        "order_routing_allowed",
        "capital_allocation_allowed",
        "paper_submit_allowed"
