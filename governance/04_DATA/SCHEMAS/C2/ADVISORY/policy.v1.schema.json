{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/advisory/policy.v1.schema.json",
  "title": "policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "policy_id",
    "parent_intent_id",
    "household_id",
    "policy_version",
    "created_at",
    "effective_at",
    "actor_source",
    "timestamp_basis",
    "contract_version",
    "compiler_version",
    "policy_fingerprint",
    "assumption_manifest_refs",
    "regime_rule_refs",
    "parent_lineage_refs",
    "suitability_profile",
    "liquidity_floor_rules",
    "concentration_cap_rules",
    "allowed_exposure_rules",
    "prohibited_exposure_rules",
    "account_treatment_rules",
    "rebalance_philosophy",
    "promotion_gate_rules",
    "allocation_policy_mode",
    "allocation_targets",
    "rebalance_threshold",
    "minimum_trade_value_cents",
    "automation_permissions",
    "approval_requirements",
    "policy_completeness_status",
    "validity_tier",
    "reason_codes",
    "unresolved_fields"
  ],
  "properties": {
    "schema_id": { "const": "policy" },
    "schema_version": { "const": "v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "parent_intent_id": { "type": "string", "minLength": 1 },
    "household_id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "effective_at": { "type": "string", "minLength": 1 },
    "actor_source": { "type": "string", "minLength": 1 },
    "timestamp_basis": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "minLength": 1 },
    "compiler_version": { "type": "string", "minLength": 1 },
    "policy_fingerprint": { "type": "string", "minLength": 1 },
    "assumption_manifest_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "regime_rule_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "parent_lineage_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "suitability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_profile", "liquidity_profile", "time_horizon", "operating_mode"],
      "properties": {
        "risk_profile": { "type": "string", "minLength": 1 },
        "liquidity_profile": { "type": "string", "minLength": 1 },
        "time_horizon": { "type": "string", "minLength": 1 },
        "operating_mode": { "type": "string", "minLength": 1 }
      }
    },
    "liquidity_floor_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "concentration_cap_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_exposure_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibited_exposure_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "account_treatment_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rebalance_philosophy": { "type": "string", "minLength": 1 },
    "promotion_gate_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allocation_policy_mode": {
      "type": "string",
      "enum": ["EXIT_ONLY", "TARGET_WEIGHTS"]
    },
    "allocation_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "asset_type", "currency", "target_weight"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "asset_type": { "type": "string", "enum": ["EQUITY", "CASH"] },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
          "target_weight": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rebalance_threshold": { "type": ["string", "null"] },
    "minimum_trade_value_cents": { "type": ["integer", "null"], "minimum": 1 },
    "automation_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_mode", "requires_explicit_approval"],
      "properties": {
        "automation_mode": { "type": "string", "minLength": 1 },
        "requires_explicit_approval": { "type": "boolean" }
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "policy_completeness_status": {
      "type": "string",
      "enum": ["VALID", "INVALID_REMEDIABLE", "INVALID_HARD_STOP"]
    },
    "validity_tier": {
      "type": "string",
      "enum": ["VALID_ADVISORY_ONLY", "INVALID_REMEDIABLE", "INVALID_HARD_STOP"]
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
