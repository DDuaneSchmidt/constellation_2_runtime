{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/advisory/assumption_manifest.v1.schema.json",
  "title": "assumption_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "assumption_manifest_id",
    "manifest_version",
    "manifest_type",
    "created_at",
    "effective_at",
    "actor_source",
    "timestamp_basis",
    "contract_version",
    "compatible_compiler_versions",
    "assumption_payload",
    "reason_codes",
    "status"
  ],
  "properties": {
    "schema_id": { "const": "assumption_manifest" },
    "schema_version": { "const": "v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "assumption_manifest_id": { "type": "string", "minLength": 1 },
    "manifest_version": { "type": "string", "minLength": 1 },
    "manifest_type": {
      "type": "string",
      "enum": ["policy_rule_interpretation"]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "effective_at": { "type": "string", "minLength": 1 },
    "actor_source": { "type": "string", "minLength": 1 },
    "timestamp_basis": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "minLength": 1 },
    "compatible_compiler_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "assumption_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_exposure_rules_by_risk",
        "concentration_cap_rules_by_preference",
        "liquidity_floor_rules_by_requirement",
        "rebalance_philosophy_by_operating_mode",
        "promotion_gate_rules_by_operating_mode"
      ],
      "properties": {
        "allowed_exposure_rules_by_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conservative", "balanced", "growth"],
          "properties": {
            "conservative": { "$ref": "#/$defs/rule_list" },
            "balanced": { "$ref": "#/$defs/rule_list" },
            "growth": { "$ref": "#/$defs/rule_list" }
          }
        },
        "concentration_cap_rules_by_preference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diversified", "moderate", "concentrated"],
          "properties": {
            "diversified": { "$ref": "#/$defs/rule_list" },
            "moderate": { "$ref": "#/$defs/rule_list" },
            "concentrated": { "$ref": "#/$defs/rule_list" }
          }
        },
        "liquidity_floor_rules_by_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "moderate", "high"],
          "properties": {
            "low": { "$ref": "#/$defs/rule_list" },
            "moderate": { "$ref": "#/$defs/rule_list" },
            "high": { "$ref": "#/$defs/rule_list" }
          }
        },
        "rebalance_philosophy_by_operating_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["advisory_only", "manual_execution_only", "automation_allowed"],
          "properties": {
            "advisory_only": { "type": "string", "minLength": 1 },
            "manual_execution_only": { "type": "string", "minLength": 1 },
            "automation_allowed": { "type": "string", "minLength": 1 }
          }
        },
        "promotion_gate_rules_by_operating_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["advisory_only", "manual_execution_only", "automation_allowed"],
          "properties": {
            "advisory_only": { "$ref": "#/$defs/rule_list" },
            "manual_execution_only": { "$ref": "#/$defs/rule_list" },
            "automation_allowed": { "$ref": "#/$defs/rule_list" }
          }
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supersedes_manifest_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "SUPERSEDED", "INVALID_HARD_STOP"]
    }
  },
  "$defs": {
    "rule_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
