{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/advisory/portfolio_intent.v1.schema.json",
  "title": "portfolio_intent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "portfolio_intent_id",
    "household_id",
    "parent_policy_id",
    "parent_household_snapshot_id",
    "intent_version",
    "created_at",
    "effective_at",
    "actor_source",
    "timestamp_basis",
    "contract_version",
    "builder_version",
    "parent_lineage_refs",
    "classification_refs",
    "target_allocation",
    "current_allocation_summary",
    "current_value_allocation",
    "allocation_drift",
    "required_directional_changes",
    "blocked_conditions",
    "constrained_deviations",
    "action_needed",
    "execution_eligibility",
    "validity_tier",
    "reason_codes",
    "input_record_refs",
    "portfolio_intent_fingerprint"
  ],
  "properties": {
    "schema_id": { "const": "portfolio_intent" },
    "schema_version": { "const": "v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "portfolio_intent_id": { "type": "string", "minLength": 1 },
    "household_id": { "type": "string", "minLength": 1 },
    "parent_policy_id": { "type": "string", "minLength": 1 },
    "parent_household_snapshot_id": { "type": "string", "minLength": 1 },
    "intent_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "effective_at": { "type": "string", "minLength": 1 },
    "actor_source": { "type": "string", "minLength": 1 },
    "timestamp_basis": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "minLength": 1 },
    "builder_version": { "type": "string", "minLength": 1 },
    "parent_lineage_refs": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "classification_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "target_allocation": {
      "oneOf": [
        { "$ref": "#/$defs/exit_only_target_allocation" },
        { "$ref": "#/$defs/value_target_allocation" }
      ]
    },
    "current_allocation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_open_position_count",
        "verified_defined_risk_position_count",
        "verified_undefined_risk_position_count",
        "unverified_external_holding_count",
        "verified_cash_total_cents",
        "verified_available_funds_total_cents",
        "verified_excess_liquidity_total_cents",
        "verified_cash_account_count",
        "accounts"
      ],
      "properties": {
        "verified_open_position_count": { "type": "integer", "minimum": 0 },
        "verified_defined_risk_position_count": { "type": "integer", "minimum": 0 },
        "verified_undefined_risk_position_count": { "type": "integer", "minimum": 0 },
        "unverified_external_holding_count": { "type": "integer", "minimum": 0 },
        "verified_cash_total_cents": { "type": "integer" },
        "verified_available_funds_total_cents": { "type": ["integer", "null"] },
        "verified_excess_liquidity_total_cents": { "type": ["integer", "null"] },
        "verified_cash_account_count": { "type": "integer", "minimum": 0 },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/current_account_summary" }
        }
      }
    },
    "current_value_allocation": {
      "$ref": "#/$defs/current_value_allocation"
    },
    "allocation_drift": {
      "$ref": "#/$defs/allocation_drift"
    },
    "required_directional_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change_entry" }
    },
    "blocked_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition_entry" }
    },
    "constrained_deviations": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation_entry" }
    },
    "action_needed": { "type": "boolean" },
    "execution_eligibility": {
      "type": "string",
      "enum": ["EXECUTION_ELIGIBLE", "ADVISORY_ONLY", "BLOCKED"]
    },
    "validity_tier": {
      "type": "string",
      "enum": [
        "VALID_EXECUTION_ELIGIBLE",
        "VALID_ADVISORY_ONLY",
        "INVALID_REMEDIABLE",
        "INVALID_HARD_STOP"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_record_refs": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "portfolio_intent_fingerprint": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "exit_only_target_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_mode",
        "rebalance_philosophy",
        "liquidity_floor_rules",
        "concentration_cap_rules",
        "allowed_exposure_rules",
        "prohibited_exposure_rules",
        "account_treatment_rules",
        "target_accounts"
      ],
      "properties": {
        "construction_mode": { "type": "string", "minLength": 1 },
        "rebalance_philosophy": { "type": "string", "minLength": 1 },
        "liquidity_floor_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "concentration_cap_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "allowed_exposure_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "prohibited_exposure_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "account_treatment_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "target_accounts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target_account_summary" }
        }
      }
    },
    "value_target_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_mode",
        "rebalance_philosophy",
        "allocation_policy_mode",
        "rebalance_threshold",
        "minimum_trade_value_cents",
        "targets"
      ],
      "properties": {
        "construction_mode": { "type": "string", "minLength": 1 },
        "rebalance_philosophy": { "type": "string", "minLength": 1 },
        "allocation_policy_mode": { "type": "string", "minLength": 1 },
        "rebalance_threshold": { "type": "string", "minLength": 1 },
        "minimum_trade_value_cents": { "type": "integer", "minimum": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/value_allocation_entry" }
        }
      }
    },
    "current_value_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allocation_policy_mode",
        "value_basis_id",
        "valuation_mode",
        "effective_at",
        "total_portfolio_value_cents",
        "total_cash_value_cents",
        "total_position_value_cents",
        "allocations",
        "reason_codes"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["DISABLED", "BLOCKED", "READY"] },
        "allocation_policy_mode": { "type": "string", "minLength": 1 },
        "value_basis_id": { "type": ["string", "null"] },
        "valuation_mode": { "type": ["string", "null"] },
        "effective_at": { "type": ["string", "null"] },
        "total_portfolio_value_cents": { "type": ["integer", "null"], "minimum": 0 },
        "total_cash_value_cents": { "type": ["integer", "null"], "minimum": 0 },
        "total_position_value_cents": { "type": ["integer", "null"], "minimum": 0 },
        "allocations": {
          "type": "array",
          "items": { "$ref": "#/$defs/value_allocation_entry" }
        },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "allocation_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "drift_metric",
        "max_abs_drift_weight",
        "drift_entries",
        "reason_codes"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["DISABLED", "BLOCKED", "READY"] },
        "drift_metric": { "type": "string", "minLength": 1 },
        "max_abs_drift_weight": { "type": ["string", "null"] },
        "drift_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/drift_entry" }
        },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "value_allocation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "asset_type", "currency", "value_cents", "weight"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "asset_type": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 },
        "value_cents": { "type": "integer", "minimum": 0 },
        "weight": { "type": "string", "minLength": 1 },
        "reference_price_cents": { "type": ["integer", "null"], "minimum": 1 },
        "current_quantity_shares": { "type": ["integer", "null"], "minimum": 0 },
        "routing_account_id": { "type": ["string", "null"] }
      }
    },
    "drift_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_id",
        "symbol",
        "asset_type",
        "currency",
        "current_value_cents",
        "target_value_cents",
        "delta_value_cents",
        "current_weight",
        "target_weight",
        "drift_weight",
        "reference_price_cents",
        "routing_account_id"
      ],
      "properties": {
        "drift_id": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "asset_type": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 },
        "current_value_cents": { "type": "integer", "minimum": 0 },
        "target_value_cents": { "type": "integer", "minimum": 0 },
        "delta_value_cents": { "type": "integer" },
        "current_weight": { "type": "string", "minLength": 1 },
        "target_weight": { "type": "string", "minLength": 1 },
        "drift_weight": { "type": "string", "minLength": 1 },
        "reference_price_cents": { "type": ["integer", "null"], "minimum": 1 },
        "routing_account_id": { "type": ["string", "null"] }
      }
    },
    "target_account_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "scope_role",
        "target_verified_position_ids",
        "target_verified_cash_total_cents",
        "unverified_external_components_in_scope"
      ],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "scope_role": { "type": "string", "minLength": 1 },
        "target_verified_position_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "target_verified_cash_total_cents": { "type": ["integer", "null"] },
        "unverified_external_components_in_scope": { "type": "boolean" }
      }
    },
    "current_account_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "scope_role",
        "verified_open_position_count",
        "verified_cash_total_cents",
        "unverified_external_holding_count"
      ],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "scope_role": { "type": "string", "minLength": 1 },
        "verified_open_position_count": { "type": "integer", "minimum": 0 },
        "verified_cash_total_cents": { "type": ["integer", "null"] },
        "unverified_external_holding_count": { "type": "integer", "minimum": 0 }
      }
    },
    "change_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "change_code", "account_id", "direction", "side", "quantity_shares", "instrument", "reason_codes", "detail_refs"],
      "properties": {
        "change_id": { "type": "string", "minLength": 1 },
        "change_code": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 },
        "side": { "type": "string", "enum": ["BUY", "SELL"] },
        "quantity_shares": { "type": "integer", "minimum": 1 },
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "symbol", "currency", "ib_conId", "ib_localSymbol"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "currency": { "type": "string", "minLength": 1 },
            "ib_conId": { "type": ["integer", "null"] },
            "ib_localSymbol": { "type": ["string", "null"] }
          }
        },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "detail_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "condition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_code", "reason_codes", "detail_refs"],
      "properties": {
        "condition_code": { "type": "string", "minLength": 1 },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "detail_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "deviation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_code", "reason_codes", "detail_refs"],
      "properties": {
        "deviation_code": { "type": "string", "minLength": 1 },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "detail_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
