{
  "$id": "https://constellation.local/governance/schemas/c2/options/exposure_to_options_intent_policy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 Exposure to Options Intent Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "engine_policies"
  ],
  "properties": {
    "schema_id": {
      "const": "c2_exposure_to_options_intent_policy"
    },
    "schema_version": {
      "const": "v1"
    },
    "engine_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "exposure_requirements",
          "options_template"
        ],
        "properties": {
          "engine_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "exposure_requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exposure_type",
              "required_engine_suite",
              "required_option_structure",
              "required_option_direction",
              "allowed_target_notional_pct",
              "allowed_expected_holding_days",
              "allowed_risk_class"
            ],
            "properties": {
              "exposure_type": {
                "type": "string",
                "enum": [
                  "SHORT_VOL_DEFINED"
                ]
              },
              "required_engine_suite": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "required_option_structure": {
                "type": "string",
                "enum": [
                  "PUT",
                  "CALL"
                ]
              },
              "required_option_direction": {
                "type": "string",
                "enum": [
                  "BUY",
                  "SELL"
                ]
              },
              "allowed_target_notional_pct": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
                }
              },
              "allowed_expected_holding_days": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 365
                }
              },
              "allowed_risk_class": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "options_template": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "suite",
              "strategy",
              "risk",
              "exit_policy",
              "selection_policy"
            ],
            "properties": {
              "suite": {
                "type": "string",
                "enum": [
                  "C2_OPTIONS_7"
                ]
              },
              "strategy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "structure",
                  "right",
                  "direction"
                ],
                "properties": {
                  "structure": {
                    "type": "string",
                    "enum": [
                      "VERTICAL_SPREAD"
                    ]
                  },
                  "right": {
                    "type": "string",
                    "enum": [
                      "PUT",
                      "CALL"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "CREDIT",
                      "DEBIT"
                    ]
                  }
                }
              },
              "risk": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_risk_usd",
                  "max_contracts",
                  "multiplier"
                ],
                "properties": {
                  "max_risk_usd": {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?$"
                  },
                  "max_contracts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "multiplier": {
                    "type": "integer",
                    "enum": [
                      100
                    ]
                  }
                }
              },
              "exit_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "policy_id",
                  "profit_target",
                  "stop_loss",
                  "time_exit",
                  "regime_exit"
                ],
                "properties": {
                  "policy_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "profit_target": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "enabled",
                      "take_profit_pct"
                    ],
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "take_profit_pct": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      }
                    }
                  },
                  "stop_loss": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "enabled",
                      "stop_loss_pct"
                    ],
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "stop_loss_pct": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    }
                  },
                  "time_exit": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "enabled",
                      "max_holding_days"
                    ],
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "max_holding_days": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 365
                      }
                    }
                  },
                  "regime_exit": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "enabled",
                      "regime_blocklist"
                    ],
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "regime_blocklist": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      }
                    }
                  }
                }
              },
              "selection_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expiry_policy",
                  "width_policy",
                  "liquidity_policy",
                  "pricing_policy"
                ],
                "properties": {
                  "expiry_policy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "target_dte_min",
                      "target_dte_max"
                    ],
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "DTE_WINDOW"
                        ]
                      },
                      "target_dte_min": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3650
                      },
                      "target_dte_max": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3650
                      }
                    }
                  },
                  "width_policy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "width_points"
                    ],
                    "properties": {
                      "width_points": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$"
                      }
                    }
                  },
                  "liquidity_policy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min_open_interest",
                      "min_volume",
                      "max_bid_ask_spread"
                    ],
                    "properties": {
                      "min_open_interest": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "min_volume": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max_bid_ask_spread": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$"
                      }
                    }
                  },
                  "pricing_policy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "limit_offset",
                      "tick_rounding"
                    ],
                    "properties": {
                      "limit_offset": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$"
                      },
                      "tick_rounding": {
                        "type": "string",
                        "enum": [
                          "ROUND_DOWN",
                          "ROUND_UP",
                          "ROUND_NEAREST"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "canonical_json_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
