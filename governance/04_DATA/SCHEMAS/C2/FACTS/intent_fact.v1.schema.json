{
  "schema_id": "C2_FACT_INTENT_SCHEMA_V1",
  "title": "C2 Intent Fact V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "intent_sha256",
    "source_intent_id",
    "engine_id",
    "symbol",
    "day_utc",
    "target_notional_pct",
    "source_intent_path",
    "producer",
    "producer_git_sha",
    "generated_at_utc"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "intent_fact.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "intent_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_intent_id": { "type": "string", "minLength": 1 },
    "engine_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 10, "maxLength": 10 },
    "target_notional_pct": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "source_intent_path": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "producer_git_sha": { "type": "string", "minLength": 7, "maxLength": 64 },
    "generated_at_utc": { "type": "string", "minLength": 11 }
  }
}
