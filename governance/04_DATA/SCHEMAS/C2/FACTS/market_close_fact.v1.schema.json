{
  "schema_id": "C2_FACT_MARKET_CLOSE_SCHEMA_V1",
  "title": "C2 Market Close Fact V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "symbol",
    "day_utc",
    "timestamp_utc",
    "close",
    "source_snapshot_path",
    "producer",
    "producer_git_sha",
    "generated_at_utc"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "market_close_fact.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
    "day_utc": { "type": "string", "minLength": 10, "maxLength": 10 },
    "timestamp_utc": { "type": "string", "minLength": 11 },
    "close": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "source_snapshot_path": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "producer_git_sha": { "type": "string", "minLength": 7, "maxLength": 64 },
    "generated_at_utc": { "type": "string", "minLength": 11 }
  }
}
