{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/tax/accepted_tax_fact.v1.schema.json",
  "title": "accepted_tax_fact.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "accepted_fact_id", "candidate_id", "fact_family", "truth_state", "scope_ids", "effective_at", "recorded_at", "payload", "reason_codes"],
  "properties": {
    "schema_id": { "const": "accepted_tax_fact" },
    "schema_version": { "const": "v1" },
    "accepted_fact_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "fact_family": { "type": "string", "minLength": 1 },
    "truth_state": { "type": "string", "enum": ["accepted", "provisional", "restricted_use", "corrected"] },
    "scope_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "effective_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "supersedes_fact_id": { "type": "string" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

