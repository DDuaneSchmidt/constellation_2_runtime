{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/tax/tax_fact_candidate.v1.schema.json",
  "title": "tax_fact_candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "candidate_id", "observed_event_id", "fact_family", "truth_state", "scope_ids", "effective_at", "recorded_at", "normalized_payload", "reason_codes"],
  "properties": {
    "schema_id": { "const": "tax_fact_candidate" },
    "schema_version": { "const": "v1" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "observed_event_id": { "type": "string", "minLength": 1 },
    "fact_family": { "type": "string", "minLength": 1 },
    "truth_state": { "const": "candidate" },
    "scope_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "effective_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "normalized_payload": { "type": "object" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

