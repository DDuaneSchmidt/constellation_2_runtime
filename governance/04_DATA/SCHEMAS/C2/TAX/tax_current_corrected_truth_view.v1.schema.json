{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/tax/tax_current_corrected_truth_view.v1.schema.json",
  "title": "tax_current_corrected_truth_view.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "view_id", "decision_id", "scope_id", "snapshot_id", "accepted_fact_ids", "accepted_fact_set_hash", "produced_utc", "reason_codes"],
  "properties": {
    "schema_id": { "const": "tax_current_corrected_truth_view" },
    "schema_version": { "const": "v1" },
    "view_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "accepted_fact_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "accepted_fact_set_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
