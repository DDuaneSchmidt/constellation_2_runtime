{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/tax/tax_scope_registry.v1.schema.json",
  "title": "tax_scope_registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "registry_id", "produced_utc", "scope_records"],
  "properties": {
    "schema_id": { "const": "tax_scope_registry" },
    "schema_version": { "const": "v1" },
    "registry_id": { "type": "string", "minLength": 1 },
    "produced_utc": { "type": "string", "format": "date-time" },
    "scope_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "scope_type", "parent_scope_ids", "member_refs"],
        "properties": {
          "scope_id": { "type": "string", "minLength": 1 },
          "scope_type": {
            "type": "string",
            "enum": ["operator_scope", "legal_owner_scope", "filing_scope", "wash_enforcement_scope", "advisory_scope"]
          },
          "parent_scope_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "member_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}

