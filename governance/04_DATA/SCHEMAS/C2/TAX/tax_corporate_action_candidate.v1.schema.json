{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/tax/tax_corporate_action_candidate.v1.schema.json",
  "title": "tax_corporate_action_candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "candidate_id", "observed_event_id", "action_key", "scope_ids", "security_id", "action_class", "support_status", "truth_state", "effective_at", "normalized_payload", "reason_codes"],
  "properties": {
    "schema_id": { "const": "tax_corporate_action_candidate" },
    "schema_version": { "const": "v1" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "observed_event_id": { "type": "string", "minLength": 1 },
    "action_key": { "type": "string", "minLength": 1 },
    "scope_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "security_id": { "type": "string", "minLength": 1 },
    "action_class": { "type": "string", "minLength": 1 },
    "support_status": { "type": "string", "enum": ["supported", "deferred"] },
    "truth_state": { "const": "candidate" },
    "effective_at": { "type": "string", "format": "date-time" },
    "normalized_payload": { "type": "object" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
