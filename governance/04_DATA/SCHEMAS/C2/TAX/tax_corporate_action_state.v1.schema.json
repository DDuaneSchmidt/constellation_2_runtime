{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/tax/tax_corporate_action_state.v1.schema.json",
  "title": "tax_corporate_action_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "state_id", "scope_id", "as_of_effective_at", "actions", "restriction_flags", "reason_codes"],
  "properties": {
    "schema_id": { "const": "tax_corporate_action_state" },
    "schema_version": { "const": "v1" },
    "state_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "as_of_effective_at": { "type": "string", "format": "date-time" },
    "actions": { "type": "array", "items": { "type": "object" } },
    "restriction_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
