{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/tax/tax_fact_acceptance_decision.v1.schema.json",
  "title": "tax_fact_acceptance_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "decision_id", "candidate_id", "fact_family", "scope_id", "decision_status", "fact_state", "produced_utc", "reason_codes"],
  "properties": {
    "schema_id": { "const": "tax_fact_acceptance_decision" },
    "schema_version": { "const": "v1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "fact_family": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "decision_status": { "type": "string", "enum": ["accept", "reject", "restrict", "provisional"] },
    "fact_state": { "type": "string", "enum": ["accepted", "provisional", "rejected", "restricted_use"] },
    "produced_utc": { "type": "string", "format": "date-time" },
    "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}

