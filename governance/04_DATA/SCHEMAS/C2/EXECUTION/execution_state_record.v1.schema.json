{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/execution/execution_state_record.v1.schema.json",
  "title": "execution_state_record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "execution_state_record_id",
    "submission_record_id",
    "submission_id",
    "execution_intent_id",
    "day_utc",
    "produced_utc",
    "contract_version",
    "current_state",
    "lifecycle_status",
    "source_lifecycle_status",
    "terminal_state",
    "transition_index",
    "previous_execution_state_record_id",
    "evidence_basis",
    "evidence_fingerprint",
    "filled_qty",
    "broker_submission_ref",
    "reason_codes",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "execution_state_record" },
    "schema_version": { "const": "v1" },
    "record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_state_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "submission_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "submission_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_intent_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "contract_version": { "type": "string", "minLength": 1 },
    "current_state": { "type": "string", "enum": ["RECORDED"] },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "HANDOFF_ENTERED",
        "UNKNOWN",
        "PENDINGSUBMIT",
        "PRESUBMITTED",
        "SUBMITTED",
        "ACKNOWLEDGED",
        "OPEN",
        "PARTIALLY_FILLED",
        "FILLED",
        "REJECTED",
        "CANCELLED",
        "INACTIVE"
      ]
    },
    "source_lifecycle_status": { "type": ["string", "null"] },
    "terminal_state": { "type": "boolean" },
    "transition_index": { "type": "integer", "minimum": 0 },
    "previous_execution_state_record_id": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "evidence_basis": {
      "type": "string",
      "enum": ["HANDOFF_ATTEMPT", "BROKER_SUBMISSION_RECORD", "EXECUTION_EVENT_RECORD", "FILL_LEDGER"]
    },
    "evidence_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "broker_order_id": { "type": ["string", "null"] },
    "perm_id": { "type": ["string", "null"] },
    "filled_qty": { "type": "integer", "minimum": 0 },
    "remaining_qty": { "type": ["integer", "null"], "minimum": 0 },
    "avg_fill_price": { "type": ["string", "null"] },
    "broker_submission_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "execution_event_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fill_ledger_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
