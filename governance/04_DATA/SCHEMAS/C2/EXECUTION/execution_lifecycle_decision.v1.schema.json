{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/execution/execution_lifecycle_decision.v1.schema.json",
  "title": "execution_lifecycle_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "execution_lifecycle_decision_id",
    "lifecycle_input_id",
    "submission_record_id",
    "submission_id",
    "execution_intent_id",
    "day_utc",
    "produced_utc",
    "contract_version",
    "outcome",
    "current_execution_state_record_id",
    "candidate_lifecycle_status",
    "candidate_source_lifecycle_status",
    "candidate_terminal_state",
    "evidence_basis",
    "evidence_fingerprint",
    "next_transition_index",
    "candidate_broker_order_id",
    "candidate_perm_id",
    "candidate_filled_qty",
    "candidate_remaining_qty",
    "candidate_avg_fill_price",
    "broker_submission_ref",
    "input_record_refs",
    "reason_codes"
  ],
  "properties": {
    "schema_id": { "const": "execution_lifecycle_decision" },
    "schema_version": { "const": "v1" },
    "record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_lifecycle_decision_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lifecycle_input_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "submission_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "submission_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_intent_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "contract_version": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "enum": ["advance", "duplicate", "blocked", "no_action"] },
    "current_execution_state_record_id": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "candidate_lifecycle_status": {
      "type": "string",
      "enum": [
        "HANDOFF_ENTERED",
        "UNKNOWN",
        "PENDINGSUBMIT",
        "PRESUBMITTED",
        "SUBMITTED",
        "ACKNOWLEDGED",
        "OPEN",
        "PARTIALLY_FILLED",
        "FILLED",
        "REJECTED",
        "CANCELLED",
        "INACTIVE"
      ]
    },
    "candidate_source_lifecycle_status": { "type": ["string", "null"] },
    "candidate_terminal_state": { "type": "boolean" },
    "evidence_basis": {
      "type": "string",
      "enum": ["HANDOFF_ATTEMPT", "BROKER_SUBMISSION_RECORD", "EXECUTION_EVENT_RECORD", "FILL_LEDGER"]
    },
    "evidence_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "next_transition_index": { "type": "integer", "minimum": 0 },
    "candidate_broker_order_id": { "type": ["string", "null"] },
    "candidate_perm_id": { "type": ["string", "null"] },
    "candidate_filled_qty": { "type": "integer", "minimum": 0 },
    "candidate_remaining_qty": { "type": ["integer", "null"], "minimum": 0 },
    "candidate_avg_fill_price": { "type": ["string", "null"] },
    "broker_submission_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "execution_event_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fill_ledger_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "input_record_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
