{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/execution/execution_set_intent.v1.schema.json",
  "title": "execution_set_intent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "execution_set_intent_id",
    "multi_delta_execution_record_id",
    "promotion_record_id",
    "household_id",
    "day_utc",
    "produced_utc",
    "contract_version",
    "status",
    "member_intents",
    "input_record_refs",
    "parent_lineage_refs",
    "source_artifact_refs",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "execution_set_intent" },
    "schema_version": { "const": "v1" },
    "record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_set_intent_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "multi_delta_execution_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "promotion_record_id": { "type": "string", "minLength": 1 },
    "household_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "contract_version": { "type": "string", "minLength": 1 },
    "status": { "const": "READY" },
    "member_intents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/member_intent" }
    },
    "input_record_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "parent_lineage_refs": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "execution_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "record_id",
        "execution_intent_id",
        "promotion_record_id",
        "household_id",
        "created_at_utc",
        "effective_at_utc",
        "actor_source",
        "contract_version",
        "builder_version",
        "idempotency_key",
        "operation_type",
        "day_utc",
        "environment",
        "sleeve_id",
        "account_id",
        "engine_id",
        "instrument",
        "side",
        "quantity_shares",
        "order_terms",
        "parent_lineage_refs",
        "source_artifact_refs",
        "canonical_json_hash"
      ],
      "properties": {
        "schema_id": { "const": "execution_intent" },
        "schema_version": { "const": "v1" },
        "record_id": { "type": "string", "minLength": 1 },
        "execution_intent_id": { "type": "string", "minLength": 1 },
        "promotion_record_id": { "type": "string", "minLength": 1 },
        "household_id": { "type": "string", "minLength": 1 },
        "created_at_utc": { "type": "string", "format": "date-time" },
        "effective_at_utc": { "type": "string", "format": "date-time" },
        "actor_source": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string", "minLength": 1 },
        "builder_version": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "operation_type": { "type": "string", "minLength": 1 },
        "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
        "sleeve_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "engine_id": { "type": "string", "minLength": 1 },
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "symbol", "currency", "ib_conId", "ib_localSymbol"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "currency": { "type": "string", "minLength": 1 },
            "ib_conId": { "type": ["integer", "null"] },
            "ib_localSymbol": { "type": ["string", "null"] }
          }
        },
        "side": { "type": "string", "enum": ["BUY", "SELL"] },
        "quantity_shares": { "type": "integer", "minimum": 1 },
        "order_terms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order_type", "limit_price", "time_in_force"],
          "properties": {
            "order_type": { "type": "string", "enum": ["LIMIT", "MARKET"] },
            "limit_price": { "type": ["string", "null"] },
            "time_in_force": { "type": "string", "enum": ["DAY", "GTC"] }
          }
        },
        "parent_lineage_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "member_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_order",
        "change_id",
        "execution_intent",
        "predicted_submission_id",
        "predicted_trade_instance_id",
        "reason_codes"
      ],
      "properties": {
        "member_order": { "type": "integer", "minimum": 0 },
        "change_id": { "type": "string", "minLength": 1 },
        "execution_intent": { "$ref": "#/$defs/execution_intent" },
        "predicted_submission_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "predicted_trade_instance_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
