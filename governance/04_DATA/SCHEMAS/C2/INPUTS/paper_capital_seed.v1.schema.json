{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/inputs/paper_capital_seed.v1.schema.json",
  "title": "paper_capital_seed.v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "ib_account",
    "produced_utc",
    "seed_mode",
    "cash_total",
    "nlv_total",
    "currency"
  ],
  "properties": {
    "schema_id": { "type": "string", "minLength": 1 },
    "schema_version": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "integer" }] },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "produced_utc": { "type": "string", "minLength": 10 },
    "seed_mode": { "type": "string", "minLength": 1 },
    "cash_total": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }] },
    "nlv_total": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }] },
    "currency": { "type": "string", "minLength": 3 },
    "status": { "type": "string" },
    "final_status": { "type": "string" },
    "canonical_blocker": { "type": "string" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "producer": { "type": "object" },
    "producer_contract_v1": { "type": "object" },
    "truth_root": { "type": "string" },
    "truth_roots": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
