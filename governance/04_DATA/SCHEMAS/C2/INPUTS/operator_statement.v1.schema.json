{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/inputs/operator_statement.v1.schema.json",
  "title": "operator_statement.v1",
  "type": "object",
  "required": [
    "account_id",
    "observed_at_utc",
    "nlv_total",
    "cash_total",
    "currency",
    "available_funds",
    "excess_liquidity"
  ],
  "properties": {
    "schema_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "account_id": { "type": "string", "minLength": 1 },
    "observed_at_utc": { "type": "string", "minLength": 10 },
    "nlv_total": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }] },
    "cash_total": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }] },
    "available_funds": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }, { "type": "null" }] },
    "excess_liquidity": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }, { "type": "null" }] },
    "currency": { "type": "string", "minLength": 3 },
    "status": { "type": "string" },
    "final_status": { "type": "string" },
    "canonical_blocker": { "type": "string" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "producer": { "type": "object" },
    "producer_contract_v1": { "type": "object" },
    "truth_root": { "type": "string" },
    "truth_roots": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
