{
  "$id": "C2_CASH_LEDGER_SNAPSHOT_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_basis": {
      "enum": [
        "broker_account_values",
        "operator_statement",
        "other"
      ],
      "type": "string"
    },
    "day_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "downstream_dependency_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "input_manifest": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "day_utc": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "producer": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": {
            "enum": [
              "broker_account_values",
              "operator_statement",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "path",
          "sha256",
          "day_utc",
          "producer"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "operator_intent_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "produced_utc": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "object"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        },
        "module": {
          "minLength": 1,
          "type": "string"
        },
        "repo": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repo",
        "git_sha",
        "module"
      ],
      "type": "object"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "runtime_evaluation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "C2_CASH_LEDGER_SNAPSHOT_V1"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_funds_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cash_total_cents": {
          "type": "integer"
        },
        "currency": {
          "minLength": 1,
          "type": "string"
        },
        "excess_liquidity_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "nlv_total_cents": {
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observed_at_utc": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "observed_at_utc",
        "currency",
        "cash_total_cents",
        "nlv_total_cents",
        "available_funds_cents",
        "excess_liquidity_cents",
        "account_id",
        "notes"
      ],
      "type": "object"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "BROKER_EXPORT",
        "MANUAL_DECLARATION",
        "SIMULATION_LEDGER",
        "STATIC_RISK_BUDGET",
        "STATIC_RISK_BUDGET_BOOTSTRAP",
        "ACCOUNT_EVIDENCE",
        "POSITIONS_SNAPSHOT_V5",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "DEGRADED_OPERATOR_INPUT",
        "FAIL_CORRUPT_INPUTS",
        "FAIL_SCHEMA_VIOLATION"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "produced_utc",
    "day_utc",
    "authority_basis",
    "producer",
    "status",
    "reason_codes",
    "input_manifest",
    "snapshot"
  ],
  "title": "C2 Cash Ledger Snapshot v1",
  "type": "object"
}
