{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/readiness/bug_metrics.v1.schema.json",
  "title": "C2 Bug Metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "window_days_evaluated",
    "new_bug_events_today",
    "bug_velocity_7d_avg",
    "bug_velocity_14d_avg",
    "recurring_bug_events",
    "recurrence_rate",
    "mttr_hours",
    "median_ttr_hours",
    "bug_velocity_trend",
    "bug_half_life_estimate_days",
    "diagnostic_stability_rate",
    "metric_views",
    "calculation_summary",
    "evidence_paths",
    "event_counts_by_day",
    "unknown_fields"
  ],
  "properties": {
    "schema_id": {"const": "C2_BUG_METRICS_V1"},
    "schema_version": {"const": 1},
    "day_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "produced_utc": {"type": "string", "minLength": 20},
    "window_days_evaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_7d", "window_14d"],
      "properties": {
        "window_7d": {"type": "integer", "minimum": 0, "maximum": 7},
        "window_14d": {"type": "integer", "minimum": 0, "maximum": 14}
      }
    },
    "new_bug_events_today": {"type": "integer", "minimum": 0},
    "bug_velocity_7d_avg": {"type": ["integer", "null"], "minimum": 0},
    "bug_velocity_14d_avg": {"type": ["integer", "null"], "minimum": 0},
    "recurring_bug_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recurrence_key", "count"],
        "properties": {
          "recurrence_key": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 2}
        }
      }
    },
    "recurrence_rate": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000},
    "mttr_hours": {"type": ["integer", "null"], "minimum": 0},
    "median_ttr_hours": {"type": ["integer", "null"], "minimum": 0},
    "bug_velocity_trend": {"type": ["string", "null"], "enum": ["IMPROVING", "STABLE", "WORSENING", "UNKNOWN", null]},
    "bug_half_life_estimate_days": {"type": ["integer", "null"], "minimum": 0},
    "diagnostic_stability_rate": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000},
    "metric_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_bug_events_today",
        "bug_velocity_7d_avg",
        "bug_velocity_14d_avg",
        "recurrence_rate",
        "diagnostic_stability_rate",
        "mttr_hours",
        "median_ttr_hours",
        "bug_half_life_estimate_days"
      ],
      "properties": {
        "new_bug_events_today": {"$ref": "#/$defs/metric_view"},
        "bug_velocity_7d_avg": {"$ref": "#/$defs/metric_view"},
        "bug_velocity_14d_avg": {"$ref": "#/$defs/metric_view"},
        "recurrence_rate": {"$ref": "#/$defs/metric_view"},
        "diagnostic_stability_rate": {"$ref": "#/$defs/metric_view"},
        "mttr_hours": {"$ref": "#/$defs/metric_view"},
        "median_ttr_hours": {"$ref": "#/$defs/metric_view"},
        "bug_half_life_estimate_days": {"$ref": "#/$defs/metric_view"}
      }
    },
    "calculation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_bug_events_today_basis",
        "bug_velocity_basis",
        "recurrence_rate_basis",
        "diagnostic_stability_basis",
        "window_days_used"
      ],
      "properties": {
        "new_bug_events_today_basis": {"type": "string"},
        "bug_velocity_basis": {"type": "string"},
        "recurrence_rate_basis": {"type": "string"},
        "diagnostic_stability_basis": {"type": "string"},
        "window_days_used": {
          "type": "object",
          "additionalProperties": false,
          "required": ["velocity_7d_days", "velocity_14d_days", "recurrence_days"],
          "properties": {
            "velocity_7d_days": {"type": "integer", "minimum": 0, "maximum": 7},
            "velocity_14d_days": {"type": "integer", "minimum": 0, "maximum": 14},
            "recurrence_days": {"type": "integer", "minimum": 0, "maximum": 14}
          }
        }
      }
    },
    "event_counts_by_day": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day_utc", "event_count"],
        "properties": {
          "day_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "event_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "unknown_fields": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "metric_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_value", "unit", "display_value"],
      "properties": {
        "raw_value": {"type": ["integer", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "display_value": {"type": "string", "minLength": 1}
      }
    }
  }
}
