{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/evaluation_policy_snapshot.v1.schema.json",
  "title": "evaluation_policy_snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "policy_snapshot_id",
    "policy_version",
    "annual_target_return",
    "window_policy",
    "benchmark_role_policy",
    "sleeve_role_assignments",
    "governance_action_policy",
    "source_registry_ref",
    "reason_codes",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_EVALUATION_POLICY_SNAPSHOT_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "policy_snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "annual_target_return": { "type": "string", "minLength": 1 },
    "window_policy": { "type": "object" },
    "evidence_assembly_policy": { "type": "object" },
    "outcome_attribution_policy": { "type": "object" },
    "sleeve_edge_measurement_policy": { "type": "object" },
    "benchmark_role_policy": { "type": "object" },
    "sleeve_role_assignments": { "type": "object" },
    "allocation_governance_policy": { "type": "object" },
    "governance_action_policy": { "type": "object" },
    "operative_control_policy": { "type": "object" },
    "source_registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
