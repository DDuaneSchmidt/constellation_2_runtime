{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/sleeve_operative_control_state.v1.schema.json",
  "title": "sleeve_operative_control_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "execution_sleeve_id",
    "mode",
    "sleeve_id",
    "state_mode",
    "state_class",
    "binding_state",
    "effective_from",
    "superseded_by",
    "allocation_governance_ref",
    "measurement_ref",
    "policy_snapshot_ref",
    "governance_action_ref",
    "operator_override_ref",
    "reason_codes",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_SLEEVE_OPERATIVE_CONTROL_STATE_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "execution_sleeve_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "state_mode": { "type": "string", "enum": ["PROPOSED_ONLY"] },
    "state_class": { "type": "string", "enum": ["ACTIVE", "REVIEW_REQUIRED", "RESTRICTED", "DISABLED", "OVERRIDE"] },
    "binding_state": { "type": "string", "enum": ["NOT_BOUND_LIVE"] },
    "effective_from": { "type": "string", "format": "date-time" },
    "superseded_by": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "allocation_governance_ref": { "type": "object" },
    "measurement_ref": { "type": "object" },
    "policy_snapshot_ref": { "type": "object" },
    "governance_action_ref": {
      "anyOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "operator_override_ref": {
      "anyOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
