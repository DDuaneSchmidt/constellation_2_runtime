{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/portfolio_governance_action_state.v1.schema.json",
  "title": "portfolio_governance_action_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "scope_kind",
    "scope_id",
    "action_state",
    "action_reason_codes",
    "mandatory_or_advisory",
    "evaluation_ref",
    "policy_snapshot_ref",
    "frozen_input_bundle",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_PORTFOLIO_GOVERNANCE_ACTION_STATE_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "scope_kind": { "const": "portfolio" },
    "scope_id": { "type": "string", "minLength": 1 },
    "action_state": { "type": "string", "enum": ["continue", "watch", "reduce", "pause", "retire", "no_conclusion"] },
    "action_reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "mandatory_or_advisory": { "type": "string", "enum": ["MANDATORY", "ADVISORY"] },
    "evaluation_ref": { "type": "object" },
    "policy_snapshot_ref": { "type": "object" },
    "frozen_input_bundle": { "type": "object" },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
