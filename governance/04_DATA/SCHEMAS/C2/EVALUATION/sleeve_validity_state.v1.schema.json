{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/sleeve_validity_state.v1.schema.json",
  "title": "sleeve_validity_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "execution_sleeve_id",
    "mode",
    "sleeve_id",
    "window",
    "sample_trade_count",
    "validity_state",
    "execution_contamination_state",
    "benchmark_applicability_state",
    "data_completeness_state",
    "reason_codes",
    "upstream_refs",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_SLEEVE_VALIDITY_STATE_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "execution_sleeve_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "window": { "type": "object" },
    "sample_trade_count": { "type": "integer", "minimum": 0 },
    "validity_state": {
      "type": "string",
      "enum": [
        "insufficient_sample",
        "execution_contaminated",
        "benchmark_not_applicable",
        "benchmark_invalid",
        "data_incomplete",
        "provisional",
        "valid"
      ]
    },
    "execution_contamination_state": { "type": "string", "enum": ["execution_clean", "execution_contaminated"] },
    "benchmark_applicability_state": { "type": "string", "enum": ["benchmark_valid", "benchmark_not_applicable", "benchmark_invalid"] },
    "data_completeness_state": { "type": "string", "enum": ["complete", "incomplete"] },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "upstream_refs": { "type": "array", "items": { "type": "object" } },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
