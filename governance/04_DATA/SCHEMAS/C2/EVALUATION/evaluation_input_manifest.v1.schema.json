{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/evaluation_input_manifest.v1.schema.json",
  "title": "evaluation_input_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "execution_sleeve_id",
    "mode",
    "sleeve_id",
    "measurement_window",
    "evidence_summary",
    "source_evidence_refs",
    "policy_snapshot_ref",
    "frozen_input_bundle",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_EVALUATION_INPUT_MANIFEST_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "execution_sleeve_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_kind", "sample_basis", "source_as_of_ts"],
      "properties": {
        "window_kind": { "type": "string", "minLength": 1 },
        "sample_basis": { "type": "string", "minLength": 1 },
        "source_as_of_ts": { "type": "string", "format": "date-time" }
      }
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_trade_count",
        "excluded_trade_count",
        "sample_trade_count",
        "source_artifact_count"
      ],
      "properties": {
        "included_trade_count": { "type": "integer", "minimum": 0 },
        "excluded_trade_count": { "type": "integer", "minimum": 0 },
        "sample_trade_count": { "type": "integer", "minimum": 0 },
        "source_artifact_count": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime_lifecycle_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "runtime_identity_contract_path",
        "runtime_identity_contract_sha256",
        "startup_identity_receipt_path",
        "lifecycle_start_receipt_path"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "runtime_identity_contract_path": { "type": "string", "minLength": 1 },
        "runtime_identity_contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "startup_identity_receipt_path": { "type": "string", "minLength": 1 },
        "lifecycle_start_receipt_path": { "type": "string", "minLength": 1 }
      }
    },
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "sha256", "root_type", "scope_kind"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "root_type": { "type": "string", "enum": ["canonical_truth_root", "execution_truth_root"] },
          "scope_kind": { "type": "string", "enum": ["day", "sleeve"] }
        }
      }
    },
    "policy_snapshot_ref": { "type": "object" },
    "frozen_input_bundle": { "type": "object" },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
