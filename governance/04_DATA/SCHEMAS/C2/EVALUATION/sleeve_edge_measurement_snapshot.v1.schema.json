{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/sleeve_edge_measurement_snapshot.v1.schema.json",
  "title": "sleeve_edge_measurement_snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "execution_sleeve_id",
    "mode",
    "sleeve_id",
    "evaluation_input_manifest_ref",
    "outcome_attribution_ref",
    "policy_snapshot_ref",
    "legacy_measurement_ref",
    "measurement_window",
    "sample_trade_count",
    "edge_measurement",
    "stability_measurement",
    "confidence_measurement",
    "reason_codes",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_SLEEVE_EDGE_MEASUREMENT_SNAPSHOT_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "execution_sleeve_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "evaluation_input_manifest_ref": { "type": "object" },
    "outcome_attribution_ref": { "type": "object" },
    "policy_snapshot_ref": { "type": "object" },
    "legacy_measurement_ref": { "type": "object" },
    "measurement_window": { "type": "object" },
    "sample_trade_count": { "type": "integer", "minimum": 0 },
    "attribution_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fact_count",
        "attributed_fact_count",
        "unattributed_fact_count",
        "expected_attribution_field",
        "fields_actually_present",
        "sample_records",
        "upstream_artifact_path"
      ],
      "properties": {
        "source_fact_count": { "type": "integer", "minimum": 0 },
        "attributed_fact_count": { "type": "integer", "minimum": 0 },
        "unattributed_fact_count": { "type": "integer", "minimum": 0 },
        "expected_attribution_field": { "type": "string", "minLength": 1 },
        "fields_actually_present": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sample_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trade_identity_id", "measurement_class", "continuity_status", "current_quantity", "fields_present"],
            "properties": {
              "trade_identity_id": { "type": "string", "minLength": 1 },
              "measurement_class": { "type": "string", "minLength": 1 },
              "continuity_status": { "type": "string" },
              "current_quantity": { "type": "string" },
              "fields_present": {
                "type": "object",
                "additionalProperties": false,
                "required": ["trade_identity", "incorporated_state", "lineage_attachment_refs", "incorporated_fills"],
                "properties": {
                  "trade_identity": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "incorporated_state": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "lineage_attachment_refs": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "incorporated_fills": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "upstream_artifact_path": { "type": "string", "minLength": 1 },
        "lineage_requirement_diagnostic": { "type": "string" }
      }
    },
    "edge_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_net_expectancy",
        "adopted_management_expectancy",
        "qualification_state",
        "edge_band"
      ],
      "properties": {
        "native_net_expectancy": { "type": "string", "minLength": 1 },
        "adopted_management_expectancy": { "type": "string", "minLength": 1 },
        "qualification_state": { "type": "string", "minLength": 1 },
        "edge_band": { "type": "string", "minLength": 1 }
      }
    },
    "stability_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drift_band", "stability_state"],
      "properties": {
        "drift_band": { "type": "string", "minLength": 1 },
        "stability_state": { "type": "string", "enum": ["stable", "unstable"] }
      }
    },
    "confidence_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_state",
        "sample_sufficiency_band",
        "execution_health_band"
      ],
      "properties": {
        "confidence_state": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "INVALID"] },
        "sample_sufficiency_band": { "type": "string", "minLength": 1 },
        "execution_health_band": { "type": "string", "minLength": 1 }
      }
    },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
