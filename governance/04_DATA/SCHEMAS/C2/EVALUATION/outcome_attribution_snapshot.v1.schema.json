{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/outcome_attribution_snapshot.v1.schema.json",
  "title": "outcome_attribution_snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "execution_sleeve_id",
    "mode",
    "sleeve_id",
    "evaluation_input_manifest_ref",
    "policy_snapshot_ref",
    "measurement_summary",
    "attribution_components",
    "confidence_state",
    "residual_state",
    "reason_codes",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_OUTCOME_ATTRIBUTION_SNAPSHOT_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "execution_sleeve_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "evaluation_input_manifest_ref": { "type": "object" },
    "policy_snapshot_ref": { "type": "object" },
    "measurement_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_trade_count", "included_trade_count", "excluded_trade_count"],
      "properties": {
        "sample_trade_count": { "type": "integer", "minimum": 0 },
        "included_trade_count": { "type": "integer", "minimum": 0 },
        "excluded_trade_count": { "type": "integer", "minimum": 0 }
      }
    },
    "attribution_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_entry_net_pnl",
        "adopted_management_net_pnl",
        "fee_drag",
        "measured_slippage_drag",
        "unknown_attribution_count"
      ],
      "properties": {
        "native_entry_net_pnl": { "type": "string", "minLength": 1 },
        "adopted_management_net_pnl": { "type": "string", "minLength": 1 },
        "fee_drag": { "type": "string", "minLength": 1 },
        "measured_slippage_drag": { "type": "object" },
        "unknown_attribution_count": { "type": "integer", "minimum": 0 }
      }
    },
    "confidence_state": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "INVALID"] },
    "residual_state": {
      "type": "string",
      "enum": ["FULLY_EXPLAINED", "PARTIALLY_EXPLAINED", "UNEXPLAINED", "NOT_ENOUGH_EVIDENCE"]
    },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
