{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/portfolio_performance_truth.v1.schema.json",
  "title": "portfolio_performance_truth.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "portfolio_scope",
    "portfolio_return",
    "drawdown_truth",
    "benchmark_truth",
    "risk_truth",
    "reason_codes",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_PORTFOLIO_PERFORMANCE_TRUTH_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "portfolio_scope": { "type": "string", "minLength": 1 },
    "performance_status": { "type": "string", "minLength": 1 },
    "portfolio_return": { "type": "object" },
    "drawdown_truth": { "type": "object" },
    "benchmark_truth": { "type": "object" },
    "risk_truth": { "type": "object" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
