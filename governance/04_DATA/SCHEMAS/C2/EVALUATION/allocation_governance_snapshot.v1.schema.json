{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/evaluation/allocation_governance_snapshot.v1.schema.json",
  "title": "allocation_governance_snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "execution_sleeve_id",
    "mode",
    "sleeve_id",
    "evaluation_input_manifest_ref",
    "measurement_ref",
    "policy_snapshot_ref",
    "capital_authority_allocation_ref",
    "current_control_context",
    "allocation_alignment_state",
    "recommended_action_state",
    "recommended_state_class",
    "recommendation_reason_codes",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "C2_ALLOCATION_GOVERNANCE_SNAPSHOT_V1" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "execution_sleeve_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "evaluation_input_manifest_ref": { "type": "object" },
    "measurement_ref": { "type": "object" },
    "policy_snapshot_ref": { "type": "object" },
    "capital_authority_allocation_ref": { "type": "object" },
    "current_control_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_state",
        "action_state",
        "control_state",
        "headroom_multiplier_bp"
      ],
      "properties": {
        "adoption_state": { "type": "string", "minLength": 1 },
        "action_state": { "type": "string", "minLength": 1 },
        "control_state": { "type": "string", "minLength": 1 },
        "headroom_multiplier_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "diagnostic": { "type": "string" }
      }
    },
    "allocation_alignment_state": { "type": "string", "enum": ["ALIGNED", "REVIEW_REQUIRED", "CONTROL_GAP"] },
    "recommended_action_state": {
      "type": "string",
      "enum": ["continue", "watch", "reduce", "pause", "retire", "no_conclusion"]
    },
    "recommended_state_class": {
      "type": "string",
      "enum": ["ACTIVE", "REVIEW_REQUIRED", "RESTRICTED", "DISABLED", "OVERRIDE"]
    },
    "recommendation_reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "DEGRADED", "BLOCKED", "OPEN"] },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
