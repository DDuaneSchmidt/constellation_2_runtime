{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "account_id": {
      "type": "string"
    },
    "build_ref": {
      "type": "object"
    },
    "context_hash": {
      "type": "string"
    },
    "day_utc": {
      "type": "string"
    },
    "dependency_refs": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "manifest_ref": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "operation_type": {
      "type": "string"
    },
    "package_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_id": {
