    "schema_version",
    "day_utc",
    "sleeve_id",
    "mode",
    "account_id",
    "operation_type",
    "context_hash",
    "sealed",
    "sealed_utc",
    "build_ref",
    "manifest_ref",
    "dependency_refs"
  ],
  "type": "object"
}
