{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "C2_POSITIONS_SNAPSHOT_V5",
  "title": "C2 Positions Snapshot v5 (Bundle A canonical account-position-lifecycle state)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "producer",
    "status",
    "reason_codes",
    "input_manifest",
    "accounts",
    "items",
    "reconciliation",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_POSITIONS_SNAPSHOT_V5" },
    "schema_version": { "const": 5 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "minLength": 20 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "git_sha", "module"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 7 },
        "module": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "type": "string", "enum": ["OK", "FAIL"] },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "day_utc": { "type": ["string", "null"] },
          "producer": { "type": ["string", "null"] }
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/account_state" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/position_item" }
    },
    "reconciliation": { "$ref": "#/$defs/reconciliation_summary" },
    "canonical_json_hash": { "type": "string", "minLength": 64, "maxLength": 64 }
  },
  "$defs": {
    "account_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "currency",
        "cash_total_cents",
        "broker_cash_cents",
        "cash_source",
        "reason_codes"
      ],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "cash_total_cents": { "type": "integer" },
        "broker_cash_cents": { "type": ["integer", "null"] },
        "cash_source": {
          "type": "string",
          "enum": [
            "CASH_LEDGER_ONLY",
            "CASH_LEDGER_AND_BROKER_STATEMENT",
            "BROKER_STATEMENT_ONLY"
          ]
        },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "position_lot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id",
        "direction",
        "opened_day_utc",
        "remaining_qty_abs",
        "cost_basis_cents",
        "source_kind",
        "source_ref"
      ],
      "properties": {
        "lot_id": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["LONG", "SHORT"] },
        "opened_day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "remaining_qty_abs": { "type": "integer", "minimum": 0 },
        "cost_basis_cents": { "type": "integer", "minimum": 0 },
        "source_kind": { "type": "string", "enum": ["NATIVE_FILL", "BROKER_AGGREGATE"] },
        "source_ref": { "type": ["string", "null"] }
      }
    },
    "position_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_position_present",
        "broker_qty",
        "status",
        "reason_codes"
      ],
      "properties": {
        "broker_position_present": { "type": "boolean" },
        "broker_qty": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["MATCH", "MISMATCH", "BROKER_ONLY", "INTERNAL_ONLY", "UNKNOWN"]
        },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "position_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_id",
        "account_id",
        "origin",
        "engine_id",
        "source_intent_id",
        "intent_sha256",
        "instrument",
        "qty",
        "avg_cost_cents",
        "opened_day_utc",
        "last_transition_utc",
        "last_transition_type",
        "lifecycle_state",
        "lifecycle_reason_code",
        "status",
        "lots",
        "reconciliation"
      ],
      "properties": {
        "position_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "enum": ["NATIVE", "IMPORTED"] },
        "engine_id": { "type": "string", "minLength": 1 },
        "source_intent_id": { "type": "string", "minLength": 1 },
        "intent_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "instrument": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "qty": { "type": "integer" },
        "avg_cost_cents": { "type": "integer", "minimum": 0 },
        "opened_day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "last_transition_utc": { "type": "string", "minLength": 20 },
        "last_transition_type": {
          "type": "string",
          "enum": [
            "OPEN",
            "ADD",
            "PARTIAL_CLOSE",
            "FULL_CLOSE",
            "IMPORTED_SNAPSHOT",
            "CARRY_FORWARD",
            "BROKER_RECONCILED"
          ]
        },
        "lifecycle_state": { "type": "string", "enum": ["OPEN", "MANAGING", "CLOSED"] },
        "lifecycle_reason_code": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "lots": {
          "type": "array",
          "items": { "$ref": "#/$defs/position_lot" }
        },
        "reconciliation": { "$ref": "#/$defs/position_reconciliation" }
      }
    },
    "reconciliation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_statement_present",
        "broker_statement_path",
        "cash_status",
        "cash_delta_cents",
        "positions_status",
        "reason_codes",
        "position_mismatches"
      ],
      "properties": {
        "broker_statement_present": { "type": "boolean" },
        "broker_statement_path": { "type": ["string", "null"] },
        "cash_status": { "type": "string", "enum": ["MATCH", "MISMATCH", "UNKNOWN"] },
        "cash_delta_cents": { "type": ["integer", "null"] },
        "positions_status": { "type": "string", "enum": ["MATCH", "MISMATCH", "UNKNOWN"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "position_mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "sec_type", "internal_qty", "broker_qty"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "sec_type": { "type": "string", "minLength": 1 },
              "internal_qty": { "type": "string", "minLength": 1 },
              "broker_qty": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
