{
  "$defs": {
    "account_state": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "minLength": 1,
          "type": "string"
        },
        "broker_cash_cents": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cash_source": {
          "enum": [
            "CASH_LEDGER_ONLY",
            "CASH_LEDGER_AND_BROKER_STATEMENT",
            "BROKER_STATEMENT_ONLY"
          ],
          "type": "string"
        },
        "cash_total_cents": {
          "type": "integer"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "account_id",
        "currency",
        "cash_total_cents",
        "broker_cash_cents",
        "cash_source",
        "reason_codes"
      ],
      "type": "object"
    },
    "position_item": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "minLength": 1,
          "type": "string"
        },
        "avg_cost_cents": {
          "minimum": 0,
          "type": "integer"
        },
        "engine_id": {
          "minLength": 1,
          "type": "string"
        },
        "instrument": {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "intent_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "last_transition_type": {
          "enum": [
            "OPEN",
            "ADD",
            "PARTIAL_CLOSE",
            "FULL_CLOSE",
            "IMPORTED_SNAPSHOT",
            "CARRY_FORWARD",
            "BROKER_RECONCILED"
          ],
          "type": "string"
        },
        "last_transition_utc": {
          "minLength": 20,
          "type": "string"
        },
        "lifecycle_reason_code": {
          "minLength": 1,
          "type": "string"
        },
        "lifecycle_state": {
          "enum": [
            "OPEN",
            "MANAGING",
            "CLOSED"
          ],
          "type": "string"
        },
        "lots": {
          "items": {
            "$ref": "#/$defs/position_lot"
          },
          "type": "array"
        },
        "opened_day_utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "origin": {
          "enum": [
            "NATIVE",
            "IMPORTED"
          ],
          "type": "string"
        },
        "position_id": {
          "minLength": 1,
          "type": "string"
        },
        "qty": {
          "type": "integer"
        },
        "reconciliation": {
          "$ref": "#/$defs/position_reconciliation"
        },
        "source_intent_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "OPEN",
            "CLOSED"
          ],
          "type": "string"
        }
      },
      "required": [
        "position_id",
        "account_id",
        "origin",
        "engine_id",
        "source_intent_id",
        "intent_sha256",
        "instrument",
        "qty",
        "avg_cost_cents",
        "opened_day_utc",
        "last_transition_utc",
        "last_transition_type",
        "lifecycle_state",
        "lifecycle_reason_code",
        "status",
        "lots",
        "reconciliation"
      ],
      "type": "object"
    },
    "position_lot": {
      "additionalProperties": false,
      "properties": {
        "cost_basis_cents": {
          "minimum": 0,
          "type": "integer"
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "type": "string"
        },
        "lot_id": {
          "minLength": 1,
          "type": "string"
        },
        "opened_day_utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "remaining_qty_abs": {
          "minimum": 0,
          "type": "integer"
        },
        "source_kind": {
          "enum": [
            "NATIVE_FILL",
            "BROKER_AGGREGATE"
          ],
          "type": "string"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lot_id",
        "direction",
        "opened_day_utc",
        "remaining_qty_abs",
        "cost_basis_cents",
        "source_kind",
        "source_ref"
      ],
      "type": "object"
    },
    "position_reconciliation": {
      "additionalProperties": false,
      "properties": {
        "broker_position_present": {
          "type": "boolean"
        },
        "broker_qty": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "BROKER_ONLY",
            "INTERNAL_ONLY",
            "UNKNOWN"
          ],
          "type": "string"
        }
      },
      "required": [
        "broker_position_present",
        "broker_qty",
        "status",
        "reason_codes"
      ],
      "type": "object"
    },
    "reconciliation_summary": {
      "additionalProperties": false,
      "properties": {
        "broker_statement_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "broker_statement_present": {
          "type": "boolean"
        },
        "cash_delta_cents": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cash_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "position_mismatches": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "broker_qty": {
                "minLength": 1,
                "type": "string"
              },
              "internal_qty": {
                "minLength": 1,
                "type": "string"
              },
              "sec_type": {
                "minLength": 1,
                "type": "string"
              },
              "symbol": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "symbol",
              "sec_type",
              "internal_qty",
              "broker_qty"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "positions_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "broker_statement_present",
        "broker_statement_path",
        "cash_status",
        "cash_delta_cents",
        "positions_status",
        "reason_codes",
        "position_mismatches"
      ],
      "type": "object"
    }
  },
  "$id": "C2_POSITIONS_SNAPSHOT_V5",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/$defs/account_state"
      },
      "minItems": 1,
      "type": "array"
    },
    "canonical_json_hash": {
      "maxLength": 64,
      "minLength": 64,
      "type": "string"
    },
    "cash_ledger_source_type": {
      "enum": [
        "BROKER_EXPORT",
        "MANUAL_DECLARATION",
        "SIMULATION_LEDGER",
        "STATIC_RISK_BUDGET",
        "STATIC_RISK_BUDGET_BOOTSTRAP",
        "ACCOUNT_EVIDENCE",
        "POSITIONS_SNAPSHOT_V5",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "day_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "downstream_dependency_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "input_manifest": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "day_utc": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "producer": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "type",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/position_item"
      },
      "type": "array"
    },
    "output_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "produced_utc": {
      "minLength": 20,
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "git_sha": {
          "minLength": 7,
          "type": "string"
        },
        "module": {
          "minLength": 1,
          "type": "string"
        },
        "repo": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repo",
        "git_sha",
        "module"
      ],
      "type": "object"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "reconciliation": {
      "$ref": "#/$defs/reconciliation_summary"
    },
    "runtime_evaluation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "C2_POSITIONS_SNAPSHOT_V5"
    },
    "schema_version": {
      "const": 5
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "BROKER_EXPORT",
        "MANUAL_DECLARATION",
        "SIMULATION_LEDGER",
        "STATIC_RISK_BUDGET",
        "STATIC_RISK_BUDGET_BOOTSTRAP",
        "ACCOUNT_EVIDENCE",
        "POSITIONS_SNAPSHOT_V5",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "FAIL"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "producer",
    "status",
    "reason_codes",
    "input_manifest",
    "accounts",
    "items",
    "reconciliation",
    "canonical_json_hash"
  ],
  "title": "C2 Positions Snapshot v5 (Bundle A canonical account-position-lifecycle state)",
  "type": "object"
}
