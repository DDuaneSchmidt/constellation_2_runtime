{
  "additionalProperties": false,
  "properties": {
    "canonical_json_hash": {
      "maxLength": 64,
      "minLength": 64,
      "type": "string"
    },
    "day_utc": {
      "maxLength": 10,
      "minLength": 10,
      "type": "string"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "engine_id": {
            "minLength": 1,
            "type": "string"
          },
          "exit_policy_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "intent_sha256": {
            "maxLength": 64,
            "minLength": 64,
            "type": "string"
          },
          "kill_switch_override": {
            "type": "boolean"
          },
          "last_transition_utc": {
            "minLength": 20,
            "type": "string"
          },
          "lifecycle_reason_code": {
            "minLength": 1,
            "type": "string"
          },
          "lifecycle_state": {
            "enum": [
              "OPEN",
              "MANAGING",
              "REDUCE_PENDING",
              "REDUCING",
              "CLOSE_PENDING",
              "CLOSING",
              "CLOSED",
              "FORCED_CLOSE_PENDING",
              "FORCED_CLOSED",
              "ORPHANED"
            ],
            "type": "string"
          },
          "opened_day_utc": {
            "maxLength": 10,
            "minLength": 10,
            "type": "string"
          },
          "position_id": {
            "minLength": 1,
            "type": "string"
          },
          "regime_snapshot_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_intent_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "position_id",
          "engine_id",
          "source_intent_id",
          "intent_sha256",
          "lifecycle_state",
          "lifecycle_reason_code",
          "opened_day_utc",
          "last_transition_utc",
          "kill_switch_override"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "output_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "produced_utc": {
      "minLength": 20,
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "git_sha": {
          "minLength": 7,
          "type": "string"
        },
        "module": {
          "minLength": 1,
          "type": "string"
        },
        "repo": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repo",
        "git_sha",
        "module"
      ],
      "type": "object"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "runtime_evaluation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "C2_POSITION_LIFECYCLE_SNAPSHOT"
    },
    "schema_version": {
      "const": 2
    },
    "source_positions_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "BROKER_EXPORT",
        "MANUAL_DECLARATION",
        "SIMULATION_LEDGER",
        "STATIC_RISK_BUDGET",
        "STATIC_RISK_BUDGET_BOOTSTRAP",
        "ACCOUNT_EVIDENCE",
        "POSITIONS_SNAPSHOT_V5",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "FAIL"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "producer",
    "status",
    "reason_codes",
    "items",
    "canonical_json_hash"
  ],
  "type": "object"
}
