{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/aegis_authority_graph.v1.schema.json",
  "title": "aegis_authority_graph.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_id", "schema_version", "day_utc", "authority_nodes", "blocking_nodes", "dependency_order"],
  "properties": {
    "schema_id": { "const": "aegis_authority_graph" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "authority_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["authority_name", "artifact_path", "phase", "dependencies", "freshness_rule", "required_or_diagnostic", "blocking_states", "allowed_states", "owning_subsystem", "status"],
        "properties": {
          "authority_name": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "producer_command": { "type": ["string", "null"] },
          "phase": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "freshness_rule": { "type": "string" },
          "required_or_diagnostic": { "type": "string", "enum": ["required", "diagnostic"] },
          "blocking_states": { "type": "array", "items": { "type": "string" } },
          "allowed_states": { "type": "array", "items": { "type": "string" } },
          "owning_subsystem": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "blocking_nodes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "dependency_order": { "type": "array", "items": { "type": "string" } }
  }
}
