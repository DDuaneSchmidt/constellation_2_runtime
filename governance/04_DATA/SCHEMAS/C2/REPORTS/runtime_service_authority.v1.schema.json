{
  "$id": "https://constellation.local/schemas/c2/reports/runtime_service_authority.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Service Authority v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "authority_scope",
    "status",
    "service_state",
    "expected_run_mode",
    "automatic_expected",
    "submit_creator_available",
    "submit_creator_running",
    "submit_creator_required",
    "observer_supervisor_running",
    "dashboard_running",
    "required_services",
    "services",
    "required_missing",
    "diagnostics",
    "first_blocker",
    "input_evidence",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_RUNTIME_SERVICE_AUTHORITY_V1" },
    "schema_version": { "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string" },
    "authority_scope": { "const": "RUNTIME_SERVICE_EXPECTATIONS" },
    "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
    "service_state": {
      "type": "string",
      "enum": ["NOT_REQUIRED", "READY", "DEGRADED", "MISSING_REQUIRED_SERVICE", "SERVICE_CRASHED", "MANUAL_MODE_READY", "UNKNOWN"]
    },
    "expected_run_mode": { "type": "string" },
    "automatic_expected": { "type": "boolean" },
    "submit_creator_available": { "type": "boolean" },
    "submit_creator_running": { "type": "boolean" },
    "submit_creator_required": { "type": "boolean" },
    "observer_supervisor_running": { "type": "boolean" },
    "dashboard_running": { "type": "boolean" },
    "required_services": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "services": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "required_missing": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "diagnostics": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "first_blocker": { "type": "string" },
    "input_evidence": { "type": "array", "items": { "$ref": "#/$defs/input_evidence" } },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "input_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "exists"],
      "properties": {
        "artifact_type": { "type": "string" },
        "path": { "type": "string" },
        "exists": { "type": "boolean" }
      }
    }
  }
}
