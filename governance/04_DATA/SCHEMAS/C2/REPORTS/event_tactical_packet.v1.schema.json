{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/event_tactical_packet.v1.schema.json",
  "title": "event_tactical_packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "event_id", "event_run_id", "day_utc", "recommended_trade_id", "symbol", "side", "instrument_type", "entry_reference_price", "order_type_suggestion", "quantity_or_sizing_guidance", "stop_price", "stop_logic", "risk_per_trade", "event_type", "edge_family", "regime_state", "confidence", "execution_sensitivity", "valid_until", "max_entry_slippage", "invalidation_conditions", "inclusion_reason", "exclusion_reason", "governance_notes", "manual_execution_checklist", "non_canonical_event_packet", "canonical_eod_state_mutated", "manual_execution_only", "broker_submit_required", "transmit_automation_required", "runtime_mutation_allowed", "automatic_promotion_allowed", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "event_tactical_packet" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "event_tactical_packet_v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "event_run_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 10 },
    "recommended_trade_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "side": { "type": "string", "minLength": 1 },
    "instrument_type": { "type": "string" },
    "entry_reference_price": { "type": "string" },
    "order_type_suggestion": { "type": "string" },
    "quantity_or_sizing_guidance": { "type": "string" },
    "stop_price": { "type": "string" },
    "stop_logic": { "type": "string" },
    "risk_per_trade": { "type": "string" },
    "event_type": { "type": "string", "enum": ["PANIC_EXHAUSTION", "RECOVERY_FAILURE", "FAILED_BREAKOUT", "BREADTH_COLLAPSE", "DEFENSIVE_ROTATION", "VOLATILITY_SPIKE", "MACRO_EVENT_REACTION"] },
    "edge_family": { "type": "string" },
    "regime_state": { "type": "string" },
    "confidence": { "type": "string" },
    "execution_sensitivity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "EXTREME"] },
    "valid_until": { "type": "string" },
    "max_entry_slippage": { "type": "string" },
    "invalidation_conditions": { "type": "array", "items": { "type": "string" } },
    "inclusion_reason": { "type": "string" },
    "exclusion_reason": { "type": "string" },
    "governance_notes": { "type": "string" },
    "manual_execution_checklist": { "type": "array", "items": { "type": "string" } },
    "non_canonical_event_packet": { "const": true },
    "canonical_eod_state_mutated": { "const": false },
    "manual_execution_only": { "const": true },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
