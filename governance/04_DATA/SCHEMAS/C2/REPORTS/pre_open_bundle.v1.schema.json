{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/pre_open_bundle.v1.schema.json",
  "title": "pre_open_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "target_day",
    "active_day_observed",
    "active_day_alignment_status",
    "owner_tool",
    "materialization_state",
    "completion_state",
    "blocking_reason_codes",
    "prerequisite_checks",
    "producer_results",
    "market_calendar_status",
    "built_at_utc",
    "producer"
  ],
  "properties": {
    "schema_id": { "const": "pre_open_bundle" },
    "schema_version": { "const": "v1" },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "active_day_observed": { "type": "string" },
    "active_day_alignment_status": {
      "type": "string",
      "enum": ["MATCH", "MISMATCH", "UNKNOWN"]
    },
    "owner_tool": { "type": "string", "minLength": 1 },
    "materialization_state": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE", "BLOCKED"]
    },
    "completion_state": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE"]
    },
    "blocking_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prerequisite_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactResult" }
    },
    "producer_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/producerResult" }
    },
    "market_calendar_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "artifact_path",
        "artifact_sha256",
        "severity",
        "required_target_day",
        "reason_codes"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" },
        "severity": { "type": "string" },
        "required_target_day": { "type": "string" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "built_at_utc": { "type": "string", "minLength": 20 },
    "producer": { "$ref": "#/$defs/producer" },
    "readiness_authority_path": { "type": "string" },
    "readiness_mode": { "type": "string" },
    "evidence_policy_used": {
      "type": "object",
      "additionalProperties": true
    },
    "carry_forward_source_used": { "type": "string" },
    "mode_specific_blocker": { "type": "boolean" }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "producerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "command",
        "return_code",
        "stdout",
        "stderr",
        "required_for_completion",
        "result_state",
        "reason_codes",
        "freshness_status",
        "target_day_expected",
        "target_day_observed",
        "artifact_refs"
      ],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "return_code": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "required_for_completion": { "type": "boolean" },
        "result_state": {
          "type": "string",
          "enum": ["PASS", "FAIL", "STALE", "MISMATCH", "BLOCKED", "UNAVAILABLE"]
        },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "freshness_status": {
          "type": "string",
          "enum": ["CURRENT", "STALE", "UNKNOWN"]
        },
        "target_day_expected": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "target_day_observed": { "type": "string" },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_path", "artifact_sha256"],
            "properties": {
              "artifact_path": { "type": "string", "minLength": 1 },
              "artifact_sha256": { "type": "string" }
            }
          }
        }
      }
    },
    "artifactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_name",
        "required",
        "role_class",
        "classification",
        "canonical_path",
        "authority_path",
        "path_family",
        "observed_status",
        "result_status",
        "blocker_codes",
        "blocking_reason_code",
        "schema_status",
        "schema_ref",
        "freshness_rule",
        "freshness_status",
        "target_day_expected",
        "target_day_observed",
        "date_binding_status",
        "date_binding_value",
        "provenance_required",
        "provenance_summary",
        "closure_status",
        "producer",
        "source_refs",
        "observed_dependency_artifacts"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "role_class": {
          "type": "string",
          "enum": ["REQUIRED_BINDING_INPUT", "REQUIRED_DERIVED_GATE", "REQUIRED_EXECUTION_BOUNDARY"]
        },
        "classification": { "type": "string", "minLength": 1 },
        "canonical_path": { "type": "string", "minLength": 1 },
        "authority_path": { "type": "string", "minLength": 1 },
        "path_family": { "type": "string", "minLength": 1 },
        "observed_status": { "type": "string", "minLength": 1 },
        "result_status": { "type": "string", "enum": ["PASS", "FAIL"] },
        "blocker_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocking_reason_code": { "type": "string" },
        "schema_status": { "type": "string", "minLength": 1 },
        "schema_ref": { "type": "string" },
        "freshness_rule": { "type": "string", "minLength": 1 },
        "freshness_status": { "type": "string", "minLength": 1 },
        "target_day_expected": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "target_day_observed": { "type": "string" },
        "date_binding_status": { "type": "string", "minLength": 1 },
        "date_binding_value": { "type": "string" },
        "provenance_required": { "type": "boolean" },
        "provenance_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "present", "fields_present", "source"],
          "properties": {
            "required": { "type": "boolean" },
            "present": { "type": "boolean" },
            "fields_present": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "source": { "type": "string" }
          }
        },
        "closure_status": { "type": "string", "enum": ["CLOSED", "OPEN"] },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "git_sha"],
          "properties": {
            "module": { "type": "string" },
            "git_sha": { "type": "string" }
          }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "object" }
        },
        "observed_dependency_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
