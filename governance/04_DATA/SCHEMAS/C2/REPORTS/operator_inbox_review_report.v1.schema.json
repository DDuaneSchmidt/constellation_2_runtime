{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/operator_inbox_review_report.v1.schema.json",
  "title": "operator_inbox_review_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "report_id",
    "generated_at_utc",
    "truth_root",
    "item_counts",
    "captured_items",
    "reviewed_items",
    "promoted_items",
    "archived_rejected_items",
    "stale_captured_items",
    "high_priority_open_items",
    "lineage_gaps",
    "operator_inbox_only",
    "research_task_creation_allowed",
    "trade_creation_allowed",
    "sleeve_creation_allowed",
    "lite_runtime_mutation_allowed",
    "production_mutation_allowed",
    "broker_submit_required",
    "transmit_automation_required",
    "automatic_promotion_allowed",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "operator_inbox_review_report" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "operator_inbox_review_report_v1" },
    "report_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "truth_root": { "type": "string", "minLength": 1 },
    "item_counts": { "type": "object" },
    "captured_items": { "type": "array", "items": { "type": "object" } },
    "reviewed_items": { "type": "array", "items": { "type": "object" } },
    "promoted_items": { "type": "array", "items": { "type": "object" } },
    "archived_rejected_items": { "type": "array", "items": { "type": "object" } },
    "stale_captured_items": { "type": "array", "items": { "type": "object" } },
    "high_priority_open_items": { "type": "array", "items": { "type": "object" } },
    "lineage_gaps": { "type": "array", "items": { "type": "object" } },
    "operator_inbox_only": { "const": true },
    "research_task_creation_allowed": { "const": false },
    "trade_creation_allowed": { "const": false },
    "sleeve_creation_allowed": { "const": false },
    "lite_runtime_mutation_allowed": { "const": false },
    "production_mutation_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
