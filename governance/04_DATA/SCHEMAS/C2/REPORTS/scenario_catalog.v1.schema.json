{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/scenario_catalog.v1.schema.json",
  "title": "scenario_catalog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "catalog_id",
    "scenarios",
    "created_at"
  ],
  "properties": {
    "schema_id": {
      "const": "scenario_catalog"
    },
    "schema_version": {
      "const": "v1"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "domain_scope",
          "scenario_type",
          "purpose",
          "input_artifact_refs",
          "policy_refs",
          "expected_outputs",
          "expected_action_classes",
          "expected_precedence_notes",
          "status"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "domain_scope": {
            "type": "string",
            "minLength": 1
          },
          "scenario_type": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "input_artifact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_outputs": {
            "type": "object"
          },
          "expected_action_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_precedence_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
