{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/evidence_gate.v1.schema.json",
  "title": "evidence_gate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "evidence_gate_id",
    "review_type",
    "period_start",
    "period_end",
    "generated_at_utc",
    "input_artifact_refs",
    "sample_count",
    "sample_band",
    "evidence_gate_status",
    "evidence_gate_pass",
    "missing_receipts",
    "missing_outcomes",
    "stale_data",
    "missing_regime_labels",
    "missing_event_labels",
    "missing_price_outcome_data",
    "data_quality_score",
    "data_quality_status",
    "strong_conclusions_allowed",
    "automatic_research_task_creation_allowed",
    "blocked_conclusion_reason_codes",
    "market_context_summary",
    "manual_execution_only",
    "broker_action_allowed",
    "production_mutation_allowed",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "evidence_gate" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "evidence_gate_v1" },
    "evidence_gate_id": { "type": "string", "minLength": 1 },
    "review_type": { "type": "string", "enum": ["EOD", "EOW"] },
    "period_start": { "type": "string", "minLength": 10 },
    "period_end": { "type": "string", "minLength": 10 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "input_artifact_refs": { "type": "array", "items": { "type": "object" } },
    "sample_count": { "type": "integer", "minimum": 0 },
    "sample_band": { "type": "string", "enum": ["NO_EVIDENCE", "OBSERVATION_ONLY", "WEAK_SIGNAL", "REVIEWABLE_PATTERN", "STRONGER_PATTERN"] },
    "evidence_gate_status": { "type": "string", "enum": ["BLOCKED", "OBSERVATION_ONLY", "PASS"] },
    "evidence_gate_pass": { "type": "boolean" },
    "missing_receipts": { "type": "integer", "minimum": 0 },
    "missing_outcomes": { "type": "integer", "minimum": 0 },
    "stale_data": { "type": "boolean" },
    "missing_regime_labels": { "type": "integer", "minimum": 0 },
    "missing_event_labels": { "type": "integer", "minimum": 0 },
    "missing_price_outcome_data": { "type": "integer", "minimum": 0 },
    "data_quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "data_quality_status": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] },
    "strong_conclusions_allowed": { "type": "boolean" },
    "automatic_research_task_creation_allowed": { "type": "boolean" },
    "blocked_conclusion_reason_codes": { "type": "array", "items": { "type": "string" } },
    "market_context_summary": { "type": "object" },
    "manual_execution_only": { "const": true },
    "broker_action_allowed": { "const": false },
    "production_mutation_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
