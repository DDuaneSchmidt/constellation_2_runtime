{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/aegis_readiness_reconciliation_report.v1.schema.json",
  "title": "aegis_readiness_reconciliation_report.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "target_day",
    "runtime_mode",
    "plan_ref",
    "plan_hash",
    "executed_actions",
    "failed_actions",
    "regenerated_artifacts",
    "ledger_records_created",
    "promotion_attestations_created",
    "final_control_plane_ref",
    "final_control_plane_hash",
    "final_status",
    "final_canonical_blocker",
    "nonrecoverable_blockers",
    "safety_confirmations",
    "producer_contract_v1"
  ],
  "properties": {
    "schema_id": { "const": "aegis_readiness_reconciliation_report" },
    "schema_version": { "const": "aegis_readiness_reconciliation_report.v1" },
    "target_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "runtime_mode": { "type": "string", "enum": ["CANDIDATE", "PRODUCTION"] },
    "plan_ref": { "type": "string", "minLength": 1 },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executed_actions": { "type": "array" },
    "failed_actions": { "type": "array" },
    "regenerated_artifacts": { "type": "array" },
    "ledger_records_created": { "type": "array" },
    "promotion_attestations_created": { "type": "array" },
    "final_control_plane_ref": { "type": "string" },
    "final_control_plane_hash": { "type": "string" },
    "final_status": { "type": "string", "minLength": 1 },
    "final_canonical_blocker": { "type": "string" },
    "nonrecoverable_blockers": { "type": "array" },
    "safety_confirmations": { "type": "object" },
    "producer_contract_v1": { "type": "object" }
  }
}
