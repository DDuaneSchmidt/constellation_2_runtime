{
  "$id": "https://constellation.local/schemas/C2_EXECUTION_RECONCILIATION_V1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 Execution Reconciliation v1 (broker vs truth consistency)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "produced_utc",
    "day_utc",
    "producer",
    "status",
    "semantic_status",
    "reason_codes",
    "input_manifest",
    "checks",
    "audit_guidance",
    "runtime_ledger_projection",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_EXECUTION_RECONCILIATION_V1" },
    "schema_version": { "type": "integer", "const": 1 },

    "produced_utc": { "type": "string", "format": "date-time" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },

    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "git_sha", "module"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "module": { "type": "string", "minLength": 1 }
      }
    },

    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "semantic_status": {
      "type": "string",
      "enum": [
        "NOT_YET_MATERIALIZED",
        "BLOCKED_BY_UPSTREAM_PREREQUISITE",
        "PENDING_PROPAGATION",
        "MATERIALIZED_AND_FAILED",
        "FULLY_OBSERVED_AND_CONFIRMED"
      ]
    },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },

    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },

    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "pass", "details"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "pass": { "type": "boolean" },
          "details": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },

    "audit_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_consumption_mode",
        "versioned_snapshot_root",
        "alias_path",
        "alias_is_best_effort"
      ],
      "properties": {
        "preferred_consumption_mode": { "type": "string", "const": "IMMUTABLE_VERSIONED_SNAPSHOT" },
        "versioned_snapshot_root": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "alias_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "alias_is_best_effort": { "type": "boolean" }
      }
    },

    "runtime_ledger_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_path",
        "ledger_sha256",
        "derived_from_runtime_ledger",
        "event_types",
        "event_count",
        "appended_event_ids",
        "reused_event_ids",
        "projection_notice"
      ],
      "properties": {
        "ledger_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "ledger_sha256": { "type": "string" },
        "derived_from_runtime_ledger": { "type": "boolean" },
        "event_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "event_count": { "type": "integer", "minimum": 0 },
        "appended_event_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "reused_event_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "projection_notice": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "runtime_lifecycle_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "runtime_identity_contract_path",
        "runtime_identity_contract_sha256",
        "startup_identity_receipt_path",
        "lifecycle_start_receipt_path"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "runtime_identity_contract_path": { "type": "string", "minLength": 1 },
        "runtime_identity_contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "startup_identity_receipt_path": { "type": "string", "minLength": 1 },
        "lifecycle_start_receipt_path": { "type": "string", "minLength": 1 }
      }
    },

    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
