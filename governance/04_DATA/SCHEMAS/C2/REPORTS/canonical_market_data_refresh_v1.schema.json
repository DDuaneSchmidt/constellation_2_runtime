{
  "$id": "https://constellation.local/schemas/canonical_market_data_refresh_v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C2 Canonical Market Data Refresh v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "producer",
    "status",
    "truth_root",
    "symbol_source_truth_root",
    "symbols_requested",
    "symbols_succeeded",
    "symbols_failed",
    "results",
    "reason_codes",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": {
      "const": "C2_CANONICAL_MARKET_DATA_REFRESH_V1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "day_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "produced_utc": {
      "type": "string",
      "minLength": 20
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "git_sha",
        "module"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "SKIP"
      ]
    },
    "truth_root": {
      "type": "string",
      "minLength": 1
    },
    "symbol_source_truth_root": {
      "type": "string",
      "minLength": 1
    },
    "symbols_requested": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "symbols_succeeded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "symbols_failed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "status",
          "returncode",
          "year_file",
          "stdout_summary",
          "stderr_summary"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "returncode": {
            "type": "integer"
          },
          "year_file": {
            "type": "string",
            "minLength": 1
          },
          "stdout_summary": {
            "type": "string"
          },
          "stderr_summary": {
            "type": "string"
          }
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage_missing_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repair_target_derivation_status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "NOT_NEEDED",
            "DERIVED",
            "FAILED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_target_derivation_source": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_target_candidate_count_before_filters": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_target_candidate_count_after_filters": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_target_derivation_failure_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "SOURCE_MISSING",
            "SOURCE_EMPTY",
            "SOURCE_MALFORMED",
            "FILTERED_TO_ZERO",
            "UNKNOWN_DERIVATION_FAILURE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_decision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_json_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "canonical_universe_discovery_report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_universe_discovery_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_universe_discovery_accepted_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_universe_minimum_successful_symbols": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
