{
  "$id": "https://constellation.local/schemas/C2/REPORTS/readiness_domain_evaluation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "blocker_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "blocker_messages": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "disallowed_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "domain": {
      "enum": [
        "market_data",
        "trade_construction",
        "capital_authority",
        "stop_risk",
        "manual_capture",
        "paper_submit",
        "execution"
      ]
    },
    "evaluated_at": {
      "type": "string"
    },
    "immutable_hash": {
      "minLength": 1,
      "type": "string"
