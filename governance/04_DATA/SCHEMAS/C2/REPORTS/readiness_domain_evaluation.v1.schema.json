    "missing_inputs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "readiness_domain_evaluation_id": {
      "minLength": 1,
      "type": "string"
    },
    "required_inputs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resolved_inputs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_id": {
      "const": "readiness_domain_evaluation"
    },
    "schema_version": {
      "const": "v1"
    },
    "selected_exposure_intent_id": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array"
