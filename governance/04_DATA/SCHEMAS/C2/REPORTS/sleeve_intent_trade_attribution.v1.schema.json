{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/sleeve_intent_trade_attribution.v1.schema.json",
  "title": "sleeve_intent_trade_attribution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "day_utc",
    "environment",
    "report_generated_at_utc",
    "evidence_cutoff_utc",
    "session_context",
    "day_summary",
    "sleeves",
    "opportunities",
    "completeness_status",
    "global_warnings",
    "evidence_status",
    "producer",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": {
      "const": "sleeve_intent_trade_attribution"
    },
    "schema_version": {
      "const": "v1"
    },
    "artifact_id": {
      "const": "sleeve_intent_trade_attribution_v1"
    },
    "day_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "report_generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_cutoff_utc": {
      "type": "string",
      "format": "date-time"
    },
    "session_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_session_path",
        "active_day",
        "target_day"
      ],
      "properties": {
        "active_session_path": {
          "type": "string",
          "minLength": 1
        },
        "active_day": {
          "type": "string"
        },
        "target_day": {
          "type": "string"
        }
      }
    },
    "day_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_count",
        "classification_counts"
      ],
      "properties": {
        "opportunity_count": {
          "type": "integer",
          "minimum": 0
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sleeves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sleeve_id",
          "opportunity_count",
          "classification_counts"
        ],
        "properties": {
          "sleeve_id": {
            "type": "string",
            "minLength": 1
          },
          "opportunity_count": {
            "type": "integer",
            "minimum": 0
          },
          "classification_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sleeve_id",
          "opportunity_id",
          "final_classification",
          "farthest_stage",
          "completeness_status",
          "root_reason_code",
          "reason_codes",
          "stage_counts",
          "event_count",
          "evidence_refs",
          "submit_decision",
          "submit_decision_reason_code",
          "submit_decision_reason_detail"
        ],
        "properties": {
          "sleeve_id": {
            "type": "string",
            "minLength": 1
          },
          "opportunity_id": {
            "type": "string",
            "minLength": 1
          },
          "final_classification": {
            "type": "string",
            "enum": [
              "SLEEVE_NOT_RUN",
              "RAN_NO_SIGNAL",
              "RAN_SIGNAL_FILTERED",
              "INTENT_CREATED_NOT_SUBMITTED",
              "INTENT_SUBMITTED_NO_ORDER",
              "ORDER_ACCEPTED_NO_FILL",
              "PARTIAL_FILL",
              "FILLED",
              "ORDER_REJECTED",
              "ORDER_CANCELLED",
              "ATTRIBUTION_INCOMPLETE"
            ]
          },
          "farthest_stage": {
            "type": "string"
          },
          "completeness_status": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "LATE_UPSTREAM",
              "CONTRADICTORY"
            ]
          },
          "root_reason_code": {
            "type": "string",
            "minLength": 1
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stage_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "event_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_type",
                "artifact_path",
                "artifact_sha256"
              ],
              "properties": {
                "artifact_type": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_path": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "submit_decision": {
            "type": "string",
            "enum": [
              "ATTEMPTED",
              "SKIPPED",
              "UNKNOWN"
            ]
          },
          "submit_decision_reason_code": {
            "type": "string",
            "minLength": 1
          },
          "submit_decision_reason_detail": {
            "type": "string"
          }
        }
      }
    },
    "completeness_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "LATE_UPSTREAM",
        "CONTRADICTORY"
      ]
    },
    "global_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_event_count",
        "lineage_root",
        "submit_decision_trace_count",
        "submit_decision_trace_root",
        "primary_evidence_only",
        "derived_sources_used"
      ],
      "properties": {
        "lineage_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "lineage_root": {
          "type": "string",
          "minLength": 1
        },
        "submit_decision_trace_count": {
          "type": "integer",
          "minimum": 0
        },
        "submit_decision_trace_root": {
          "type": "string",
          "minLength": 1
        },
        "primary_evidence_only": {
          "type": "boolean"
        },
        "derived_sources_used": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "repo"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canonical_json_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
