{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C2 Auto Repair Health Supervisor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "evaluated_at_utc",
    "target_day_utc",
    "state",
    "blocker_class",
    "reason_codes",
    "authoritative_attempt_id",
    "operator_summary",
    "supporting_artifact_refs",
    "details",
    "producer"
  ],
  "properties": {
    "schema_id": { "const": "C2_AUTO_REPAIR_HEALTH_SUPERVISOR_V1" },
    "schema_version": { "type": "integer", "const": 1 },
    "evaluated_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "target_day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "state": { "type": "string", "enum": ["READY", "DEGRADED", "REPAIR_REQUIRED"] },
    "blocker_class": { "type": "string", "minLength": 1 },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "authoritative_attempt_id": { "type": ["string", "null"] },
    "operator_summary": { "type": "string", "minLength": 1 },
    "supporting_artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "details": { "type": "object" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string" },
        "module": { "type": "string" },
        "git_sha": { "type": "string" }
      }
    }
  }
}
