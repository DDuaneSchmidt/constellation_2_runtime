    "lineage_status": { "type": "string" },
    "consistency_status": { "type": "string" },
    "freshness_status": { "type": "string" },
    "action_validity_status": { "type": "string" },
    "advisory_intelligence_status": { "type": "string" },
    "trade_health_status": { "type": "string" },
    "allowed_operator_actions": { "type": "array" },
    "forbidden_operator_actions": { "type": "array" },
    "unsafe_actions": { "type": "array" },
    "downstream_consequences": { "type": "array" },
    "authoritative_artifacts": { "type": "array" },
    "diagnostic_artifacts": { "type": "array" },
    "advisory_artifacts": { "type": "array" },
    "unknown_or_untrusted_artifacts": { "type": "array" },
