{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/bod_execution_environment_proof.v1.schema.json",
  "title": "bod_execution_environment_proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "status",
    "blocking_codes",
    "producer",
    "produced_at_utc",
    "python_executable",
    "repo_root",
    "cwd",
    "pythonpath",
    "virtual_env",
    "environment_snapshot",
    "sys_path_head",
    "constellation_2_import",
    "bridge_import_probe",
    "human_readable_summary"
  ],
  "properties": {
    "schema_id": { "const": "bod_execution_environment_proof" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "NON_AUTHORITY_FACT" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "type": "string", "enum": ["PASS", "BLOCKED_BY_DEFECT"] },
    "blocking_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "produced_at_utc": { "type": "string", "minLength": 20 },
    "python_executable": { "type": "string", "minLength": 1 },
    "repo_root": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "pythonpath": { "type": "string" },
    "virtual_env": { "type": "string" },
    "environment_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HOME", "PATH", "PYTHONPATH", "VIRTUAL_ENV"],
      "properties": {
        "HOME": { "type": "string" },
        "PATH": { "type": "string" },
        "PYTHONPATH": { "type": "string" },
        "VIRTUAL_ENV": { "type": "string" }
      }
    },
    "sys_path_head": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constellation_2_import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "bridge_import_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "cwd", "returncode", "stdout", "stderr", "proof_payload"],
      "properties": {
        "cmd": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "returncode": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "proof_payload": { "type": "object" }
      }
    },
    "human_readable_summary": { "type": "string", "minLength": 1 }
  }
}
