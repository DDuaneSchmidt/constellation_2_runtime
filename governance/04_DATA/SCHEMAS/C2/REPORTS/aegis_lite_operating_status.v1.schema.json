{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/aegis_lite_operating_status.v1.schema.json",
  "title": "aegis_lite_operating_status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "day_utc",
    "generated_at_utc",
    "truth_root",
    "lite_eod_timer_status",
    "lite_eod_latest_report_path",
    "lite_eod_latest_queue_path",
    "legacy_paper_timers_status",
    "broker_submit_required",
    "manual_execution_only",
    "readiness_classification",
    "current_blockers",
    "active_release_commit",
    "repo_head_commit",
    "release_repo_match_status",
    "working_repo_changes_inactive",
    "source_artifact_lineage",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "aegis_lite_operating_status" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "aegis_lite_operating_status_v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "truth_root": { "type": "string", "minLength": 1 },
    "lite_eod_timer_status": { "type": "object", "additionalProperties": true },
    "lite_eod_latest_report_path": { "type": "string" },
    "lite_eod_latest_queue_path": { "type": "string" },
    "legacy_paper_timers_status": { "type": "array", "items": { "type": "object" } },
    "broker_submit_required": { "const": false },
    "manual_execution_only": { "const": true },
    "readiness_classification": {
      "type": "string",
      "enum": [
        "NOT_READY",
        "ADVISORY_ONLY",
        "READY_FOR_SUPERVISED_MANUAL_PAPER_TRADING",
        "READY_FOR_UNSUPERVISED_MANUAL_PAPER_TRADING",
        "READY_FOR_AUTOMATION"
      ]
    },
    "current_blockers": { "type": "array", "items": { "type": "string" } },
    "active_release_commit": { "type": "string" },
    "repo_head_commit": { "type": "string" },
    "release_repo_match_status": { "type": "string", "enum": ["MATCH", "MISMATCH", "UNKNOWN"] },
    "working_repo_changes_inactive": { "type": "boolean" },
    "release_integrity_status": { "type": "object", "additionalProperties": true },
    "legacy_paper_runtime_status": { "type": "object", "additionalProperties": true },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "source_artifact_lineage": { "type": "array", "items": { "type": "object" } },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
