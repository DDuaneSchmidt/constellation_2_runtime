{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/runtime_resilience_authority.v1.schema.json",
  "title": "runtime_resilience_authority.v1",
  "type": "object",
  "required": ["day_utc", "status"],
  "properties": {
    "schema_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "type": "string", "minLength": 1 },
    "final_status": { "type": "string", "minLength": 1 },
    "canonical_blocker": { "type": "string" },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocking_reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "producer": {
      "type": "object",
      "required": ["module", "git_sha"],
      "properties": {
        "repo": { "type": "string" },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 7 }
      },
      "additionalProperties": true
    },
    "producer_contract_v1": { "type": "object", "required": ["producer_name", "code_version_git_commit"], "additionalProperties": true },
    "truth_root": { "type": "string", "minLength": 1 },
    "truth_roots": { "type": "object", "additionalProperties": true },
    "generated_at_utc": { "type": "string", "minLength": 10 },
    "produced_utc": { "type": "string", "minLength": 10 }
  },
  "anyOf": [
    { "required": ["producer"] },
    { "required": ["producer_contract_v1"] }
  ],
  "oneOf": [
    { "required": ["truth_root"] },
    { "required": ["truth_roots"] }
  ],
  "allOf": [
    { "anyOf": [{ "required": ["generated_at_utc"] }, { "required": ["produced_utc"] }] },
    {
      "if": {
        "properties": {
          "status": { "enum": ["BLOCKED", "DENIED", "FAIL", "FAILED", "NOT_READY"] }
        },
        "required": ["status"]
      },
      "then": {
        "anyOf": [
          { "required": ["canonical_blocker"] },
          { "required": ["reason_codes"] },
          { "required": ["blocking_reason_codes"] }
        ]
      }
    }
  ],
  "additionalProperties": true
}
