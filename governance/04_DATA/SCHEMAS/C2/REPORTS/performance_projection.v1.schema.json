{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/performance_projection.v1.schema.json",
  "title": "performance_projection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "projection_id",
    "generated_at_utc",
    "journal_ref",
    "journal_id",
    "overall_wall_time_ms",
    "per_stage_durations",
    "trend_summary",
    "constitutional_dependency_declaration",
    "constitutional_lineage",
    "source_artifacts",
    "informational_only_notice",
    "producer"
  ],
  "properties": {
    "schema_id": { "const": "performance_projection" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "DERIVED_ONLY_PERFORMANCE_PROJECTION" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "projection_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "journal_ref": { "type": "string", "minLength": 1 },
    "journal_id": { "type": "string", "minLength": 1 },
    "overall_wall_time_ms": { "type": ["integer", "null"], "minimum": 0 },
    "per_stage_durations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_name", "status", "started_at_utc", "ended_at_utc", "duration_ms", "source_event_seq"],
        "properties": {
          "stage_name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "started_at_utc": { "type": "string" },
          "ended_at_utc": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "source_event_seq": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "trend_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "history_points"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "history_points": { "type": "integer", "minimum": 0 }
      }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "path", "sha256", "generated_at_utc", "status"],
        "properties": {
          "logical_name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "generated_at_utc": { "type": "string" },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "informational_only_notice": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    }
  }
}
