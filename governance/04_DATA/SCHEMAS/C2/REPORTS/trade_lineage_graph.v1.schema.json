{
  "$id": "https://constellation.local/schemas/c2/reports/trade_lineage_graph.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trade Lineage Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "produced_utc",
    "authority_scope",
    "status",
    "identity_state",
    "lineage_count",
    "node_count",
    "edge_count",
    "broken_edge_count",
    "first_broken_edge",
    "lineages",
    "projection_consistency",
    "input_evidence",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_TRADE_LINEAGE_GRAPH_V1" },
    "schema_version": { "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "produced_utc": { "type": "string", "format": "date-time" },
    "authority_scope": { "const": "END_TO_END_TRADE_IDENTITY" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "identity_state": { "$ref": "#/$defs/identity_state" },
    "lineage_count": { "type": "integer", "minimum": 0 },
    "node_count": { "type": "integer", "minimum": 0 },
    "edge_count": { "type": "integer", "minimum": 0 },
    "broken_edge_count": { "type": "integer", "minimum": 0 },
    "first_broken_edge": { "anyOf": [{ "$ref": "#/$defs/edge" }, { "type": "null" }] },
    "lineages": {
      "type": "array",
      "items": { "$ref": "#/$defs/lineage" }
    },
    "projection_consistency": {
      "type": "array",
      "items": { "$ref": "#/$defs/projection_consistency" }
    },
    "input_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/input_evidence" }
    },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "identity_state": {
      "type": "string",
      "enum": [
        "NO_INTENTS",
        "INTENT_ONLY",
        "RELEASED",
        "AUTHORIZED",
        "BUILT",
        "PACKAGED",
        "SUBMIT_DECIDED",
        "SUBMIT_RECORDED",
        "BROKER_IDENTIFIED",
        "FILLED",
        "RECONCILED",
        "DRY_RUN_COMPLETE",
        "LINEAGE_GAP",
        "IDENTITY_CONFLICT",
        "DUPLICATE_IDENTITY"
      ]
    },
    "identity_object": {
      "type": "object",
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "artifact_path", "status", "identity"],
      "properties": {
        "node_id": { "type": "string" },
        "node_type": { "type": "string" },
        "artifact_path": { "type": "string" },
        "status": { "type": "string" },
        "identity": { "$ref": "#/$defs/identity_object" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_node_id",
        "target_node_id",
        "source_artifact_path",
        "target_artifact_path_expected",
        "identity_key_expected",
        "identity_key_observed",
        "status",
        "blocker_code",
        "operator_actionable"
      ],
      "properties": {
        "source_node_id": { "type": "string" },
        "target_node_id": { "type": "string" },
        "source_artifact_path": { "type": "string" },
        "target_artifact_path_expected": { "type": "string" },
        "identity_key_expected": { "$ref": "#/$defs/identity_object" },
        "identity_key_observed": { "$ref": "#/$defs/identity_object" },
        "status": { "type": "string", "enum": ["PASS", "BROKEN"] },
        "blocker_code": { "type": "string" },
        "operator_actionable": { "type": "boolean" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_lineage_id",
        "identity_state",
        "lifecycle_state",
        "intent_id",
        "intent_hash",
        "submission_id",
        "execution_package_id",
        "broker_order_id",
        "broker_perm_id",
        "dry_run",
        "broker_transmit_enabled",
        "reconciliation_complete",
        "first_broken_edge",
        "identity_observations",
        "nodes",
        "edges"
      ],
      "properties": {
        "trade_lineage_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "identity_state": { "$ref": "#/$defs/identity_state" },
        "lifecycle_state": { "type": "string" },
        "intent_id": { "type": "string" },
        "intent_hash": { "type": "string" },
        "submission_id": { "type": "string" },
        "execution_package_id": { "type": "string" },
        "broker_order_id": { "type": ["integer", "null"] },
        "broker_perm_id": { "type": ["integer", "null"] },
        "dry_run": { "type": "boolean" },
        "broker_transmit_enabled": { "type": "boolean" },
        "reconciliation_complete": { "type": "boolean" },
        "first_broken_edge": { "anyOf": [{ "$ref": "#/$defs/edge" }, { "type": "null" }] },
        "identity_observations": { "type": "array", "items": { "$ref": "#/$defs/identity_object" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "projection_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "path", "status", "reason_code"],
      "properties": {
        "projection": { "type": "string" },
        "path": { "type": "string" },
        "status": { "type": "string", "enum": ["AGREE", "STALE_PROJECTION"] },
        "reason_code": { "type": "string" }
      }
    },
    "input_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "exists"],
      "properties": {
        "artifact_type": { "type": "string" },
        "path": { "type": "string" },
        "exists": { "type": "boolean" }
      }
    }
  }
}
