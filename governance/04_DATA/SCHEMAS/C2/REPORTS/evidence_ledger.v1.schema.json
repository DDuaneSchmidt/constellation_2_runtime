{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/evidence_ledger.v1.schema.json",
  "title": "Aegis Verified Runtime Evidence Ledger v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "day_utc",
    "generated_at",
    "generator_name",
    "generator_version",
    "git_commit_hash",
    "input_artifact_hashes",
    "output_hash",
    "entries",
    "hash_verification_status",
    "hash_verification_summary"
  ],
  "properties": {
    "schema_id": { "const": "aegis_verified_runtime_evidence_ledger" },
    "schema_version": { "const": "v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "generator_name": { "const": "build_aegis_verified_runtime_graph_v1" },
    "generator_version": { "const": "aegis_verified_runtime_graph.v1" },
    "git_commit_hash": { "type": "string" },
    "input_artifact_hashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "output_hash": { "type": "string", "minLength": 1 },
    "hash_verification_status": { "enum": ["PASS", "BLOCKED"] },
    "hash_verification_summary": { "type": "object", "additionalProperties": { "type": "integer" } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "artifact_path",
          "artifact_hash",
          "current_artifact_hash",
          "hash_verification_status",
          "artifact_type",
          "producer",
          "day_utc",
          "schema_version",
          "freshness_status",
          "validation_status",
          "consumed_by"
        ],
        "properties": {
          "evidence_id": { "type": "string" },
          "artifact_path": { "type": "string" },
          "artifact_hash": { "type": "string" },
          "current_artifact_hash": { "type": "string" },
          "hash_verification_status": { "enum": ["VERIFIED", "MISMATCH", "MISSING", "NO_RECORDED_HASH", "UNVERIFIED_INVALID_ARTIFACT"] },
          "artifact_type": { "type": "string" },
          "producer": { "type": "string" },
          "day_utc": { "type": "string" },
          "schema_version": { "type": "string" },
          "freshness_status": { "type": "string" },
          "validation_status": { "type": "string" },
          "consumed_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": true
}
