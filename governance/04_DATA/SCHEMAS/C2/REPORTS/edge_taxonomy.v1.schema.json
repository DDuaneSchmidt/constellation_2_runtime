{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/edge_taxonomy.v1.schema.json",
  "title": "edge_taxonomy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "taxonomy_id",
    "generated_at_utc",
    "market_theses",
    "edge_families",
    "edge_clusters",
    "trade_expressions",
    "deprecated_terms",
    "naming_rules",
    "duplicate_term_warnings",
    "research_lab_only",
    "runtime_mutation_allowed",
    "broker_submit_required",
    "transmit_automation_required",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "edge_taxonomy" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "edge_taxonomy_v1" },
    "taxonomy_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "market_theses": { "type": "array", "items": { "type": "string" } },
    "edge_families": { "type": "array", "items": { "type": "string" } },
    "edge_clusters": { "type": "array", "items": { "type": "string" } },
    "trade_expressions": { "type": "array", "items": { "type": "string" } },
    "deprecated_terms": { "type": "array", "items": { "type": "string" } },
    "naming_rules": { "type": "array", "items": { "type": "string" } },
    "duplicate_term_warnings": { "type": "array", "items": { "type": "string" } },
    "research_lab_only": { "const": true },
    "runtime_mutation_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
