{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_startup_intent_input_convergence.v1.schema.json",
  "title": "paper_startup_intent_input_convergence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "generated_utc",
    "target_day",
    "environment",
    "ib_account",
    "sleeve_id",
    "sleeve_truth_root",
    "authority_root",
    "convergence_status",
    "required_inputs",
    "artifact_results",
    "blocker_chain",
    "source_refs",
    "readiness_authority_path",
    "readiness_mode",
    "evidence_policy_used",
    "symbol_diagnostics"
  ],
  "properties": {
    "schema_id": { "const": "paper_startup_intent_input_convergence_v1" },
    "schema_version": { "const": 1 },
    "generated_utc": { "type": "string", "minLength": 20 },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "ib_account": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "sleeve_truth_root": { "type": "string", "minLength": 1 },
    "authority_root": { "type": "string", "minLength": 1 },
    "convergence_status": { "type": "string", "enum": ["SUCCESS", "BLOCKED"] },
    "required_inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "required",
          "artifact_path",
          "schema_id",
          "target_day_expected",
          "target_day_observed",
          "observed_status",
          "ready",
          "reason_codes",
          "blocker_code",
          "summary"
        ],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "artifact_path": { "type": "string", "minLength": 1 },
          "schema_id": { "type": "string" },
          "target_day_expected": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "target_day_observed": { "type": "string" },
          "observed_status": { "type": "string", "minLength": 1 },
          "ready": { "type": "boolean" },
          "reason_codes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "blocker_code": { "type": "string" },
          "summary": { "type": "string" },
          "symbol": { "type": "string" },
          "required_snapshot_symbols": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "materialized_snapshot_symbols": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "missing_snapshot_symbols": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source_registry_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source_registry_hashes": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "required_snapshot_engines": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "blocker_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "blocker_code", "summary"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "blocker_code": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "object" }
    },
    "readiness_authority_path": { "type": "string" },
    "readiness_mode": { "type": "string" },
    "evidence_policy_used": { "type": "object" },
    "symbol_diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "selected_intent_symbol",
        "required_options_symbol",
        "options_snapshot_symbol",
        "symbol_source",
        "stale_default_symbol_detected",
        "bridge_symbol_used_for_market_snapshot"
      ],
      "properties": {
        "selected_intent_symbol": { "type": "string" },
        "required_options_symbol": { "type": "string" },
        "options_snapshot_symbol": { "type": "string" },
        "symbol_source": { "type": "string" },
        "stale_default_symbol_detected": { "type": "boolean" },
        "bridge_symbol": { "type": "string" },
        "bridge_symbol_source": { "type": "string" },
        "bridge_symbol_used_for_market_snapshot": { "type": "boolean" },
        "required_snapshot_symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "materialized_snapshot_symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing_snapshot_symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_registry_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_registry_hashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "required_snapshot_engines": {
          "type": "array",
          "items": { "type": "object" }
        },
        "market_data_snapshot_results": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
