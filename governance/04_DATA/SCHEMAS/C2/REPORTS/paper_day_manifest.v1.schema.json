{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_day_manifest.v1.schema.json",
  "title": "paper_day_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "artifacts"
  ],
  "properties": {
    "schema_id": { "const": "paper_day_manifest" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "PAPER_DAY_READINESS_MANIFEST" },
    "description": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_name",
          "path_template",
          "dependencies",
          "freshness_rule",
          "required_or_diagnostic",
          "owning_subsystem",
          "blocker_code_if_missing",
          "blocker_code_if_stale",
          "blocker_code_if_failing"
        ],
        "properties": {
          "artifact_name": { "type": "string", "minLength": 1 },
          "path_template": { "type": "string", "minLength": 1 },
          "producer_command": { "type": "string" },
          "producer_function": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "freshness_rule": { "type": "string", "minLength": 1 },
          "required_or_diagnostic": { "type": "string", "enum": ["required", "diagnostic", "conditional_required"] },
          "condition": { "type": "string", "minLength": 1 },
          "owning_subsystem": { "type": "string", "minLength": 1 },
          "blocker_code_if_missing": { "type": "string", "minLength": 1 },
          "blocker_code_if_stale": { "type": "string", "minLength": 1 },
          "blocker_code_if_failing": { "type": "string", "minLength": 1 },
          "operator_actionable_if_missing": { "type": "boolean" },
          "operator_actionable_if_stale": { "type": "boolean" },
          "operator_actionable_if_failing": { "type": "boolean" },
          "schema_relpath": { "type": "string" },
          "readiness_role": {
            "type": "string",
            "enum": ["authority_input", "authority_output", "projection", "diagnostic"]
          }
        },
        "oneOf": [
          { "required": ["producer_command"] },
          { "required": ["producer_function"] }
        ]
      }
    }
  }
}
