{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_to_lite_promotion.v1.schema.json",
  "title": "research_to_lite_promotion.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "promotion_id",
    "research_id",
    "hypothesis_id",
    "proposed_lite_component_type",
    "promotion_status",
    "evidence_packet_refs",
    "result_ledger_refs",
    "validation_summary",
    "regime_evidence",
    "expectancy_evidence",
    "failure_mode_review",
    "governance_compatibility_review",
    "risk_contract_review",
    "stop_logic_review",
    "manual_execution_compatibility",
    "operator_clarity_review",
    "implementation_notes",
    "required_tests",
    "approval_reason_codes",
    "rejection_reason_codes",
    "data_snapshot_refs",
    "methodology_version",
    "code_version",
    "artifact_lineage",
    "reason_codes",
    "reproducibility_notes",
    "approved_by_human",
    "created_at_utc",
    "reviewed_at_utc",
    "source_research_status",
    "eligible_for_lite_implementation",
    "advisory_governance_evidence_only",
    "runtime_mutation_allowed",
    "automatic_lite_promotion_allowed",
    "broker_submit_required",
    "transmit_automation_required",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "research_to_lite_promotion" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_to_lite_promotion_v1" },
    "promotion_id": { "type": "string", "minLength": 1 },
    "research_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "proposed_lite_component_type": {
      "type": "string",
      "enum": ["SLEEVE", "EDGE_CLUSTER_RULE", "REGIME_SIGNAL", "GOVERNANCE_RULE", "STOP_LOGIC", "RISK_RULE", "REPORT_FIELD"]
    },
    "promotion_status": {
      "type": "string",
      "enum": ["NOT_READY", "CANDIDATE", "APPROVED_FOR_LITE_REVIEW", "APPROVED_FOR_LITE_IMPLEMENTATION", "REJECTED", "DEFERRED"]
    },
    "evidence_packet_refs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "result_ledger_refs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "validation_summary": { "type": "string" },
    "regime_evidence": { "type": "string" },
    "expectancy_evidence": { "type": "string" },
    "failure_mode_review": { "type": "string" },
    "governance_compatibility_review": { "type": "string" },
    "risk_contract_review": { "type": "string" },
    "stop_logic_review": { "type": "string" },
    "manual_execution_compatibility": { "type": "string" },
    "operator_clarity_review": { "type": "string" },
    "implementation_notes": { "type": "string" },
    "required_tests": { "type": "array", "items": { "type": "string" } },
    "approval_reason_codes": { "type": "array", "items": { "type": "string" } },
    "rejection_reason_codes": { "type": "array", "items": { "type": "string" } },
    "data_snapshot_refs": { "type": "array", "items": { "type": "string" } },
    "methodology_version": { "type": "string", "minLength": 1 },
    "code_version": { "type": "string", "minLength": 1 },
    "artifact_lineage": { "type": "array", "items": { "type": "object" } },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "reproducibility_notes": { "type": "string" },
    "approved_by_human": { "type": "boolean" },
    "created_at_utc": { "type": "string", "minLength": 20 },
    "reviewed_at_utc": { "type": "string" },
    "source_research_status": { "type": "string" },
    "eligible_for_lite_implementation": { "type": "boolean" },
    "advisory_governance_evidence_only": { "const": true },
    "runtime_mutation_allowed": { "const": false },
    "automatic_lite_promotion_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
