{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/eod_sleeve_review.v1.schema.json",
  "title": "eod_sleeve_review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "review_id",
    "review_type",
    "period_start",
    "period_end",
    "generated_at_utc",
    "input_artifact_refs",
    "sleeve_ids_reviewed",
    "event_ids_reviewed",
    "outcome_rows_reviewed",
    "ai_used",
    "ai_model_source",
    "deterministic_reason_codes",
    "review_summary",
    "trades_opened",
    "trades_closed",
    "missing_receipts",
    "missing_outcomes",
    "slippage_issues",
    "stop_behavior_issues",
    "event_regime_attribution",
    "sleeve_warnings",
    "recommendations",
    "research_tasks_created_or_recommended",
    "safety_boundaries_confirmed",
    "manual_execution_only",
    "broker_submit_required",
    "runtime_mutation_allowed",
    "trade_creation_allowed",
    "automatic_promotion_allowed",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "eod_sleeve_review" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "eod_sleeve_review_v1" },
    "review_id": { "type": "string", "minLength": 1 },
    "review_type": { "const": "EOD" },
    "period_start": { "type": "string", "minLength": 10 },
    "period_end": { "type": "string", "minLength": 10 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "input_artifact_refs": { "type": "array", "items": { "type": "object" } },
    "sleeve_ids_reviewed": { "type": "array", "items": { "type": "string" } },
    "event_ids_reviewed": { "type": "array", "items": { "type": "string" } },
    "outcome_rows_reviewed": { "type": "integer", "minimum": 0 },
    "ai_used": { "const": false },
    "ai_model_source": { "type": "string" },
    "deterministic_reason_codes": { "type": "array", "items": { "type": "string" } },
    "review_summary": { "type": "object" },
    "trades_opened": { "type": "array", "items": { "type": "object" } },
    "trades_closed": { "type": "array", "items": { "type": "object" } },
    "missing_receipts": { "type": "array", "items": { "type": "object" } },
    "missing_outcomes": { "type": "array", "items": { "type": "object" } },
    "slippage_issues": { "type": "array", "items": { "type": "object" } },
    "stop_behavior_issues": { "type": "array", "items": { "type": "object" } },
    "event_regime_attribution": { "type": "object" },
    "sleeve_warnings": { "type": "array", "items": { "type": "object" } },
    "recommendations": { "type": "array", "items": { "type": "object" } },
    "research_tasks_created_or_recommended": { "type": "array", "items": { "type": "object" } },
    "safety_boundaries_confirmed": { "type": "object" },
    "manual_execution_only": { "const": true },
    "broker_submit_required": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "trade_creation_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
