{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/advisory_evidence_packet.v1.schema.json",
  "title": "Advisory Evidence Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "advisory_packet_id",
    "generated_at",
    "day_utc",
    "status",
    "ai_consumption_allowed",
    "promoted_commit",
    "evaluated_commit",
    "truth_root",
    "runtime_root",
    "control_plane_ref",
    "control_plane_final_status",
    "control_plane_current_domain",
    "control_plane_current_phase",
    "control_plane_canonical_blocker",
    "control_plane_submit_allowed",
    "authority",
    "readiness_authority",
    "submit_authority",
    "operator_action_authority",
    "included_artifacts",
    "excluded_artifacts",
    "warnings",
    "non_actionable_deferred_evidence",
    "producer_contract_v1"
  ],
  "properties": {
    "schema_id": { "const": "advisory_evidence_packet" },
    "schema_version": { "const": "advisory_evidence_packet.v1" },
    "advisory_packet_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "enum": ["PASS", "BLOCKED"] },
    "ai_consumption_allowed": { "type": "boolean" },
    "promoted_commit": { "type": "string" },
    "evaluated_commit": { "type": "string" },
    "packet_commit": { "type": "string" },
    "truth_root": { "type": "string" },
    "runtime_root": { "type": "string" },
    "control_plane_ref": { "type": "object" },
    "control_plane_final_status": { "type": "string" },
    "control_plane_current_domain": { "type": "string" },
    "control_plane_current_phase": { "type": "string" },
    "control_plane_canonical_blocker": { "type": "string" },
    "control_plane_submit_allowed": { "type": "boolean" },
    "authority": { "const": "ADVISORY_ONLY" },
    "readiness_authority": { "const": "aegis_control_plane_v1" },
    "submit_authority": { "const": "aegis_submit_enforcement_v1" },
    "operator_action_authority": { "const": "CONTROL_PLANE_OR_GOVERNED_RECOVERY_ONLY" },
    "included_artifacts": { "type": "array" },
    "excluded_artifacts": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "non_actionable_deferred_evidence": { "type": "array" },
    "producer_contract_v1": { "type": "object" }
  }
}
