{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/day_failure_causality.v1.schema.json",
  "title": "day_failure_causality.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_at_utc",
    "producer",
    "status",
    "final_operator_classification",
    "first_failing_artifact_id",
    "first_failing_artifact_path",
    "first_failing_field",
    "first_failing_code",
    "first_failing_owner_tool",
    "first_failing_owner_contract",
    "direct_stderr",
    "propagation_chain",
    "operator_message"
  ],
  "properties": {
    "schema_id": { "const": "day_failure_causality" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_at_utc": { "type": "string", "minLength": 20 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "type": "string", "enum": ["NO_FAILURE_DETECTED", "FAILURE_DETECTED"] },
    "final_operator_classification": { "type": "string", "minLength": 1 },
    "first_failing_artifact_id": { "type": "string" },
    "first_failing_artifact_path": { "type": "string" },
    "first_failing_field": { "type": "string" },
    "first_failing_code": { "type": "string" },
    "first_failing_owner_tool": { "type": "string" },
    "first_failing_owner_contract": { "type": "string" },
    "direct_returncode": { "type": ["integer", "null"] },
    "direct_stderr": { "type": "string" },
    "propagation_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_path", "observed_status", "failing_code"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "observed_status": { "type": "string" },
          "failing_code": { "type": "string" }
        }
      }
    },
    "operator_message": { "type": "string", "minLength": 1 }
  }
}
