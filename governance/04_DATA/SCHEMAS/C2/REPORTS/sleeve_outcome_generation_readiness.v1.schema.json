{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/sleeve_outcome_generation_readiness.v1.schema.json",
  "title": "Sleeve Outcome Generation Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "generated_at",
    "git_commit",
    "git_dirty_status",
    "truth_root",
    "runtime_root",
    "execution_root",
    "producer",
    "authority",
    "readiness_effect",
    "submit_effect",
    "allocation_effect",
    "same_day_execution_requirements",
    "scoring_eligible_sleeves",
    "sleeve_results",
    "summary",
    "producer_contract_v1"
  ],
  "properties": {
    "schema_id": { "const": "sleeve_outcome_generation_readiness" },
    "schema_version": { "const": "sleeve_outcome_generation_readiness.v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string", "minLength": 1 },
    "git_dirty_status": { "type": "string", "enum": ["CLEAN", "DIRTY"] },
    "truth_root": { "type": "string", "minLength": 1 },
    "runtime_root": { "type": "string", "minLength": 1 },
    "execution_root": { "type": "string", "minLength": 1 },
    "producer": { "const": "ops/tools/run_sleeve_outcome_generation_readiness_v1.py" },
    "authority": { "const": "DIAGNOSTIC_ONLY" },
    "readiness_effect": { "const": "NONE" },
    "submit_effect": { "const": "NONE" },
    "allocation_effect": { "const": "NONE" },
    "same_day_execution_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "producer",
          "producer_command",
          "expected_artifact_path",
          "freshness_threshold_seconds",
          "must_be_produced_during_target_day",
          "recovery_command"
        ],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "producer": { "type": "string", "minLength": 1 },
          "producer_command": { "type": "string", "minLength": 1 },
          "expected_artifact_path": { "type": "string", "minLength": 1 },
          "freshness_threshold_seconds": { "type": ["number", "null"], "minimum": 0 },
          "must_be_produced_during_target_day": { "type": "boolean" },
          "recovery_command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scoring_eligible_sleeves": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sleeve_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sleeve_id",
          "intent_id",
          "intent_artifact",
          "signal_trigger",
          "market_inputs",
          "risk_sizing_result",
          "sizing_audit",
          "authorization_details",
          "execution_package_readiness",
          "submit_trace_readiness",
          "scoring_eligible",
          "execution_ready_if_aegis_ready",
          "root_cause_classification",
          "same_day_evidence_status",
          "why_did_not_submit",
          "missing_evidence",
          "next_governed_producer",
          "recovery_command",
          "outcome_generation_blockers",
          "evidence_paths"
        ],
        "properties": {
          "sleeve_id": { "type": "string", "minLength": 1 },
          "intent_id": { "type": "string", "minLength": 1 },
          "intent_artifact": { "type": "string" },
          "signal_trigger": { "type": "string" },
          "market_inputs": {
            "type": "object",
            "additionalProperties": true,
            "required": ["symbol", "missing_inputs"]
          },
          "risk_sizing_result": {
            "type": "object",
            "additionalProperties": true,
            "required": ["sizing_state", "execution_package_path", "final_quantity", "reason_code"]
          },
          "sizing_audit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "source_artifact",
              "requested_target_pct",
              "nav_basis",
              "risk_per_unit_cents",
              "stop_distance_bps",
              "requested_quantity",
              "requested_quantity_basis",
              "authorized_quantity",
              "final_quantity",
              "required_risk_cents",
              "sleeve_headroom_cents",
              "portfolio_headroom_cents",
              "policy_reason_codes",
              "sleeve_governance_control",
              "root_cause"
            ],
            "properties": {
              "source": { "const": "capital_authority_allocation_v1" },
              "source_artifact": { "type": "string" },
              "requested_target_pct": { "type": "string" },
              "nav_basis": {
                "type": "object",
                "additionalProperties": false,
                "required": ["account_net_liquidation_cents", "allowed_risk_cents"],
                "properties": {
                  "account_net_liquidation_cents": { "type": ["integer", "null"] },
                  "allowed_risk_cents": { "type": ["integer", "null"] }
                }
              },
              "risk_per_unit_cents": { "type": ["integer", "null"] },
              "stop_distance_bps": { "type": ["integer", "null"] },
              "requested_quantity": { "type": ["integer", "null"] },
              "requested_quantity_basis": { "type": ["string", "null"] },
              "authorized_quantity": { "type": ["integer", "null"] },
              "final_quantity": { "type": ["integer", "null"] },
              "required_risk_cents": { "type": ["integer", "null"] },
              "sleeve_headroom_cents": { "type": ["integer", "null"] },
              "portfolio_headroom_cents": { "type": ["integer", "null"] },
              "policy_reason_codes": { "type": "array", "items": { "type": "string" } },
              "sleeve_governance_control": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope_id",
                  "artifact_status",
                  "control_state",
                  "diagnostic",
                  "effective_headroom_cents",
                  "reason_codes"
                ],
                "properties": {
                  "scope_id": { "type": "string" },
                  "artifact_status": { "type": "string" },
                  "control_state": { "type": "string" },
                  "diagnostic": { "type": "string" },
                  "effective_headroom_cents": { "type": ["integer", "null"] },
                  "reason_codes": { "type": "array", "items": { "type": "string" } }
                }
              },
              "root_cause": { "type": "string", "minLength": 1 }
            }
          },
          "authorization_details": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "artifact_path",
              "authorization_status",
              "authorized_quantity",
              "rejection_reason",
              "policy_rules",
              "required_recovery_command"
            ]
          },
          "execution_package_readiness": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status", "expected_path", "producer", "recovery_command"]
          },
          "submit_trace_readiness": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status", "producer", "recovery_command"]
          },
          "scoring_eligible": { "type": "boolean" },
          "execution_ready_if_aegis_ready": { "type": "boolean" },
          "root_cause_classification": { "type": "array", "items": { "type": "string" } },
          "same_day_evidence_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "blocking_artifact",
              "reason_codes",
              "must_be_produced_during_target_day",
              "recovery_command"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "NON_RECOVERABLE_STALE_SAME_DAY_EVIDENCE",
                  "RECOVERABLE_DURING_TARGET_DAY_ONLY",
                  "NOT_BLOCKED_BY_SAME_DAY_FRESHNESS"
                ]
              },
              "blocking_artifact": { "type": "string" },
              "reason_codes": { "type": "array", "items": { "type": "string" } },
              "must_be_produced_during_target_day": { "type": "boolean" },
              "recovery_command": { "type": "string" }
            }
          },
          "why_did_not_submit": { "type": "array", "items": { "type": "string" } },
          "missing_evidence": { "type": "array", "items": { "type": "string" } },
          "next_governed_producer": { "type": "string", "minLength": 1 },
          "recovery_command": { "type": "string", "minLength": 1 },
          "outcome_generation_blockers": { "type": "array", "items": { "type": "string" } },
          "evidence_paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_intent_count",
        "execution_ready_count",
        "completed_outcome_ready_count",
        "allocation_eligibility_effect"
      ],
      "properties": {
        "eligible_intent_count": { "type": "integer", "minimum": 0 },
        "execution_ready_count": { "type": "integer", "minimum": 0 },
        "completed_outcome_ready_count": { "type": "integer", "minimum": 0 },
        "allocation_eligibility_effect": { "const": "NONE" }
      }
    },
    "producer_contract_v1": { "type": "object" }
  }
}
