{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_session_envelope.v1.schema.json",
  "title": "paper_session_envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "envelope_id",
    "session_id",
    "day_utc",
    "mode",
    "graph_fingerprint",
    "dependency_keys",
    "admitted_sleeve_ids",
    "allowed_truth_roots",
    "execution_entrypoint",
    "contract_fingerprints",
    "config_fingerprint",
    "valid_from",
    "valid_until"
  ],
  "properties": {
    "schema_id": { "const": "paper_session_envelope" },
    "schema_version": { "const": "v1" },
    "envelope_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["PAPER"] },
    "graph_fingerprint": { "type": "string", "minLength": 1 },
    "dependency_keys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "admitted_sleeve_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_truth_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "execution_entrypoint": { "type": "string", "minLength": 1 },
    "contract_fingerprints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 1 }
        }
      }
    },
    "config_fingerprint": { "type": "string", "minLength": 1 },
    "valid_from": { "type": "string", "minLength": 1 },
    "valid_until": { "type": "string", "minLength": 1 }
  }
}
