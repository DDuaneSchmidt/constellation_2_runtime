{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/sleeve_intent_quality_diagnostics.v1.schema.json",
  "title": "Sleeve Intent Quality Diagnostics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "generated_at",
    "git_commit",
    "git_dirty_status",
    "truth_root",
    "runtime_root",
    "producer",
    "authority",
    "readiness_effect",
    "submit_effect",
    "allocation_effect",
    "sleeve_diagnostics",
    "intent_diagnostics",
    "differentiation_diagnostics",
    "risk_sizing_diagnostics",
    "producer_contract_v1"
  ],
  "properties": {
    "schema_id": { "const": "sleeve_intent_quality_diagnostics" },
    "schema_version": { "const": "sleeve_intent_quality_diagnostics.v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string", "minLength": 1 },
    "git_dirty_status": { "type": "string", "enum": ["CLEAN", "DIRTY"] },
    "truth_root": { "type": "string", "minLength": 1 },
    "runtime_root": { "type": "string", "minLength": 1 },
    "producer": { "const": "ops/tools/run_sleeve_intent_quality_diagnostics_v1.py" },
    "authority": { "const": "DIAGNOSTIC_ONLY" },
    "readiness_effect": { "const": "NONE" },
    "submit_effect": { "const": "NONE" },
    "allocation_effect": { "const": "NONE" },
    "sleeve_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sleeve_id",
          "status",
          "evaluated_universe_count",
          "trigger_count",
          "rejected_candidate_count",
          "no_intent_reason",
          "missing_data_reason",
          "downstream_blocker"
        ],
        "additionalProperties": true
      }
    },
    "intent_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sleeve_id",
          "intent_id",
          "signal_id",
          "signal_trigger_reason",
          "inputs_used",
          "missing_inputs",
          "trigger_threshold",
          "rejection_reason",
          "downstream_blocker",
          "intent_reached_risk_sizing"
        ],
        "additionalProperties": true
      }
    },
    "differentiation_diagnostics": {
      "type": "object",
      "required": ["possible_hidden_correlation", "overlapping_symbol_groups"],
      "additionalProperties": true
    },
    "risk_sizing_diagnostics": {
      "type": "object",
      "required": ["status", "root_cause", "correction_path", "evidence_paths"],
      "additionalProperties": true
    },
    "producer_contract_v1": { "type": "object" }
  }
}
