{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/aegis_readiness_reconciliation_plan.v1.schema.json",
  "title": "aegis_readiness_reconciliation_plan.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "plan_id",
    "target_day",
    "runtime_mode",
    "desired_state_ref",
    "desired_state_hash",
    "current_control_plane_ref",
    "current_control_plane_hash",
    "dependency_graph",
    "ordered_actions",
    "skipped_actions",
    "nonrecoverable_blockers",
    "safety_assertions",
    "no_submit",
    "producer_contract_v1",
    "dry_run_status"
  ],
  "properties": {
    "schema_id": { "const": "aegis_readiness_reconciliation_plan" },
    "schema_version": { "const": "aegis_readiness_reconciliation_plan.v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "target_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "runtime_mode": { "type": "string", "enum": ["CANDIDATE", "PRODUCTION"] },
    "desired_state_ref": { "type": "string" },
    "desired_state_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "current_control_plane_ref": { "type": "string" },
    "current_control_plane_hash": { "type": "string" },
    "dependency_graph": { "type": "array" },
    "ordered_actions": { "type": "array" },
    "skipped_actions": { "type": "array" },
    "nonrecoverable_blockers": { "type": "array" },
    "safety_assertions": { "type": "object" },
    "no_submit": { "const": true },
    "producer_contract_v1": { "type": "object" },
    "dry_run_status": { "type": "string", "enum": ["PASS", "BLOCKED"] }
  }
}
