{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/constitutional_decision.v1.schema.json",
  "title": "constitutional_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "decision_id",
    "proposal_hash",
    "fact_bundle_hash",
    "policy_version",
    "decision_enum",
    "effective_scope",
    "authorization_issuable",
    "approval_required",
    "required_fact_types",
    "gate_results",
    "blocker_rules",
    "rule_provenance",
    "negative_evidence",
    "evaluated_at",
    "decision_time_utc"
  ],
  "properties": {
    "schema_id": { "const": "constitutional_decision" },
    "schema_version": { "const": "v1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "proposal_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fact_bundle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "decision_enum": {
      "type": "string",
      "enum": [
        "AUTO_EXECUTE",
        "AUTO_EXECUTE_PROTECTIVE",
        "REQUIRE_HUMAN_REVIEW",
        "ADVISORY_ONLY",
        "DEFER",
        "BLOCK",
        "FREEZE_SCOPE"
      ]
    },
    "effective_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global", "domain", "account", "sleeve", "action_class", "effective_authority"],
      "properties": {
        "global": { "type": "string" },
        "domain": { "type": "string" },
        "account": { "type": "string" },
        "sleeve": { "type": "string" },
        "action_class": { "type": "string" },
        "effective_authority": { "type": "string", "minLength": 1 }
      }
    },
    "authorization_issuable": { "type": "boolean" },
    "approval_required": { "type": "boolean" },
    "required_fact_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gate_results": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_index", "gate_name", "outcome", "detail"],
        "properties": {
          "gate_index": { "type": "integer", "minimum": 1, "maximum": 10 },
          "gate_name": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocker_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rule_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "gate_index", "outcome", "detail"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "gate_index": { "type": "integer", "minimum": 1, "maximum": 10 },
          "outcome": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "fact", "severity", "detail"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "fact": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["INFO", "NON_BLOCKING", "BLOCKING"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "decision_time_utc": { "type": "string", "minLength": 1 }
  }
}
