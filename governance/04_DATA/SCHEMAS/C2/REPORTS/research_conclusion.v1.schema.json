{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_conclusion.v1.schema.json",
  "title": "research_conclusion.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "conclusion_id", "hypothesis_id", "program_id", "created_at_utc", "conclusion_summary", "conclusion_status", "supporting_evidence_refs", "contradictory_evidence_refs", "result_ledger_refs", "confidence_level", "confidence_trend", "regime_specificity", "edge_family", "operational_implications", "known_failure_modes", "limitations", "invalidation_conditions", "reproducibility_notes", "methodology_version", "data_snapshot_refs", "code_version", "created_by", "reviewed_by", "supersedes_conclusion_ids", "superseded_by_conclusion_id", "artifact_lineage", "reason_codes", "research_lab_only", "runtime_mutation_allowed", "trade_authorization_allowed", "automatic_promotion_allowed", "broker_submit_required", "transmit_automation_required", "immutable_artifact", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "research_conclusion" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_conclusion_v1" },
    "conclusion_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "program_id": { "type": "string" },
    "created_at_utc": { "type": "string", "minLength": 20 },
    "conclusion_summary": { "type": "string", "minLength": 1 },
    "conclusion_status": { "type": "string", "enum": ["ACTIVE", "SUPERSEDED", "CONTRADICTED", "ARCHIVED"] },
    "supporting_evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "contradictory_evidence_refs": { "type": "array", "items": { "type": "string" } },
    "result_ledger_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "confidence_level": { "type": "string" },
    "confidence_trend": { "type": "string" },
    "regime_specificity": { "type": "string" },
    "edge_family": { "type": "string" },
    "operational_implications": { "type": "array", "items": { "type": "string" } },
    "known_failure_modes": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "invalidation_conditions": { "type": "array", "items": { "type": "string" } },
    "reproducibility_notes": { "type": "string", "minLength": 1 },
    "methodology_version": { "type": "string", "minLength": 1 },
    "data_snapshot_refs": { "type": "array", "items": { "type": "string" } },
    "code_version": { "type": "string", "minLength": 1 },
    "created_by": { "type": "string" },
    "reviewed_by": { "type": "string" },
    "supersedes_conclusion_ids": { "type": "array", "items": { "type": "string" } },
    "superseded_by_conclusion_id": { "type": "string" },
    "artifact_lineage": { "type": "array", "items": { "type": "object" } },
    "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "research_lab_only": { "const": true },
    "runtime_mutation_allowed": { "const": false },
    "trade_authorization_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "immutable_artifact": { "const": true },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
