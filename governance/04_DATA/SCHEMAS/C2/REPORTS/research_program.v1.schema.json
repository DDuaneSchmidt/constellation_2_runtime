{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_program.v1.schema.json",
  "title": "research_program.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "program_id", "title", "thesis", "status", "related_hypotheses", "edge_families", "regimes", "instruments", "current_open_questions", "summary_findings", "research_priority", "owner_notes", "created_at_utc", "updated_at_utc", "research_lab_only", "can_authorize_promotion", "runtime_mutation_allowed", "trade_authorization_allowed", "automatic_promotion_allowed", "broker_submit_required", "transmit_automation_required", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "research_program" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_program_v1" },
    "program_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "thesis": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "COMPLETE", "ARCHIVED"] },
    "related_hypotheses": { "type": "array", "items": { "type": "string" } },
    "edge_families": { "type": "array", "items": { "type": "string" } },
    "regimes": { "type": "array", "items": { "type": "string" } },
    "instruments": { "type": "array", "items": { "type": "string" } },
    "current_open_questions": { "type": "array", "items": { "type": "string" } },
    "summary_findings": { "type": "array", "items": { "type": "string" } },
    "research_priority": { "type": "string" },
    "owner_notes": { "type": "string" },
    "created_at_utc": { "type": "string", "minLength": 20 },
    "updated_at_utc": { "type": "string", "minLength": 20 },
    "research_lab_only": { "const": true },
    "can_authorize_promotion": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "trade_authorization_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
