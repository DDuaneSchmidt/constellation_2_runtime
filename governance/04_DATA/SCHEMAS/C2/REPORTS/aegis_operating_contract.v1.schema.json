{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/aegis_operating_contract.v1.schema.json",
  "title": "aegis_operating_contract.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_id", "schema_version", "day_utc", "mode", "run_style", "target_sleeve", "required_phases", "required_authorities_by_phase", "required_services_by_mode_run_style", "no_silent_day_rule"],
  "properties": {
    "schema_id": { "const": "aegis_operating_contract" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "mode": { "type": "string", "enum": ["DRY_RUN", "PAPER_TRANSMIT", "LIVE"] },
    "run_style": { "type": "string", "enum": ["MANUAL", "AUTO"] },
    "target_sleeve": { "type": "string", "minLength": 1 },
    "required_phases": {
      "type": "array",
      "items": { "type": "string", "enum": ["PRE_MARKET", "INTENT", "MATERIALIZATION", "SUBMIT", "POST_SUBMIT", "CLOSURE", "PACKET"] }
    },
    "required_authorities_by_phase": { "type": "object" },
    "required_services_by_mode_run_style": { "type": "object" },
    "success_states": { "type": "array", "items": { "type": "string" } },
    "fail_states": { "type": "array", "items": { "type": "string" } },
    "allowed_diagnostic_states": { "type": "array", "items": { "type": "string" } },
    "no_silent_day_rule": {
      "type": "object",
      "required": ["allowed_outcomes", "mutually_exclusive", "exactly_one_required"],
      "properties": {
        "allowed_outcomes": {
          "type": "array",
          "items": { "type": "string", "enum": ["SUCCESS_DRY_RUN", "SUCCESS_TRANSMITTED", "NO_INTENT_EXPECTED", "BLOCKED_WITH_REASON", "FAILED_WITH_OWNER"] }
        },
        "mutually_exclusive": { "const": true },
        "exactly_one_required": { "const": true }
      }
    }
  }
}
