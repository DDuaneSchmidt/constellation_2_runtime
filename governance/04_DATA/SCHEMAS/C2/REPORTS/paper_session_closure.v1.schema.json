{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_session_closure.v1.schema.json",
  "title": "paper_session_closure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "closure_id",
    "session_id",
    "day_utc",
    "graph_ref",
    "blocker_ledger_ref",
    "producer_attempts_ref",
    "status",
    "node_results",
    "edge_results",
    "unresolved_blockers",
    "evaluated_at"
  ],
  "properties": {
    "schema_id": { "const": "paper_session_closure" },
    "schema_version": { "const": "v1" },
    "closure_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 1 },
    "graph_ref": { "type": "string", "minLength": 1 },
    "blocker_ledger_ref": { "type": "string", "minLength": 1 },
    "producer_attempts_ref": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "node_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "dependency_key",
          "status",
          "checks"
        ],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "dependency_key": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "checks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "edge_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_node_id", "to_node_id", "status"],
        "properties": {
          "from_node_id": { "type": "string", "minLength": 1 },
          "to_node_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evaluated_at": { "type": "string", "minLength": 1 }
  }
}
