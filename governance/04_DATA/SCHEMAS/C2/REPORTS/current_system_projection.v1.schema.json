{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/current_system_projection.v1.schema.json",
  "title": "current_system_projection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "projection_id",
    "generated_at_utc",
    "journal_ref",
    "journal_id",
    "journal_event_count",
    "day_attempt_id",
    "pipeline_run_id",
    "release_id",
    "git_sha",
    "current_deployment_status",
    "current_startup_status",
    "current_startup_proof_status",
    "current_ledger_status",
    "current_submission_status",
    "authoritative_day_start_decision",
    "first_true_blocker_code",
    "first_true_blocker_source",
    "operator_action_required",
    "operator_action_summary",
    "contradiction_status",
    "contradictions",
    "operational_evidence",
    "source_artifacts",
    "source_generated_at_utc",
    "non_authority_notice",
    "producer"
  ],
  "properties": {
    "schema_id": { "const": "current_system_projection" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "DERIVED_ONLY_CURRENT_SYSTEM_PROJECTION" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "projection_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "journal_ref": { "type": "string", "minLength": 1 },
    "journal_id": { "type": "string", "minLength": 1 },
    "journal_event_count": { "type": "integer", "minimum": 0 },
    "day_attempt_id": { "type": "string", "minLength": 1 },
    "pipeline_run_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "current_deployment_status": { "type": "string", "minLength": 1 },
    "current_startup_status": { "type": "string", "minLength": 1 },
    "current_startup_proof_status": { "type": "string", "minLength": 1 },
    "current_ledger_status": { "type": "string", "minLength": 1 },
    "current_submission_status": { "type": "string", "minLength": 1 },
    "authoritative_day_start_decision": { "type": "string", "minLength": 1 },
    "first_true_blocker_code": { "type": "string" },
    "first_true_blocker_source": { "type": "string" },
    "operator_action_required": { "type": "boolean" },
    "operator_action_summary": { "type": "string", "minLength": 1 },
    "contradiction_status": { "type": "string", "enum": ["NONE", "PRESENT"] },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contradiction_code", "summary", "source_paths"],
        "properties": {
          "contradiction_code": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source_paths": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "operational_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal_status",
        "required_event_types_present",
        "missing_required_event_types",
        "source_artifact_count",
        "source_artifacts_complete"
      ],
      "properties": {
        "journal_status": { "type": "string", "minLength": 1 },
        "required_event_types_present": { "type": "boolean" },
        "missing_required_event_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_artifact_count": { "type": "integer", "minimum": 0 },
        "source_artifacts_complete": { "type": "boolean" }
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "path", "generated_at_utc", "sha256", "status", "producer_git_sha"],
        "properties": {
          "logical_name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "generated_at_utc": { "type": "string" },
          "sha256": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "producer_git_sha": { "type": "string" }
        }
      }
    },
    "source_generated_at_utc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_state_machine_v1",
        "startup_materialization_v1",
        "startup_proof_validation_v1",
        "paper_session_ledger_v1",
        "trading_day_state_machine_v1"
      ],
      "properties": {
        "deployment_state_machine_v1": { "type": "string" },
        "startup_materialization_v1": { "type": "string" },
        "startup_proof_validation_v1": { "type": "string" },
        "paper_session_ledger_v1": { "type": "string" },
        "trading_day_state_machine_v1": { "type": "string" }
      }
    },
    "non_authority_notice": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    }
  }
}

