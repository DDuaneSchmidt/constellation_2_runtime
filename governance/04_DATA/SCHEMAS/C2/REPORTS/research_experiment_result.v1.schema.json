{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_experiment_result.v1.schema.json",
  "title": "research_experiment_result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "experiment_id", "hypothesis_id", "task_id", "dataset_used", "test_window", "trigger_definition", "outcome_definition", "sample_count", "expectancy", "win_rate", "drawdown", "regime_dependency", "robustness_notes", "overlap_with_existing_sleeves", "result_status", "recommendation", "next_action", "completed_stage", "completed_at_utc", "research_lab_only", "executable_trade_created", "automatic_promotion_allowed", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "research_experiment_result" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_experiment_result_v1" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "dataset_used": { "type": "string" },
    "test_window": { "type": "string" },
    "trigger_definition": { "type": "string" },
    "outcome_definition": { "type": "string" },
    "sample_count": { "type": "integer", "minimum": 0 },
    "expectancy": { "type": "string" },
    "win_rate": { "type": "string" },
    "drawdown": { "type": "string" },
    "regime_dependency": { "type": "string" },
    "robustness_notes": { "type": "string" },
    "overlap_with_existing_sleeves": { "type": "string" },
    "result_status": { "type": "string", "enum": ["insufficient_data", "weak", "promising", "regime_dependent", "overlapping", "rejected", "validated_candidate"] },
    "recommendation": { "type": "string" },
    "next_action": { "type": "string" },
    "completed_stage": { "type": "string" },
    "completed_at_utc": { "type": "string" },
    "research_lab_only": { "const": true },
    "executable_trade_created": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
