{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_session_authority.v1.schema.json",
  "title": "paper_session_authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "produced_utc",
    "mode",
    "authority_status",
    "paper_open_allowed",
    "blocking_reason_codes",
    "blocking_reason_details",
    "safety_checks",
    "advisory_checks",
    "degraded_mode",
    "submission_authorized",
    "upstream_refs",
    "producer"
  ],
  "properties": {
    "schema_id": { "const": "paper_session_authority" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "CANONICAL_PAPER_SESSION_AUTHORITY" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["PAPER"] },
    "authority_status": { "type": "string", "enum": ["GRANTED", "DENIED"] },
    "paper_open_allowed": { "type": "boolean" },
    "blocking_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocking_reason_details": {
      "type": "array",
      "items": { "$ref": "#/$defs/reasonDetail" }
    },
    "safety_checks": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/check" }
    },
    "advisory_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "degraded_mode": { "type": "boolean" },
    "submission_authorized": { "type": "boolean" },
    "upstream_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_session_bootstrap_v1",
        "paper_capital_seed",
        "operator_statement",
        "pre_open_bundle_v1",
        "canonical_kill_switch_v1"
      ],
      "properties": {
        "paper_session_bootstrap_v1": { "type": "string", "minLength": 1 },
        "paper_capital_seed": { "type": "string" },
        "operator_statement": { "type": "string" },
        "pre_open_bundle_v1": { "type": "string" },
        "canonical_kill_switch_v1": { "type": "string" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "reason_code",
        "summary",
        "artifact_path"
      ],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "ADVISORY"] },
        "reason_code": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string" }
      }
    },
    "reasonDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "blocker_class",
        "check_id",
        "summary",
        "artifact_path"
      ],
      "properties": {
        "reason_code": { "type": "string", "minLength": 1 },
        "blocker_class": { "type": "string", "enum": ["SAFETY_CRITICAL"] },
        "check_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string" }
      }
    }
  }
}
