{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2.reports.diagnostic_decision_ledger.v1",
  "title": "C2 Diagnostic Decision Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "diagnostic_ruleset_id",
    "diagnostic_ruleset_version",
    "day_utc",
    "selected_attempt_id",
    "evidence_refs",
    "root_cause_rules_evaluated",
    "root_cause_winning_rule",
    "intent_absence_rules_evaluated",
    "intent_absence_winning_rule",
    "final_classifications"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "diagnostic_decision_ledger_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "diagnostic_ruleset_id": { "type": "string", "minLength": 1 },
    "diagnostic_ruleset_version": { "type": "integer", "minimum": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "selected_attempt_id": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "root_cause_rules_evaluated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "matched", "reason"],
        "properties": {
          "rule_id": { "type": "string" },
          "matched": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "root_cause_winning_rule": { "type": "string" },
    "intent_absence_rules_evaluated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "matched", "reason"],
        "properties": {
          "rule_id": { "type": "string" },
          "matched": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "intent_absence_winning_rule": { "type": "string" },
    "final_classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause", "intent_absence"],
      "properties": {
        "root_cause": { "type": "string" },
        "intent_absence": { "type": "string" }
      }
    }
  }
}
