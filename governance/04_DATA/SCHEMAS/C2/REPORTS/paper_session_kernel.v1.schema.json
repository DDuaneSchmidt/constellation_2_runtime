{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_session_kernel.v1.schema.json",
  "title": "paper_session_kernel.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "session_id",
    "kernel_decision_id",
    "evaluated_at_utc",
    "manifest_id",
    "evidence_digest",
    "current_state",
    "authority_status",
    "system_ready",
    "submission_authorized",
    "blocking_codes",
    "transition_history",
    "finalization_status",
    "provenance"
  ],
  "properties": {
    "schema_id": { "const": "paper_session_kernel" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "CANONICAL_SESSION_AUTHORITY" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "session_id": { "type": "string", "minLength": 1 },
    "kernel_decision_id": { "type": "string", "minLength": 1 },
    "evaluated_at_utc": { "type": "string", "minLength": 20 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "evidence_digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "current_state": { "const": "SESSION_FINALIZED" },
    "authority_status": { "type": "string", "enum": ["GRANTED", "DENIED"] },
    "system_ready": { "type": "boolean" },
    "submission_authorized": { "type": "boolean" },
    "blocking_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "transition_history": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_state",
          "to_state",
          "transition_at_utc",
          "transition_reason_code",
          "evidence_reference"
        ],
        "properties": {
          "from_state": { "type": "string", "minLength": 1 },
          "to_state": { "type": "string", "minLength": 1 },
          "transition_at_utc": { "type": "string", "minLength": 20 },
          "transition_reason_code": { "type": "string", "minLength": 1 },
          "evidence_reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "finalization_status": { "const": "FINALIZED" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    }
  }
}
