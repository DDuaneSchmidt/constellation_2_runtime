{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_trading_posture.v1.schema.json",
  "title": "paper_trading_posture.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "session_id",
    "system_ready",
    "posture_status",
    "posture_class",
    "blocking_family",
    "expected_no_op_today",
    "policy_reasons",
    "blocking_codes",
    "blocking_reason_codes",
    "source_dependencies",
    "producer",
    "produced_at_utc",
    "freshness_verdict",
    "linkage_verdict"
  ],
  "properties": {
    "schema_id": { "const": "paper_trading_posture" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "NON_AUTHORITY_FACT" },
    "binding_classification": { "type": "string", "const": "NON_BINDING_DIAGNOSTIC" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "session_id": { "type": "string", "minLength": 1 },
    "system_ready": { "type": "boolean" },
    "posture_status": {
      "type": "string",
      "enum": ["ENABLED", "DISABLED", "BLOCKED", "UNKNOWN", "STALE", "MALFORMED"]
    },
    "posture_class": { "type": "string", "minLength": 1 },
    "blocking_family": { "type": "string", "minLength": 1 },
    "expected_no_op_today": { "type": "boolean" },
    "policy_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocking_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocking_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceDependency" }
    },
    "producer": { "$ref": "#/$defs/producer" },
    "produced_at_utc": { "type": "string", "minLength": 20 },
    "freshness_verdict": { "type": "string", "enum": ["CURRENT", "STALE", "UNKNOWN"] },
    "linkage_verdict": { "type": "string", "enum": ["LINKED", "UNLINKED"] }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "sourceDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "absolute_path", "sha256", "day_utc", "status", "reason_codes", "producer"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "absolute_path": { "type": "string" },
        "sha256": { "type": "string" },
        "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string", "minLength": 1 },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "producer": { "type": "string", "minLength": 1 }
      }
    }
  }
}
