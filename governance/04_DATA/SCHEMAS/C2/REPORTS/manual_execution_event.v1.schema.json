{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/manual_execution_event.v1.schema.json",
  "title": "manual_execution_event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "day_utc",
    "run_id",
    "candidate_id",
    "symbol",
    "direction",
    "instrument_type",
    "side",
    "quantity",
    "order_type",
    "actual_entry_price",
    "stop_price_entered",
    "stop_order_type",
    "ib_order_id",
    "ib_perm_id",
    "execution_time_utc",
    "deviation_from_aegis_plan",
    "operator_notes",
    "observational_only",
    "broker_submit_required",
    "transmit_automation_required",
    "source_artifact_lineage",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "manual_execution_event" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "manual_execution_event_v1" },
    "day_utc": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "direction": { "type": "string", "minLength": 1 },
    "instrument_type": { "type": "string", "minLength": 1 },
    "side": { "type": "string", "minLength": 1 },
    "quantity": { "type": "integer", "minimum": 0 },
    "order_type": { "type": "string", "minLength": 1 },
    "actual_entry_price": { "type": "string" },
    "stop_price_entered": { "type": "string" },
    "stop_order_type": { "type": "string" },
    "ib_order_id": { "type": "string" },
    "ib_perm_id": { "type": "string" },
    "execution_time_utc": { "type": "string", "minLength": 20 },
    "deviation_from_aegis_plan": { "type": "string" },
    "operator_notes": { "type": "string" },
    "observational_only": { "const": true },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "source_artifact_lineage": { "type": "array", "items": { "type": "object" } },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
