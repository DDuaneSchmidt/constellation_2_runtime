{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/execution_dossier.v1.schema.json",
  "title": "execution_dossier.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "generated_utc",
    "day_utc",
    "subsystem_id",
    "current_state",
    "owner_ref",
    "first_blocker",
    "upstream_evidence_refs",
    "ambiguity_state",
    "recommended_operator_action",
    "canonical_owner_status",
    "precedence_resolution",
    "sleeve_id",
    "mode",
    "truth_partition",
    "execution_root_path"
  ],
  "properties": {
    "schema_id": { "const": "execution_dossier" },
    "schema_version": { "const": "v1" },
    "generated_utc": { "type": "string", "minLength": 20 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "subsystem_id": { "const": "execution_authority" },
    "current_state": { "type": "string", "enum": ["READY", "RESOLVED", "BLOCKED"] },
    "owner_ref": { "$ref": "#/$defs/artifact_ref" },
    "first_blocker": { "$ref": "#/$defs/first_blocker" },
    "upstream_evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    },
    "ambiguity_state": { "$ref": "#/$defs/ambiguity_state" },
    "recommended_operator_action": { "type": "string", "minLength": 1 },
    "canonical_owner_status": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string" },
    "mode": { "type": "string" },
    "truth_partition": { "type": "string" },
    "execution_root_path": { "type": "string" },
    "precedence_resolution": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" }
      }
    },
    "first_blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "summary", "source"],
      "properties": {
        "reason_code": { "type": "string" },
        "summary": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "ref_type", "artifact_path", "artifact_sha256"],
      "properties": {
        "ref_id": { "type": "string", "minLength": 1 },
        "ref_type": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string" }
      }
    },
    "ambiguity_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "reason_codes", "conflicting_authorities"],
      "properties": {
        "status": { "type": "string", "enum": ["CLEAR", "AMBIGUOUS_AUTHORITY"] },
        "summary": { "type": "string" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conflicting_authorities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
