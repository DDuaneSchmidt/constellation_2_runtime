{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_knowledge_graph.v1.schema.json",
  "title": "research_knowledge_graph.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "generated_at_utc",
    "nodes",
    "edges",
    "hypothesis_refs",
    "edge_family_refs",
    "regime_refs",
    "sleeve_refs",
    "evidence_refs",
    "failure_mode_refs",
    "research_lab_only",
    "runtime_mutation_allowed",
    "trade_authorization_allowed",
    "automatic_promotion_allowed",
    "broker_submit_required",
    "transmit_automation_required",
    "non_authoritative_scaffold",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "research_knowledge_graph" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_knowledge_graph_v1" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "nodes": { "type": "array", "items": { "type": "object" } },
    "edges": { "type": "array", "items": { "type": "object" } },
    "hypothesis_refs": { "type": "array", "items": { "type": "string" } },
    "edge_family_refs": { "type": "array", "items": { "type": "string" } },
    "regime_refs": { "type": "array", "items": { "type": "string" } },
    "sleeve_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "failure_mode_refs": { "type": "array", "items": { "type": "string" } },
    "research_lab_only": { "const": true },
    "runtime_mutation_allowed": { "const": false },
    "trade_authorization_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "non_authoritative_scaffold": { "const": true },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
