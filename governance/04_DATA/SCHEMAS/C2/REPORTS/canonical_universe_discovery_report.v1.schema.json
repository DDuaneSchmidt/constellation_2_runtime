{
  "$id": "https://constellation.local/schemas/canonical_universe_discovery_report.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Universe Discovery Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "day_utc", "discovery_source", "requested_target_count", "minimum_required_symbol_count", "discovered_count", "accepted_count", "accepted_symbols", "rejected_count_by_reason", "last_known_good_used", "current_refresh_success", "status", "blocker_codes", "notes", "generated_at", "source_artifacts"],
  "properties": {
    "schema_id": { "const": "canonical_universe_discovery_report" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "discovery_source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requested_target_count": { "type": "integer", "minimum": 1 },
    "minimum_required_symbol_count": { "type": "integer", "minimum": 1 },
    "discovered_count": { "type": "integer", "minimum": 0 },
    "accepted_count": { "type": "integer", "minimum": 0 },
    "accepted_symbols": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
    "rejected_count_by_reason": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "last_known_good_used": { "type": "boolean" },
    "current_refresh_success": { "type": "boolean" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "blocker_codes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "path", "sha256"],
        "properties": {
          "artifact_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string" }
        }
      }
    }
  }
}
