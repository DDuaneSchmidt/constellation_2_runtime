{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/eod_run_manifest.v1.schema.json",
  "title": "eod_run_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "run_id",
    "generated_at_utc",
    "trading_date",
    "release_id",
    "git_commit",
    "repo_dirty_status",
    "active_release_repo_match",
    "market_snapshot_artifact_path",
    "sleeve_eval_artifact_path",
    "raw_candidate_artifact_path",
    "promoted_sleeve_manifest_path",
    "promoted_candidate_artifact_path",
    "readiness_artifact_path",
    "operator_queue_artifact_path",
    "report_artifact_path",
    "overall_status",
    "blockers",
    "advisory_only",
    "broker_transmit_control_touched",
    "ib_submit_automation_invoked",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": {"const": "eod_run_manifest"},
    "schema_version": {"const": "v1"},
    "artifact_id": {"const": "eod_run_manifest_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "minLength": 20},
    "trading_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "release_id": {"type": "string"},
    "git_commit": {"type": "string"},
    "repo_dirty_status": {"type": "string"},
    "active_release_repo_match": {"type": "string"},
    "market_snapshot_artifact_path": {"type": "string"},
    "sleeve_eval_artifact_path": {"type": "string"},
    "raw_candidate_artifact_path": {"type": "string"},
    "promoted_sleeve_manifest_path": {"type": "string"},
    "promoted_candidate_artifact_path": {"type": "string"},
    "readiness_artifact_path": {"type": "string"},
    "operator_queue_artifact_path": {"type": "string"},
    "report_artifact_path": {"type": "string"},
    "candidate_lineage_artifact_path": {"type": "string"},
    "overall_status": {
      "type": "string",
      "enum": ["SUCCESS", "BLOCKED", "ADVISORY_ONLY", "INPUT_CONTRACT_FAILED", "RUNTIME_NOT_READY", "RELEASE_MISMATCH", "DATA_NOT_READY"]
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "advisory_only": {"type": "boolean"},
    "broker_transmit_control_touched": {"const": false},
    "ib_submit_automation_invoked": {"const": false},
    "canonical_json_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
