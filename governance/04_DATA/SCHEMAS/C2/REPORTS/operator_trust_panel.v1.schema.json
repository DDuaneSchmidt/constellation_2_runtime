{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2.reports.operator_trust_panel.v1",
  "title": "C2 Operator Trust Panel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "day_utc", "view_or_query_id", "trust_classification", "finalization_state", "integrity_state", "source_count", "source_refs", "bounded_limitations", "exactness_classification", "suppression_rules_applied", "downgrade_rules_applied"],
  "properties": {
    "schema_id": { "type": "string", "const": "operator_trust_panel_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "view_or_query_id": { "type": "string" },
    "trust_classification": { "type": "string", "enum": ["TRUSTED", "LIMITED", "UNAVAILABLE", "INTEGRITY_CONSTRAINED"] },
    "finalization_state": { "type": "string", "enum": ["FINALIZED", "BOUNDED_PARTIAL", "UNAVAILABLE", "IN_FLIGHT_BLOCKED"] },
    "integrity_state": { "type": "string", "enum": ["OK", "BOUNDED_INCOMPLETE", "EVIDENCE_INCONSISTENT", "INTERNAL_FAILURE"] },
    "source_count": { "type": "integer", "minimum": 0 },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "bounded_limitations": { "type": "array", "items": { "type": "string" } },
    "exactness_classification": { "type": "string", "enum": ["EXACT", "BOUNDED_PARTIAL", "UNAVAILABLE", "INTEGRITY_CONSTRAINED"] },
    "suppression_rules_applied": { "type": "array", "items": { "type": "string" } },
    "downgrade_rules_applied": { "type": "array", "items": { "type": "string" } }
  }
}
