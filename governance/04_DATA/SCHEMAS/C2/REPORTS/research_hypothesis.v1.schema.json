{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_hypothesis.v1.schema.json",
  "title": "research_hypothesis.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "hypothesis_id",
    "created_at_utc",
    "title",
    "hypothesis_summary",
    "market_thesis",
    "edge_family",
    "behavioral_state",
    "expected_regime",
    "expected_direction",
    "expected_holding_period",
    "instruments",
    "rationale",
    "expected_behavior",
    "failure_conditions",
    "invalidation_conditions",
    "related_sleeves",
    "related_research_refs",
    "confidence_level",
    "status",
    "source",
    "notes",
    "research_lab_only",
    "runtime_mutation_allowed",
    "trade_authorization_allowed",
    "automatic_promotion_allowed",
    "broker_submit_required",
    "transmit_automation_required",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "research_hypothesis" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_hypothesis_v1" },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "minLength": 20 },
    "title": { "type": "string", "minLength": 1 },
    "hypothesis_summary": { "type": "string", "minLength": 1 },
    "market_thesis": { "type": "string" },
    "edge_family": { "type": "string" },
    "behavioral_state": { "type": "string" },
    "expected_regime": { "type": "string" },
    "expected_direction": { "type": "string" },
    "expected_holding_period": { "type": "string" },
    "instruments": { "type": "array", "items": { "type": "string" } },
    "rationale": { "type": "string" },
    "expected_behavior": { "type": "string" },
    "failure_conditions": { "type": "array", "items": { "type": "string" } },
    "invalidation_conditions": { "type": "array", "items": { "type": "string" } },
    "related_sleeves": { "type": "array", "items": { "type": "string" } },
    "related_research_refs": { "type": "array", "items": { "type": "string" } },
    "confidence_level": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "IDEA",
        "UNDER_INVESTIGATION",
        "BACKTESTING",
        "REPLAY_REVIEW",
        "OBSERVED_IN_MARKET",
        "VALIDATED_RESEARCH",
        "PROMOTION_CANDIDATE",
        "APPROVED_FOR_LITE",
        "REJECTED",
        "ARCHIVED"
      ]
    },
    "source": {
      "type": "string",
      "enum": ["CHATGPT_SEED", "MANUAL", "RESEARCH_LAB"]
    },
    "notes": { "type": "string" },
    "research_lab_only": { "const": true },
    "runtime_mutation_allowed": { "const": false },
    "trade_authorization_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
