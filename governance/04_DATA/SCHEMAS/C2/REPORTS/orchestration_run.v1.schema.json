{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/orchestration_run.v1.schema.json",
  "title": "Aegis Same-Day Orchestration Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "orchestration_run_id",
    "day_utc",
    "phase",
    "session_state",
    "truth_root",
    "execution_root",
    "runtime_root",
    "started_at",
    "finished_at",
    "producer_results",
    "artifact_results",
    "blockers",
    "recovery_commands",
    "final_status",
    "readiness_authority",
    "submit_authority",
    "readiness_effect",
    "submit_effect",
    "producer_contract_v1"
  ],
  "properties": {
    "schema_id": { "const": "orchestration_run_v1" },
    "schema_version": { "const": "orchestration_run.v1" },
    "orchestration_run_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "phase": { "type": "string", "enum": ["PRE_OPEN", "MARKET_OPEN", "INTRADAY", "PRE_SUBMIT", "EOD"] },
    "session_state": { "type": "string", "minLength": 1 },
    "truth_root": { "type": "string", "minLength": 1 },
    "execution_root": { "type": "string", "minLength": 1 },
    "runtime_root": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "producer_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_id",
          "command",
          "status",
          "artifact_path",
          "validation_status",
          "blocker_code",
          "recovery_command"
        ],
        "properties": {
          "producer_id": { "type": "string", "minLength": 1 },
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "BLOCKED", "SKIPPED", "FAILED"] },
          "artifact_path": { "type": "string" },
          "validation_status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "blocker_code": { "type": "string" },
          "recovery_command": { "type": "string" }
        }
      }
    },
    "artifact_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_id",
          "artifact_id",
          "artifact_path",
          "status",
          "blocker_code",
          "schema_status",
          "target_day_status",
          "truth_root_status",
          "freshness_status"
        ],
        "properties": {
          "producer_id": { "type": "string", "minLength": 1 },
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "blocker_code": { "type": "string" },
          "schema_status": { "type": "string" },
          "target_day_status": { "type": "string" },
          "truth_root_status": { "type": "string" },
          "freshness_status": { "type": "string" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "recovery_commands": { "type": "array", "items": { "type": "string" } },
    "final_status": { "type": "string", "enum": ["PASS", "BLOCKED", "SKIPPED_NON_TRADING_DAY"] },
    "readiness_authority": { "const": "aegis_control_plane_v1" },
    "submit_authority": { "const": "aegis_submit_enforcement_v1" },
    "readiness_effect": { "const": "NONE" },
    "submit_effect": { "const": "NONE" },
    "producer_contract_v1": { "type": "object" }
  }
}
