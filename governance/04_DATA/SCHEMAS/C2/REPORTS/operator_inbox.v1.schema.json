{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/operator_inbox.v1.schema.json",
  "title": "operator_inbox.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "inbox_item_id",
    "title",
    "description",
    "category",
    "source",
    "created_at",
    "updated_at",
    "status",
    "priority",
    "tags",
    "related_artifact_refs",
    "promoted_to_research_idea_id",
    "promoted_to_hypothesis_id",
    "notes",
    "operator_inbox_only",
    "research_task_creation_allowed",
    "trade_creation_allowed",
    "sleeve_creation_allowed",
    "lite_runtime_mutation_allowed",
    "production_mutation_allowed",
    "broker_submit_required",
    "transmit_automation_required",
    "automatic_promotion_allowed",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "operator_inbox" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "operator_inbox_v1" },
    "inbox_item_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "RESEARCH_IDEA",
        "HYPOTHESIS_SEED",
        "SLEEVE_IMPROVEMENT",
        "EVENT_AWARENESS",
        "DATASET_GAP",
        "UI_IMPROVEMENT",
        "OPERATIONAL_FIX",
        "PERFORMANCE_REVIEW",
        "FUTURE_AUTOMATION",
        "OTHER"
      ]
    },
    "source": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 20 },
    "updated_at": { "type": "string", "minLength": 20 },
    "status": {
      "type": "string",
      "enum": [
        "CAPTURED",
        "REVIEWED",
        "PROMOTED_TO_IDEA",
        "PROMOTED_TO_HYPOTHESIS",
        "ARCHIVED",
        "REJECTED"
      ]
    },
    "priority": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "related_artifact_refs": { "type": "array", "items": { "type": "string" } },
    "promoted_to_research_idea_id": { "type": "string" },
    "promoted_to_hypothesis_id": { "type": "string" },
    "notes": { "type": "string" },
    "operator_inbox_only": { "const": true },
    "research_task_creation_allowed": { "const": false },
    "trade_creation_allowed": { "const": false },
    "sleeve_creation_allowed": { "const": false },
    "lite_runtime_mutation_allowed": { "const": false },
    "production_mutation_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
