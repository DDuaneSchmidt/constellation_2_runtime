{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_architecture_integrity_review.v1.schema.json",
  "title": "research_architecture_integrity_review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "review_id", "generated_at_utc", "review_status", "blockers", "warnings", "findings", "checked_artifact_counts", "research_lab_only", "runtime_mutation_allowed", "trade_authorization_allowed", "automatic_promotion_allowed", "broker_submit_required", "transmit_automation_required", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "research_architecture_integrity_review" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_architecture_integrity_review_v1" },
    "review_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "review_status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "checked_artifact_counts": { "type": "object" },
    "research_lab_only": { "const": true },
    "runtime_mutation_allowed": { "const": false },
    "trade_authorization_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
