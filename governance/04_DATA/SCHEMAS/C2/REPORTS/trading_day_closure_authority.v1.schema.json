{
  "$id": "https://constellation.local/schemas/c2/reports/trading_day_closure_authority.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trading Day Closure Authority v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "authority_scope",
    "status",
    "closure_state",
    "reconciliation_complete",
    "reconciliation_required",
    "submission_count",
    "dry_run_submission_count",
    "transmitted_submission_count",
    "unresolved_submissions",
    "closure_gaps",
    "submissions",
    "first_blocker",
    "input_evidence",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_TRADING_DAY_CLOSURE_AUTHORITY_V1" },
    "schema_version": { "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string" },
    "authority_scope": { "const": "TRADING_DAY_CLOSURE" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "closure_state": {
      "type": "string",
      "enum": ["NOT_STARTED", "NO_TRADES_CLOSED", "DRY_RUN_CLOSED", "OPEN_EXECUTIONS", "RECONCILIATION_REQUIRED", "RECONCILED", "CLOSURE_BLOCKED", "CLOSURE_GAP"]
    },
    "reconciliation_complete": { "type": "boolean" },
    "reconciliation_required": { "type": "boolean" },
    "submission_count": { "type": "integer", "minimum": 0 },
    "dry_run_submission_count": { "type": "integer", "minimum": 0 },
    "transmitted_submission_count": { "type": "integer", "minimum": 0 },
    "unresolved_submissions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "closure_gaps": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "submissions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "first_blocker": { "type": "string" },
    "input_evidence": { "type": "array", "items": { "$ref": "#/$defs/input_evidence" } },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "input_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "exists"],
      "properties": {
        "artifact_type": { "type": "string" },
        "path": { "type": "string" },
        "exists": { "type": "boolean" }
      }
    }
  }
}
