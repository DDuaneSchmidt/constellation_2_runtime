{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/startup_materialization.v1.schema.json",
  "title": "startup_materialization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "session_id",
    "status",
    "required_inputs_checked",
    "materialized_outputs",
    "blocking_codes",
    "producer",
    "produced_at_utc",
    "freshness_verdict",
    "linkage_verdict",
    "producer_run_id"
  ],
  "properties": {
    "schema_id": { "const": "startup_materialization" },
    "schema_version": { "const": "v1" },
    "authority_scope": { "const": "NON_AUTHORITY_FACT" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "session_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAIL", "MISSING_DEPENDENCY", "MALFORMED", "STALE", "UNKNOWN"]
    },
    "required_inputs_checked": {
      "type": "array",
      "items": { "$ref": "#/$defs/factDependency" }
    },
    "materialized_outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/factDependency" }
    },
    "blocking_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "producer": { "$ref": "#/$defs/producer" },
    "produced_at_utc": { "type": "string", "minLength": 20 },
    "freshness_verdict": { "type": "string", "enum": ["CURRENT", "STALE", "UNKNOWN"] },
    "linkage_verdict": { "type": "string", "enum": ["LINKED", "UNLINKED"] },
    "materialization_scope": {
      "type": "string",
      "enum": ["BOOTSTRAP_SESSION_PREREQUISITES", "PHASEC_IDENTITY_AND_INPUTS"]
    },
    "phase_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_status",
        "startup_authorization_convergence_status",
        "gate_artifacts_status",
        "materialized_output_count",
        "root_blocker_code"
      ],
      "properties": {
        "phase_status": { "type": "string", "enum": ["COMPLETE", "BLOCKED"] },
        "startup_authorization_convergence_status": { "type": "string" },
        "gate_artifacts_status": { "type": "string", "enum": ["READY", "BLOCKED"] },
        "materialized_output_count": { "type": "integer", "minimum": 0 },
        "root_blocker_code": { "type": "string" }
      }
    },
    "path_resolution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phasec_root", "latest_active_attempt_path"],
      "properties": {
        "phasec_root": { "type": "string", "minLength": 1 },
        "latest_active_attempt_path": { "type": "string", "minLength": 1 }
      }
    },
    "producer_run_id": { "type": "string", "minLength": 1 },
    "phasec_materializer_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returncode", "stdout", "stderr"],
      "properties": {
        "returncode": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      }
    },
    "startup_materialization_input_convergence_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returncode", "stdout", "stderr"],
      "properties": {
        "returncode": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "factDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "absolute_path", "sha256", "day_utc", "status", "reason_codes"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "absolute_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string" },
        "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string", "minLength": 1 },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
