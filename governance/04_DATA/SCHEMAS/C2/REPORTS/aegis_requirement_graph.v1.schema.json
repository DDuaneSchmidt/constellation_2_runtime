{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://constellation/governance/04_DATA/SCHEMAS/C2/REPORTS/aegis_requirement_graph.v1.schema.json",
  "title": "aegis_requirement_graph.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "generated_at_utc",
    "status",
    "canonical_blocker",
    "operator_next_action",
    "requirements",
    "producer_contract_v1"
  ],
  "properties": {
    "schema_id": { "const": "aegis_requirement_graph" },
    "schema_version": { "const": "aegis_requirement_graph.v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "environment": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "SATISFIED", "BLOCKED", "STALE"] },
    "canonical_blocker": { "type": "string" },
    "operator_next_action": { "type": "string" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "requirement_id",
          "owner_phase",
          "source_type",
          "source_id",
          "producer_command",
          "expected_path",
          "schema_path",
          "freshness_policy",
          "blocking_class",
          "dependencies",
          "status",
          "canonical_blocker",
          "operator_next_action"
        ],
        "properties": {
          "blocking_class": {
            "type": "string",
            "enum": ["HARD_BLOCKER", "SOFT_BLOCKER", "DIAGNOSTIC_ONLY", "REPORTING_ONLY"]
          },
          "dependencies": { "type": "array" }
        }
      }
    },
    "producer_contract_v1": { "type": "object" }
  }
}
