{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/trade_lifecycle_case.v1.schema.json",
  "title": "TradeLifecycleCase v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "trade_lifecycle_case_id",
    "selected_exposure_intent_id",
    "symbol",
    "direction",
    "sleeve_id",
    "engine_id",
    "source_day",
    "source_run_id",
    "current_state",
    "state_reason",
    "paper_trade_construction_id",
    "manual_capture_candidate_id",
    "manual_capture_record_ids",
    "lifecycle_event_ids",
    "blocker_codes",
    "blocker_messages",
    "source_artifacts",
    "created_at",
    "updated_at",
    "immutable_hash"
  ],
  "properties": {
    "schema_id": { "const": "trade_lifecycle_case" },
    "schema_version": { "const": "v1" },
    "trade_lifecycle_case_id": { "type": "string", "minLength": 1 },
    "selected_exposure_intent_id": { "type": "string" },
    "symbol": { "type": "string" },
    "direction": { "type": "string" },
    "sleeve_id": { "type": "string" },
    "engine_id": { "type": "string" },
    "source_day": { "type": "string" },
    "source_run_id": { "type": "string" },
    "current_state": {
      "enum": [
        "OBSERVED",
        "SELECTED_EXPOSURE",
        "CONSTRUCTION_BLOCKED",
        "CAPTURE_READY",
        "CAPTURED_MANUALLY",
        "SKIPPED",
        "EXPIRED",
        "CLOSED"
      ]
    },
    "state_reason": { "type": "string" },
    "paper_trade_construction_id": { "type": "string" },
    "manual_capture_candidate_id": { "type": "string" },
    "manual_capture_record_ids": { "type": "array", "items": { "type": "string" } },
    "lifecycle_event_ids": { "type": "array", "items": { "type": "string" } },
    "blocker_codes": { "type": "array", "items": { "type": "string" } },
    "blocker_messages": { "type": "array", "items": { "type": "string" } },
    "source_artifacts": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "immutable_hash": { "type": "string", "minLength": 1 }
  }
}
