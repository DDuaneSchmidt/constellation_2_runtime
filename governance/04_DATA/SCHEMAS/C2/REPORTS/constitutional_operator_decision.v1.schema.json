{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/constitutional_operator_decision.v1.schema.json",
  "title": "constitutional_operator_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "decision_record_hash",
    "review_packet_hash",
    "proposal_hash",
    "fact_bundle_hash",
    "policy_version",
    "original_decision_enum",
    "options_shown",
    "operator_action",
    "operator_id",
    "decided_at",
    "final_decision_applied",
    "authorization_source",
    "source_artifact_ref",
    "operator_note",
    "resolved_constitutional_authorization"
  ],
  "properties": {
    "schema_id": { "const": "constitutional_operator_decision" },
    "schema_version": { "const": "v1" },
    "decision_record_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "review_packet_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proposal_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fact_bundle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "original_decision_enum": { "type": "string", "const": "REQUIRE_HUMAN_REVIEW" },
    "options_shown": {
      "type": "array",
      "items": { "type": "string", "enum": ["APPROVE", "REJECT", "DEFER"] },
      "minItems": 3,
      "maxItems": 3
    },
    "operator_action": { "type": "string", "enum": ["APPROVE", "REJECT", "DEFER"] },
    "operator_id": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "decided_at": { "type": "string", "minLength": 1 },
    "final_decision_applied": {
      "type": "string",
      "enum": [
        "AUTO_EXECUTE",
        "AUTO_EXECUTE_PROTECTIVE",
        "DEFER",
        "BLOCK"
      ]
    },
    "authorization_source": { "type": "string", "enum": ["HUMAN_OVERRIDE", "NONE"] },
    "source_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_path", "artifact_hash"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "operator_note": { "type": "string" },
    "resolved_constitutional_authorization": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_id",
            "schema_version",
            "authorization_id",
            "proposal_hash",
            "fact_bundle_hash",
            "policy_version",
            "effective_scope",
            "decision_enum",
            "issued_at",
            "expires_at",
            "authorization_source",
            "issuer_identity"
          ],
          "properties": {
            "schema_id": { "const": "constitutional_authorization" },
            "schema_version": { "const": "v1" },
            "authorization_id": { "type": "string", "minLength": 1 },
            "proposal_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "fact_bundle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "policy_version": { "type": "string", "minLength": 1 },
            "effective_scope": {
              "type": "object",
              "additionalProperties": false,
              "required": ["global", "domain", "account", "sleeve", "action_class", "effective_authority"],
              "properties": {
                "global": { "type": "string" },
                "domain": { "type": "string" },
                "account": { "type": "string" },
                "sleeve": { "type": "string" },
                "action_class": { "type": "string" },
                "effective_authority": { "type": "string", "minLength": 1 }
              }
            },
            "decision_enum": {
              "type": "string",
              "enum": ["AUTO_EXECUTE", "AUTO_EXECUTE_PROTECTIVE"]
            },
            "issued_at": { "type": "string", "minLength": 1 },
            "expires_at": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "authorization_source": { "type": "string", "const": "HUMAN_OVERRIDE" },
            "issuer_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["issuer", "producer_module", "git_sha"],
              "properties": {
                "issuer": { "type": "string", "minLength": 1 },
                "producer_module": { "type": "string", "minLength": 1 },
                "git_sha": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    }
  }
}
