{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/trade_capture_alert_ledger.v1.schema.json",
  "title": "trade_capture_alert_ledger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "run_id", "day_utc", "generated_at_utc", "alert_attempts", "canonical_eod_state_mutated", "manual_execution_only", "broker_submit_required", "transmit_automation_required", "runtime_mutation_allowed", "automatic_promotion_allowed", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "trade_capture_alert_ledger" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "trade_capture_alert_ledger_v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 10 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "alert_attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
    "canonical_eod_state_mutated": { "const": false },
    "manual_execution_only": { "const": true },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_id", "event_id", "event_run_id", "source_packet_id", "source_packet_type", "symbol", "side", "alert_channel", "alert_urgency", "sent_at_utc", "valid_until_utc", "valid_until_display_et", "seconds_remaining_at_send", "validity_gate_status", "alert_gate_status", "execution_sensitivity", "operator_action_required", "delivery_status", "duplicate_suppressed", "reason_codes", "no_alert_reason", "material_packet_hash", "sms_body", "email_subject", "email_body"],
      "properties": {
        "alert_id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string" },
        "event_run_id": { "type": "string" },
        "source_packet_id": { "type": "string" },
        "source_packet_type": { "type": "string" },
        "symbol": { "type": "string" },
        "side": { "type": "string" },
        "alert_channel": { "type": "string" },
        "alert_urgency": { "type": "string" },
        "sent_at_utc": { "type": "string" },
        "valid_until_utc": { "type": "string" },
        "valid_until_display_et": { "type": "string" },
        "seconds_remaining_at_send": { "type": "integer" },
        "validity_gate_status": { "type": "string" },
        "alert_gate_status": { "type": "string" },
        "execution_sensitivity": { "type": "string" },
        "operator_action_required": { "type": "string" },
        "delivery_status": { "type": "string" },
        "duplicate_suppressed": { "type": "boolean" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "no_alert_reason": { "type": "string" },
        "material_packet_hash": { "type": "string" },
        "sms_body": { "type": "string" },
        "email_subject": { "type": "string" },
        "email_body": { "type": "string" }
      }
    }
  }
}
