{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/aegis_lite_eod_report.v1.schema.json",
  "title": "aegis_lite_eod_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "day_utc",
    "run_id",
    "generated_at_utc",
    "truth_root",
    "artifact_path",
    "operating_model",
    "market_session",
    "market_regime_state",
    "data_freshness_status",
    "governance_status",
    "gates",
    "sleeve_outputs",
    "sleeve_performance_summary",
    "sandbox_research_notes",
    "selected_trade_candidates",
    "edge_overlap_review",
    "edge_overlap_summary",
    "manual_execution_checklist",
    "do_not_trade_blockers",
    "warnings",
    "operator_notes",
    "source_artifact_lineage",
    "run_receipt",
    "report_status",
    "manual_execution_status",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "aegis_lite_eod_report" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "aegis_lite_eod_report_v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "truth_root": { "type": "string", "minLength": 1 },
    "artifact_path": { "type": "string", "minLength": 1 },
    "operating_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "near_term_product",
        "manual_execution_only",
        "ib_automation_status",
        "broker_submit_required",
        "autonomous_order_routing_allowed"
      ],
      "properties": {
        "phase": { "const": "AEGIS_LITE" },
        "near_term_product": { "const": "EOD_MANUAL_TRADE_REPORT" },
        "manual_execution_only": { "const": true },
        "ib_automation_status": { "const": "DEFERRED" },
        "broker_submit_required": { "const": false },
        "autonomous_order_routing_allowed": { "const": false }
      }
    },
    "market_session": { "type": "object", "additionalProperties": true },
    "market_regime_state": { "type": "object", "additionalProperties": true },
    "data_freshness_status": { "type": "object", "additionalProperties": true },
    "governance_status": { "type": "object", "additionalProperties": true },
    "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" }, "minItems": 3 },
    "sleeve_outputs": { "type": "array", "items": { "type": "object" } },
    "sleeve_performance_summary": { "type": "array", "items": { "type": "object" } },
    "sandbox_research_notes": { "type": "array", "items": { "type": "object" } },
    "selected_trade_candidates": { "type": "array", "items": { "$ref": "#/$defs/report_candidate" } },
    "edge_overlap_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "sha256", "status", "distinct_edge_count"],
      "properties": {
        "artifact_type": { "const": "sleeve_edge_overlap_review_v1" },
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "status": { "type": "string" },
        "distinct_edge_count": { "type": "integer", "minimum": 0 }
      }
    },
    "edge_overlap_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_edge_count",
        "edge_groups",
        "shared_risk_groups",
        "duplicate_thesis_groups",
        "correlated_exposure_groups",
        "portfolio_concentration_warnings"
      ],
      "properties": {
        "distinct_edge_count": { "type": "integer", "minimum": 0 },
        "edge_groups": { "type": "array", "items": { "type": "object" } },
        "shared_risk_groups": { "type": "array", "items": { "type": "object" } },
        "duplicate_thesis_groups": { "type": "array", "items": { "type": "object" } },
        "correlated_exposure_groups": { "type": "array", "items": { "type": "object" } },
        "portfolio_concentration_warnings": { "type": "array", "items": { "type": "object" } }
      }
    },
    "manual_execution_checklist": { "type": "array", "items": { "$ref": "#/$defs/checklist_item" }, "minItems": 1 },
    "do_not_trade_blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "operator_notes": { "type": "string" },
    "source_artifact_lineage": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } },
    "run_receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pipeline",
        "deterministic",
        "replayable",
        "audit_archive_path",
        "ib_submit_automation_invoked",
        "broker_transmit_control_touched"
      ],
      "properties": {
        "pipeline": { "const": "aegis_lite_eod_pipeline_v1" },
        "deterministic": { "const": true },
        "replayable": { "const": true },
        "audit_archive_path": { "type": "string" },
        "ib_submit_automation_invoked": { "const": false },
        "broker_transmit_control_touched": { "const": false }
      }
    },
    "report_status": { "type": "string", "enum": ["READY", "READY_WITH_WARNINGS", "BLOCKED"] },
    "manual_execution_status": { "type": "string", "enum": ["READY_FOR_MANUAL_ENTRY", "NOT_READY"] },
    "producer_contract_v1": { "type": "object" },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "exists", "sha256"],
      "properties": {
        "artifact_type": { "type": "string" },
        "path": { "type": "string" },
        "exists": { "type": "boolean" },
        "sha256": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "reason_codes"],
      "properties": {
        "gate_id": { "type": "string", "enum": ["DATA_INTEGRITY", "GOVERNANCE_INTEGRITY", "REPORT_COMPLETENESS"] },
        "status": { "type": "string", "enum": ["PASS", "BLOCKED"] },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checklist_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "label", "status"],
      "properties": {
        "check_id": { "type": "string" },
        "label": { "type": "string" },
        "status": { "const": "REQUIRED" }
      }
    },
    "report_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "sleeve_id",
        "symbol",
        "direction",
        "instrument_type",
        "entry_reference_price",
        "suggested_quantity",
        "sizing_guidance",
        "stop_price",
        "stop_logic",
        "risk_per_trade",
        "sleeve_ownership",
        "confidence",
        "conviction",
        "reason_codes",
        "governance_notes",
        "edge_family",
        "thesis_id",
        "shared_risk_tags",
        "correlated_symbols",
        "edge_overlap",
        "shared_risk_classification",
        "portfolio_concentration_warnings",
        "governance_adjusted_status",
        "manual_execution",
        "executable_status",
        "blockers",
        "source_artifact_refs"
      ],
      "properties": {
        "candidate_id": { "type": "string" },
        "sleeve_id": { "type": "string" },
        "symbol": { "type": "string" },
        "direction": { "type": "string" },
        "instrument_type": { "type": "string" },
        "entry_reference_price": { "type": "string" },
        "suggested_quantity": { "type": "integer", "minimum": 0 },
        "sizing_guidance": { "type": "string" },
        "stop_price": { "type": "string" },
        "stop_logic": { "type": "string" },
        "risk_per_trade": { "type": "string" },
        "sleeve_ownership": { "type": "string" },
        "confidence": { "type": "string" },
        "conviction": { "type": "string" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "governance_notes": { "type": "array", "items": { "type": "string" } },
        "edge_family": { "type": "string" },
        "thesis_id": { "type": "string" },
        "shared_risk_tags": { "type": "array", "items": { "type": "string" } },
        "correlated_symbols": { "type": "array", "items": { "type": "string" } },
        "edge_overlap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overlap_group_id",
            "duplicate_thesis_flag",
            "concentration_warning_flag",
            "governance_recommendation"
          ],
          "properties": {
            "overlap_group_id": { "type": "string" },
            "duplicate_thesis_flag": { "type": "boolean" },
            "concentration_warning_flag": { "type": "boolean" },
            "governance_recommendation": { "$ref": "#/$defs/recommendation" }
          }
        },
        "shared_risk_classification": { "type": "array", "items": { "type": "string" } },
        "portfolio_concentration_warnings": { "type": "array", "items": { "type": "string" } },
        "governance_adjusted_status": { "$ref": "#/$defs/recommendation" },
        "manual_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator_must_enter_in_ib",
            "aegis_broker_submit_required",
            "checklist_required"
          ],
          "properties": {
            "operator_must_enter_in_ib": { "const": true },
            "aegis_broker_submit_required": { "const": false },
            "checklist_required": { "const": true }
          }
        },
        "executable_status": { "type": "string", "enum": ["EXECUTABLE", "NON_EXECUTABLE"] },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "source_artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "approve",
        "approve_reduced_size",
        "prefer_best_candidate_in_group",
        "block_due_to_duplicate_edge",
        "block_due_to_concentration",
        "manual_review_required"
      ]
    }
  }
}
