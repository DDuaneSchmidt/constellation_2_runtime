{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/ai_advisory_review.v1.schema.json",
  "title": "AI Advisory Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "day_utc",
    "generated_at",
    "git_commit",
    "git_dirty_status",
    "truth_root",
    "runtime_root",
    "producer",
    "authority",
    "readiness_authority",
    "submit_authority",
    "operator_action_authority",
    "environment",
    "status",
    "advisory_evidence_packet_path",
    "advisory_evidence_packet_status",
    "control_plane_final_status_observed",
    "control_plane_current_domain_observed",
    "control_plane_canonical_blocker_observed",
    "control_plane_submit_allowed_observed",
    "recommendations",
    "warnings",
    "requires_human_review",
    "evidence_paths",
    "producer_contract_v1"
  ],
  "not": {
    "anyOf": [
      { "required": ["final_status"] },
      { "required": ["readiness"] },
      { "required": ["ready"] },
      { "required": ["submit_allowed"] },
      { "required": ["authorized"] },
      { "required": ["operator_next_action"] },
      { "required": ["next_valid_actions"] }
    ]
  },
  "properties": {
    "schema_id": { "const": "ai_advisory_review" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "ai_advisory_review_v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string", "minLength": 1 },
    "git_dirty_status": { "type": "string", "enum": ["CLEAN", "DIRTY"] },
    "truth_root": { "type": "string", "minLength": 1 },
    "runtime_root": { "type": "string", "minLength": 1 },
    "producer": { "const": "ops/tools/run_ai_advisory_review_v1.py" },
    "authority": { "const": "ADVISORY_ONLY" },
    "readiness_authority": { "const": "aegis_control_plane_v1" },
    "submit_authority": { "const": "aegis_submit_enforcement_v1" },
    "operator_action_authority": { "const": "CONTROL_PLANE_OR_GOVERNED_RECOVERY_ONLY" },
    "environment": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "DEGRADED", "NO_GOVERNED_ADVISORY_INPUT"] },
    "advisory_evidence_packet_path": { "type": "string" },
    "advisory_evidence_packet_status": { "type": "string" },
    "control_plane_final_status_observed": { "type": "string" },
    "control_plane_current_domain_observed": { "type": "string" },
    "control_plane_canonical_blocker_observed": { "type": "string" },
    "control_plane_submit_allowed_observed": { "type": "boolean" },
    "decisions_reviewed": { "type": "integer", "minimum": 0 },
    "included_artifact_count": { "type": "integer", "minimum": 0 },
    "excluded_artifact_count": { "type": "integer", "minimum": 0 },
    "non_actionable_deferred_evidence_count": { "type": "integer", "minimum": 0 },
    "advisory_observations": { "type": "array", "items": { "type": "object" } },
    "anomaly_flags": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string" },
    "requires_human_review": { "type": "boolean" },
    "prohibited_actions_attempted": { "type": "boolean" },
    "evidence_paths": { "type": "array", "items": { "type": "string" } },
    "produced_at_utc": { "type": "string" },
    "artifact_path": { "type": "string" },
    "producer_contract_v1": { "type": "object" }
  }
}
