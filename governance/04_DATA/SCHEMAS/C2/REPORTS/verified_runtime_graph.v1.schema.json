{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/verified_runtime_graph.v1.schema.json",
  "title": "Aegis Verified Runtime Graph v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "day_utc",
    "generated_at",
    "generator_name",
    "generator_version",
    "git_commit_hash",
    "input_artifact_hashes",
    "output_hash",
    "declared_modules",
    "verified_capabilities",
    "evidence_links",
    "policy_gates",
    "portal_bindings",
    "readiness_linkage_to_runtime_truth_kernel",
    "safety_invariants"
  ],
  "properties": {
    "schema_id": { "const": "aegis_verified_runtime_graph" },
    "schema_version": { "const": "v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "generator_name": { "const": "build_aegis_verified_runtime_graph_v1" },
    "generator_version": { "const": "aegis_verified_runtime_graph.v1" },
    "git_commit_hash": { "type": "string" },
    "input_artifact_hashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "output_hash": { "type": "string", "minLength": 1 },
    "graph_status": { "enum": ["READY", "BLOCKED"] },
    "runtime_readiness_status": { "enum": ["READY", "BLOCKED"] },
    "audit_blockers": { "type": "array", "items": { "type": "string" } },
    "runtime_blockers": { "type": "array", "items": { "type": "string" } },
    "declared_modules": { "type": "array", "items": { "type": "object" } },
    "verified_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "capability_id", "state", "state_path", "required_evidence", "evidence_links"],
        "properties": {
          "module_id": { "type": "string" },
          "capability_id": { "type": "string" },
          "state": {
            "enum": ["DECLARED", "SCHEMA_VALID", "EVIDENCE_PRESENT", "EVIDENCE_CURRENT", "TESTED", "VERIFIED", "READY", "ALLOWED", "BLOCKED"]
          },
          "state_path": { "type": "array", "items": { "type": "string" } },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "evidence_links": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence_links": { "type": "array", "items": { "type": "object" } },
    "policy_gates": { "type": "object" },
    "portal_bindings": { "type": "object" },
    "readiness_linkage_to_runtime_truth_kernel": { "type": "object" },
    "safety_invariants": { "type": "object" }
  },
  "additionalProperties": true
}
