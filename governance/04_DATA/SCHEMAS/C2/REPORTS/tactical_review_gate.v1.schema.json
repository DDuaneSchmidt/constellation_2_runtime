{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/tactical_review_gate.v1.schema.json",
  "title": "tactical_review_gate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "gate_id", "event_id", "event_rule_id", "event_rule_version", "event_run_id", "day_utc", "evaluated_at_utc", "gate_status", "tactical_review_allowed", "reason_codes", "required_inputs_present", "stale_data_status", "production_status", "research_status", "promoted_sleeve_available", "canonical_eod_state_mutated", "manual_execution_only", "broker_submit_required", "runtime_mutation_allowed", "automatic_promotion_allowed", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "tactical_review_gate" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "tactical_review_gate_v1" },
    "gate_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "event_rule_id": { "type": "string", "minLength": 1 },
    "event_rule_version": { "type": "string", "minLength": 1 },
    "event_run_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 10 },
    "evaluated_at_utc": { "type": "string", "minLength": 20 },
    "gate_status": { "type": "string", "enum": ["REVIEW_ALLOWED", "REVIEW_BLOCKED", "RESEARCH_ONLY", "DATA_STALE", "NO_PROMOTED_SLEEVE", "LOW_CONFIDENCE"] },
    "tactical_review_allowed": { "type": "boolean" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "required_inputs_present": { "type": "boolean" },
    "stale_data_status": { "type": "string" },
    "production_status": { "type": "string" },
    "research_status": { "type": "string" },
    "promoted_sleeve_available": { "type": "boolean" },
    "canonical_eod_state_mutated": { "const": false },
    "manual_execution_only": { "const": true },
    "broker_submit_required": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
