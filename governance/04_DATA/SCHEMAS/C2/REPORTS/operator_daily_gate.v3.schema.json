{
  "$id": "https://constellation.local/schemas/operator_daily_gate.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator Daily Gate v3 (adds exit reconciliation enforcement; immutable-safe new version)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "producer",
    "status",
    "reason_codes",
    "blocking_codes",
    "closure_state",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage",
    "input_manifest",
    "checks",
    "economic_state"
  ],
  "properties": {
    "schema_id": { "const": "operator_daily_gate" },
    "schema_version": { "const": "v3" },

    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },

    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1, "maxLength": 128 },
        "module": { "type": "string", "minLength": 1, "maxLength": 256 },
        "git_sha": { "type": "string", "minLength": 7, "maxLength": 64 }
      }
    },

    "status": { "type": "string", "enum": ["PASS", "FAIL"] },

    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "blocking_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "closure_state": {
      "type": "string",
      "enum": ["COMPLETE", "BLOCKED", "DEGRADED", "OPEN"]
    },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" },

    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },

    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },

    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconciliation_v3_status",
        "cash_ledger_integrity_ok",
        "positions_snapshot_present",
        "capital_risk_envelope_v2_status",
        "exit_reconciliation_present",
        "exit_intents_satisfied_when_obligations_exist",
        "previous_day_economic_state_status",
        "previous_day_drawdown_guard_status"
      ],
      "properties": {
        "reconciliation_v3_status": { "type": "string", "enum": ["OK", "FAIL", "MISSING"] },
        "cash_ledger_integrity_ok": { "type": "boolean" },
        "positions_snapshot_present": { "type": "boolean" },
        "capital_risk_envelope_v2_status": { "type": "string", "enum": ["PASS", "FAIL", "MISSING"] },
        "exit_reconciliation_present": { "type": "boolean" },
        "exit_intents_satisfied_when_obligations_exist": { "type": "boolean" },
        "previous_day_economic_state_status": { "type": "string", "enum": ["OK", "UNKNOWN"] },
        "previous_day_drawdown_guard_status": { "type": "string", "enum": ["PASS", "BLOCKED", "UNKNOWN"] }
      }
    },
    "economic_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_day_utc",
        "artifact_path",
        "artifact_sha256",
        "drawdown_pct",
        "drawdown_guard_status",
        "policy_baseline_comparison_vs_portfolio_return",
        "external_benchmark_underperformer_count",
        "reason_codes"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["OK", "UNKNOWN"] },
        "source_day_utc": { "type": "string" },
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" },
        "drawdown_pct": { "type": ["string", "null"] },
        "drawdown_guard_status": { "type": "string", "enum": ["PASS", "BLOCKED", "UNKNOWN"] },
        "policy_baseline_comparison_vs_portfolio_return": { "type": ["string", "null"] },
        "external_benchmark_underperformer_count": { "type": "integer", "minimum": 0 },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "expected_artifact_root": { "type": "string" },
        "producer_command": { "type": "string" },
        "recovery_command": { "type": "string" }
      }
    }
  }
}
