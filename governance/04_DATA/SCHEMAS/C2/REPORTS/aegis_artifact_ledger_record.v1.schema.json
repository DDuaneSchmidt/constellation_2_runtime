{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/aegis_artifact_ledger_record.v1.schema.json",
  "title": "aegis_artifact_ledger_record.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "ledger_record_id",
    "artifact_id",
    "artifact_type",
    "artifact_path",
    "artifact_hash",
    "day",
    "runtime_mode",
    "truth_root",
    "runtime_root",
    "schema_id_ref",
    "schema_version_ref",
    "producer_module",
    "producer_git_commit",
    "producer_contract_ref",
    "input_artifact_refs",
    "input_artifact_hashes",
    "output_artifact_hash",
    "generated_at",
    "validation_status",
    "blockers",
    "recovery_command",
    "append_only"
  ],
  "properties": {
    "schema_id": { "const": "aegis_artifact_ledger_record" },
    "schema_version": { "const": "aegis_artifact_ledger_record.v1" },
    "ledger_record_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "account": { "type": "string" },
    "sleeve": { "type": "string" },
    "runtime_mode": { "type": "string", "enum": ["PRODUCTION", "CANDIDATE"] },
    "truth_root": { "type": "string", "minLength": 1 },
    "runtime_root": { "type": "string", "minLength": 1 },
    "schema_id_ref": { "type": "string" },
    "schema_version_ref": { "type": "string" },
    "producer_module": { "type": "string", "minLength": 1 },
    "producer_git_commit": { "type": "string", "minLength": 1 },
    "producer_contract_ref": { "type": "object" },
    "input_artifact_refs": { "type": "array" },
    "input_artifact_hashes": { "type": "array" },
    "output_artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "validation_status": { "type": "string", "minLength": 1 },
    "blockers": { "type": "array" },
    "recovery_command": { "type": "string" },
    "append_only": { "const": true }
  }
}
