{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/trade_ticket_lineage.v1.schema.json",
  "title": "Trade Ticket Lineage v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "ticket_id",
    "exposure_id",
    "sleeve_id",
    "symbol",
    "side",
    "day_utc",
    "sleeve_run_id",
    "runtime_evaluation_hash",
    "construction_contract_id",
    "construction_contract_hash",
    "paper_trade_construction_id",
    "lineage_status",
    "source_artifact_paths",
    "source_event_ids",
    "lineage_hash"
  ],
  "properties": {
    "schema_id": { "const": "trade_ticket_lineage" },
    "schema_version": { "const": "v1" },
    "ticket_id": { "type": "string", "minLength": 1 },
    "exposure_id": { "type": "string" },
    "sleeve_id": { "type": "string" },
    "symbol": { "type": "string" },
    "side": { "type": "string" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sleeve_run_id": { "type": "string" },
    "runtime_evaluation_hash": { "type": "string" },
    "universe_hash": { "type": "string" },
    "market_data_hash": { "type": "string" },
    "construction_contract_id": { "type": "string" },
    "construction_contract_hash": { "type": "string" },
    "paper_trade_construction_id": { "type": "string" },
    "submit_boundary_id": { "type": "string" },
    "submit_boundary_hash": { "type": "string" },
    "market_freshness_id": { "type": "string" },
    "paper_intent_id": { "type": "string" },
    "conversion_id": { "type": "string" },
    "source_artifact_paths": { "type": "array", "items": { "type": "string" } },
    "source_event_ids": { "type": "array", "items": { "type": "string" } },
    "lineage_status": {
      "enum": [
        "ACTIVE_CURRENT",
        "STALE_CONTRACT",
        "STALE_RUNTIME",
        "MISSING_SUBMIT_BOUNDARY",
        "MISSING_MARKET_FRESHNESS",
        "MISSING_PAPER_INTENT",
        "MISSING_CONVERSION",
        "HISTORICAL_READ_ONLY",
        "INVALIDATED"
      ]
    },
    "editable": { "type": "boolean" },
    "read_only": { "type": "boolean" },
    "lineage_hash": { "type": "string", "minLength": 1 }
  }
}
