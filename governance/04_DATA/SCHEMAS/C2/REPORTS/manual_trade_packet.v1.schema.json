{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/manual_trade_packet.v1.schema.json",
  "title": "manual_trade_packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "packet_id", "run_id", "date", "generated_at_utc", "runtime_truth_classification", "manual_execution_only", "broker_submit_required", "ib_automation_status", "trade_candidates", "all_candidates_traceable_to_promoted_sleeves", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "manual_trade_packet" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "manual_trade_packet_v1" },
    "packet_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string" },
    "runtime_truth_classification": { "type": "string", "enum": ["REAL_RUNTIME", "DEMO_ONLY", "DRY_RUN_ONLY"] },
    "manual_execution_only": { "const": true },
    "broker_submit_required": { "const": false },
    "ib_automation_status": { "const": "DEFERRED" },
    "trade_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "date", "recommended_trade_id", "sleeve_id", "source_hypothesis_id", "symbol", "side", "instrument_type", "entry_reference_price", "order_type_suggestion", "quantity_or_sizing_guidance", "stop_price", "stop_logic", "risk_per_trade", "portfolio_value_used", "sizing_tier", "risk_pct_used", "allowed_dollar_risk", "risk_per_share", "suggested_quantity", "estimated_position_value", "max_loss_if_stopped", "overlap_adjustment", "regime_adjustment", "concentration_adjustment", "sizing_blockers", "sizing_reason_codes", "ai_selected_size", "operator_can_override", "edge_family", "regime_state", "confidence", "inclusion_reason", "exclusion_reason", "governance_notes", "edge_overlap_result", "runtime_truth_classification", "demo_mode", "dry_run_only", "manual_execution_checklist", "actionable", "do_not_trade_blockers"],
        "properties": {
          "run_id": { "type": "string" },
          "date": { "type": "string" },
          "recommended_trade_id": { "type": "string" },
          "sleeve_id": { "type": "string" },
          "source_hypothesis_id": { "type": "string" },
          "symbol": { "type": "string" },
          "side": { "type": "string" },
          "instrument_type": { "type": "string" },
          "entry_reference_price": { "type": "string" },
          "order_type_suggestion": { "type": "string" },
          "quantity_or_sizing_guidance": { "type": "string" },
          "stop_price": { "type": "string" },
          "stop_logic": { "type": "string" },
          "risk_per_trade": { "type": "string" },
          "portfolio_value_used": { "type": "string" },
          "sizing_tier": { "type": "string", "enum": ["SMOKE_TEST", "VERY_SMALL", "NORMAL", "STRONG", "MAX"] },
          "risk_pct_used": { "type": "string" },
          "allowed_dollar_risk": { "type": "string" },
          "risk_per_share": { "type": "string" },
          "suggested_quantity": { "type": "integer", "minimum": 0 },
          "estimated_position_value": { "type": "string" },
          "max_loss_if_stopped": { "type": "string" },
          "overlap_adjustment": { "type": "string" },
          "regime_adjustment": { "type": "string" },
          "concentration_adjustment": { "type": "string" },
          "sizing_blockers": { "type": "array", "items": { "type": "string" } },
          "sizing_reason_codes": { "type": "array", "items": { "type": "string" } },
          "ai_selected_size": { "const": false },
          "operator_can_override": { "const": true },
          "edge_family": { "type": "string" },
          "regime_state": { "type": "string" },
          "confidence": { "type": "string" },
          "inclusion_reason": { "type": "string" },
          "exclusion_reason": { "type": "string" },
          "governance_notes": { "type": "string" },
          "edge_overlap_result": { "type": "string" },
          "runtime_truth_classification": { "type": "string", "enum": ["REAL_RUNTIME", "DEMO_ONLY", "DRY_RUN_ONLY"] },
          "demo_mode": { "type": "boolean" },
          "dry_run_only": { "type": "boolean" },
          "manual_execution_checklist": { "type": "array", "items": { "type": "string" } },
          "actionable": { "type": "boolean" },
          "do_not_trade_blockers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "all_candidates_traceable_to_promoted_sleeves": { "type": "boolean" },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
