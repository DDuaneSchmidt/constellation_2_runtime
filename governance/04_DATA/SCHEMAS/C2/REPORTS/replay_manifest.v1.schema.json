{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/replay_manifest.v1.schema.json",
  "title": "replay_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "produced_utc",
    "day_utc",
    "source_truth_root",
    "replay_truth_root",
    "submission_id",
    "status",
    "reason_codes",
    "tool_runs",
    "comparisons",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": {"const": "C2_REPLAY_MANIFEST_V1"},
    "schema_version": {"type": "integer", "const": 1},
    "produced_utc": {"type": "string", "format": "date-time"},
    "day_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_truth_root": {"type": "string", "minLength": 1},
    "replay_truth_root": {"type": "string", "minLength": 1},
    "submission_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["OK", "FAIL"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tool_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "rc"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "rc": {"type": "integer", "minimum": 0},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_role", "source_path", "replay_path", "comparison_status"],
        "properties": {
          "artifact_role": {"type": "string", "enum": ["allocation", "authorization_dir", "submission_dir", "execution_stream_dir", "fill_ledger"]},
          "source_path": {"type": "string", "minLength": 1},
          "replay_path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "replay_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "comparison_status": {"type": "string", "enum": ["identical", "different", "missing_source", "missing_replay"]}
        }
      }
    },
    "canonical_json_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
