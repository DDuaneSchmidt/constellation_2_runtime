{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/trade_readiness_decision.v1.schema.json",
  "title": "trade_readiness_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "day_utc",
    "intent_hash",
    "decision",
    "submit_allowed",
    "canonical_gate",
    "canonical_blocker",
    "canonical_reason",
    "ordered_gate_results",
    "all_blockers",
    "evidence_artifacts",
    "evidence_hashes",
    "decision_timestamp_utc",
    "decision_writer",
    "truth_root",
    "policy_version",
    "blocker_priority_order",
    "producer"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "intent_hash": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["YES", "NO"] },
    "submit_allowed": { "type": "boolean" },
    "canonical_gate": { "type": "string", "minLength": 1 },
    "canonical_blocker": { "type": ["string", "null"] },
    "canonical_reason": { "type": "string", "minLength": 1 },
    "ordered_gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "blockers", "reason", "evidence_artifacts", "evidence_hashes"],
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "FILTERED", "PENDING", "NOT_ATTEMPTED"] },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 },
          "evidence_artifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_hashes": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "all_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "decision_timestamp_utc": { "type": "string", "minLength": 20 },
    "decision_writer": { "type": "string", "minLength": 1 },
    "truth_root": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "blocker_priority_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    }
  }
}
