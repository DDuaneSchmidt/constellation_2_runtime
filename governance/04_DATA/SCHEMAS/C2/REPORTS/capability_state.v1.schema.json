{
  "$id": "C2_REPORTS_CAPABILITY_STATE_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 Capability State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "ib_account",
    "sleeve_id",
    "overall_status",
    "capabilities",
    "source_artifacts",
    "registry_ref",
    "release_id",
    "git_sha",
    "generated_at_utc"
  ],
  "properties": {
    "schema_id": { "const": "capability_state" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "ib_account": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "overall_status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "status", "kind", "reason_codes", "source_artifacts", "details"],
        "properties": {
          "capability_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
          "kind": { "type": "string", "enum": ["HARD_OPERATIONAL_FACT", "SYNTHESIZED_SUMMARY"] },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "source_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_family", "artifact_path", "artifact_sha256"],
              "properties": {
                "artifact_family": { "type": "string" },
                "artifact_path": { "type": "string" },
                "artifact_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
              }
            }
          },
          "details": { "type": "object" }
        }
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_family", "artifact_path", "artifact_sha256"],
        "properties": {
          "artifact_family": { "type": "string" },
          "artifact_path": { "type": "string" },
          "artifact_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
        }
      }
    },
    "registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256", "schema_id", "schema_version"],
      "properties": {
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "schema_id": { "type": "string" },
        "schema_version": { "type": "string" }
      }
    },
    "release_id": { "type": "string" },
    "git_sha": { "type": "string" },
    "generated_at_utc": { "type": "string" }
  }
}
