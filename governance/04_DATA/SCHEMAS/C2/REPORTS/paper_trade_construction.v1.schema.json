{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/paper_trade_construction.v1.schema.json",
  "title": "Paper Trade Construction v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "construction_id",
    "selected_exposure_intent_id",
    "symbol",
    "direction",
    "sleeve_id",
    "engine_id",
    "source_day",
    "source_run_id",
    "portfolio_gate_decision_id",
    "symbol_authority_source",
    "market_data_snapshot_id",
    "market_data_latest_session",
    "trade_construction_status",
    "entry_reference_price",
    "entry_reference_source",
    "suggested_quantity",
    "suggested_notional",
    "allocation_percent",
    "stop_price",
    "invalidation_level",
    "stop_policy_source",
    "risk_per_share",
    "max_loss_estimate",
    "risk_budget_source",
    "submit_boundary_status",
    "runtime_evaluation_hash",
    "construction_contract_id",
    "construction_contract_hash",
    "manual_capture_ready",
    "blocker_codes",
    "blocker_messages",
    "source_artifacts",
    "immutable_hash"
  ],
  "properties": {
    "schema_id": { "const": "paper_trade_construction" },
    "schema_version": { "const": "v1" },
    "construction_id": { "type": "string", "minLength": 1 },
    "selected_exposure_intent_id": { "type": "string" },
    "symbol": { "type": "string" },
    "direction": { "type": "string" },
    "sleeve_id": { "type": "string" },
    "engine_id": { "type": "string" },
    "source_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source_run_id": { "type": "string" },
    "portfolio_gate_decision_id": { "type": "string" },
    "symbol_authority_source": { "type": "string" },
    "market_data_snapshot_id": { "type": "string" },
    "market_data_latest_session": { "type": "string" },
    "trade_construction_status": {
      "enum": [
        "complete",
        "blocked_missing_market_data",
        "blocked_missing_capital_authority",
        "blocked_missing_entry_policy",
        "blocked_missing_sizing_policy",
        "blocked_missing_stop_policy",
        "blocked_missing_risk_policy",
        "blocked_submit_boundary",
        "blocked_incomplete_trade_definition"
      ]
    },
    "entry_reference_price": { "type": "string" },
    "entry_reference_source": { "type": "string" },
    "suggested_quantity": { "type": ["integer", "null"], "minimum": 1 },
    "suggested_notional": { "type": "string" },
    "allocation_percent": { "type": "string" },
    "stop_price": { "type": "string" },
    "invalidation_level": { "type": "string" },
    "stop_policy_source": { "type": "string" },
    "risk_per_share": { "type": "string" },
    "max_loss_estimate": { "type": "string" },
    "risk_budget_source": { "type": "string" },
    "submit_boundary_status": { "type": "string" },
    "runtime_evaluation_hash": { "type": "string" },
    "construction_contract_id": { "type": "string" },
    "construction_contract_hash": { "type": "string" },
    "construction_contract": { "type": "object" },
    "paper_trade_construction_id": { "type": "string" },
    "manual_capture_ready": { "type": "boolean" },
    "blocker_codes": { "type": "array", "items": { "type": "string" } },
    "blocker_messages": { "type": "array", "items": { "type": "string" } },
    "source_artifacts": { "type": "array", "items": { "type": "object" } },
    "immutable_hash": { "type": "string" }
  }
}
