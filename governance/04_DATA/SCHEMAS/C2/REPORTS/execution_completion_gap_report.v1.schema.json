{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2.reports.execution_completion_gap_report.v1",
  "title": "C2 Execution Completion Gap Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "execution_completion_ruleset_id",
    "execution_completion_ruleset_version",
    "run_scope",
    "target_day_utc",
    "dependency_statuses",
    "payload_completeness_results",
    "lifecycle_stage_statuses",
    "economic_finalization_status",
    "first_break_stage",
    "missing_dependencies",
    "missing_required_fields",
    "blocked_writers",
    "next_satisfiable_writer",
    "evidence_refs",
    "integrity_status"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "execution_completion_gap_report_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "minLength": 1 },
    "execution_completion_ruleset_id": { "type": "string", "const": "EXECUTION_COMPLETION_RULESET_V1" },
    "execution_completion_ruleset_version": { "type": "integer", "const": 1 },
    "run_scope": { "$ref": "#/$defs/run_scope" },
    "target_day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "dependency_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "dependency_version", "dependency_type", "blocking", "status", "resolved_path", "reasons", "downstream_consumers", "expected_source_path", "generation_path"],
        "properties": {
          "dependency_id": { "type": "string" },
          "dependency_version": { "type": "integer", "minimum": 1 },
          "dependency_type": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "blocking": { "type": "boolean" },
          "status": { "type": "string", "enum": ["READY", "MISSING_BLOCKING_DEPENDENCY", "STALE_DEPENDENCY", "WRONG_DAY_DEPENDENCY", "PARTIAL_DEPENDENCY_SET"] },
          "resolved_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "downstream_consumers": { "type": "array", "items": { "type": "string" } },
          "expected_source_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "generation_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        }
      }
    },
    "payload_completeness_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_family", "observed_paths", "record_count", "schema_validation_status", "completeness_status", "missing_required_fields", "missing_join_critical_fields", "downstream_stage_blockers", "notes"],
        "properties": {
          "artifact_family": { "type": "string" },
          "observed_paths": { "type": "array", "items": { "type": "string" } },
          "record_count": { "type": "integer", "minimum": 0 },
          "schema_validation_status": { "type": "string" },
          "completeness_status": { "type": "string" },
          "missing_required_fields": { "type": "array", "items": { "type": "string" } },
          "missing_join_critical_fields": { "type": "array", "items": { "type": "string" } },
          "downstream_stage_blockers": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "lifecycle_stage_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_name", "stage_status", "dependency_failures", "missing_fields", "blocked_writers"],
        "properties": {
          "stage_name": { "type": "string" },
          "stage_status": { "type": "string" },
          "dependency_failures": { "type": "array", "items": { "type": "string" } },
          "missing_fields": { "type": "array", "items": { "type": "string" } },
          "blocked_writers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "economic_finalization_status": { "type": "string" },
    "first_break_stage": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "missing_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "status", "expected_source_path", "generation_path", "resolved_path", "reasons"],
        "properties": {
          "dependency_id": { "type": "string" },
          "status": { "type": "string" },
          "expected_source_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "generation_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "resolved_path": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "missing_required_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_family", "field"],
        "properties": {
          "artifact_family": { "type": "string" },
          "field": { "type": "string" }
        }
      }
    },
    "blocked_writers": { "type": "array", "items": { "type": "string" } },
    "next_satisfiable_writer": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "integrity_status": { "type": "string", "enum": ["OK", "BLOCKED", "INTERNAL_FAILURE"] }
  },
  "$defs": {
    "run_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_utc", "mode", "sleeve_id", "engine_id", "attempt_id", "attempt_seq", "truth_partition"],
      "properties": {
        "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "mode": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sleeve_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "engine_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt_seq": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "truth_partition": { "type": "string" }
      }
    }
  }
}
