{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/trade_candidate_contract.v1.schema.json",
  "title": "trade_candidate_contract.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "projection_id",
    "trade_candidate_id",
    "exposure_intent_id",
    "sleeve_id",
    "engine_id",
    "symbol",
    "direction",
    "source_day",
    "source_run_id",
    "selected_by_arbitration",
    "entry_reference_price",
    "quantity",
    "notional_value",
    "stop_price",
    "invalidation_level",
    "risk_per_share",
    "max_loss_estimate",
    "blocker_status",
    "data_freshness_status",
    "current_truth_snapshot_id",
    "symbol_authority_source",
    "market_data_snapshot_id",
    "portfolio_gate_decision_id",
    "conversion_status",
    "submit_boundary_status",
    "paper_intent_status",
    "lifecycle_status",
    "operator_action_allowed",
    "disallowed_actions",
    "manual_capture_record",
    "blockers",
    "safety",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "trade_candidate_projection" },
    "schema_version": { "const": "v1" },
    "projection_id": { "type": "string" },
    "trade_candidate_id": { "type": "string" },
    "exposure_intent_id": { "type": "string" },
    "selected_exposure_intent_id": { "type": "string" },
    "sleeve_id": { "type": "string" },
    "engine_id": { "type": "string" },
    "symbol": { "type": "string" },
    "direction": { "type": "string" },
    "source_day": { "type": "string" },
    "source_run_id": { "type": "string" },
    "selected_by_arbitration": { "type": "boolean" },
    "selected_rank": {},
    "suppression_watchlist_context": { "type": "object" },
    "entry_reference_price": { "type": "string" },
    "fill_price": { "type": "string" },
    "quantity": { "type": ["integer", "null"] },
    "notional_value": { "type": "string" },
    "allocation_percent": { "type": "string" },
    "risk_budget_reference": { "type": "string" },
    "stop_price": { "type": "string" },
    "invalidation_level": { "type": "string" },
    "target_exit_rule": { "type": "string" },
    "time_in_force": { "type": "string" },
    "holding_period": { "type": "string" },
    "review_date": { "type": "string" },
    "risk_per_share": { "type": "string" },
    "max_loss_estimate": { "type": "string" },
    "thesis_reason": { "type": "string" },
    "blocker_status": { "type": "string", "enum": ["CLEAR", "BLOCKED"] },
    "blockers": { "type": "array", "items": { "type": "object", "required": ["code", "message"] } },
    "missing_required_fields": { "type": "array", "items": { "type": "string" } },
    "data_freshness_status": { "type": "object" },
    "current_truth_snapshot_id": { "type": "string" },
    "symbol_authority_source": { "type": "string" },
    "market_data_snapshot_id": { "type": "string" },
    "portfolio_gate_decision_id": { "type": "string" },
    "conversion_status": { "type": "string" },
    "conversion_blocker_code": { "type": "string" },
    "conversion_blocker_message": { "type": "string" },
    "submit_boundary_status": { "type": "string" },
    "paper_intent_status": { "type": "string" },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "review_only_blocked",
        "incomplete_trade_definition",
        "manual_capture_ready",
        "paper_package_ready",
        "paper_intent_created",
        "skipped",
        "captured_manually"
      ]
    },
    "operator_action_allowed": { "type": "boolean" },
    "disallowed_actions": { "type": "array", "items": { "type": "string" } },
    "manual_capture_record": {
      "type": "object",
      "required": [
        "capture_status",
        "quantity",
        "fill_price",
        "fill_time",
        "stop_price",
        "invalidation_level",
        "operator_id",
        "notes",
        "external_reference",
        "blocker_snapshot",
        "immutable_hash"
      ]
    },
    "safety": {
      "type": "object",
      "required": [
        "broker_execution_allowed",
        "live_trading_allowed",
        "order_routing_allowed",
        "capital_allocation_allowed",
        "paper_submit_created_by_projection",
        "candidate_selection_mutated"
      ]
    },
    "canonical_json_hash": { "type": "string" }
  }
}
