{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/active_session.v1.schema.json",
  "title": "active_session.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "generated_utc",
    "target_day",
    "active_day",
    "prior_day",
    "next_target_day",
    "active_day_admission_ref",
    "active_day_build_ref",
    "target_day_admission_ref",
    "target_day_build_ref",
    "target_day_admission_status",
    "rollover_status",
    "rollover_reason",
    "rollover_reason_code",
    "rollover_reason_summary",
    "blocked_target_day",
    "blocked_admission_ref",
    "blocked_reason_codes",
    "authority_owner"
  ],
  "properties": {
    "schema_id": { "const": "active_session" },
    "schema_version": { "const": "v1" },
    "generated_utc": { "type": "string", "minLength": 20 },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "active_day": { "type": "string" },
    "prior_day": { "type": "string" },
    "next_target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "active_day_admission_ref": { "type": "string" },
    "active_day_build_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 64 }
      }
    },
    "target_day_admission_ref": { "type": "string", "minLength": 1 },
    "target_day_build_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 64 }
      }
    },
    "target_day_admission_status": { "type": "string", "enum": ["ADMIT", "BLOCKED"] },
    "rollover_status": {
      "type": "string",
      "enum": ["ROLLOVER_COMPLETED", "ACTIVE_SESSION_CONFIRMED", "ROLLOVER_WITHHELD"]
    },
    "rollover_reason": { "type": "string" },
    "rollover_reason_code": { "type": "string" },
    "rollover_reason_summary": { "type": "string" },
    "blocked_target_day": { "type": "string" },
    "blocked_admission_ref": { "type": "string" },
    "blocked_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authority_owner": { "type": "string", "minLength": 1 },
    "promotion_state": {
      "type": "string",
      "enum": ["PROMOTED", "BLOCKED", "FAILED_VALIDATION"]
    },
    "promotion_decision_ref": { "type": "string" },
    "blocking_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "closure_state": {
      "type": "string",
      "enum": ["COMPLETE", "BLOCKED", "DEGRADED", "OPEN"]
    },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  }
}
