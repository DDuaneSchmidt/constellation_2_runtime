{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2.reports.operator_query_response.v1",
  "title": "C2 Operator Query Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "day_utc", "interface_ruleset_id", "interface_ruleset_version", "query_class_id", "query_class_version", "response_template_id", "response_template_version", "query_id", "original_query_text", "normalized_query_text", "run_scope", "response_status", "answer_blocks", "source_refs", "retrieval_manifest_ref", "trust_panel_ref", "unsupported_reason", "partiality_status", "integrity_status"],
  "properties": {
    "schema_id": { "type": "string", "const": "operator_query_response_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "interface_ruleset_id": { "type": "string", "const": "BATCH3_OPERATOR_INTERFACE_RULESET" },
    "interface_ruleset_version": { "type": "integer", "const": 1 },
    "query_class_id": { "type": "string" },
    "query_class_version": { "type": "integer", "minimum": 1 },
    "response_template_id": { "type": "string" },
    "response_template_version": { "type": "integer", "minimum": 1 },
    "query_id": { "type": "string" },
    "original_query_text": { "type": "string" },
    "normalized_query_text": { "type": "string" },
    "run_scope": { "$ref": "#/$defs/run_scope" },
    "response_status": { "type": "string", "enum": ["EXACT", "BOUNDED_PARTIAL", "UNAVAILABLE", "INTEGRITY_CONSTRAINED", "UNSUPPORTED"] },
    "answer_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "title", "lines", "source_refs"],
        "properties": {
          "block_id": { "type": "string" },
          "title": { "type": "string" },
          "lines": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "retrieval_manifest_ref": { "type": "string" },
    "trust_panel_ref": { "type": "string" },
    "unsupported_reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "partiality_status": { "type": "string", "enum": ["EXACT", "BOUNDED_PARTIAL", "UNAVAILABLE", "INTEGRITY_CONSTRAINED"] },
    "integrity_status": { "type": "string", "enum": ["OK", "BOUNDED_INCOMPLETE", "EVIDENCE_INCONSISTENT", "INTERNAL_FAILURE"] }
  },
  "$defs": {
    "run_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_utc", "mode", "sleeve_id", "engine_id", "attempt_id", "attempt_seq", "truth_partition"],
      "properties": {
        "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "mode": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sleeve_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "engine_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt_seq": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "truth_partition": { "type": "string" }
      }
    }
  }
}
