{
  "$id": "https://constellation.local/schemas/session_readiness_refresh.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C2 Session Readiness Refresh v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "producer",
    "status",
    "overall_refresh_verdict",
    "core_failure_count",
    "monitoring_failure_count",
    "failures",
    "results",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_SESSION_READINESS_REFRESH_V1" },
    "schema_version": { "type": "integer", "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "minLength": 20 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "git_sha", "module"],
      "properties": {
        "repo": { "type": "string" },
        "git_sha": { "type": "string" },
        "module": { "type": "string" }
      }
    },
    "status": { "type": "string" },
    "overall_refresh_verdict": { "type": "string" },
    "core_failure_count": { "type": "integer", "minimum": 0 },
    "monitoring_failure_count": { "type": "integer", "minimum": 0 },
    "failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "results": {
      "type": "object",
      "additionalProperties": true
    },
    "canonical_json_hash": { "type": "string", "minLength": 64, "maxLength": 64 }
  }
}
