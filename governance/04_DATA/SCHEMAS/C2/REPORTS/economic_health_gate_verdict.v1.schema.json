{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "economic_health_gate_verdict.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "gate_classification_registry_id",
    "gate_classification_registry_version",
    "lifecycle_state_authority_ref",
    "day_utc",
    "mode",
    "produced_utc",
    "included_gates",
    "excluded_gates",
    "blocking_gates",
    "status",
    "blocking_class",
    "reason_codes",
    "evidence_refs",
    "decision_ledger_ref"
  ],
  "properties": {
    "schema_id": { "const": "economic_health_gate_verdict_v1" },
    "schema_version": { "const": 1 },
    "gate_classification_registry_id": { "type": "string", "minLength": 1 },
    "gate_classification_registry_version": { "type": "integer", "minimum": 1 },
    "lifecycle_state_authority_ref": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "mode": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "produced_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00Z$" },
    "included_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "artifact_path", "artifact_sha256", "reason_codes"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": "string", "minLength": 1 },
          "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "excluded_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "exclusion_reasons"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "exclusion_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "blocking_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "blocking_domain", "artifact_path", "reason_codes"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "blocking_domain": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "blocking_class": {
      "type": "string",
      "enum": ["CLASS1_SYSTEM_HARD_STOP", "CLASS2_RISK_HARD_STOP", "CLASS3_CONTROLLED_DEGRADATION", "CLASS4_ADVISORY", "NONE"]
    },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decision_ledger_ref": { "type": "string", "minLength": 1 }
  }
}
