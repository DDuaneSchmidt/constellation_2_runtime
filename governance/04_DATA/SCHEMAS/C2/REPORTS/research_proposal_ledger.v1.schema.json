{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_proposal_ledger.v1.schema.json",
  "title": "Research Proposal Ledger v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_id", "schema_version", "day_utc", "generated_at_utc", "status", "proposals", "authority", "producer_contract_v1"],
  "properties": {
    "schema_id": { "const": "research_proposal_ledger" },
    "schema_version": { "const": "research_proposal_ledger.v1" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at_utc": { "type": "string" },
    "status": { "type": "string" },
    "authority": { "const": "RESEARCH_PROPOSAL_ONLY" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal_id", "hypothesis", "signal_idea", "expected_market_behavior", "data_required", "risks", "created_by", "generated_at", "status"],
        "properties": {
          "proposal_id": { "type": "string", "minLength": 1 },
          "hypothesis": { "type": "string", "minLength": 1 },
          "signal_idea": { "type": "string", "minLength": 1 },
          "expected_market_behavior": { "type": "string", "minLength": 1 },
          "data_required": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "created_by": { "type": "string", "minLength": 1 },
          "generated_at": { "type": "string", "minLength": 1 },
          "status": { "const": "PROPOSED" }
        }
      }
    },
    "producer_contract_v1": { "type": "object" }
  }
}
