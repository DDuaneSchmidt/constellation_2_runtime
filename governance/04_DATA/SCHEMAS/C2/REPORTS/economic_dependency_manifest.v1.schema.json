
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_id": {"const": "economic_dependency_manifest"},
    "schema_version": {"const": "v1"},
    "operation_type": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "seal_requires": {"type": "array", "items": {"type": "string"}},
    "stage_order": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema_id", "schema_version", "operation_type", "dependencies", "seal_requires", "stage_order"]
}
