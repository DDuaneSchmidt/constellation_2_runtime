{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/operator_trade_health_queues.v1.schema.json",
  "title": "operator_trade_health_queues.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authority_owner",
    "queue_set_id",
    "day_utc",
    "generated_at_utc",
    "execution_root_path",
    "rollup_rule_version",
    "queue_membership_basis",
    "blocked_index",
    "review_required_index",
    "stale_degraded_index",
    "drift_exception_index",
    "unauthorized_transmit_attempt_index",
    "recent_change_queue",
    "queue_degradation_codes",
    "session_summary",
    "derived_only"
  ],
  "properties": {
    "schema_id": { "const": "operator_trade_health_queues" },
    "schema_version": { "const": "v1" },
    "authority_owner": { "const": "operator_trade_health_queues_v1" },
    "queue_set_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "execution_root_path": { "type": "string", "minLength": 1 },
    "rollup_rule_version": { "type": "string", "minLength": 1 },
    "queue_membership_basis": { "const": "OPERATOR_TRADE_HEALTH_AND_PROVENANCE_ONLY" },
    "blocked_index": { "$ref": "#/$defs/queue_rows" },
    "review_required_index": { "$ref": "#/$defs/queue_rows" },
    "stale_degraded_index": { "$ref": "#/$defs/queue_rows" },
    "drift_exception_index": { "$ref": "#/$defs/queue_rows" },
    "unauthorized_transmit_attempt_index": { "$ref": "#/$defs/queue_rows" },
    "recent_change_queue": { "$ref": "#/$defs/queue_rows" },
    "queue_degradation_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "session_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_trade_count",
        "healthy_count",
        "action_required_count",
        "review_required_count",
        "blocked_count",
        "degraded_incomplete_count"
      ],
      "properties": {
        "total_trade_count": { "type": "integer", "minimum": 0 },
        "healthy_count": { "type": "integer", "minimum": 0 },
        "action_required_count": { "type": "integer", "minimum": 0 },
        "review_required_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "degraded_incomplete_count": { "type": "integer", "minimum": 0 }
      }
    },
    "derived_only": { "const": true }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "queue_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_identity_id",
        "operator_health_ref",
        "summary_provenance_ref",
        "queue_reason_class",
        "highest_severity",
        "degraded"
      ],
      "properties": {
        "trade_identity_id": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" },
        "operator_health_ref": { "$ref": "#/$defs/artifact_ref" },
        "summary_provenance_ref": { "$ref": "#/$defs/artifact_ref" },
        "queue_reason_class": { "type": "string", "minLength": 1 },
        "highest_severity": { "type": "string", "minLength": 1 },
        "degraded": { "type": "boolean" }
      }
    },
    "queue_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/queue_row" }
    }
  }
}
