{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_session_dependency_graph.v1.schema.json",
  "title": "paper_session_dependency_graph.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "graph_id",
    "session_id",
    "day_utc",
    "mode",
    "graph_fingerprint",
    "dependency_keys",
    "admitted_sleeve_ids",
    "nodes",
    "edges",
    "recorded_at"
  ],
  "properties": {
    "schema_id": { "const": "paper_session_dependency_graph" },
    "schema_version": { "const": "v1" },
    "graph_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["PAPER"] },
    "graph_fingerprint": { "type": "string", "minLength": 1 },
    "dependency_keys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "admitted_sleeve_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_type",
          "dependency_key",
          "path",
          "required"
        ],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "node_type": { "type": "string", "minLength": 1 },
          "dependency_key": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "schema_relpath": { "type": "string" },
          "expected_status": { "type": "string" },
          "producer_owner": { "type": "string" },
          "source_registry_ref": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_node_id", "to_node_id"],
        "properties": {
          "from_node_id": { "type": "string", "minLength": 1 },
          "to_node_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recorded_at": { "type": "string", "minLength": 1 }
  }
}
