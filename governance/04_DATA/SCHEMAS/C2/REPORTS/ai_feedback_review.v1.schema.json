{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/ai_feedback_review.v1.schema.json",
  "title": "ai_feedback_review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "review_id",
    "review_type",
    "period_start",
    "period_end",
    "generated_at_utc",
    "input_artifact_refs",
    "evidence_gate_id",
    "evidence_gate_status",
    "data_quality_status",
    "sleeves_reviewed",
    "trades_reviewed",
    "events_reviewed",
    "regimes_reviewed",
    "alerts_reviewed",
    "market_context_summary",
    "findings",
    "hypothesis_suggestions",
    "research_tasks_created",
    "ai_used",
    "model_used",
    "deterministic_fallback_used",
    "human_review_required",
    "production_mutation",
    "broker_action_allowed",
    "auto_promotion_allowed",
    "auto_demotion_allowed",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "ai_feedback_review" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "ai_feedback_review_v1" },
    "review_id": { "type": "string", "minLength": 1 },
    "review_type": { "type": "string", "enum": ["EOD", "EOW"] },
    "period_start": { "type": "string", "minLength": 10 },
    "period_end": { "type": "string", "minLength": 10 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "input_artifact_refs": { "type": "array", "items": { "type": "object" } },
    "evidence_gate_id": { "type": "string", "minLength": 1 },
    "evidence_gate_status": { "type": "string", "enum": ["BLOCKED", "OBSERVATION_ONLY", "PASS"] },
    "data_quality_status": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] },
    "sleeves_reviewed": { "type": "array", "items": { "type": "string" } },
    "trades_reviewed": { "type": "array", "items": { "type": "string" } },
    "events_reviewed": { "type": "array", "items": { "type": "string" } },
    "regimes_reviewed": { "type": "array", "items": { "type": "string" } },
    "alerts_reviewed": { "type": "array", "items": { "type": "string" } },
    "market_context_summary": { "type": "object" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "finding_type",
          "sleeve_id",
          "hypothesis_id",
          "event_type",
          "regime_state",
          "evidence_refs",
          "trade_ids",
          "sample_count",
          "summary",
          "severity",
          "confidence",
          "recommended_action",
          "recommended_research_task_type",
          "production_action_allowed"
        ],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "finding_type": {
            "type": "string",
            "enum": [
              "SLEEVE_DEGRADATION",
              "SLEEVE_IMPROVEMENT",
              "REGIME_DEPENDENCY",
              "EVENT_FALSE_POSITIVE",
              "EVENT_SUCCESS_PATTERN",
              "STOP_BEHAVIOR_ISSUE",
              "SLIPPAGE_ISSUE",
              "EDGE_OVERLAP",
              "DATA_QUALITY_ISSUE",
              "MISSED_TRADE_PATTERN",
              "HYPOTHESIS_REFINEMENT",
              "PROMOTION_CANDIDATE",
              "DEMOTION_CANDIDATE"
            ]
          },
          "sleeve_id": { "type": "string" },
          "hypothesis_id": { "type": "string" },
          "event_type": { "type": "string" },
          "regime_state": { "type": "string" },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
          "trade_ids": { "type": "array", "items": { "type": "string" } },
          "sample_count": { "type": "integer", "minimum": 0 },
          "summary": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "recommended_action": { "type": "string", "minLength": 1 },
          "recommended_research_task_type": { "type": "string" },
          "production_action_allowed": { "const": false }
        }
      }
    },
    "hypothesis_suggestions": { "type": "array", "items": { "type": "object" } },
    "research_tasks_created": { "type": "array", "items": { "type": "object" } },
    "ai_used": { "const": false },
    "model_used": { "type": "string" },
    "deterministic_fallback_used": { "const": true },
    "human_review_required": { "const": true },
    "production_mutation": { "const": false },
    "broker_action_allowed": { "const": false },
    "auto_promotion_allowed": { "const": false },
    "auto_demotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
