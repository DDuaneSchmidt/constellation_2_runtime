{
  "$id": "C2_REPORTS_PAPER_POLICY_VERDICT_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 Paper Policy Verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "ib_account",
    "sleeve_id",
    "overall_status",
    "paper_allowed",
    "blocking_items",
    "advisory_items",
    "production_only_open_items",
    "capability_state_ref",
    "source_artifacts",
    "release_id",
    "git_sha",
    "generated_at_utc"
  ],
  "properties": {
    "schema_id": { "const": "paper_policy_verdict" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "ib_account": { "type": "string" },
    "sleeve_id": { "type": "string" },
    "overall_status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "paper_allowed": { "type": "boolean" },
    "blocking_items": { "$ref": "#/$defs/policyItems" },
    "advisory_items": { "$ref": "#/$defs/policyItems" },
    "production_only_open_items": { "$ref": "#/$defs/policyItems" },
    "capability_state_ref": { "$ref": "#/$defs/artifactRef" },
    "source_artifacts": { "$ref": "#/$defs/artifactRefs" },
    "release_id": { "type": "string" },
    "git_sha": { "type": "string" },
    "generated_at_utc": { "type": "string" }
  },
  "$defs": {
    "policyItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "status", "paper_role", "production_role", "reason_codes", "rationale"],
        "properties": {
          "capability_id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
          "paper_role": { "type": "string", "enum": ["BLOCKING", "ADVISORY"] },
          "production_role": { "type": "string", "enum": ["BLOCKING", "ADVISORY"] },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "rationale": { "type": "string" }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_family", "artifact_path", "artifact_sha256"],
        "properties": {
          "artifact_family": { "type": "string" },
          "artifact_path": { "type": "string" },
          "artifact_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
        }
      }
    }
  }
}
