{
  "$id": "https://constellation.local/schemas/c2/reports/aegis_structure_decision.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis Structure Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "structure_decision_id",
    "candidate_id",
    "timestamp",
    "sleeve_id",
    "symbol",
    "original_direction",
    "normalized_direction",
    "current_regime",
    "confidence",
    "fallback_used",
    "selected_structure",
    "rejected_structures",
    "structure_status",
    "reason_codes",
    "structure_reason",
    "risk_defined",
    "max_loss_known",
    "max_gain_known_or_bounded",
    "risk_status",
    "execution_status",
    "raw_candidate_payload"
  ],
  "properties": {
    "structure_decision_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "original_direction": { "type": "string", "minLength": 1 },
    "normalized_direction": { "type": "string", "enum": ["bullish", "bearish", "neutral", "UNKNOWN"] },
    "current_regime": { "type": "string", "minLength": 1 },
    "confidence": { "type": "string", "minLength": 1 },
    "signal_strength": { "type": "string" },
    "expected_move": { "type": "string" },
    "holding_period": { "type": "string" },
    "fallback_used": { "type": "boolean" },
    "selected_structure": {
      "type": "string",
      "enum": [
        "STOCK_ETF",
        "LONG_OPTION",
        "VERTICAL_SPREAD",
        "CREDIT_SPREAD",
        "IRON_CONDOR",
        "NO_TRADE"
      ]
    },
    "rejected_structures": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "STOCK_ETF",
          "LONG_OPTION",
          "VERTICAL_SPREAD",
          "CREDIT_SPREAD",
          "IRON_CONDOR"
        ]
      },
      "uniqueItems": true
    },
    "structure_status": {
      "type": "string",
      "enum": ["structure_selected", "structure_rejected"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "STRUCTURE_SELECTED_STOCK_ETF",
          "STRUCTURE_SELECTED_LONG_OPTION",
          "STRUCTURE_SELECTED_VERTICAL_SPREAD",
          "STRUCTURE_SELECTED_CREDIT_SPREAD",
          "STRUCTURE_SELECTED_IRON_CONDOR",
          "STRUCTURE_REJECTED_NO_TRADE",
          "STRUCTURE_REJECTED_INPUT_MISSING",
          "STRUCTURE_REJECTED_WEAK_SIGNAL",
          "STRUCTURE_REJECTED_REGIME_UNKNOWN",
          "STRUCTURE_REJECTED_HIGH_VOL",
          "STRUCTURE_FALLBACK_USED",
          "STRUCTURE_MATCHES_TRENDING",
          "STRUCTURE_MATCHES_CHOPPY",
          "STRUCTURE_DOES_NOT_CHANGE_DIRECTION",
          "STRUCTURE_DEFINED_RISK_REQUIRED"
        ]
      },
      "uniqueItems": true
    },
    "structure_reason": { "type": "string" },
    "risk_defined": { "type": "boolean" },
    "max_loss_known": { "type": "boolean" },
    "max_gain_known_or_bounded": { "type": "boolean" },
    "risk_status": { "const": "not_evaluated" },
    "execution_status": { "const": "not_evaluated" },
    "raw_candidate_payload": { "type": "object" }
  }
}
