{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/paper_session_definition.v1.schema.json",
  "title": "paper_session_definition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "session_id",
    "day_utc",
    "mode",
    "operator_entrypoint",
    "execution_entrypoint",
    "required_artifact_families",
    "required_dependency_keys",
    "dependency_source_refs",
    "declared_sleeve_ids",
    "recorded_at"
  ],
  "properties": {
    "schema_id": { "const": "paper_session_definition" },
    "schema_version": { "const": "v1" },
    "session_id": { "type": "string", "minLength": 1 },
    "day_utc": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["PAPER"] },
    "operator_entrypoint": { "type": "string", "minLength": 1 },
    "execution_entrypoint": { "type": "string", "minLength": 1 },
    "required_artifact_families": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_dependency_keys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependency_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "declared_sleeve_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "recorded_at": { "type": "string", "minLength": 1 }
  }
}
