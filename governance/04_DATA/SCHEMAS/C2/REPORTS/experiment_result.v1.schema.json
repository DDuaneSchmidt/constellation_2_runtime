{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/experiment_result.v1.schema.json",
  "title": "experiment_result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "artifact_id", "experiment_id", "hypothesis_id", "task_id", "test_stage", "dataset_used", "instrument_universe", "test_window", "trigger_definition", "outcome_definition", "sample_count", "expectancy", "win_rate", "avg_return", "median_return", "max_drawdown", "volatility", "friction_adjusted_result", "regime_dependency", "robustness_notes", "out_of_sample_result", "overlap_with_existing_sleeves", "result_status", "recommendation", "next_action", "created_at", "research_lab_only", "executable_trade_created", "automatic_promotion_allowed", "canonical_json_hash"],
  "properties": {
    "schema_id": { "const": "experiment_result" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "experiment_result_v1" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "test_stage": { "type": "string", "minLength": 1 },
    "dataset_used": { "type": "string" },
    "instrument_universe": { "type": "array", "items": { "type": "string" } },
    "test_window": { "type": "string" },
    "trigger_definition": { "type": "string" },
    "outcome_definition": { "type": "string" },
    "sample_count": { "type": "integer", "minimum": 0 },
    "expectancy": { "type": "string" },
    "win_rate": { "type": "string" },
    "avg_return": { "type": "string" },
    "median_return": { "type": "string" },
    "max_drawdown": { "type": "string" },
    "volatility": { "type": "string" },
    "friction_adjusted_result": { "type": "string" },
    "regime_dependency": { "type": "string" },
    "robustness_notes": { "type": "string" },
    "out_of_sample_result": { "type": "string" },
    "overlap_with_existing_sleeves": { "type": "string" },
    "result_status": { "type": "string", "enum": ["insufficient_data", "weak", "promising", "regime_dependent", "overlapping", "duplicate", "rejected", "validated_candidate"] },
    "recommendation": { "type": "string" },
    "next_action": { "type": "string" },
    "created_at": { "type": "string" },
    "research_lab_only": { "const": true },
    "executable_trade_created": { "const": false },
    "automatic_promotion_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
