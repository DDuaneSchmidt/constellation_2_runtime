{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/capital_authority_allocation.v1.schema.json",
  "title": "capital_authority_allocation.v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "runtime_evaluation_hash",
    "allocation_policy_version",
    "total_capital_authorized",
    "allowed_sleeves",
    "blocked_sleeves",
    "decision_chain",
    "input_hashes",
    "output_hash",
    "validation_status",
    "broker_execution_allowed",
    "autonomous_execution_allowed",
    "trade_advice_allowed"
  ],
  "properties": {
    "schema_id": {"const": "capital_authority_allocation"},
    "schema_version": {"const": "v1"},
    "artifact_id": {"type": "string"},
    "day_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "generated_at_utc": {"type": "string"},
    "runtime_evaluation_hash": {"type": "string"},
    "allocation_policy_version": {"type": "string"},
    "allocation_policy_path": {"type": "string"},
    "allocation_policy_hash": {"type": "string"},
    "allocation_source": {"type": "string", "enum": ["POLICY_DERIVED", "OPERATOR_APPROVED", "STATIC_RISK_BUDGET", "MANUAL_REQUIRED", "FORBIDDEN"]},
    "operator_manual_authority_source": {"type": "string"},
    "manual_required_command": {"type": "string"},
    "total_capital_authorized": {"type": "string"},
    "total_capital_authorized_cents": {"type": "integer"},
    "sleeve_level_allocations": {"type": "array", "items": {"type": "object"}},
    "symbol_ticket_allocation_limits": {"type": "array", "items": {"type": "object"}},
    "allowed_sleeves": {"type": "array", "items": {"type": "object"}},
    "blocked_sleeves": {"type": "array", "items": {"type": "object"}},
    "max_notional": {"type": "string"},
    "max_risk": {"type": "string"},
    "decision_chain": {"type": "object"},
    "per_sleeve": {"type": "array", "items": {"type": "object"}},
    "per_intent": {"type": "array", "items": {"type": "object"}},
    "portfolio": {"type": "object"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "output_hash": {"type": "string"},
    "validation_status": {"type": "string", "enum": ["VALID", "REJECTED", "MANUAL_REQUIRED"]},
    "status": {"type": "string"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "broker_execution_allowed": {"const": false},
    "broker_submit_transmit_allowed": {"const": false},
    "order_routing_allowed": {"const": false},
    "autonomous_execution_allowed": {"const": false},
    "trade_advice_allowed": {"const": false}
  },
  "additionalProperties": true
}
