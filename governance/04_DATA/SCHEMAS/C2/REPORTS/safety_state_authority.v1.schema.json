{
  "$id": "https://constellation.local/schemas/c2/reports/safety_state_authority.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safety State Authority v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "authority_scope",
    "day_utc",
    "produced_utc",
    "status",
    "account",
    "environment",
    "nav_source",
    "nav_current_cents",
    "nav_prior_cents",
    "nav_valid",
    "drawdown_pct",
    "drawdown_limit_pct",
    "drawdown_status",
    "kill_switch_state",
    "kill_switch_reason_codes",
    "allow_entries",
    "allow_exits",
    "forced_mode",
    "capital_envelope_status",
    "submit_safety_status",
    "canonical_blocker",
    "root_cause",
    "upstream_artifact_paths",
    "stale_or_conflicting_inputs",
    "operator_next_action",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_SAFETY_STATE_AUTHORITY_V1" },
    "schema_version": { "const": 1 },
    "authority_scope": { "const": "SAFETY_STATE" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "BLOCKED", "DEGRADED"] },
    "account": { "type": "string" },
    "environment": { "type": "string" },
    "nav_source": { "type": "string" },
    "nav_current_cents": { "type": ["integer", "null"] },
    "nav_prior_cents": { "type": ["integer", "null"] },
    "nav_valid": { "type": "boolean" },
    "drawdown_pct": { "type": ["string", "null"] },
    "drawdown_limit_pct": { "type": ["string", "null"] },
    "drawdown_status": { "type": "string" },
    "kill_switch_state": { "type": "string" },
    "kill_switch_reason_codes": { "type": "array", "items": { "type": "string" } },
    "allow_entries": { "type": "boolean" },
    "allow_exits": { "type": "boolean" },
    "forced_mode": { "type": "string" },
    "capital_envelope_status": { "type": "string" },
    "submit_safety_status": { "type": "string" },
    "canonical_blocker": { "type": "string" },
    "root_cause": { "type": "string" },
    "upstream_artifact_paths": { "type": "object", "additionalProperties": { "type": "string" } },
    "stale_or_conflicting_inputs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "operator_next_action": { "type": "string" },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
