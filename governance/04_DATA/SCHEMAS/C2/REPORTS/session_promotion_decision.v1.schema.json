{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/session_promotion_decision.v1.schema.json",
  "title": "session_promotion_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "decided_at_utc",
    "target_day",
    "owner_tool",
    "rules_version",
    "pre_open_bundle_ref",
    "target_day_admission_ref",
    "prior_current_state",
    "pre_open_materialization_state",
    "pre_open_completion_state",
    "target_day_admission_status",
    "promotion_state",
    "candidate_artifacts",
    "promoted_artifacts",
    "blocked_reason_codes"
  ],
  "properties": {
    "schema_id": { "const": "session_promotion_decision" },
    "schema_version": { "const": "v1" },
    "decided_at_utc": { "type": "string", "minLength": 20 },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "owner_tool": { "type": "string", "minLength": 1 },
    "rules_version": { "type": "string", "minLength": 1 },
    "pre_open_bundle_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" }
      }
    },
    "target_day_admission_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" }
      }
    },
    "prior_current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_session_ref", "active_day", "target_day_admission_status"],
      "properties": {
        "active_session_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_path", "artifact_sha256"],
          "properties": {
            "artifact_path": { "type": "string" },
            "artifact_sha256": { "type": "string" }
          }
        },
        "active_day": { "type": "string" },
        "target_day_admission_status": { "type": "string" }
      }
    },
    "pre_open_materialization_state": { "type": "string" },
    "pre_open_completion_state": { "type": "string" },
    "target_day_admission_status": { "type": "string" },
    "promotion_state": {
      "type": "string",
      "enum": ["PROMOTED", "BLOCKED", "FAILED_VALIDATION"]
    },
    "candidate_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_path"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "promoted_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_path"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocked_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
