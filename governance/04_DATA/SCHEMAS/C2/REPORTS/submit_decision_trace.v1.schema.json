{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/submit_decision_trace.v1.schema.json",
  "title": "submit_decision_trace.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "decision_id",
    "day_utc",
    "environment",
    "sleeve_id",
    "opportunity_id",
    "intent_id",
    "submit_decision",
    "submit_decision_reason_code",
    "submit_decision_reason_detail",
    "boundary_status_at_decision",
    "submission_authorized_at_decision",
    "authority_status_at_decision",
    "evidence_refs",
    "observed_at_utc",
    "emitted_by",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": {
      "const": "submit_decision_trace"
    },
    "schema_version": {
      "const": "v1"
    },
    "artifact_id": {
      "const": "submit_decision_trace_v1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "day_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "sleeve_id": {
      "type": "string",
      "minLength": 1
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "submit_decision": {
      "type": "string",
      "enum": [
        "ATTEMPTED",
        "SKIPPED",
        "UNKNOWN"
      ]
    },
    "submit_decision_reason_code": {
      "type": "string",
      "minLength": 1
    },
    "submit_decision_reason_detail": {
      "type": "string"
    },
    "boundary_status_at_decision": {
      "type": "string",
      "minLength": 1
    },
    "submission_authorized_at_decision": {
      "type": "boolean"
    },
    "authority_status_at_decision": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_type",
          "artifact_path",
          "artifact_sha256"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "emitted_by": {
      "type": "string",
      "minLength": 1
    },
    "canonical_json_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
