{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/research_evidence_packet.v1.schema.json",
  "title": "research_evidence_packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "research_id",
    "hypothesis_id",
    "task_id",
    "title",
    "hypothesis_description",
    "research_type",
    "created_at_utc",
    "source_data_summary",
    "replay_window",
    "instruments_tested",
    "regimes_tested",
    "edge_family",
    "expected_holding_period",
    "methodology_summary",
    "methodology_version",
    "metrics_summary",
    "expectancy_summary",
    "drawdown_summary",
    "MAE_MFE_summary",
    "failure_modes",
    "known_limitations",
    "reproducibility_notes",
    "artifact_lineage",
    "data_snapshot_refs",
    "code_version",
    "reason_codes",
    "research_status",
    "research_lab_only",
    "execution_authority_granted",
    "runtime_authorized",
    "broker_submit_required",
    "transmit_automation_required",
    "automatic_lite_promotion_allowed",
    "immutable_artifact",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "research_evidence_packet" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "research_evidence_packet_v1" },
    "research_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "hypothesis_description": { "type": "string", "minLength": 1 },
    "research_type": { "$ref": "#/$defs/research_type" },
    "created_at_utc": { "type": "string", "minLength": 20 },
    "source_data_summary": { "type": "string" },
    "replay_window": { "type": "string" },
    "instruments_tested": { "type": "array", "items": { "type": "string" } },
    "regimes_tested": { "type": "array", "items": { "type": "string" } },
    "edge_family": { "type": "string" },
    "expected_holding_period": { "type": "string" },
    "methodology_summary": { "type": "string" },
    "methodology_version": { "type": "string", "minLength": 1 },
    "metrics_summary": { "type": "object" },
    "expectancy_summary": { "type": "string" },
    "drawdown_summary": { "type": "string" },
    "MAE_MFE_summary": { "type": "string" },
    "failure_modes": { "type": "array", "items": { "type": "string" } },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "reproducibility_notes": { "type": "string" },
    "artifact_lineage": { "type": "array", "items": { "type": "object" } },
    "data_snapshot_refs": { "type": "array", "items": { "type": "string" } },
    "code_version": { "type": "string", "minLength": 1 },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "research_status": { "$ref": "#/$defs/research_status" },
    "research_lab_only": { "const": true },
    "execution_authority_granted": { "const": false },
    "runtime_authorized": { "const": false },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "automatic_lite_promotion_allowed": { "const": false },
    "immutable_artifact": { "const": true },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "research_type": {
      "type": "string",
      "enum": ["SLEEVE", "EDGE", "REGIME", "GOVERNANCE", "OVERLAP", "STOP_LOGIC", "RISK_SIZING", "BEHAVIORAL_STATE"]
    },
    "research_status": {
      "type": "string",
      "enum": ["DRAFT", "UNDER_REVIEW", "VALIDATED_RESEARCH", "REJECTED", "ARCHIVED"]
    }
  }
}
