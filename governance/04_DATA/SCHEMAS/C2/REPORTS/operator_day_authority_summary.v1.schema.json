{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/operator_day_authority_summary.v1.schema.json",
  "title": "operator_day_authority_summary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "binding_classification",
    "day_utc",
    "produced_at_utc",
    "producer",
    "active_day",
    "admission_status",
    "session_authority_rollover_status",
    "session_authority_status_severity",
    "final_start_decision",
    "startup_open_status",
    "open_policy",
    "first_blocker_code",
    "first_blocker_artifact_path",
    "operator_message",
    "trade_readiness_yes_no",
    "trade_readiness_canonical_gate",
    "trade_readiness_canonical_blocker",
    "trade_readiness_reason",
    "input_refs"
  ],
  "properties": {
    "schema_id": { "const": "operator_day_authority_summary" },
    "schema_version": { "const": "v1" },
    "binding_classification": { "type": "string", "const": "BINDING_AUTHORITY_SUMMARY" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_at_utc": { "type": "string", "minLength": 20 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "active_day": { "type": "string" },
    "admission_status": { "type": "string", "enum": ["ADMIT", "BLOCKED"] },
    "session_authority_rollover_status": { "type": "string", "minLength": 1 },
    "session_authority_status_severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
    "final_start_decision": { "type": "string", "minLength": 1 },
    "startup_open_status": {
      "type": "string",
      "enum": [
        "PRE_OPEN_READY",
        "READY_NOT_STARTED",
        "OPEN_WAITING_FOR_AUTHORITY",
        "PAPER_OPEN_AVAILABLE",
        "OPEN_TRIGGER_EMITTED",
        "OPEN_ATTEMPTED",
        "OPEN_SUCCEEDED",
        "LATE_OPEN_AVAILABLE",
        "LATE_OPEN_EXHAUSTED",
        "OPEN_MISSED",
        "OPEN_FAILED",
        "OPEN_NO_TRADES",
        "OPEN_SUBMIT_CAPABLE",
        "OPEN_WITH_SUBMISSIONS",
        "OPEN_WITH_FILLS",
        "STARTING",
        "STARTED",
        "STARTED_AND_PROGRESSED",
        "BLOCKED",
        "FAILED"
      ]
    },
    "open_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_mode",
        "environment",
        "max_successful_opens_per_day",
        "max_late_open_attempts_per_day",
        "same_day_open_cap_enforced",
        "time_window_enforced",
        "successful_open_already_recorded",
        "prior_success_ref",
        "initial_open_consumed",
        "late_open_available",
        "late_open_consumed",
        "late_open_consumed_ref",
        "open_terminal",
        "terminal_reason_code",
        "policy_status",
        "attempt_count",
        "latest_attempt_kind",
        "latest_attempt_result",
        "prior_trigger_kind",
        "prior_trigger_status"
      ],
      "properties": {
        "policy_mode": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
        "max_successful_opens_per_day": { "type": "integer", "minimum": 0 },
        "max_late_open_attempts_per_day": { "type": "integer", "minimum": 0 },
        "same_day_open_cap_enforced": { "type": "boolean" },
        "time_window_enforced": { "type": "boolean" },
        "successful_open_already_recorded": { "type": "boolean" },
        "prior_success_ref": { "type": "string" },
        "initial_open_consumed": { "type": "boolean" },
        "late_open_available": { "type": "boolean" },
        "late_open_consumed": { "type": "boolean" },
        "late_open_consumed_ref": { "type": "string" },
        "open_terminal": { "type": "boolean" },
        "terminal_reason_code": { "type": "string" },
        "policy_status": { "type": "string", "minLength": 1 },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "latest_attempt_kind": { "type": "string", "minLength": 1 },
        "latest_attempt_result": { "type": "string" },
        "prior_trigger_kind": { "type": "string", "minLength": 1 },
        "prior_trigger_status": { "type": "string" }
      }
    },
    "first_blocker_code": { "type": "string" },
    "first_blocker_artifact_path": { "type": "string" },
    "operator_message": { "type": "string", "minLength": 1 },
    "trade_readiness_yes_no": { "type": "string", "enum": ["YES", "NO"] },
    "trade_readiness_canonical_gate": { "type": "string", "minLength": 1 },
    "trade_readiness_canonical_blocker": { "type": "string" },
    "trade_readiness_reason": { "type": "string", "minLength": 1 },
    "input_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_session_v1",
        "target_day_admission_v1",
        "session_authority_status_v1",
        "paper_session_ledger_v1",
        "trading_day_state_machine_v1",
        "day_open_trigger_v1",
        "day_open_attempt_v1",
        "execution_reconciliation_v1",
        "trade_readiness_decision_v1"
      ],
      "properties": {
        "active_session_v1": { "type": "string", "minLength": 1 },
        "target_day_admission_v1": { "type": "string", "minLength": 1 },
        "session_authority_status_v1": { "type": "string", "minLength": 1 },
        "paper_session_ledger_v1": { "type": "string", "minLength": 1 },
        "trading_day_state_machine_v1": { "type": "string", "minLength": 1 },
        "day_open_trigger_v1": { "type": "string", "minLength": 1 },
        "day_open_attempt_v1": { "type": "string", "minLength": 1 },
        "execution_reconciliation_v1": { "type": "string", "minLength": 1 },
        "trade_readiness_decision_v1": { "type": "string", "minLength": 1 }
      }
    }
  }
}
