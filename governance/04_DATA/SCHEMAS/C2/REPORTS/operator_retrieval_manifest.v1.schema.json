{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2.reports.operator_retrieval_manifest.v1",
  "title": "C2 Operator Retrieval Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "day_utc", "query_or_view_id", "route_classification", "requested_scope", "normalized_scope", "retrieved_artifacts", "rejected_artifacts", "scope_filters_applied", "precedence_rules_applied", "retrieval_status"],
  "properties": {
    "schema_id": { "type": "string", "const": "operator_retrieval_manifest_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "query_or_view_id": { "type": "string" },
    "route_classification": { "type": "string" },
    "requested_scope": { "$ref": "#/$defs/scope" },
    "normalized_scope": { "$ref": "#/$defs/scope" },
    "retrieved_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "required", "status"],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "required": { "type": "boolean" },
          "status": { "type": "string", "enum": ["RETRIEVED", "OPTIONAL_MISSING"] }
        }
      }
    },
    "rejected_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "reason"],
        "properties": {
          "artifact_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "scope_filters_applied": { "type": "array", "items": { "type": "string" } },
    "precedence_rules_applied": { "type": "array", "items": { "type": "string" } },
    "retrieval_status": { "type": "string", "enum": ["EXACT", "BOUNDED_PARTIAL", "UNAVAILABLE", "INTEGRITY_CONSTRAINED", "UNSUPPORTED"] }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_utc", "mode", "sleeve_id", "attempt_id", "truth_partition"],
      "properties": {
        "day_utc": { "anyOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, { "type": "null" }] },
        "mode": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sleeve_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "truth_partition": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    }
  }
}
