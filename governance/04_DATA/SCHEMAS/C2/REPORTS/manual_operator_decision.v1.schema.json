{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/manual_operator_decision.v1.schema.json",
  "title": "manual_operator_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "day_utc",
    "run_id",
    "candidate_id",
    "sleeve_id",
    "edge_cluster_id",
    "decision",
    "decision_reason_codes",
    "operator_notes",
    "decision_time_utc",
    "deviation_from_recommendation",
    "manual_review_required",
    "observational_only",
    "broker_submit_required",
    "transmit_automation_required",
    "source_artifact_lineage",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "manual_operator_decision" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "manual_operator_decision_v1" },
    "day_utc": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "edge_cluster_id": { "type": "string" },
    "decision": { "type": "string", "enum": ["ENTERED", "SKIPPED", "MODIFIED", "WATCHLIST", "REJECTED"] },
    "decision_reason_codes": { "type": "array", "items": { "type": "string" } },
    "operator_notes": { "type": "string" },
    "decision_time_utc": { "type": "string", "minLength": 20 },
    "deviation_from_recommendation": { "type": "string" },
    "manual_review_required": { "type": "boolean" },
    "observational_only": { "const": true },
    "broker_submit_required": { "const": false },
    "transmit_automation_required": { "const": false },
    "source_artifact_lineage": { "type": "array", "items": { "type": "object" } },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
