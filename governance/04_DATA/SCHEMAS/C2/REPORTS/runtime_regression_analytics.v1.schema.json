{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2.reports.runtime_regression_analytics.v1",
  "title": "C2 Runtime Regression Analytics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "regression_ruleset_id",
    "regression_ruleset_version",
    "comparison_mode",
    "day_utc",
    "comparison_day_utc",
    "produced_utc",
    "comparison_status",
    "current_activity_flow_ref",
    "comparison_activity_flow_ref",
    "compared_metrics",
    "material_changes",
    "integrity_status",
    "producer"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "runtime_regression_analytics_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "regression_ruleset_id": { "type": "string", "minLength": 1 },
    "regression_ruleset_version": { "type": "integer", "minimum": 1 },
    "comparison_mode": { "type": "string", "const": "PRIOR_DAY" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "comparison_day_utc": { "anyOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, { "type": "null" }] },
    "produced_utc": { "type": "string", "minLength": 1 },
    "comparison_status": { "type": "string", "enum": ["PRIOR_DAY_AVAILABLE", "PRIOR_DAY_UNAVAILABLE"] },
    "current_activity_flow_ref": { "type": "string", "minLength": 1 },
    "comparison_activity_flow_ref": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "compared_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "current_value",
          "comparison_value",
          "absolute_change",
          "relative_change_bps",
          "comparison_status"
        ],
        "properties": {
          "metric_id": { "type": "string" },
          "current_value": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "comparison_value": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "absolute_change": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "relative_change_bps": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "comparison_status": { "type": "string", "enum": ["COMPARED", "UNAVAILABLE"] }
        }
      }
    },
    "material_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "absolute_change"],
        "properties": {
          "metric_id": { "type": "string" },
          "absolute_change": { "type": "integer" }
        }
      }
    },
    "integrity_status": { "type": "string", "enum": ["OK", "COMPARISON_UNAVAILABLE"] },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string" },
        "module": { "type": "string" },
        "git_sha": { "type": "string" }
      }
    }
  }
}
