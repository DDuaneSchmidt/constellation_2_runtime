{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/step_result_envelope.v1.schema.json",
  "title": "step_result_envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "step_id",
    "status",
    "artifact_refs",
    "counts",
    "warnings",
    "blocking_defects",
    "diagnostics",
    "schema_refs"
  ],
  "properties": {
    "schema_id": {
      "const": "step_result_envelope"
    },
    "schema_version": {
      "const": "v1"
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["OK", "OK_WITH_WARNINGS", "BLOCKED"]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocking_class", "reason_code", "evidence_ref"],
        "properties": {
          "blocking_class": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
