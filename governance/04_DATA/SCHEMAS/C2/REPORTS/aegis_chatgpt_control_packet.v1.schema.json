{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/C2/REPORTS/aegis_chatgpt_control_packet.v1.schema.json",
  "title": "aegis_chatgpt_control_packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "day_utc",
    "generated_at",
    "packet_version",
    "runtime_truth_classification",
    "source_artifacts_used",
    "source_artifact_timestamps",
    "stale_or_missing_sources",
    "aegis_lite_status",
    "event_monitoring_status",
    "market_context_status",
    "research_lab_status",
    "operator_inbox_status",
    "sleeve_performance_status",
    "ai_feedback_status",
    "dataset_gaps",
    "readiness_state",
    "current_actionable_items",
    "blocked_items",
    "next_operator_actions",
    "do_not_claim",
    "safety_assertions",
    "trade_advice_allowed",
    "manual_trade_capture_allowed",
    "reason_if_blocked",
    "manual_execution_only",
    "broker_submit_required",
    "ib_automation_required",
    "autonomous_execution_allowed",
    "production_mutation_allowed",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "aegis_chatgpt_control_packet" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "aegis_chatgpt_control_packet_v1" },
    "day_utc": { "type": "string", "minLength": 10 },
    "generated_at": { "type": "string", "minLength": 20 },
    "packet_version": { "const": "aegis_chatgpt_control_packet.v1" },
    "runtime_truth_classification": {
      "type": "string",
      "enum": ["REAL_RUNTIME", "DEMO_ONLY", "DRY_RUN_ONLY", "PARTIAL_CONTEXT", "ADVISORY_ONLY", "BLOCKED"]
    },
    "source_artifacts_used": { "type": "array", "items": { "type": "object" } },
    "source_artifact_timestamps": { "type": "object" },
    "stale_or_missing_sources": { "type": "array", "items": { "type": "object" } },
    "aegis_lite_status": { "type": "object" },
    "event_monitoring_status": { "type": "object" },
    "market_context_status": { "type": "object" },
    "research_lab_status": { "type": "object" },
    "operator_inbox_status": { "type": "object" },
    "sleeve_performance_status": { "type": "object" },
    "ai_feedback_status": { "type": "object" },
    "dataset_gaps": { "type": "object" },
    "readiness_state": { "type": "object" },
    "current_actionable_items": { "type": "array", "items": { "type": "object" } },
    "blocked_items": { "type": "array", "items": { "type": "object" } },
    "next_operator_actions": { "type": "array", "items": { "type": "string" } },
    "do_not_claim": { "type": "array", "items": { "type": "string" } },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_control_packet_no_trade_advice",
        "partial_packet_advisory_only",
        "demo_or_dry_run_never_actionable",
        "manual_execution_only",
        "broker_submit_required",
        "ib_automation_required",
        "autonomous_execution_allowed",
        "research_artifacts_authorize_trades",
        "event_runs_mutate_canonical_eod_state",
        "ai_can_mutate_production_logic",
        "operator_must_verify_packet_before_manual_entry"
      ],
      "properties": {
        "no_control_packet_no_trade_advice": { "const": true },
        "partial_packet_advisory_only": { "const": true },
        "demo_or_dry_run_never_actionable": { "const": true },
        "manual_execution_only": { "const": true },
        "broker_submit_required": { "const": false },
        "ib_automation_required": { "const": false },
        "autonomous_execution_allowed": { "const": false },
        "research_artifacts_authorize_trades": { "const": false },
        "event_runs_mutate_canonical_eod_state": { "const": false },
        "ai_can_mutate_production_logic": { "const": false },
        "operator_must_verify_packet_before_manual_entry": { "const": true }
      }
    },
    "trade_advice_allowed": { "type": "boolean" },
    "manual_trade_capture_allowed": { "type": "boolean" },
    "reason_if_blocked": { "type": "string" },
    "manual_execution_only": { "const": true },
    "broker_submit_required": { "const": false },
    "ib_automation_required": { "const": false },
    "autonomous_execution_allowed": { "const": false },
    "production_mutation_allowed": { "const": false },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
