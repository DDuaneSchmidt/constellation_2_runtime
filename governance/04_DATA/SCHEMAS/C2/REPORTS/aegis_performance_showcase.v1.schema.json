{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/aegis_performance_showcase.v1.schema.json",
  "title": "aegis_performance_showcase.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "report_id",
    "report_date",
    "data_mode",
    "data_label",
    "as_of_date",
    "advisory_only",
    "controls_runtime_behavior",
    "controls_broker_execution",
    "controls_phasec_materialization",
    "source_artifacts",
    "metrics",
    "equity_curve",
    "benchmark_curve",
    "sleeve_curves",
    "drawdown_curve",
    "monthly_returns",
    "capital_risk_allocation",
    "paper_orders",
    "annotations",
    "excluded_nav_points",
    "data_gaps",
    "disclaimer",
    "generated_at"
  ],
  "properties": {
    "schema_id": { "const": "C2_AEGIS_PERFORMANCE_SHOWCASE_V1" },
    "schema_version": { "const": "v1" },
    "report_id": { "type": "string", "minLength": 1 },
    "report_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "data_mode": { "enum": ["BACKTEST", "PAPER_TRADING", "LIVE"] },
    "data_label": { "type": "string", "minLength": 1 },
    "as_of_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "advisory_only": { "const": true },
    "controls_runtime_behavior": { "const": false },
    "controls_broker_execution": { "const": false },
    "controls_phasec_materialization": { "const": false },
    "source_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_artifact" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_return_pct",
        "annualized_return_pct",
        "max_drawdown_pct",
        "sharpe_ratio",
        "win_rate_pct",
        "total_orders",
        "completed_trades",
        "filled_quantity",
        "active_sleeves",
        "valid_nav_points",
        "excluded_nav_points"
      ],
      "properties": {
        "total_return_pct": { "type": ["string", "null"] },
        "annualized_return_pct": { "type": ["string", "null"] },
        "max_drawdown_pct": { "type": ["string", "null"] },
        "sharpe_ratio": { "type": ["string", "null"] },
        "win_rate_pct": { "type": ["string", "null"] },
        "total_orders": { "type": "integer", "minimum": 0 },
        "completed_trades": { "type": "integer", "minimum": 0 },
        "filled_quantity": { "type": "string" },
        "active_sleeves": { "type": "integer", "minimum": 0 },
        "valid_nav_points": { "type": "integer", "minimum": 0 },
        "excluded_nav_points": { "type": "integer", "minimum": 0 }
      }
    },
    "equity_curve": {
      "type": "array",
      "items": { "$ref": "#/$defs/equity_point" }
    },
    "benchmark_curve": {
      "type": "array",
      "items": { "$ref": "#/$defs/benchmark_point" }
    },
    "sleeve_curves": { "type": "array" },
    "drawdown_curve": {
      "type": "array",
      "items": { "$ref": "#/$defs/drawdown_point" }
    },
    "monthly_returns": { "type": "array" },
    "capital_risk_allocation": {
      "type": "array",
      "items": { "$ref": "#/$defs/capital_allocation" }
    },
    "paper_orders": {
      "type": "array",
      "items": { "$ref": "#/$defs/paper_order" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "excluded_nav_points": {
      "type": "array",
      "items": { "$ref": "#/$defs/excluded_nav_point" }
    },
    "data_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/data_gap" }
    },
    "disclaimer": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 20 }
  },
  "$defs": {
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "path", "sha256", "status"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "equity_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "nav_total", "status", "source_path", "source_sha256", "cumulative_return_pct"],
      "properties": {
        "date": { "type": "string" },
        "nav_total": { "type": "string" },
        "status": { "type": "string" },
        "source_path": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "cumulative_return_pct": { "type": "string" }
      }
    },
    "benchmark_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "symbol", "close", "cumulative_return_pct", "source_name", "source_hash", "source_path", "source_sha256"],
      "properties": {
        "date": { "type": "string" },
        "symbol": { "type": "string" },
        "close": { "type": "string" },
        "cumulative_return_pct": { "type": "string" },
        "source_name": { "type": "string" },
        "source_hash": { "type": "string" },
        "source_path": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "drawdown_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "nav_total", "peak_nav", "drawdown_pct"],
      "properties": {
        "date": { "type": "string" },
        "nav_total": { "type": "string" },
        "peak_nav": { "type": "string" },
        "drawdown_pct": { "type": "string" }
      }
    },
    "capital_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sleeve_id", "engine_ids", "allowed_capital_at_risk_cents", "used_capital_at_risk_cents", "headroom_cents", "utilization_pct", "source_path", "source_sha256"],
      "properties": {
        "sleeve_id": { "type": "string" },
        "engine_ids": { "type": "array", "items": { "type": "string" } },
        "allowed_capital_at_risk_cents": { "type": "integer", "minimum": 0 },
        "used_capital_at_risk_cents": { "type": "integer", "minimum": 0 },
        "headroom_cents": { "type": "integer" },
        "utilization_pct": { "type": "string" },
        "source_path": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "paper_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_utc", "engine_id", "source_intent_id", "symbol", "action", "order_qty", "filled_qty", "remaining_qty", "avg_fill_price_weighted", "lifecycle_status", "submission_status", "broker_environment", "source_path", "source_sha256"],
      "properties": {
        "day_utc": { "type": "string" },
        "engine_id": { "type": "string" },
        "source_intent_id": { "type": "string" },
        "symbol": { "type": "string" },
        "action": { "type": "string" },
        "order_qty": { "type": "integer", "minimum": 0 },
        "filled_qty": { "type": "integer", "minimum": 0 },
        "remaining_qty": { "type": "integer", "minimum": 0 },
        "avg_fill_price_weighted": { "type": "string" },
        "lifecycle_status": { "type": "string" },
        "submission_status": { "type": "string" },
        "broker_environment": { "type": "string" },
        "source_path": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_type", "date", "title", "summary"],
      "properties": {
        "annotation_type": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "excluded_nav_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "day_utc": { "type": "string" },
        "status": { "type": "string" },
        "nav_total": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data_gap": {
      "type": "object",
      "additionalProperties": true,
      "required": ["field", "severity", "reason", "required_artifacts"],
      "properties": {
        "field": { "type": "string" },
        "severity": { "type": "string" },
        "reason": { "type": "string" },
        "required_artifacts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
