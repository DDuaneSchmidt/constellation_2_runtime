{
  "$id": "https://constellation.local/schemas/c2/reports/execution_mode_authority.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Mode Authority v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "environment",
    "produced_utc",
    "authority_scope",
    "status",
    "mode_state",
    "mode",
    "dry_run_policy",
    "broker_transmit_enabled",
    "broker_ids_expected",
    "fills_expected",
    "post_submit_lineage_gap_policy",
    "missing_broker_ids_diagnostic",
    "missing_broker_ids_blocker",
    "first_blocker",
    "mode_sources",
    "submissions",
    "input_evidence",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "const": "C2_EXECUTION_MODE_AUTHORITY_V1" },
    "schema_version": { "const": 1 },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "environment": { "type": "string", "enum": ["PAPER", "LIVE"] },
    "produced_utc": { "type": "string" },
    "authority_scope": { "const": "EXECUTION_MODE_EXPECTATIONS" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "mode_state": { "type": "string", "enum": ["DRY_RUN_LOCKED", "PAPER_READY_NOT_TRANSMITTED", "PAPER_TRANSMIT_ENABLED", "SUBMIT_BLOCKED"] },
    "mode": { "type": "string", "enum": ["DRY_RUN_LOCKED", "PAPER_READY_NOT_TRANSMITTED", "PAPER_TRANSMIT_ENABLED", "SUBMIT_BLOCKED"] },
    "dry_run_policy": { "type": "string" },
    "broker_transmit_enabled": { "type": "boolean" },
    "broker_ids_expected": { "type": "boolean" },
    "fills_expected": { "type": "boolean" },
    "post_submit_lineage_gap_policy": { "type": "string", "enum": ["BLOCKER", "DIAGNOSTIC"] },
    "missing_broker_ids_diagnostic": { "type": "boolean" },
    "missing_broker_ids_blocker": { "type": "boolean" },
    "first_blocker": { "type": "string" },
    "mode_sources": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "submissions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "input_evidence": { "type": "array", "items": { "$ref": "#/$defs/input_evidence" } },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "input_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "exists"],
      "properties": {
        "artifact_type": { "type": "string" },
        "path": { "type": "string" },
        "exists": { "type": "boolean" }
      }
    }
  }
}
