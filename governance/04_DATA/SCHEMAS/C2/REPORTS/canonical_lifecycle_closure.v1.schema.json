{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/canonical_lifecycle_closure.v1.schema.json",
  "title": "canonical_lifecycle_closure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "produced_utc",
    "producer",
    "canonical_truth_root",
    "source_truth_root",
    "submission_id",
    "order_id",
    "perm_id",
    "linkage_key",
    "source_submission_ref",
    "canonical_submission_ref",
    "source_execution_event_ref",
    "canonical_execution_event_ref",
    "broker_observation_ref",
    "fill_observation_ref",
    "broker_observation_basis",
    "fill_observation_basis",
    "broker_observation_match_count",
    "fill_observation_match_count",
    "sleeve_submission_status",
    "broker_status_observed",
    "broker_status_advanced_observed",
    "explicit_terminal_broker_state_observed",
    "fill_status_observed",
    "fill_observed",
    "canonical_lifecycle_status",
    "lifecycle_states",
    "broker_observation_state",
    "fill_observation_state",
    "propagation_state",
    "blocker_chain",
    "runtime_ledger_projection"
  ],
  "properties": {
    "schema_id": { "const": "canonical_lifecycle_closure" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "produced_utc": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "canonical_truth_root": { "type": "string", "minLength": 1 },
    "source_truth_root": { "type": "string", "minLength": 1 },
    "submission_id": { "type": "string", "minLength": 1 },
    "order_id": { "type": "string", "minLength": 1 },
    "perm_id": { "type": "string", "minLength": 1 },
    "linkage_key": { "type": "string", "minLength": 1 },
    "source_submission_ref": { "$ref": "#/$defs/artifactRef" },
    "canonical_submission_ref": { "$ref": "#/$defs/artifactRef" },
    "source_execution_event_ref": { "$ref": "#/$defs/artifactRef" },
    "canonical_execution_event_ref": { "$ref": "#/$defs/artifactRef" },
    "broker_observation_ref": { "$ref": "#/$defs/artifactRef" },
    "fill_observation_ref": { "$ref": "#/$defs/artifactRef" },
    "broker_observation_basis": {
      "type": "string",
      "enum": ["NONE", "EXECUTION_EVENT_ONLY", "BROKER_FACT_ONLY", "BROKER_FACT_AND_EXECUTION_EVENT"]
    },
    "fill_observation_basis": {
      "type": "string",
      "enum": ["NONE", "EXECUTION_EVENT_ONLY", "BROKER_FACT_ONLY", "BROKER_FACT_AND_EXECUTION_EVENT"]
    },
    "broker_observation_match_count": { "type": "integer", "minimum": 0 },
    "fill_observation_match_count": { "type": "integer", "minimum": 0 },
    "sleeve_submission_status": { "type": "string", "minLength": 1 },
    "broker_status_observed": { "type": "string", "minLength": 1 },
    "broker_status_advanced_observed": { "type": "boolean" },
    "explicit_terminal_broker_state_observed": { "type": "boolean" },
    "fill_status_observed": { "$ref": "#/$defs/fillStatus" },
    "fill_observed": { "type": "boolean" },
    "canonical_lifecycle_status": { "type": "string", "enum": ["CANONICALIZED", "BLOCKED"] },
    "lifecycle_states": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SUBMISSION_RECORDED",
          "BROKER_STATUS_NOT_YET_OBSERVED",
          "BROKER_STATUS_OBSERVED",
          "FILL_NOT_YET_OBSERVED",
          "FILL_OBSERVED",
          "TERMINAL_STATE_OBSERVED",
          "PROPAGATION_PENDING",
          "PROPAGATION_COMPLETE",
          "PROPAGATION_BLOCKED"
        ]
      }
    },
    "broker_observation_state": {
      "type": "string",
      "enum": ["BROKER_STATUS_NOT_YET_OBSERVED", "BROKER_STATUS_OBSERVED", "TERMINAL_STATE_OBSERVED"]
    },
    "fill_observation_state": {
      "type": "string",
      "enum": ["FILL_NOT_YET_OBSERVED", "FILL_OBSERVED"]
    },
    "propagation_state": { "$ref": "#/$defs/propagationState" },
    "blocker_chain": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime_ledger_projection": { "$ref": "#/$defs/runtimeLedgerProjection" }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "sha256", "status", "reason_codes"],
      "properties": {
        "path": { "type": "string" },
        "exists": { "type": "boolean" },
        "sha256": { "type": "string" },
        "status": { "type": "string" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fillStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filled_qty", "avg_price"],
      "properties": {
        "filled_qty": { "type": "integer", "minimum": 0 },
        "avg_price": { "type": "string", "minLength": 1 }
      }
    },
    "propagationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fill_ledger_ref",
        "positions_snapshot_ref",
        "positions_effective_ref",
        "nav_ref",
        "positions_item_count",
        "positions_effective_snapshot_path",
        "nav_total_observed",
        "blocker_chain"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PROPAGATION_PENDING", "PROPAGATION_COMPLETE", "PROPAGATION_BLOCKED"]
        },
        "fill_ledger_ref": { "$ref": "#/$defs/artifactRef" },
        "positions_snapshot_ref": { "$ref": "#/$defs/artifactRef" },
        "positions_effective_ref": { "$ref": "#/$defs/artifactRef" },
        "nav_ref": { "$ref": "#/$defs/artifactRef" },
        "positions_item_count": { "type": "integer", "minimum": 0 },
        "positions_effective_snapshot_path": { "type": "string" },
        "nav_total_observed": { "type": "boolean" },
        "blocker_chain": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtimeLedgerProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_path",
        "ledger_sha256",
        "derived_from_runtime_ledger",
        "event_types",
        "event_count",
        "appended_event_ids",
        "reused_event_ids",
        "projection_notice"
      ],
      "properties": {
        "ledger_path": { "type": "string", "minLength": 1 },
        "ledger_sha256": { "type": "string" },
        "derived_from_runtime_ledger": { "type": "boolean" },
        "event_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "event_count": { "type": "integer", "minimum": 0 },
        "appended_event_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "reused_event_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "projection_notice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
