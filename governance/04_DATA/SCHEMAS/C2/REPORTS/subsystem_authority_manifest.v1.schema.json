{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/reports/subsystem_authority_manifest.v1.schema.json",
  "title": "subsystem_authority_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "generated_utc",
    "subsystem_id",
    "authority_owner",
    "canonical_artifacts",
    "trusted_upstream_authorities",
    "precedence_rules",
    "invalidation_rules",
    "degraded_states",
    "fail_closed_on_ambiguity",
    "operator_summary_ref"
  ],
  "properties": {
    "schema_id": { "const": "subsystem_authority_manifest" },
    "schema_version": { "const": "v1" },
    "generated_utc": { "type": "string", "minLength": 20 },
    "subsystem_id": { "type": "string", "minLength": 1 },
    "authority_owner": { "type": "string", "minLength": 1 },
    "canonical_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_path", "authority_role"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "authority_role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trusted_upstream_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_id", "authority_path", "authority_type"],
        "properties": {
          "authority_id": { "type": "string", "minLength": 1 },
          "authority_path": { "type": "string", "minLength": 1 },
          "authority_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "precedence_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "rule_id", "description", "source_ids", "outcome"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "source_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outcome": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invalidation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason_code", "condition", "effect"],
        "properties": {
          "reason_code": { "type": "string", "minLength": 1 },
          "condition": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 }
        }
      }
    },
    "degraded_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "reason_code", "meaning"],
        "properties": {
          "state": { "type": "string", "minLength": 1 },
          "reason_code": { "type": "string" },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fail_closed_on_ambiguity": { "type": "boolean" },
    "operator_summary_ref": { "type": "string" }
  }
}
