{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2.reports.daily_summary.v1",
  "title": "C2 Daily Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "visibility_ruleset_id", "visibility_ruleset_version", "metric_registry_id", "metric_registry_version", "run_scope", "readiness_status", "blocked_status", "summary_classification", "integrity_status", "key_counts", "key_changes", "key_risks", "diagnostic_refs", "metric_snapshot_ref", "decision_ledger_ref", "evidence_refs"],
  "properties": {
    "schema_id": { "type": "string", "const": "daily_summary_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "visibility_ruleset_id": { "type": "string", "const": "BATCH2_VISIBILITY_RULESET" },
    "visibility_ruleset_version": { "type": "integer", "const": 1 },
    "metric_registry_id": { "type": "string", "const": "C2_VISIBILITY_METRIC_REGISTRY_V1" },
    "metric_registry_version": { "type": "integer", "const": 1 },
    "run_scope": { "$ref": "#/$defs/run_scope" },
    "readiness_status": { "type": "string" },
    "blocked_status": { "type": "string", "enum": ["BLOCKED", "NOT_BLOCKED", "UNKNOWN"] },
    "summary_classification": { "type": "string", "enum": ["READINESS_BLOCKED", "INTEGRITY_FAILED", "DIAGNOSTIC_ATTENTION_REQUIRED", "READY_ZERO_INTENTS", "READY_WITH_MATERIAL_DRIFT", "READY_STABLE", "INTERNAL_FAILURE"] },
    "integrity_status": { "type": "string", "enum": ["OK", "BOUNDED_INCOMPLETE", "EVIDENCE_INCONSISTENT", "INTERNAL_FAILURE"] },
    "key_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "value", "availability_status"],
        "properties": {
          "metric_id": { "type": "string" },
          "value": { "anyOf": [{ "type": "integer" }, { "type": "string" }, { "type": "null" }] },
          "availability_status": { "type": "string", "enum": ["VALUE", "ZERO", "UNAVAILABLE", "BLOCKED_DOWNSTREAM", "INTEGRITY_FAILED"] }
        }
      }
    },
    "key_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "absolute_change"],
        "properties": {
          "metric_id": { "type": "string" },
          "absolute_change": { "type": "integer" }
        }
      }
    },
    "key_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_code", "source", "detail"],
        "properties": {
          "risk_code": { "type": "string" },
          "source": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "diagnostic_refs": { "type": "array", "items": { "type": "string" } },
    "metric_snapshot_ref": { "type": "string" },
    "decision_ledger_ref": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "run_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_utc", "mode", "sleeve_id", "engine_id", "attempt_id", "attempt_seq", "truth_partition"],
      "properties": {
        "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "mode": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sleeve_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "engine_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt_seq": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "truth_partition": { "type": "string" }
      }
    }
  }
}
