{
  "$id": "C2_ACCOUNTING_NAV_V2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cash_hash": {
      "type": "string"
    },
    "day0_bootstrap_classification": {
      "type": "string"
    },
    "day_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "history": {
      "additionalProperties": true,
      "type": "object"
    },
    "input_manifest": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "nav": {
      "additionalProperties": true,
      "type": "object"
    },
    "positions_hash": {
      "type": "string"
    },
    "produced_utc": {
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "git_sha": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "git_sha",
        "module"
      ],
      "type": "object"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "runtime_evaluation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "C2_ACCOUNTING_NAV_V2"
    },
    "schema_version": {
      "const": 2
    },
    "source_type": {
      "enum": [
        "BROKER_EXPORT",
        "MANUAL_DECLARATION",
        "SIMULATION_LEDGER",
        "STATIC_RISK_BUDGET",
        "STATIC_RISK_BUDGET_BOOTSTRAP",
        "ACCOUNT_EVIDENCE",
        "POSITIONS_SNAPSHOT_V5",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "produced_utc",
    "day_utc",
    "producer",
    "status",
    "reason_codes",
    "input_manifest",
    "nav",
    "history"
  ],
  "title": "C2 Accounting NAV v2 (supports broker marks)",
  "type": "object"
}
