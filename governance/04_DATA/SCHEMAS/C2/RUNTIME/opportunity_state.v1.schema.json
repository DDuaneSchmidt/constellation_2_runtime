{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/opportunity_state.v1.schema.json",
  "title": "opportunity_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "surface_kind",
    "opportunity_id",
    "opportunity_state_id",
    "kernel_version",
    "explanation_mapping_version",
    "generated_at_utc",
    "authority_label",
    "target_day",
    "scope_id",
    "operation_type",
    "sleeve_id",
    "environment",
    "ib_account",
    "opportunity_type",
    "opportunity_state",
    "actionability_state",
    "review_priority",
    "freshness_state",
    "visibility_state",
    "blocker_states",
    "delta_state",
    "scenario_significance_state",
    "advisory_binding_state",
    "primary_rule_id",
    "primary_explanation",
    "historical_visibility",
    "governing_advisory_refs",
    "governing_tax_refs",
    "governing_trust_refs",
    "governing_readiness_refs",
    "governing_scenario_refs",
    "governing_portfolio_refs",
    "evidence_refs",
    "semantic_events"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "historicalVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_current", "is_historical_only", "is_suppressed"],
      "properties": {
        "is_current": { "type": "boolean" },
        "is_historical_only": { "type": "boolean" },
        "is_suppressed": { "type": "boolean" }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explanation_id",
        "opportunity_type",
        "opportunity_state",
        "actionability_state",
        "review_priority",
        "blocker_states",
        "delta_state",
        "scenario_significance_state",
        "freshness_state",
        "visibility_state",
        "short_message",
        "detail_fields",
        "evidence_refs",
        "authority_label"
      ],
      "properties": {
        "explanation_id": { "type": "string", "minLength": 1 },
        "opportunity_type": { "type": "string", "minLength": 1 },
        "opportunity_state": { "type": "string", "minLength": 1 },
        "actionability_state": { "type": "string", "minLength": 1 },
        "review_priority": { "type": "string", "minLength": 1 },
        "blocker_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "delta_state": { "type": "string", "minLength": 1 },
        "scenario_significance_state": { "type": "string", "minLength": 1 },
        "freshness_state": { "type": "string", "minLength": 1 },
        "visibility_state": { "type": "string", "minLength": 1 },
        "short_message": { "type": "string", "minLength": 1 },
        "detail_fields": { "type": "object", "additionalProperties": true },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "authority_label": { "type": "string", "minLength": 1 },
        "action_class": {
          "type": "string",
          "enum": ["none", "review_now", "monitor", "inspect_blocker", "inspect_history"]
        }
      }
    },
    "advisoryBindingState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_state",
        "opportunity_state",
        "review_priority",
        "visibility_state",
        "blocker_states",
        "binding_reason_id"
      ],
      "properties": {
        "effect_state": { "type": "string", "enum": ["clear", "downgrade", "block"] },
        "opportunity_state": { "type": "string", "minLength": 1 },
        "review_priority": { "type": "string", "minLength": 1 },
        "visibility_state": { "type": "string", "minLength": 1 },
        "blocker_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "delta_state": { "type": "string", "minLength": 1 },
        "scenario_significance_state": { "type": "string", "minLength": 1 },
        "binding_reason_id": { "type": "string", "minLength": 1 }
      }
    },
    "semanticEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "authority_label",
        "opportunity_type",
        "opportunity_state",
        "review_priority",
        "blocker_states",
        "delta_state",
        "scenario_significance_state",
        "governing_refs",
        "kernel_version"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "opportunity_state_computed",
            "opportunity_priority_changed",
            "opportunity_blocked",
            "opportunity_unblocked",
            "opportunity_historical_only",
            "review_snapshot_created",
            "review_delta_detected",
            "scenario_significance_raised",
            "advisory_downgraded_due_to_opportunity"
          ]
        },
        "authority_label": { "type": "string", "minLength": 1 },
        "opportunity_type": { "type": "string", "minLength": 1 },
        "opportunity_state": { "type": "string", "minLength": 1 },
        "review_priority": { "type": "string", "minLength": 1 },
        "blocker_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "delta_state": { "type": "string", "minLength": 1 },
        "scenario_significance_state": { "type": "string", "minLength": 1 },
        "governing_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "kernel_version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema_id": { "const": "opportunity_state" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "opportunity_state_v1" },
    "surface_kind": { "const": "projection" },
    "opportunity_id": { "type": "string", "minLength": 1 },
    "opportunity_state_id": { "type": "string", "minLength": 1 },
    "kernel_version": { "type": "string", "minLength": 1 },
    "explanation_mapping_version": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "authority_label": { "type": "string", "enum": ["governed_certified_opportunity"] },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "operation_type": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "opportunity_type": {
      "type": "string",
      "enum": [
        "tax_harvest_review",
        "advisory_action_review",
        "platform_blocker_review",
        "scenario_review"
      ]
    },
    "opportunity_state": {
      "type": "string",
      "enum": ["blocked", "monitor_only", "actionable", "historical_only"]
    },
    "actionability_state": {
      "type": "string",
      "enum": ["blocked", "inspect_only", "monitor_only", "actionable"]
    },
    "review_priority": {
      "type": "string",
      "enum": ["review_now", "review_soon", "monitor_only", "historical_only"]
    },
    "freshness_state": {
      "type": "string",
      "enum": ["fresh", "stale", "superseded", "historical_only", "unknown"]
    },
    "visibility_state": {
      "type": "string",
      "enum": ["current", "current_downgraded", "historical_only", "suppressed"]
    },
    "blocker_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "delta_state": {
      "type": "string",
      "enum": ["new", "changed", "unchanged", "blocked_but_still_important", "monitor_only"]
    },
    "scenario_significance_state": {
      "type": "string",
      "enum": ["not_evaluated", "basis_unavailable", "monitor_only", "review_now"]
    },
    "advisory_binding_state": { "$ref": "#/$defs/advisoryBindingState" },
    "primary_rule_id": { "type": "string", "minLength": 1 },
    "primary_explanation": { "$ref": "#/$defs/explanation" },
    "historical_visibility": { "$ref": "#/$defs/historicalVisibility" },
    "governing_advisory_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_tax_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_trust_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_readiness_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_scenario_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_portfolio_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "review_snapshot_ref": { "$ref": "#/$defs/ref" },
    "prior_review_snapshot_ref": { "$ref": "#/$defs/ref" },
    "supersedes_ref": { "$ref": "#/$defs/ref" },
    "superseded_by_ref": { "$ref": "#/$defs/ref" },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "semantic_events": { "type": "array", "items": { "$ref": "#/$defs/semanticEvent" } }
  }
}
