{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/tax_state.v1.schema.json",
  "title": "tax_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "tax_state_id",
    "artifact_id",
    "kernel_version",
    "explanation_mapping_version",
    "generated_at_utc",
    "authority_label",
    "target_day",
    "scope_id",
    "tax_scope_id",
    "operation_type",
    "sleeve_id",
    "environment",
    "ib_account",
    "completeness_state",
    "freshness_state",
    "visibility_state",
    "blocker_states",
    "opportunity_states",
    "lot_basis_state",
    "holding_period_state",
    "wash_sale_state",
    "primary_rule_id",
    "primary_explanation",
    "historical_visibility",
    "advisory_binding_state",
    "account_tax_profiles",
    "realized_unrealized_tax_posture",
    "lot_level_entries",
    "harvesting_candidates",
    "governing_refs",
    "evidence_refs",
    "semantic_events"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "historical_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_current", "is_historical_only", "is_suppressed"],
      "properties": {
        "is_current": { "type": "boolean" },
        "is_historical_only": { "type": "boolean" },
        "is_suppressed": { "type": "boolean" }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explanation_id",
        "completeness_state",
        "freshness_state",
        "blocker_states",
        "opportunity_states",
        "degraded_reason_id",
        "short_message",
        "detail_fields",
        "evidence_refs",
        "authority_label"
      ],
      "properties": {
        "explanation_id": { "type": "string", "minLength": 1 },
        "completeness_state": { "type": "string", "minLength": 1 },
        "freshness_state": { "type": "string", "minLength": 1 },
        "blocker_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "opportunity_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "degraded_reason_id": { "type": "string", "minLength": 1 },
        "short_message": { "type": "string", "minLength": 1 },
        "detail_fields": { "type": "object", "additionalProperties": true },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "authority_label": { "type": "string", "minLength": 1 },
        "action_class": {
          "type": "string",
          "enum": [
            "none",
            "verify_tax_truth",
            "review_tax_blocker",
            "inspect_historical_tax_state",
            "wait_for_fresh_tax_state"
          ]
        }
      }
    },
    "advisory_binding_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_state",
        "completeness_state",
        "freshness_state",
        "blocker_states",
        "opportunity_states",
        "binding_reason_id",
        "tax_state_ref"
      ],
      "properties": {
        "effect_state": { "type": "string", "enum": ["clear", "downgrade", "block"] },
        "completeness_state": { "type": "string", "minLength": 1 },
        "freshness_state": { "type": "string", "minLength": 1 },
        "blocker_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "opportunity_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "binding_reason_id": { "type": "string", "minLength": 1 },
        "tax_state_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "account_tax_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "account_id",
        "environment",
        "tax_profile_state",
        "lot_basis_state",
        "holding_period_state",
        "source_authority",
        "provenance_refs"
      ],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "tax_profile_state": { "type": "string", "enum": ["materialized", "missing_regime", "no_positions", "degraded"] },
        "tax_regime": { "type": ["string", "null"] },
        "lot_basis_state": { "type": "string", "enum": ["known", "partial", "unknown"] },
        "holding_period_state": { "type": "string", "enum": ["known", "partial", "unknown"] },
        "source_authority": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "lot_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id",
        "account_id",
        "security_id",
        "remaining_quantity",
        "basis_total",
        "holding_period_state",
        "confidence_state",
        "maturity_state",
        "restriction_flags",
        "data_quality_flags",
        "reason_codes",
        "source_kind"
      ],
      "properties": {
        "lot_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "security_id": { "type": "string", "minLength": 1 },
        "remaining_quantity": { "type": "string", "minLength": 1 },
        "basis_total": { "type": "string", "minLength": 1 },
        "holding_period_state": { "type": "string", "enum": ["short_term", "long_term", "unknown"] },
        "confidence_state": { "type": "string", "enum": ["exact", "broker_provided", "reconstructed", "unknown"] },
        "maturity_state": { "type": "string", "enum": ["unverified", "restricted", "decision_eligible", "optimization_ineligible"] },
        "restriction_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "data_quality_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_kind": { "type": "string", "enum": ["NATIVE_FILL", "BROKER_AGGREGATE", "ACCEPTED_TAX_FACT"] }
      }
    },
    "harvest_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id",
        "account_id",
        "security_id",
        "unrealized_loss_amount",
        "holding_period_state",
        "wash_sale_replacement_risk",
        "policy_eligibility_result",
        "warnings"
      ],
      "properties": {
        "lot_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "security_id": { "type": "string", "minLength": 1 },
        "unrealized_loss_amount": { "type": "string", "minLength": 1 },
        "holding_period_state": { "type": "string", "enum": ["short_term", "long_term", "unknown"] },
        "wash_sale_replacement_risk": { "type": "boolean" },
        "policy_eligibility_result": { "type": "string", "enum": ["eligible", "eligible_with_warning"] },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "semantic_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "authority_label",
        "completeness_state",
        "freshness_state",
        "visibility_state",
        "blocker_states",
        "opportunity_states",
        "degraded_reason_id",
        "governing_refs",
        "kernel_version"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "tax_state_computed",
            "tax_state_degraded",
            "tax_opportunity_visible",
            "tax_opportunity_suppressed",
            "tax_blocker_raised",
            "tax_blocker_cleared",
            "tax_state_historical_only",
            "tax_advisory_downgraded_due_to_tax"
          ]
        },
        "authority_label": { "type": "string", "minLength": 1 },
        "completeness_state": { "type": "string", "minLength": 1 },
        "freshness_state": { "type": "string", "minLength": 1 },
        "visibility_state": { "type": "string", "minLength": 1 },
        "blocker_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "opportunity_states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "degraded_reason_id": { "type": "string", "minLength": 1 },
        "governing_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "kernel_version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema_id": { "const": "tax_state" },
    "schema_version": { "const": "v1" },
    "tax_state_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "const": "tax_state_v1" },
    "kernel_version": { "type": "string", "minLength": 1 },
    "explanation_mapping_version": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "authority_label": { "type": "string", "enum": ["governed_deterministic_tax_state"] },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "tax_scope_id": { "type": "string", "minLength": 1 },
    "operation_type": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "completeness_state": { "type": "string", "enum": ["complete", "incomplete_basis", "degraded_runtime"] },
    "freshness_state": { "type": "string", "enum": ["fresh", "stale", "superseded", "historical_only", "unknown"] },
    "visibility_state": { "type": "string", "enum": ["current", "current_downgraded", "historical_only", "suppressed"] },
    "blocker_states": { "type": "array", "items": { "type": "string", "enum": ["accepted_tax_truth_missing", "account_regime_missing", "basis_unknown", "holding_period_unknown", "corporate_action_unresolved", "wash_sale_conflict", "policy_block", "stale_tax_state", "superseded_tax_state"] } },
    "opportunity_states": { "type": "array", "items": { "type": "string", "enum": ["harvest_candidate_available"] } },
    "lot_basis_state": { "type": "string", "enum": ["known", "partial", "unknown"] },
    "holding_period_state": { "type": "string", "enum": ["known", "partial", "unknown"] },
    "wash_sale_state": { "type": "string", "enum": ["clear", "warning", "blocked", "unknown"] },
    "primary_rule_id": { "type": "string", "minLength": 1 },
    "primary_explanation": { "$ref": "#/$defs/explanation" },
    "historical_visibility": { "$ref": "#/$defs/historical_visibility" },
    "advisory_binding_state": { "$ref": "#/$defs/advisory_binding_state" },
    "account_tax_profiles": { "type": "array", "items": { "$ref": "#/$defs/account_tax_profile" } },
    "realized_unrealized_tax_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "realized_gain_loss_ytd_usd", "unrealized_gain_loss_usd", "source_refs"],
      "properties": {
        "status": { "type": "string", "enum": ["available", "unavailable"] },
        "realized_gain_loss_ytd_usd": { "type": ["string", "null"] },
        "unrealized_gain_loss_usd": { "type": ["string", "null"] },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "lot_level_entries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "total_lots", "items", "source_refs"],
      "properties": {
        "status": { "type": "string", "enum": ["available", "suppressed", "unavailable"] },
        "total_lots": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/lot_entry" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "harvesting_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_count", "items", "source_refs"],
      "properties": {
        "status": { "type": "string", "enum": ["available", "suppressed", "unavailable"] },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/harvest_candidate" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "governing_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_release_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "semantic_events": { "type": "array", "items": { "$ref": "#/$defs/semantic_event" } },
    "supersedes_ref": { "$ref": "#/$defs/ref" },
    "superseded_by_ref": { "$ref": "#/$defs/ref" }
  }
}
