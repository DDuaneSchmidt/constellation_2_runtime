{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/control_stage_transition_record.v1.schema.json",
  "title": "control_stage_transition_record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "transition_record_artifact_id",
    "transition_id",
    "stage_id",
    "target_day",
    "scope_id",
    "operation_type",
    "sleeve_id",
    "environment",
    "ib_account",
    "transition_request_type",
    "transition_status",
    "generated_at_utc",
    "input_resolution_mode",
    "upstream_stage_ref",
    "authoritative_inputs_used",
    "frozen_inputs_used",
    "invariant_results",
    "validator_kernel_version",
    "boundary_validator_result",
    "family_validator_result",
    "evidence_refs",
    "admission_decision",
    "certification_decision",
    "supersedes_ref",
    "superseded_by_ref",
    "failure_taxonomy",
    "explanation_payload",
    "blocking_reason_codes",
    "closure_state",
    "blocking_codes",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "control_stage_transition_record" },
    "schema_version": { "const": "v1" },
    "transition_record_artifact_id": { "const": "control_stage_transition_record_v1" },
    "transition_id": { "type": "string", "minLength": 1 },
    "stage_id": { "type": "string", "minLength": 1 },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "operation_type": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "transition_request_type": {
      "enum": [
        "evaluate",
        "admit_and_certify",
        "certify_only",
        "recompute_frozen",
        "supersede_from_new_inputs",
        "explain_blocked"
      ]
    },
    "transition_status": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "input_resolution_mode": { "enum": ["NEWLY_RESOLVED", "FROZEN"] },
    "upstream_stage_ref": {
      "anyOf": [
        { "$ref": "#/$defs/control_ref" },
        { "type": "null" }
      ]
    },
    "authoritative_inputs_used": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_ref" }
    },
    "frozen_inputs_used": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_ref" }
    },
    "invariant_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "status"],
        "properties": {
          "invariant_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validator_kernel_version": { "type": "string", "minLength": 1 },
    "boundary_validator_result": { "type": "object", "additionalProperties": true },
    "family_validator_result": { "type": "object", "additionalProperties": true },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_ref" }
    },
    "admission_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stage_admission_ref"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "stage_admission_ref": {
          "anyOf": [
            { "$ref": "#/$defs/control_ref" },
            { "type": "null" }
          ]
        }
      }
    },
    "certification_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stage_certification_ref"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "stage_certification_ref": {
          "anyOf": [
            { "$ref": "#/$defs/control_ref" },
            { "type": "null" }
          ]
        }
      }
    },
    "supersedes_ref": {
      "anyOf": [
        { "$ref": "#/$defs/control_ref" },
        { "type": "null" }
      ]
    },
    "superseded_by_ref": {
      "anyOf": [
        { "$ref": "#/$defs/control_ref" },
        { "type": "null" }
      ]
    },
    "failure_taxonomy": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "explanation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "blocked_reason_codes", "persistence_plan"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "blocked_reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "persistence_plan": { "type": "object", "additionalProperties": true }
      }
    },
    "blocking_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "closure_state": { "enum": ["COMPLETE", "BLOCKED"] },
    "blocking_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "control_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "family_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "root_type"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "root_type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
