{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/control_stage_admission.v1.schema.json",
  "title": "control_stage_admission.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "stage_artifact_id",
    "stage_id",
    "target_day",
    "scope_id",
    "operation_type",
    "sleeve_id",
    "environment",
    "ib_account",
    "admission_status",
    "admitted_at_utc",
    "governing_validator_ids",
    "validator_version",
    "upstream_stage_admission_ref",
    "required_authoritative_family_refs",
    "effective_current_surface_refs",
    "immutable_evidence_refs",
    "invariants_checked",
    "blocking_reason_codes",
    "closure_state",
    "blocking_codes",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "control_stage_admission" },
    "schema_version": { "const": "v1" },
    "stage_artifact_id": { "type": "string", "minLength": 1 },
    "stage_id": { "type": "string", "minLength": 1 },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "operation_type": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "admission_status": { "const": "ADMITTED" },
    "admitted_at_utc": { "type": "string", "minLength": 20 },
    "governing_validator_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "validator_version": { "type": "string", "minLength": 1 },
    "upstream_stage_admission_ref": {
      "anyOf": [
        { "$ref": "#/$defs/control_ref" },
        { "type": "null" }
      ]
    },
    "required_authoritative_family_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_ref" }
    },
    "effective_current_surface_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_ref" }
    },
    "immutable_evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/family_ref" }
    },
    "invariants_checked": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocking_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "closure_state": { "const": "COMPLETE" },
    "blocking_codes": {
      "type": "array",
      "maxItems": 0
    },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": {
      "type": "array",
      "maxItems": 0
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "control_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "family_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "root_type"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "root_type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
