{
  "schema_id": "C2_RELEASE_CURRENT_SCHEMA_V1",
  "title": "C2 Release Current V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "release_current_id",
    "reducer_owner",
    "activation_state",
    "status",
    "generated_at_utc",
    "release_id",
    "git_sha",
    "authoritative_repo_root",
    "release_root",
    "runtime_data_root",
    "canonical_truth_root",
    "truth_sleeves_root",
    "pointer_index_family",
    "allowed_truth_roots",
    "runtime_environment",
    "primary_execution_identity_ref",
    "configuration_state_id",
    "compiled_config_id",
    "activation_transaction_id",
    "release_manifest_ref",
    "active_runtime_contract_ref",
    "configuration_state_ref",
    "compiled_active_config_ref",
    "configuration_activation_transaction_ref",
    "lineage"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "release_current.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "release_current_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reducer_owner": { "type": "string", "const": "truth_kernel_release_current_reducer_v1" },
    "activation_state": { "type": "string", "const": "SHADOW_ONLY" },
    "status": { "type": "string", "const": "ACTIVE_SHADOW" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "release_id": { "type": "string", "minLength": 1 },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "authoritative_repo_root": { "type": "string", "minLength": 1 },
    "release_root": { "type": "string", "minLength": 1 },
    "runtime_data_root": { "type": "string", "minLength": 1 },
    "canonical_truth_root": { "type": "string", "minLength": 1 },
    "truth_sleeves_root": { "type": "string", "minLength": 1 },
    "pointer_index_family": { "type": "string", "minLength": 1 },
    "allowed_truth_roots": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime_environment": { "type": "string", "minLength": 1 },
    "primary_execution_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_owner", "sleeve_id"],
      "properties": {
        "authority_owner": { "type": "string", "const": "execution_identity_binding_v1" },
        "sleeve_id": { "type": "string", "minLength": 1 }
      }
    },
    "configuration_state_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compiled_config_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "activation_transaction_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "release_manifest_ref": { "$ref": "#/$defs/inputSurfaceRef" },
    "active_runtime_contract_ref": { "$ref": "#/$defs/inputSurfaceRef" },
    "configuration_state_ref": { "$ref": "#/$defs/inputSurfaceRef" },
    "compiled_active_config_ref": { "$ref": "#/$defs/artifactRef" },
    "configuration_activation_transaction_ref": { "$ref": "#/$defs/artifactRef" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_module",
        "code_version",
        "replay_input_refs",
        "shadow_only_reason_code"
      ],
      "properties": {
        "producer_module": { "type": "string", "minLength": 1 },
        "code_version": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "replay_input_refs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/inputSurfaceRef" }
        },
        "shadow_only_reason_code": {
          "type": "string",
          "const": "CUTOVER_BOUNDARY_NOT_ESTABLISHED"
        }
      }
    }
  },
  "$defs": {
    "inputSurfaceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "surface", "path", "sha256", "schema_relpath"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_relpath": { "type": "string", "minLength": 1 }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "artifact_class", "finality_state"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_class": { "type": "string", "minLength": 1 },
        "finality_state": { "type": "string", "minLength": 1 }
      }
    }
  }
}
