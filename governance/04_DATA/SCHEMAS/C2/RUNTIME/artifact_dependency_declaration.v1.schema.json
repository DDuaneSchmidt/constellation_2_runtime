{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": { "const": "artifact_dependency_declaration" },
    "schema_version": { "const": "v1" },
    "artifact_type": { "type": "string", "minLength": 1 },
    "artifact_class": {
      "enum": [
        "source_fact",
        "compiled_state",
        "policy_snapshot",
        "policy_interpretation",
        "decision_proposal",
        "admission_result",
        "execution_result",
        "outcome_record",
        "override_record",
        "exception_record",
        "read_model"
      ]
    },
    "authority_id": { "type": "string", "minLength": 1 },
    "declared_dependency_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "artifact_class": { "type": "string" },
          "finality_state": { "type": "string" }
        },
        "required": ["artifact_id", "path", "sha256", "artifact_class", "finality_state"]
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "artifact_type",
    "artifact_class",
    "authority_id",
    "declared_dependency_artifacts",
    "dependency_refs"
  ]
}
