{
  "schema_id": "C2_COMPILED_ACTIVE_CONFIG_SCHEMA_V1",
  "title": "C2 Compiled Active Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "compiled_config_id",
    "authority_owner",
    "generated_at_utc",
    "effective_at_utc",
    "policy_snapshot_ref",
    "validation_result_ref",
    "compile_status",
    "compiled_digest_sha256",
    "resolved_configuration_refs",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "compiled_active_config.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "compiled_config_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_owner": { "type": "string", "const": "configuration_activation_authority_v1" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "effective_at_utc": { "type": "string", "minLength": 20 },
    "policy_snapshot_ref": { "$ref": "#/$defs/artifactRef" },
    "validation_result_ref": { "$ref": "#/$defs/artifactRef" },
    "compile_status": { "type": "string", "enum": ["COMPILED"] },
    "compiled_digest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resolved_configuration_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resolvedConfigRef" }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "artifact_class", "finality_state"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_class": { "type": "string", "minLength": 1 },
        "finality_state": { "type": "string", "minLength": 1 }
      }
    },
    "resolvedConfigRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "path",
        "sha256",
        "document_class",
        "required_for_runtime"
      ],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "document_class": { "type": "string", "minLength": 1 },
        "required_for_runtime": { "type": "boolean" }
      }
    }
  }
}
