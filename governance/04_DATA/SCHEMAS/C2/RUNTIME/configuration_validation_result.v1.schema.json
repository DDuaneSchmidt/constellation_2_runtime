{
  "schema_id": "C2_CONFIGURATION_VALIDATION_RESULT_SCHEMA_V1",
  "title": "C2 Configuration Validation Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "validation_result_id",
    "authority_owner",
    "generated_at_utc",
    "policy_snapshot_ref",
    "governance_utility_refs",
    "validation_status",
    "artifact_writing_convention_status",
    "validated_document_count",
    "required_governance_utility_count",
    "blocking_reason_codes",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "configuration_validation_result.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "validation_result_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_owner": { "type": "string", "const": "configuration_activation_authority_v1" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "policy_snapshot_ref": { "$ref": "#/$defs/artifactRef" },
    "governance_utility_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/logicalRef" }
    },
    "validation_status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "artifact_writing_convention_status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "validated_document_count": { "type": "integer", "minimum": 0 },
    "required_governance_utility_count": { "type": "integer", "minimum": 1 },
    "blocking_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "logicalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "path", "sha256"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "artifact_class", "finality_state"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_class": { "type": "string", "minLength": 1 },
        "finality_state": { "type": "string", "minLength": 1 }
      }
    }
  }
}
