{
  "schema_id": "C2_CONFIGURATION_REVIEW_DIFF_SCHEMA_V1",
  "title": "C2 Configuration Review Diff V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "review_diff_id",
    "authority_owner",
    "generated_at_utc",
    "review_kind",
    "review_status",
    "candidate_compiled_active_config_ref",
    "diff_summary",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "configuration_review_diff.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "review_diff_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_owner": { "type": "string", "const": "configuration_activation_authority_v1" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "review_kind": { "type": "string", "enum": ["FIRST_ACTIVATION", "SUPERSEDING_ACTIVATION"] },
    "review_status": { "type": "string", "enum": ["REVIEW_READY", "BLOCKED"] },
    "candidate_compiled_active_config_ref": { "$ref": "#/$defs/artifactRef" },
    "prior_configuration_state_ref": { "$ref": "#/$defs/optionalArtifactRef" },
    "prior_compiled_active_config_ref": { "$ref": "#/$defs/optionalArtifactRef" },
    "diff_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_entry_count",
        "removed_entry_count",
        "changed_entry_count",
        "unchanged_entry_count"
      ],
      "properties": {
        "added_entry_count": { "type": "integer", "minimum": 0 },
        "removed_entry_count": { "type": "integer", "minimum": 0 },
        "changed_entry_count": { "type": "integer", "minimum": 0 },
        "unchanged_entry_count": { "type": "integer", "minimum": 0 }
      }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "artifact_class", "finality_state"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_class": { "type": "string", "minLength": 1 },
        "finality_state": { "type": "string", "minLength": 1 }
      }
    },
    "optionalArtifactRef": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/artifactRef" }
      ]
    }
  }
}
