{
  "$id": "https://constellation.local/schemas/c2/runtime/runtime_control_decision.v1.schema.json",
  "title": "runtime_control_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "runtime_control_decision_id",
    "day_utc",
    "produced_utc",
    "contract_version",
    "capability_scope",
    "environment",
    "ib_account",
    "sleeve_id",
    "outcome",
    "effective_at_utc",
    "source_artifact_refs",
    "reason_codes",
    "evidence_fingerprint",
    "canonical_json_hash"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "runtime_control_decision" },
    "schema_version": { "type": "string", "const": "v1" },
    "record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime_control_decision_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "day_utc": { "type": "string", "minLength": 10, "maxLength": 10 },
    "produced_utc": { "type": "string", "minLength": 11 },
    "contract_version": { "type": "string", "minLength": 1 },
    "capability_scope": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "enum": ["allow", "blocked", "duplicate", "no_action"] },
    "candidate_control_state": { "type": ["string", "null"], "enum": ["ALLOW", "BLOCKED", null] },
    "effective_at_utc": { "type": "string", "minLength": 11 },
    "source_artifact_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "existing_record_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256", "runtime_control_record_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runtime_control_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonical_json_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

