{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/product_snapshot.v1.schema.json",
  "title": "product_snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "surface_kind",
    "snapshot_id",
    "kernel_version",
    "generated_at_utc",
    "authority_label",
    "target_day",
    "scope_id",
    "summary_ref",
    "selected_item_refs",
    "critical_degraded_refs",
    "rendered_ai_summaries"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "aiSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_summary_id",
        "summary_type",
        "rendered_text",
        "degraded_state_summary",
        "blocked_state_summary",
        "provenance_refs",
        "assist_status",
        "version"
      ],
      "properties": {
        "ai_summary_id": { "type": "string", "minLength": 1 },
        "source_summary_ref": { "$ref": "#/$defs/ref" },
        "summary_type": {
          "type": "string",
          "enum": [
            "daily_review_brief",
            "weekly_review_brief",
            "blocked_explanation_brief",
            "domain_condensed_summary",
            "scenario_comparison_brief"
          ]
        },
        "rendered_text": { "type": "string", "minLength": 1 },
        "degraded_state_summary": { "type": "string" },
        "blocked_state_summary": { "type": "string" },
        "provenance_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "assist_status": { "type": "string", "enum": ["generated", "fallback_deterministic"] },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema_id": { "const": "product_snapshot" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "product_snapshot_v1" },
    "surface_kind": { "const": "projection" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "kernel_version": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "authority_label": { "type": "string", "enum": ["governed_product_snapshot"] },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "summary_ref": { "$ref": "#/$defs/ref" },
    "prior_snapshot_ref": { "$ref": "#/$defs/ref" },
    "selected_item_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "critical_degraded_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "rendered_ai_summaries": { "type": "array", "items": { "$ref": "#/$defs/aiSummary" } }
  }
}
