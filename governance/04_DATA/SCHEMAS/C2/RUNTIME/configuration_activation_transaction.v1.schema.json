{
  "schema_id": "C2_CONFIGURATION_ACTIVATION_TRANSACTION_SCHEMA_V1",
  "title": "C2 Configuration Activation Transaction V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "activation_transaction_id",
    "authority_owner",
    "generated_at_utc",
    "activation_kind",
    "activation_status",
    "configuration_policy_snapshot_ref",
    "configuration_validation_result_ref",
    "configuration_compile_result_ref",
    "configuration_review_diff_ref",
    "compiled_active_config_ref",
    "candidate_artifacts",
    "promoted_artifacts",
    "blocked_reason_codes",
    "frozen_input_bundle",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "configuration_activation_transaction.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "activation_transaction_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_owner": { "type": "string", "const": "configuration_activation_authority_v1" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "activation_kind": { "type": "string", "enum": ["FIRST_ACTIVATION", "SUPERSEDING_ACTIVATION"] },
    "activation_status": { "type": "string", "enum": ["PROMOTED", "BLOCKED", "FAILED_VALIDATION"] },
    "configuration_policy_snapshot_ref": { "$ref": "#/$defs/artifactRef" },
    "configuration_validation_result_ref": { "$ref": "#/$defs/artifactRef" },
    "configuration_compile_result_ref": { "$ref": "#/$defs/artifactRef" },
    "configuration_review_diff_ref": { "$ref": "#/$defs/artifactRef" },
    "compiled_active_config_ref": { "$ref": "#/$defs/artifactRef" },
    "prior_configuration_state_ref": { "$ref": "#/$defs/optionalArtifactRef" },
    "prior_activation_transaction_ref": { "$ref": "#/$defs/optionalArtifactRef" },
    "candidate_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "promoted_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "blocked_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "frozen_input_bundle": { "type": "object" },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "artifact_class", "finality_state"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_class": { "type": "string", "minLength": 1 },
        "finality_state": { "type": "string", "minLength": 1 }
      }
    },
    "optionalArtifactRef": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/artifactRef" }
      ]
    }
  }
}
