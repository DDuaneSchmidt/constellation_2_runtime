{
  "schema_id": "C2_RUNTIME_LIFECYCLE_RECEIPT_SCHEMA_V1",
  "title": "C2 Runtime Lifecycle Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "seam_id",
    "status",
    "generated_at_utc",
    "entrypoint_name",
    "entrypoint_path",
    "service_name",
    "launcher_pid",
    "reason_codes",
    "admission_reason_code",
    "admission_reason_summary",
    "active_uniqueness_outcome",
    "active_state_path",
    "runtime_identity_ref"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "runtime_lifecycle_receipt.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "seam_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ADMITTED", "DENIED"] },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "entrypoint_name": { "type": "string", "minLength": 1 },
    "entrypoint_path": { "type": "string", "minLength": 1 },
    "service_name": { "type": "string" },
    "launcher_pid": { "type": "integer", "minimum": 1 },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "admission_reason_code": { "type": "string", "minLength": 1 },
    "admission_reason_summary": { "type": "string", "minLength": 1 },
    "active_uniqueness_outcome": { "type": "string", "minLength": 1 },
    "active_state_path": { "type": "string" },
    "startup_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup_id", "startup_receipt_path", "startup_receipt_sha256"],
      "properties": {
        "startup_id": { "type": "string", "minLength": 1 },
        "startup_receipt_path": { "type": "string", "minLength": 1 },
        "startup_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "conflicting_active_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "launcher_pid", "active_state_path"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "launcher_pid": { "type": "integer", "minimum": 1 },
        "active_state_path": { "type": "string", "minLength": 1 }
      }
    },
    "runtime_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_path",
        "contract_sha256",
        "authoritative_repo_root",
        "runtime_environment",
        "primary_execution_identity_ref"
      ],
      "properties": {
        "contract_path": { "type": "string", "minLength": 1 },
        "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authoritative_repo_root": { "type": "string", "minLength": 1 },
        "runtime_environment": { "type": "string", "minLength": 1 },
        "primary_execution_identity_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_owner", "sleeve_id"],
          "properties": {
            "authority_owner": { "type": "string", "const": "execution_identity_binding_v1" },
            "sleeve_id": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
