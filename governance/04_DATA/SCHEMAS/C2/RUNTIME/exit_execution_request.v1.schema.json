{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/exit_execution_request.v1.schema.json",
  "title": "exit_execution_request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "position_id",
    "decision_id",
    "origin",
    "risk_basis",
    "execution_action",
    "order_type",
    "quantity_fraction",
    "stop_price",
    "decision_action",
    "scoring_eligibility",
    "reason_codes",
    "produced_at_utc",
    "producer",
    "provenance_refs"
  ],
  "properties": {
    "schema_id": { "const": "exit_execution_request" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "position_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "enum": ["NATIVE", "IMPORTED"] },
    "risk_basis": { "type": "string", "enum": ["R_NATIVE", "R_SYNTHETIC", "UNMANAGED"] },
    "execution_action": { "type": "string", "enum": ["AMEND_PROTECTION", "REDUCE_POSITION", "CLOSE_POSITION"] },
    "order_type": { "type": "string", "enum": ["STOP", "MARKET"] },
    "quantity_fraction": { "type": "string" },
    "stop_price": { "type": "string" },
    "decision_action": { "type": "string", "enum": ["UPDATE_STOP", "TAKE_PARTIAL", "EXIT_FULL"] },
    "scoring_eligibility": {
      "type": "string",
      "enum": ["INCLUDED", "EXCLUDED_BY_DEFAULT", "EXCLUDED_PERMANENT"]
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "produced_at_utc": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/producer" },
    "provenance_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenanceRef" }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "artifact_path", "artifact_sha256"],
      "properties": {
        "logical_name": { "type": "string" },
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" }
      }
    }
  }
}
