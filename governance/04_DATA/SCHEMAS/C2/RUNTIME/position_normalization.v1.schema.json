{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/position_normalization.v1.schema.json",
  "title": "position_normalization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "position_id",
    "origin",
    "normalization_status",
    "risk_basis",
    "entry_reference",
    "initial_stop_reference",
    "initial_r_value",
    "reference_entry_source",
    "synthetic_stop_source",
    "scoring_eligibility",
    "exit_management_eligibility",
    "reason_codes",
    "synthetic_risk_labeled",
    "produced_at_utc",
    "producer",
    "provenance_refs"
  ],
  "properties": {
    "schema_id": { "const": "position_normalization" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "position_id": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "enum": ["NATIVE", "IMPORTED"] },
    "normalization_status": { "type": "string", "enum": ["NORMALIZED", "BLOCKED"] },
    "risk_basis": { "type": "string", "enum": ["R_NATIVE", "R_SYNTHETIC", "UNMANAGED"] },
    "entry_reference": { "$ref": "#/$defs/priceReference" },
    "initial_stop_reference": { "$ref": "#/$defs/priceReference" },
    "initial_r_value": { "type": "string" },
    "reference_entry_source": { "type": "string" },
    "synthetic_stop_source": { "type": "string" },
    "scoring_eligibility": {
      "type": "string",
      "enum": ["INCLUDED", "EXCLUDED_BY_DEFAULT", "EXCLUDED_PERMANENT"]
    },
    "exit_management_eligibility": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "synthetic_risk_labeled": { "type": "boolean" },
    "produced_at_utc": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/producer" },
    "provenance_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenanceRef" }
    }
  },
  "$defs": {
    "priceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "price"],
      "properties": {
        "source": { "type": "string" },
        "price": { "type": "string" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "artifact_path", "artifact_sha256"],
      "properties": {
        "logical_name": { "type": "string" },
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" }
      }
    }
  }
}
