{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/exit_decision.v1.schema.json",
  "title": "exit_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "day_utc",
    "position_id",
    "decision_id",
    "origin",
    "risk_basis",
    "management_state",
    "decision_action",
    "reason_codes",
    "rule_trace",
    "rule_precedence_version",
    "side",
    "quantity",
    "entry_price",
    "mark_price",
    "current_stop_price",
    "proposed_stop_price",
    "initial_r_value",
    "r_multiple",
    "partial_exit_fraction",
    "scoring_eligibility",
    "exit_execution_eligibility",
    "normalization_ref",
    "produced_at_utc",
    "producer",
    "provenance_refs"
  ],
  "properties": {
    "schema_id": { "const": "exit_decision" },
    "schema_version": { "const": "v1" },
    "day_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "position_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "enum": ["NATIVE", "IMPORTED"] },
    "risk_basis": { "type": "string", "enum": ["R_NATIVE", "R_SYNTHETIC", "UNMANAGED"] },
    "management_state": {
      "type": "string",
      "enum": [
        "OPEN_UNPROTECTED",
        "OPEN_INITIAL_RISK",
        "OPEN_RISK_REDUCED",
        "OPEN_PARTIALS_TAKEN",
        "OPEN_TRAILING",
        "EXIT_PENDING",
        "EXIT_SUBMITTED",
        "EXIT_FILLED",
        "EXIT_CANCELLED",
        "EXIT_BLOCKED"
      ]
    },
    "decision_action": { "type": "string", "enum": ["HOLD", "UPDATE_STOP", "TAKE_PARTIAL", "EXIT_FULL", "BLOCK"] },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rule_trace": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rule_precedence_version": { "type": "string", "minLength": 1 },
    "side": { "type": "string", "enum": ["LONG", "SHORT"] },
    "quantity": { "type": "string" },
    "entry_price": { "type": "string" },
    "mark_price": { "type": "string" },
    "current_stop_price": { "type": "string" },
    "proposed_stop_price": { "type": "string" },
    "initial_r_value": { "type": "string" },
    "r_multiple": { "type": "string" },
    "partial_exit_fraction": { "type": "string" },
    "scoring_eligibility": {
      "type": "string",
      "enum": ["INCLUDED", "EXCLUDED_BY_DEFAULT", "EXCLUDED_PERMANENT"]
    },
    "exit_execution_eligibility": { "type": "string", "enum": ["APPROVED", "BLOCKED"] },
    "normalization_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_id", "normalization_status"],
      "properties": {
        "position_id": { "type": "string", "minLength": 1 },
        "normalization_status": { "type": "string", "minLength": 1 }
      }
    },
    "produced_at_utc": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/producer" },
    "provenance_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenanceRef" }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "module", "git_sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "git_sha": { "type": "string", "minLength": 1 }
      }
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "artifact_path", "artifact_sha256"],
      "properties": {
        "logical_name": { "type": "string" },
        "artifact_path": { "type": "string" },
        "artifact_sha256": { "type": "string" }
      }
    }
  }
}
