{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/startup_chain_certification.v1.schema.json",
  "title": "startup_chain_certification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "target_day",
    "scope_id",
    "operation_type",
    "sleeve_id",
    "environment",
    "ib_account",
    "certified_at_utc",
    "certification_status",
    "boundary_validator_result",
    "family_validator_results",
    "stage_admission_refs",
    "stage_certification_refs",
    "blocking_reason_codes",
    "closure_state",
    "blocking_codes",
    "first_blocker_code",
    "missing_dependency_artifacts",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "const": "startup_chain_certification" },
    "schema_version": { "const": "v1" },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "operation_type": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "certified_at_utc": { "type": "string", "minLength": 20 },
    "certification_status": { "enum": ["CERTIFIED", "FAILED"] },
    "boundary_validator_result": { "type": "object", "additionalProperties": true },
    "family_validator_results": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "stage_admission_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_ref" }
    },
    "stage_certification_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_ref" }
    },
    "blocking_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "closure_state": { "enum": ["COMPLETE", "BLOCKED"] },
    "blocking_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "first_blocker_code": { "type": "string" },
    "missing_dependency_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "control_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 1 }
      }
    }
  }
}
