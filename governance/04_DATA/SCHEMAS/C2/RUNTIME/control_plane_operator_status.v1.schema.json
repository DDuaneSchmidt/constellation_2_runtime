{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/c2/runtime/control_plane_operator_status.v1.schema.json",
  "title": "control_plane_operator_status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "surface_kind",
    "projection_id",
    "projection_version",
    "generated_at_utc",
    "authority_label",
    "target_day",
    "scope_id",
    "operation_type",
    "sleeve_id",
    "environment",
    "ib_account",
    "freshness_state",
    "chain_certification_status",
    "current_operator_status",
    "stage_rows",
    "governing_stage_refs",
    "governing_transition_refs",
    "governing_certification_refs",
    "evidence_refs",
    "semantic_events"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "semantic_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "authority_label",
        "freshness_state",
        "projection_version",
        "governing_refs",
        "taxonomy"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "transition_start",
            "transition_completion",
            "blocked_transition",
            "supersession",
            "certification_outcome",
            "projection_refresh",
            "advisory_invalidation"
          ]
        },
        "transition_id": { "type": "string" },
        "projection_id": { "type": "string" },
        "stage_id": { "type": "string" },
        "policy": { "type": "string" },
        "status": { "type": "string" },
        "authority_label": { "type": "string" },
        "governing_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "taxonomy": { "type": "array", "items": { "type": "string" } },
        "freshness_state": { "type": "string" },
        "projection_version": { "type": "string", "minLength": 1 }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explanation_id",
        "taxonomy_code",
        "stage_id",
        "policy",
        "status",
        "short_message",
        "details_fields",
        "evidence_refs",
        "authority_label",
        "freshness_state"
      ],
      "properties": {
        "explanation_id": { "type": "string", "minLength": 1 },
        "taxonomy_code": { "type": "string", "minLength": 1 },
        "stage_id": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "short_message": { "type": "string", "minLength": 1 },
        "details_fields": { "type": "object", "additionalProperties": true },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "authority_label": { "type": "string", "minLength": 1 },
        "freshness_state": { "type": "string", "minLength": 1 },
        "action_class": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema_id": { "const": "control_plane_operator_status" },
    "schema_version": { "const": "v1" },
    "artifact_id": { "const": "control_plane_operator_status_v1" },
    "surface_kind": { "const": "projection" },
    "projection_id": { "type": "string", "minLength": 1 },
    "projection_version": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "authority_label": { "type": "string", "enum": ["governed_derived"] },
    "target_day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "operation_type": { "type": "string", "minLength": 1 },
    "sleeve_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "ib_account": { "type": "string", "minLength": 1 },
    "freshness_state": { "type": "string", "enum": ["fresh", "stale", "superseded", "uncertified", "historical_only", "unknown"] },
    "explanation_mapping_version": { "type": "string", "minLength": 1 },
    "chain_certification_status": { "type": "string", "enum": ["CERTIFIED", "FAILED", "MISSING"] },
    "current_operator_status": { "type": "string", "enum": ["CERTIFIED_READY", "BLOCKED", "UNCERTIFIED", "PARTIAL", "UNKNOWN"] },
    "stage_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "stage_admitted", "stage_certified", "freshness_state"],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "stage_admitted": { "type": "boolean" },
          "stage_certified": { "type": "boolean" },
          "latest_transition_status": { "type": "string" },
          "latest_transition_ref": { "$ref": "#/$defs/ref" },
          "freshness_state": { "type": "string", "enum": ["fresh", "stale", "superseded", "uncertified", "historical_only", "unknown"] }
        }
      }
    },
    "latest_blocked_transition_ref": { "$ref": "#/$defs/ref" },
    "latest_blocked_explanations": { "type": "array", "items": { "$ref": "#/$defs/explanation" } },
    "recovery_supersession_lineage": { "type": "array", "items": { "type": "object" } },
    "governing_stage_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_transition_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "governing_certification_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "semantic_events": { "type": "array", "items": { "$ref": "#/$defs/semantic_event" } }
  }
}

