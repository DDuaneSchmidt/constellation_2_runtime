{
  "schema_id": "C2_CONFIGURATION_POLICY_SNAPSHOT_SCHEMA_V1",
  "title": "C2 Configuration Policy Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "policy_snapshot_id",
    "authority_owner",
    "generated_at_utc",
    "effective_at_utc",
    "activation_scope",
    "source_document_refs",
    "governance_utility_refs",
    "policy_digest_sha256",
    "closure_state",
    "blocked_reason_codes",
    "constitutional_dependency_declaration",
    "constitutional_lineage"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "configuration_policy_snapshot.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "policy_snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_owner": { "type": "string", "const": "configuration_activation_authority_v1" },
    "generated_at_utc": { "type": "string", "minLength": 20 },
    "effective_at_utc": { "type": "string", "minLength": 20 },
    "activation_scope": { "type": "string", "const": "runtime" },
    "source_document_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceDocumentRef" }
    },
    "governance_utility_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/logicalRef" }
    },
    "policy_digest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "closure_state": { "type": "string", "enum": ["COMPLETE", "BLOCKED"] },
    "blocked_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constitutional_dependency_declaration": { "type": "object" },
    "constitutional_lineage": { "type": "object" }
  },
  "$defs": {
    "logicalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "path", "sha256"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "sourceDocumentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "path", "sha256", "document_class"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "document_class": { "type": "string", "minLength": 1 }
      }
    }
  }
}
