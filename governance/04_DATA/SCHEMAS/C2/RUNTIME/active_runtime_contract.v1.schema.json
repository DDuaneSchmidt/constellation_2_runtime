{
  "schema_id": "C2_RUNTIME_ACTIVE_RUNTIME_CONTRACT_SCHEMA_V1",
  "title": "C2 Active Runtime Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "release_id",
    "git_sha",
    "authoritative_repo_root",
    "release_root",
    "runtime_data_root",
    "canonical_truth_root",
    "truth_sleeves_root",
    "pointer_index_family",
    "allowed_truth_roots",
    "provenance_mode",
    "runtime_environment",
    "primary_execution_identity_ref",
    "generated_at_utc",
    "status"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "active_runtime_contract.v1" },
    "schema_version": { "type": "string", "const": "v1" },
    "release_id": { "type": "string", "minLength": 1 },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "authoritative_repo_root": { "type": "string", "minLength": 1 },
    "release_root": { "type": "string", "minLength": 1 },
    "runtime_data_root": { "type": "string", "minLength": 1 },
    "canonical_truth_root": { "type": "string", "minLength": 1 },
    "truth_sleeves_root": { "type": "string", "minLength": 1 },
    "pointer_index_family": { "type": "string", "enum": ["run_pointer_v1"] },
    "allowed_truth_roots": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance_mode": { "type": "string", "enum": ["release_manifest"] },
    "runtime_environment": { "type": "string", "enum": ["PAPER"] },
    "primary_execution_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_owner", "sleeve_id"],
      "properties": {
        "authority_owner": { "type": "string", "const": "execution_identity_binding_v1" },
        "sleeve_id": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at_utc": { "type": "string", "minLength": 11 },
    "status": { "type": "string", "enum": ["ACTIVE"] }
  }
}
