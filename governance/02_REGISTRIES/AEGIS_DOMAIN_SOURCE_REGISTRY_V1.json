      "rebuild_command": "python3 ops/tools/build_domain_source_v1.py --truth-root {truth_root} --day-utc {day_utc} --domain-id EARNINGS_EVENTS",
      "repair_mode_when_missing": "SOURCE_SETUP_REQUIRED",
      "required": false,
      "required_config_keys": [
        "AEGIS_EARNINGS_EVENTS_SOURCE_FILE"
      ],
      "required_fields": [
        "symbol",
        "company",
        "report_date",
        "report_time",
        "confirmed_or_estimated",
        "source"
      ],
      "required_source": "earnings_events_v1",
      "setup_required_message": "Set AEGIS_EARNINGS_EVENTS_SOURCE_FILE to a governed JSON export or place earnings_events.v1.json at the required path. Required fields: symbol, company, report date/time, confirmed/estimated flag, source.",
      "validation_command": "python3 ops/tools/validate_domain_source_v1.py --truth-root {truth_root} --day-utc {day_utc} --domain-id EARNINGS_EVENTS"
    },
    {
      "artifact_path_template": "reports/corporate_actions_v1/{day_utc}/corporate_actions.v1.json",
      "certification_command": "python3 ops/tools/build_domain_certification_v1.py --truth-root {truth_root} --day-utc {day_utc}",
      "coverage_requirement": "split/dividend/corporate-action coverage for tracked symbols",
      "domain_id": "CORPORATE_ACTIONS",
