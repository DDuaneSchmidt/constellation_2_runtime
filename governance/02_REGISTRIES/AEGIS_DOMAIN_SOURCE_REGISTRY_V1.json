      ],
      "required_fields": [
        "symbol",
        "action_type",
        "effective_date",
        "source"
      ],
      "required_source": "corporate_actions_v1",
      "setup_required_message": "Set AEGIS_CORPORATE_ACTIONS_SOURCE_FILE to a governed JSON export or place corporate_actions.v1.json at the required path. Required fields: symbol, action type, effective date, source.",
      "validation_command": "python3 ops/tools/validate_domain_source_v1.py --truth-root {truth_root} --day-utc {day_utc} --domain-id CORPORATE_ACTIONS"
