      "owner": "execution_observer",
      "expected_source_path": "execution_stream_v1/<DAY>/*.execution_event_stream_record.v1.json",
      "generation_path": "ops/tools/run_execution_stream_snapshot_day_v1.py --day_utc <DAY>",
