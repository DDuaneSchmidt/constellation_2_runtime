      "day_alignment_rule": "operator statement day must equal target day",
      "freshness_rule": "same_day_only",
      "blocking": true,
      "downstream_consumers": [
        "cash_ledger_v1/snapshots",
        "accounting_v2/nav"
      ]
    },
    {
      "dependency_id": "raw_broker_statement_input",
      "dependency_version": 1,
      "dependency_type": "operator_input",
      "owner": "operator",
      "expected_source_path": "operator_inputs/raw_broker_statements/<DAY>/broker_statement_raw.v1.json",
      "generation_path": "ops/tools/ingest_raw_broker_statement_v1.py --day_utc <DAY> --truth_root <TRUTH_ROOT> --input_json <RAW_STATEMENT_JSON>",
      "day_alignment_rule": "raw broker statement input must correspond to target day",
      "freshness_rule": "same_day_only",
      "blocking": true,
      "downstream_consumers": [
        "execution_evidence_v1/broker_statement_normalized_v1",
        "market_data_snapshot_v1/broker_marks_v1",
        "accounting_v2/nav"
      ]
    },
    {
      "dependency_id": "broker_marks_override_input",
      "dependency_version": 1,
      "dependency_type": "operator_input",
      "owner": "operator",
      "expected_source_path": "constellation_2/operator_inputs/broker_marks_operator_overrides/<DAY>/broker_marks_override.v1.json",
      "generation_path": "ops/tools/run_broker_marks_snapshot_day_v1.py --day_utc <DAY>",
      "day_alignment_rule": "override day must equal target day",
      "freshness_rule": "same_day_only",
      "blocking": false,
      "downstream_consumers": [
        "market_data_snapshot_v1/broker_marks_v1"
      ]
