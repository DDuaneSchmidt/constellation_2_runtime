    {
      "dependency_id": "submission_identity_bundle",
      "dependency_version": 1,
      "dependency_type": "runtime_truth",
      "owner": "phaseD_and_phaseF_execution_evidence",
      "expected_source_path": "execution_evidence_v1/submissions/<DAY>/<SUBMISSION_DIR>/{broker_submission_record.v2.json,execution_event_record.v1.json,equity_order_plan.v1.json}",
      "generation_path": "constellation_2/phaseF/execution_evidence/run/run_execution_evidence_truth_day_v1.py --day_utc <DAY>",
