# FCC-SOURCE-001 canonical repository boundaries
#
# Versioned in Git:
# - application and governance source;
# - tests and authored documentation;
# - research_journal/** evidence inputs required by reproducible tests; and
# - explicit fixtures and static application assets.
#
# Never versioned here:
# - live/runtime state;
# - downloaded or cached market data;
# - generated reports, browser captures, and proof bundles;
# - local credentials, environments, and tool caches.

# Python and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and package outputs
.venv/
.venv_*/
venv/
node_modules/
dist/
build/
*.egg-info/

# OS and editor files
.DS_Store
*.swp
*.swo
*~

# Credentials and local configuration
.env
.env.*
!.env.example
ops/config/*.env
*.pem
*.key

# Runtime state. The top-level runtime/ directory is Python source and is
# intentionally NOT ignored.
/constellation_2/runtime/
/constellation_2/phaseD/outputs/
/constellation_2/phaseF/**/inputs/
/artifacts/
/tmp/
/.tmp_runtime_quarantine_*/

# Local/downloaded datasets and research execution stores
/data/
/research_lab/research_store/
/research_lab/local_data/ohlcv/csv_readiness_report.json
/research_lab/local_data/ohlcv/expected_csv_files.json
/research_lab/local_data/ohlcv/templates/*_template.csv

# Generated reports and evidence outputs. Versioned evidence inputs live in
# research_journal/** and are deliberately not ignored.
/reports/
/docs/screenshots/
/docs/aegis/operator_ui_projection_audit.v1.*
/aegis_ui_architecture_proof/
/aegis_ui_legacy_cleanup_proof/
/aegis_ui_phase1b_audit/
/aegis_filtered_real_icon_logo_candidates_manifest.tsv

# Root-level generated image/research exports. Static UI assets and test
# fixtures in subdirectories remain eligible for version control.
/*.png
/research_*_v*.json
/research_*_v*.png
/research_data_readiness_audit_v1.json
/research_pipeline_data_resolution_report_v1.json

# Temporary/generated file suffixes
*.tmp
*.out
